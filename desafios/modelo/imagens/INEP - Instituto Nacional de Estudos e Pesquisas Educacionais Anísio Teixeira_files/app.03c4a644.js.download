amp;&amp; c.menu.exibeEspelho()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor:pointer" ng-click="c.navegarEspelho()" ng-if="!c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Acompanhar inscri&ccedil;&atilde;o {{c.anoEdicao}}</a></li><li class="ng-scope"><a style="cursor:pointer" ng-click="c.downloadDeclaracao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Declara&ccedil;&atilde;o Comparecimento</a></li><li class="ng-scope"><a style="cursor:pointer" ng-click="c.navegarCartaoConfirmacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Local de Prova/Cart&atilde;o Confirma&ccedil;&atilde;o</a></li><li class="ng-scope"><a style="cursor:pointer" ng-click="c.navegarDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuDoencaInfectoContagiosaVisivel.menuDoencaInfectoContagiosaEnabled" class="ng-scope">Doenças Infectocontagiosas</a></li><li class="ng-scope"><a style="cursor:pointer" ng-click="c.navegarResultadoDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuResultadoDoencaInfectoContagiosaVisivel.menuResultadoDoencaInfectoContagiosaEnabled" class="ng-scope">Resultado de Doenças Infectocontagiosas</a></li><li class="ng-scope"><a style="cursor:pointer" ng-click="c.navegarReaplicacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeReaplicacao() || c.menu.exibeReaplicacaoResultado()" class="ng-scope">Solicita&ccedil;&atilde;o de Reaplica&ccedil;&atilde;o</a></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor:pointer" class="ng-scope">Alterar dados</a></li><li class="ng-scope"><a style="cursor:pointer;padding-left:30px" ng-click="c.navegarDadosPessoais()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeAlterarDadosInscricao()" class="ng-scope">Informa&ccedil;&otilde;es pessoais</a></li><li class="ng-scope"><a style="cursor:pointer;padding-left:30px" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope">Atendimento Especializado</a></li><li class="ng-scope"><a style="cursor:pointer;padding-left:40px" ng-click="c.navegarAtendimentosEspecializados()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope">Solicitar / Alterar Solicitação</a></li><li class="ng-scope"><a style="cursor:pointer;padding-left:30px" ng-click="c.navegarMunicipioProva()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuInformacoesProvaVisivel.inscricaoEmAndamento" class="ng-scope">Informa&ccedil;&otilde;es de prova</a></li><li class="ng-scope"><a style="cursor:pointer;padding-left:30px" ng-click="c.navegarJustificativaAusencia()" ng-if="c.validarExibicaoAcompanhamentoJustific()" class="ng-scope">Justificativa de aus&ecirc;ncia</a></li><li class="ng-scope"><a style="cursor:pointer;padding-left:30px" ng-click="c.navegarContato()" class="ng-scope">Contato</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; false" class="ng-scope"><a style="cursor:pointer;padding-left:30px" data-ui-sref="atualizarSenha" class="ng-scope">Senha</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuRecursoLaudoMedico" class="ng-scope"><a style="cursor:pointer;padding-left:30px" ng-click="c.navegarLaudoMedico()" class="ng-scope">Recurso Laudo M&eacute;dico</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuTratamentoNomeSocialVisivel.menuTratamentoNomeSocialEnabled" class="ng-scope"><a style="cursor:pointer;padding-left:30px" data-ui-sref="nomeSocial" class="ng-scope">Tratamento pelo Nome Social</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.recursoMenuTratamentoNomeSocialVisivel.recursoMenuTratamentoNomeSocialEnabled &amp;&amp; !!c.menuRecursoNomeSocial" class="ng-scope"><a style="cursor:pointer;padding-left:30px" data-ui-sref="reenvioNomeSocial" class="ng-scope">Recurso Nome Social</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menu.exibeBoletoCobranca()" class="ng-scope"><a style="cursor:pointer;padding-left:30px" data-ui-sref="boletoCobranca" class="ng-scope">Boleto de Cobrança</a></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultados()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor:pointer" class="ng-scope">Resultado</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2017()" class="ng-scope"><a style="cursor:pointer;padding-left:30px" data-ui-sref="resultado2017" class="ng-scope">ENCCEJA 2017</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2018()" class="ng-scope"><a style="cursor:pointer;padding-left:30px" data-ui-sref="resultado2018" class="ng-scope">ENCCEJA 2018</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2019()" class="ng-scope"><a style="cursor:pointer;padding-left:30px" data-ui-sref="resultado2019" class="ng-scope">ENCCEJA 2019</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2020()" class="ng-scope"><a style="cursor:pointer;padding-left:30px" data-ui-sref="resultado2020" class="ng-scope">ENCCEJA 2020</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2022()" class="ng-scope"><a style="cursor:pointer;padding-left:30px" data-ui-sref="resultado2022" class="ng-scope">ENCCEJA 2022</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2023()" class="ng-scope"><a style="cursor:pointer;padding-left:30px" data-ui-sref="resultado2023" class="ng-scope">ENCCEJA 2023</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2024()" class="ng-scope"><a style="cursor:pointer;padding-left:30px" data-ui-sref="resultado2024" class="ng-scope">ENCCEJA 2024</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2025()" class="ng-scope"><a style="cursor:pointer;padding-left:30px" data-ui-sref="resultado2025" class="ng-scope">ENCCEJA 2025</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2026()" class="ng-scope"><a style="cursor:pointer;padding-left:30px" data-ui-sref="resultado2026" class="ng-scope">ENCCEJA 2026</a></li></ul><ul inep-sidebar="inep-sidebar" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor:pointer" ng-click="c.sair()" class="ng-scope">Sair</a></li></ul></nav></section></div><div class="col-sm-9 col-sm-offset-3 col-md-10 col-md-offset-2"><div class="panel-box ng-scope"><div ng-controller="InformacoesPessoaisController as c" ng-init="c.init()"><header><div class="page-header with-space-top"><h1 class="h3">Inscri&ccedil;&atilde;o > ENCCEJA <small>dados pessoais</small></h1></div></header><div class="row"><div class="col-md-12"><form autocomplete="off" inep-message-bag="inep-message-bag" message-bag-header-error="O formulário abaixo está inválido pelos seguintes erros:" name="informacoesPessoaisForm" novalidate="true" role="form"><div tabindex="0"><div class="text-center text-primary"><label>Os campos com <i alt="asterisco" class="fa fa-asterisk"><span class="hidden-accessibility">asterisco</span></i> s&atilde;o de preenchimento obrigat&oacute;rio</label></div><div class="row with-space-bottom"></div></div><div class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Dados pessoais</h2></div><div class="panel-body"><div class="row"><inep-cpf np-id="numeroCpf" np-label="CPF " np-optional="false" np-readonly="true" np-size="2" np-value="c.informacoesPessoais.cpf"></inep-cpf><inep-input-text np-id="inputNome" np-label="Nome completo" ng-model="c.informacoesPessoais.nome" np-optional="false" np-readonly="true" np-size="7"></inep-input-text><div class="col-md-3"><inep-calendar ng-model="c.informacoesPessoais.dataDeNascimento" np-id="calendar" np-label="Data de nascimento" np-type="popup" np-optional="false" np-starting-day="0" np-hide-icon="true" np-min-date="1900-01-01" np-year-range="20" np-current-text="Hoje" np-clear-text="Limpar" np-close-text="Fechar" np-width="12" np-readonly="true"></inep-calendar></div></div><div class="row"><inep-input-text np-id="inputNomeMae" np-label="Nome completo da mãe" ng-model="c.informacoesPessoais.nomeDaMae" np-optional="false" np-readonly="true" np-size="6"></inep-input-text><inep-radiobutton np-id="checkboxSexo" np-inline="true" np-label="Sexo" np-selected-value="c.informacoesPessoais.sexo" np-on-change="c.alteraDeclaracaoRecurso()" np-optional="false" np-values="c.sexos" np-text-name="label" np-value-name="value" np-size="3"></inep-radiobutton></div><div class="row"><inep-boolean-checkbox np-id="exteriorCheck" np-value="\'Não quero declarar o nome do meu pai\'" np-selected-value="c.informarNomePai" np-optional="true" np-on-change="c.onChangeDeclaraPai()" np-size="6"></inep-boolean-checkbox><inep-input-text np-id="inputNomePai" np-label="Nome completo do pai" ng-model="c.informacoesPessoais.nomeDoPai" inep-validator="c.validarNomeDoPai(c.informacoesPessoais.nomeDoPai)" np-optional="c.informarNomePai" np-readonly="c.informarNomePai" np-size="6"></inep-input-text></div><div class="row"><inep-combobox np-id="selectEtnia" np-label="Cor ou Raça" np-optional="false" np-selected-value="c.informacoesPessoais.etnia" np-values="c.etnias" np-size="3"></inep-combobox><inep-combobox np-id="selectEstadoCivil" np-label="Estado civil" np-optional="false" np-selected-value="c.informacoesPessoais.estadoCivil" np-size="3" np-values="c.estadosCivis"></inep-combobox><inep-combobox np-accessibility-message="{{c.mensagens.MSGA030}}" np-id="selectNacionalidade" np-label="Nacionalidade" np-optional="false" np-selected-value="c.informacoesPessoais.nacionalidade" np-size="6" np-on-change="c.nacionalidadeChanged()" np-values="c.nacionalidades"></inep-combobox></div><div class="row"><div id="nacionalidade" ng-if="c.isBrasileiro()"><inep-combobox np-accessibility-message="{{c.mensagens.MSGA031}}" np-id="ufNascimento" np-label="UF de nascimento" np-optional="!c.isBrasileiro()" np-selected-value="c.informacoesPessoais.nascimentoUf" np-size="3" np-values="c.ufs"></inep-combobox><inep-municipio np-id="municipioNascimento" np-accessibility-message="{{c.mensagens.MSGA032}}" np-label="Município de nascimento" np-optional="!c.isBrasileiro()" np-no-select-label="Selecione" np-selected-value="c.informacoesPessoais.nascimentoMunicipio" np-size="3" np-uf="c.informacoesPessoais.nascimentoUf"></inep-municipio></div></div><div class="row with-space-top"><div class="col-md-12"><div class="box-describe"><span class="text-justify">Caso seus dados pessoais não estejam corretos, continue sua inscrição fornecendo os dados\nsolicitados e após concluí-la, entre em contato com a Receita Federal para realizar a\natualização necessária. Em caso de dúvidas entre em contato com a Central de Atendimento\ndo Inep pelo telefone 0800-616161 ou com a Ouvidoria pelo endereço&ensp;<a target="_blank" href="https://falabr.cgu.gov.br/">falabr.cgu.gov.br.</a></span></div></div></div></div></div><div class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Endere&ccedil;o</h2></div><div class="panel-body"><div class="row"><inep-cep np-accessibility-message="{{c.mensagens.MSGA013}}" np-cep-found="c.cepCorreio" np-id="inputResidenciaCep" np-label="CEP" np-on-blur="c.consultarCep()" np-optional="false" np-do-watch="c.flagWatchCep" np-value="c.informacoesPessoais.residencia.cep"></inep-cep><div style="" class="col-md-3"><a target="_blank" title="{{c.mensagens.MSGA056}}" href="http://www.buscacep.correios.com.br/">Se você não tem certeza de qual é o seu CEP, o site dos Correios pode te ajudar.<span style="position:absolute;left:-999em">{{c.mensagens.MSGA056}}</span></a></div></div><div class="row"><inep-input-text np-accessibility-message="{{c.mensagens.MSGA014}}" np-disabled="c.informacoesPessoais.desabilitaCampoLogradouro" np-id="inputResidenciaLogradouro" np-label="Endereço" np-maxlength="100" ng-model="c.informacoesPessoais.residencia.logradouro" np-optional="true" np-readonly="c.informacoesPessoais.desabilitaCampoLogradouro" np-size="6"></inep-input-text><inep-input-text np-accessibility-message="{{c.mensagens.MSGA015}}" np-id="inputResidenciaNumero" np-label="Número" np-maxlength="8" ng-model="c.informacoesPessoais.residencia.numero" np-optional="false" np-size="2"></inep-input-text><inep-input-text np-accessibility-message="{{c.mensagens.MSGA016}}" np-id="inputResidenciaComplemento" np-label="Complemento" np-maxlength="50" ng-model="c.informacoesPessoais.residencia.complemento" np-optional="true" np-size="4"></inep-input-text></div><div class="row"><inep-input-text np-accessibility-message="{{c.mensagens.MSGA017}}" np-id="inputResidenciaBairro" np-disabled="c.informacoesPessoais.desabilitaCampoBairro" np-label="Bairro" np-maxlength="100" ng-model="c.informacoesPessoais.residencia.bairro" np-optional="true" np-readonly="c.informacoesPessoais.desabilitaCampoBairro" np-size="6"></inep-input-text><inep-input-text np-disabled="true" np-id="inputResidenciaMunicipio" np-label="Município" np-maxlength="100" ng-model="c.informacoesPessoais.residencia.municipio" np-optional="true" np-readonly="true" np-size="4"></inep-input-text><inep-input-text np-disabled="true" np-id="inputResidenciaUf" np-label="UF" np-maxlength="100" ng-model="c.informacoesPessoais.residencia.uf" np-optional="true" np-readonly="true" np-size="2"></inep-input-text></div></div></div></form></div></div><div inep-modal="inep-modal" np-id="modalWizard" np-buttons="c.modalInscricoesEncerradas.buttons" np-options="c.modalOptions" np-show="c.modalInscricoesEncerradas.show"><h2 aria-labelledby="texto" tabindex="0" class="titulo-modal h5 panel-title text-center text-primary">{{ c.modalInscricoesEncerradas.message }}\n</h2></div><div inep-modal="inep-modal" np-buttons="c.modalPesquisaAusencia.buttons" np-show="c.modalPesquisaAusencia.show" np-id="modalPesquisa" np-options="c.modalPesquisaAusencia.options"><p>Participante, verificamos que você foi ausente na aplicação do Encceja do ano passado.\nQue bom te ver por aqui fazendo uma nova inscrição e contamos com a sua presença no dia de aplicação das provas.</p><p>Assim, gostaríamos que você nos indicasse os motivos que te levaram a não comparecer no dia de aplicação das provas. Você pode marcar uma ou mais opções. Sua resposta é sigilosa e ajudará o Inep a melhorar a aplicação do Exame.</p><div ng-repeat="alternativa in c.modalPesquisaAusencia.alternativas track by alternativa.id"><input id="a{{alternativa.id}}" type="checkbox" ng-model="c.respostasPesquisaAusencia[alternativa.id]" ng-true-value="{{alternativa}}" ng-false-value="null" ng-optional="false"><label style="margin-left:5px">{{alternativa.noJustificativa}}</label><br><textarea ng-if="c.respostasPesquisaAusencia[alternativa.id].noJustificativa.includes(\'descreva\')" id="complemento-pesquisa" ng-model="c.respostasPesquisaAusencia[alternativa.id].complemento" maxlength="1000" style="width:100%"></textarea></div><h5 ng-if="c.erroNenhumaResposta" style="color:#a94442" class="h5 panel-title"><b class="fa fa-times-circle-o"></b>Marcação obrigatória.</h5><br><h5 tabindex="0" focus-me="focus-me" class="h5 panel-title text-center">Obrigado por sua resposta. Só a educação pode transformar vidas! Compareça.</h5></div></div><div class="clearfix"><ul class="pagination margin-bottom-none pull-right"><li class="primary"><button data-ng-href="#/" ng-click="c.salvarDadosPessoais()" role="button" class="btn btn-primary">Salvar</button></li></ul></div><div inep-modal="inep-modal" np-id="modalWizard" np-buttons="c.modalAlteraSexo.botoes" np-show="c.modalAlteraSexo.exibe"><h2 aria-labelledby="texto" tabindex="0" class="titulo-modal h5 panel-title text-center text-primary">{{ c.modalAlteraSexo.mensagem }}</h2></div><div inep-modal="inep-modal" np-id="modalWizard2" np-buttons="c.modelOrientacaoAtendEspecifico.botoes" np-show="c.modelOrientacaoAtendEspecifico.exibe"><h2 aria-labelledby="texto" tabindex="0" class="titulo-modal h5 panel-title text-center text-primary">{{ c.modelOrientacaoAtendEspecifico.mensagem }}</h2></div></div><div inep-modal="inep-modal" np-buttons="c.buttons" np-show="c.modalShow" np-id="modal" np-options="c.modalOptions" np-header="Aviso"><p tabindex="0">{{ c.modalMessage }}</p></div><div inep-modal="inep-modal" np-id="modalCarencia" np-buttons="c.modalCarencia.buttons" np-show="c.modalCarencia.show" np-options="c.modalCarencia.options" np-header="Aviso"><p tabindex="0">{{ c.modalCarencia.message }}</p></div><div inep-modal="inep-modal" np-id="modalExibirMensagem" np-buttons="c.modalExibirMensagem.buttons" np-show="c.modalExibirMensagem.show" np-options="c.modalExibirMensagem.options" np-header="Avaliar serviço"><p tabindex="0">{{ c.modalExibirMensagem.saudacao }}</p><p tabindex="0">{{ c.modalExibirMensagem.message }}</p></div><div inep-modal="inep-modal" np-buttons="c.modalSair.buttons" np-show="c.modalSair.show" np-id="modalSair" np-options="c.modalSair.options" np-header="Aviso"><p tabindex="0">{{ c.modalSair.saudacao }}</p><p tabindex="0">{{ c.modalSair.message }}</p></div></div></div></section></main>'),a.put("views/acompanhamento/atualizarMunicipioProva.html",'<header role="banner"><h1 class="hide"> - </h1><nav role="navigation" aria-labelledby="#nav" ng-controller="NavigationBarController" class="navbar navbar-default navbar-fixed-top"><h2 id="nav" class="hide">Navegação Principal</h2><div class="container-fluid"><div class="navbar-header text-center"><button type="button" data-toggle="offcanvas" class="navbar-toggle collapsed left"><span class="sr-only">Toggle navigation</span><span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span></button><div aria-label="Bem vindo ao INEP" class="navbar-brand"><img src="images/logo_inep.svg" alt="Instituto Nacional de Estudos e Pesquisas Educacionais Anísio Teixeira"></div><button type="button" data-toggle="collapse" data-target="#navbar-collapse" class="navbar-toggle collapsed right p-n"><span class="sr-only">Toggle navigation</span><i class="fa fa-gear text-white"></i></button></div><script type="text/ng-template" id="warning-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Você ainda está aí?</h3></div><div idle-countdown="countdown" class="modal-body"><uib-progressbar max="30" value="countdown" animate="true" class="progress-striped active"></uib-progressbar>Sua sessão será encerrada em {{countdown}} segundos.</div></div></script><script type="text/ng-template" id="timedout-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Sess&atilde;o encerrada.</h3></div><div class="modal-body"><p></p>Sua sess&atilde;o foi encerrada por inatividade.</div></div></script></div></nav></header><main role="main"><section class="login"><h1 class="hide">Painel de entrada</h1><div ng-controller="AcompanhamentoController as c" ng-init="c.init()"><div id="sideBar" class="col-sm-3 col-md-2 sidebar sidebar-offcanvas"><section><header></header><nav aria-labeledby="#nav"><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeEspelho()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor:pointer" ng-click="c.navegarEspelho()" ng-if="!c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Acompanhar inscri&ccedil;&atilde;o {{c.anoEdicao}}</a></li><li class="ng-scope"><a style="cursor:pointer" ng-click="c.downloadDeclaracao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Declara&ccedil;&atilde;o Comparecimento</a></li><li class="ng-scope"><a style="cursor:pointer" ng-click="c.navegarCartaoConfirmacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Local de Prova/Cart&atilde;o Confirma&ccedil;&atilde;o</a></li><li class="ng-scope"><a style="cursor:pointer" ng-click="c.navegarDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuDoencaInfectoContagiosaVisivel.menuDoencaInfectoContagiosaEnabled" class="ng-scope">Doenças Infectocontagiosas</a></li><li class="ng-scope"><a style="cursor:pointer" ng-click="c.navegarResultadoDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuResultadoDoencaInfectoContagiosaVisivel.menuResultadoDoencaInfectoContagiosaEnabled" class="ng-scope">Resultado de Doenças Infectocontagiosas</a></li><li class="ng-scope"><a style="cursor:pointer" ng-click="c.navegarReaplicacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeReaplicacao() || c.menu.exibeReaplicacaoResultado()" class="ng-scope">Solicita&ccedil;&atilde;o de Reaplica&ccedil;&atilde;o</a></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor:pointer" class="ng-scope">Alterar dados</a></li><li class="ng-scope"><a style="cursor:pointer;padding-left:30px" ng-click="c.navegarDadosPessoais()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeAlterarDadosInscricao()" class="ng-scope">Informa&ccedil;&otilde;es pessoais</a></li><li class="ng-scope"><a style="cursor:pointer;padding-left:30px" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope">Atendimento Especializado</a></li><li class="ng-scope"><a style="cursor:pointer;padding-left:40px" ng-click="c.navegarAtendimentosEspecializados()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope">Solicitar / Alterar Solicitação</a></li><li class="ng-scope"><a style="cursor:pointer;padding-left:30px" ng-click="c.navegarMunicipioProva()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuInformacoesProvaVisivel.inscricaoEmAndamento" class="ng-scope">Informa&ccedil;&otilde;es de prova</a></li><li class="ng-scope"><a style="cursor:pointer;padding-left:30px" ng-click="c.navegarJustificativaAusencia()" ng-if="c.validarExibicaoAcompanhamentoJustific()" class="ng-scope">Justificativa de aus&ecirc;ncia</a></li><li class="ng-scope"><a style="cursor:pointer;padding-left:30px" ng-click="c.navegarContato()" class="ng-scope">Contato</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; false" class="ng-scope"><a style="cursor:pointer;padding-left:30px" data-ui-sref="atualizarSenha" class="ng-scope">Senha</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuRecursoLaudoMedico" class="ng-scope"><a style="cursor:pointer;padding-left:30px" ng-click="c.navegarLaudoMedico()" class="ng-scope">Recurso Laudo M&eacute;dico</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuTratamentoNomeSocialVisivel.menuTratamentoNomeSocialEnabled" class="ng-scope"><a style="cursor:pointer;padding-left:30px" data-ui-sref="nomeSocial" class="ng-scope">Tratamento pelo Nome Social</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.recursoMenuTratamentoNomeSocialVisivel.recursoMenuTratamentoNomeSocialEnabled &amp;&amp; !!c.menuRecursoNomeSocial" class="ng-scope"><a style="cursor:pointer;padding-left:30px" data-ui-sref="reenvioNomeSocial" class="ng-scope">Recurso Nome Social</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menu.exibeBoletoCobranca()" class="ng-scope"><a style="cursor:pointer;padding-left:30px" data-ui-sref="boletoCobranca" class="ng-scope">Boleto de Cobrança</a></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultados()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor:pointer" class="ng-scope">Resultado</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2017()" class="ng-scope"><a style="cursor:pointer;padding-left:30px" data-ui-sref="resultado2017" class="ng-scope">ENCCEJA 2017</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2018()" class="ng-scope"><a style="cursor:pointer;padding-left:30px" data-ui-sref="resultado2018" class="ng-scope">ENCCEJA 2018</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2019()" class="ng-scope"><a style="cursor:pointer;padding-left:30px" data-ui-sref="resultado2019" class="ng-scope">ENCCEJA 2019</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2020()" class="ng-scope"><a style="cursor:pointer;padding-left:30px" data-ui-sref="resultado2020" class="ng-scope">ENCCEJA 2020</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2022()" class="ng-scope"><a style="cursor:pointer;padding-left:30px" data-ui-sref="resultado2022" class="ng-scope">ENCCEJA 2022</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2023()" class="ng-scope"><a style="cursor:pointer;padding-left:30px" data-ui-sref="resultado2023" class="ng-scope">ENCCEJA 2023</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2024()" class="ng-scope"><a style="cursor:pointer;padding-left:30px" data-ui-sref="resultado2024" class="ng-scope">ENCCEJA 2024</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2025()" class="ng-scope"><a style="cursor:pointer;padding-left:30px" data-ui-sref="resultado2025" class="ng-scope">ENCCEJA 2025</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2026()" class="ng-scope"><a style="cursor:pointer;padding-left:30px" data-ui-sref="resultado2026" class="ng-scope">ENCCEJA 2026</a></li></ul><ul inep-sidebar="inep-sidebar" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor:pointer" ng-click="c.sair()" class="ng-scope">Sair</a></li></ul></nav></section></div><div class="col-sm-9 col-sm-offset-3 col-md-10 col-md-offset-2"><div class="panel-box ng-scope"><div><div ng-controller="InformacoesProvaController as c" ng-init="c.init()"><header><div class="page-header with-space-top"><h1 ng-if="c.pagina === 1" class="h3">Inscri&ccedil;&atilde;o > ENCCEJA <small>informa&ccedil;&otilde;es de prova</small></h1><h1 ng-if="c.pagina === 2" class="h3">Inscri&ccedil;&atilde;o > ENCCEJA <small>confirmação de dados</small></h1></div></header><div class="row"><div class="col-md-12"><form name="informacoesProvaForm" role="form" novalidate="true" autocomplete="off" inep-message-bag="inep-message-bag" message-bag-header-error="O formulário abaixo está inválido pelos seguintes erros:"><div ng-if="c.pagina === 1"><div tabindex="0"><div class="text-center text-primary"><label>Os campos com <i alt="asterisco" class="fa fa-asterisk"><span class="hidden-accessibility">asterisco</span></i> são de preenchimento obrigatório</label></div><div class="row with-space-bottom"></div></div><div class="panel panel-info"><div tabindex="0" class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Prova</h2></div><div class="panel-body"><div class="row with-space"><div class="col-md-12"><inep-radiobutton np-id="radioNivel" np-label="Para qual nível de ensino você busca certificação ou declaração parcial de proficiência?" np-values="c.opcoesConclusaoCurso" np-selected-value="c.informacoesProva.opcaoConclusao" np-inline="true" np-on-change="c.escolherNivelProvaChanged()" np-optional="false"></inep-radiobutton></div></div><div ng-if="c.habilitarDisciplinasEnsinoFundamental()" class="row"><enem-checkbox np-id="checkEnsinoFundamental" np-promise="c.ensinoFundamental" np-optional="false" np-lines="6" np-callback="c.ensinoFundamentalCallback" np-reiniciar-elements="false" np-size="8" np-label="Ensino Fundamental - Marque as provas que precisa fazer para conseguir a certificação do Ensino Fundamental"></enem-checkbox></div><div ng-if="c.habilitarDisciplinasEnsinoMedio()" class="row"><enem-checkbox np-id="checkEnsinoMedio" np-promise="c.ensinoMedio" np-values="c.iInnformacoesProva.opcaoDisciplinas" np-optional="false" np-lines="6" np-callback="c.ensinoMedioCallback" np-reiniciar-elements="false" np-size="6" np-label="Ensino Médio - Marque as provas que precisa fazer para conseguir a certificação do Ensino Médio"></enem-checkbox></div><div ng-if="c.habilitarDisciplinasEnsinoFundamental() || c.habilitarDisciplinasEnsinoMedio()" class="box-describe"><span class="text-justify">{{c.mensagens.MSGA074}}</span></div></div></div><div class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Cidade de prova</h2></div><div class="panel-body"><div class="row with-space"><div class="col-md-12"><div><label>Em qual estado e em qual município você prefere fazer as provas do Encceja?</label><i style="color:#9A0000" class="fa fa-asterisk fa"><span style="position:absolute;top:-20em;left:-300em">Campo de preenchimento obrigat&oacute;rio.</span></i></div></div></div><div class="row with-space-top"><div class="col-md-12"><inep-combobox np-id="ufCidadeProva" np-label="Selecione a UF:" np-optional="false" np-no-select-label="Selecione" np-size="3" np-values="c.ufs" np-selected-value="c.informacoesProva.codigoUf" np-on-change="c.carregarMunicipios()" np-accessibility-message="{{c.mensagens.MSGA042}}"></inep-combobox><inep-combobox np-id="municipioCidadeProva" np-label="Selecione o Município:" np-optional="false" np-no-select-label="Selecione" np-size="4" np-values="c.listaMunicipio" np-selected-value="c.informacoesProva.codigoMunicipio" np-disabled="!c.informacoesProva.codigoUf" np-order-by="label" np-on-change="c.reiniciaDeclaro()" np-accessibility-message="{{c.mensagens.MSGA043}}"></inep-combobox></div></div></div></div><div class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Instituição certificadora</h2></div><div class="panel-body"><div class="row with-space"><div class="col-md-12"><div><label>O Inep não emite o Certificado de conclusão ou Declaração Parcial de Proficiência. Essa tarefa é da Instituição Certificadora:  Secretarias                              Estaduais de Educação e Institutos Federais de Educação. Você precisa escolher em qual Instituição Certificadora será mais fácil solicitar o Certificado                       ou a Declaração após a liberação dos resultados.</label></div></div></div></div><div class="panel-body"><div class="row with-space"><div class="col-md-12"><div><label>Em qual Instituição Certificadora você prefere solicitar seu certificado ou declaração parcial de proficiência?</label></div></div></div><div class="row with-space-top"><div class="col-md-12"><inep-combobox np-id="ufCidadeProva" np-label="Selecione a UF:" np-optional="false" np-no-select-label="Selecione" np-size="3" np-values="c.ufs" np-selected-value="c.informacoesProva.codigoUfCertificadora" np-on-change="c.carregarEntidadesCertificadoras()"></inep-combobox><inep-combobox np-id="entidadeCertificadora" np-label="Selecione a Instituição certificadora:" np-optional="false" np-no-select-label="Selecione" np-size="8" np-values="c.secretariasCertificadoras" np-selected-value="c.informacoesProva.codigoSecretariaCertificadora" np-order-by="id" np-on-change="c.setarUfEndidadeCertificadora()"></inep-combobox></div></div></div></div></div><div ng-if="c.pagina === 2"><div class="row"><div class="col-md-4"></div><enem-fieldset><div tabindex="0" focus-me="focus-me" class="msg-inscricao-aviso">Verifique se as informa&ccedil;&otilde;es abaixo est&atilde;o corretas  e continue sua inscri&ccedil;&atilde;o</div></enem-fieldset></div><div class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Prova</h2></div><div class="panel-body"><div><b><div class="row with-space"><b class="col-md-6"></b></div>Nível de ensino escolhido para o qual quero a certificação:<inep-output-selection np-id="c.informacoesProva.opcaConclusao" ng-model="c.informacoesProva.opcaoConclusao" np-values="c.opcoesConclusaoCurso" np-empty-value="NÃO INFORMADO"></inep-output-selection><div class="row with-space"><b class="col-md-4">Provas que farei no Encceja 2026:</b></div><ul ng-show="c.habilitarDisciplinasEnsinoFundamental()"><li ng-if="a.statusItem === c.constantes.MARCADO" ng-repeat="a in c.ensinoFundamental"><label style="font-weight:400">{{ a.descricao }}</label></li></ul><ul ng-show="c.habilitarDisciplinasEnsinoMedio()"><li ng-if="a.statusItem === c.constantes.MARCADO" ng-repeat="a in c.ensinoMedio"><label style="font-weight:400">{{ a.descricao }}</label></li></ul></b></div></div></div><div class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Cidade de prova</h2></div><div class="panel-body"><div><div class="row with-space"><b class="col-md-4">UF e cidade onde farei as provas: &nbsp;<inep-output-selection np-id="c.informacoesProva.codigoUf.label" ng-model="c.informacoesProva.codigoUf" np-values="c.ufs" np-empty-value="NÃO INFORMADO"></inep-output-selection>,<inep-output-selection np-id="c.informacoesProva.codigoMunicipio.label" ng-model="c.informacoesProva.codigoMunicipio" np-values="c.listaMunicipio" np-empty-value="NÃO INFORMADO"></inep-output-selection></b></div></div></div></div><div class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Instituição certificadora</h2></div><div class="panel-body"><div><div class="row with-space"><b class="col-md-10">Instituição Certificadora onde poderei solicitar o certificado de conclusão ou a declaração parcial de proficiência se conseguir a nota mínima exigida:</b></div><inep-output-selection np-id="c.informacoesProva.codigoSecretariaCertificadora.id" ng-model="c.informacoesProva.codigoSecretariaCertificadora" np-values="c.secretariasCertificadoras" np-empty-value="NÃO INFORMADO"></inep-output-selection><div class="row with-space"><b class="col-md-4">UF da Instituição certificadora: &nbsp;<inep-output-selection np-id="c.informacoesProva.codigoSecretariaCertificadora.id" ng-model="c.informacoesProva.codigoSecretariaCertificadora" np-values="c.secretariasCertificadoras" np-item-label="uf" np-empty-value="NÃO INFORMADO"></inep-output-selection></b></div></div><div class="row with-space"><div class="col-md-12"><enem-fieldset np-tab="0"><span class="attention-label">Aten&ccedil;&atilde;o:&nbsp;</span><span class="text-justify"> Na Página do Participante, durante o período de inscrição, você poderá alterar o nível de ensino ao qual busca certificação ou proficiência parcial e as provas que pretende fazer.</span></enem-fieldset></div></div><div class="row"><div class="col-md-12"><inep-boolean-checkbox np-id="booleanCheck" np-value="c.textDeclaracao" np-selected-value="c.informacoesProva.declaro" np-required-message="{{c.mensagens.MSGOD05}}" np-optional="false"></inep-boolean-checkbox></div></div></div></div></div></form></div></div><div inep-modal="inep-modal" np-id="modalWizard" np-buttons="c.modalInscricoesEncerradas.buttons" np-options="c.modalOptions" np-show="c.modalInscricoesEncerradas.show"><h2 aria-labelledby="texto" tabindex="0" class="titulo-modal h5 panel-title text-center text-primary">{{ c.modalInscricoesEncerradas.message }}</h2></div></div></div><div class="clearfix"><ul class="pagination margin-bottom-none pull-right"><li ng-if="c.paginaMunicipioProva === 2" class="primary"><button data-ng-href="#/" ng-click="c.voltarMunicipioProva()" role="button" class="btn btn-primary">Voltar</button></li><li class="primary"><button data-ng-href="#/" ng-click="c.salvarMunicipioProva()" role="button" class="btn btn-primary">{{c.paginaMunicipioProva === 2 ? \'Salvar\' : \'Pr\\u00F3ximo\'}}</button></li></ul></div></div><div inep-modal="inep-modal" np-buttons="c.buttons" np-show="c.modalShow" np-id="modal" np-options="c.modalOptions" np-header="Aviso"><p tabindex="0">{{ c.modalMessage }}</p></div><div inep-modal="inep-modal" np-id="modalCarencia" np-buttons="c.modalCarencia.buttons" np-show="c.modalCarencia.show" np-options="c.modalCarencia.options" np-header="Aviso"><p tabindex="0">{{ c.modalCarencia.message }}</p></div><div inep-modal="inep-modal" np-id="modalExibirMensagem" np-buttons="c.modalExibirMensagem.buttons" np-show="c.modalExibirMensagem.show" np-options="c.modalExibirMensagem.options" np-header="Avaliar serviço"><p tabindex="0">{{ c.modalExibirMensagem.saudacao }}</p><p tabindex="0">{{ c.modalExibirMensagem.message }}</p></div><div inep-modal="inep-modal" np-buttons="c.modalSair.buttons" np-show="c.modalSair.show" np-id="modalSair" np-options="c.modalSair.options" np-header="Aviso"><p tabindex="0">{{ c.modalSair.saudacao }}</p><p tabindex="0">{{ c.modalSair.message }}</p></div></div></div></section></main>'),
a.put("views/acompanhamento/atualizarSenha.html",'<header role="banner"><h1 class="hide"> - </h1><nav role="navigation" aria-labelledby="#nav" ng-controller="NavigationBarController" class="navbar navbar-default navbar-fixed-top"><h2 id="nav" class="hide">Navegação Principal</h2><div class="container-fluid"><div class="navbar-header text-center"><button type="button" data-toggle="offcanvas" class="navbar-toggle collapsed left"><span class="sr-only">Toggle navigation</span><span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span></button><div aria-label="Bem vindo ao INEP" class="navbar-brand"><img src="images/logo_inep.svg" alt="Instituto Nacional de Estudos e Pesquisas Educacionais Anísio Teixeira"></div><button type="button" data-toggle="collapse" data-target="#navbar-collapse" class="navbar-toggle collapsed right p-n"><span class="sr-only">Toggle navigation</span><i class="fa fa-gear text-white"></i></button></div><script type="text/ng-template" id="warning-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Você ainda está aí?</h3></div><div idle-countdown="countdown" class="modal-body"><uib-progressbar max="30" value="countdown" animate="true" class="progress-striped active"></uib-progressbar>Sua sessão será encerrada em {{countdown}} segundos.</div></div></script><script type="text/ng-template" id="timedout-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Sess&atilde;o encerrada.</h3></div><div class="modal-body"><p></p>Sua sess&atilde;o foi encerrada por inatividade.</div></div></script></div></nav></header><main role="main"><section class="login"><h1 class="hide">Painel de entrada</h1><div ng-controller="AcompanhamentoController as c" ng-init="c.init()"><div id="sideBar" class="col-sm-3 col-md-2 sidebar sidebar-offcanvas"><section><header></header><nav aria-labeledby="#nav"><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeEspelho()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor:pointer" ng-click="c.navegarEspelho()" ng-if="!c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Acompanhar inscri&ccedil;&atilde;o {{c.anoEdicao}}</a></li><li class="ng-scope"><a style="cursor:pointer" ng-click="c.downloadDeclaracao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Declara&ccedil;&atilde;o Comparecimento</a></li><li class="ng-scope"><a style="cursor:pointer" ng-click="c.navegarCartaoConfirmacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Local de Prova/Cart&atilde;o Confirma&ccedil;&atilde;o</a></li><li class="ng-scope"><a style="cursor:pointer" ng-click="c.navegarDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuDoencaInfectoContagiosaVisivel.menuDoencaInfectoContagiosaEnabled" class="ng-scope">Doenças Infectocontagiosas</a></li><li class="ng-scope"><a style="cursor:pointer" ng-click="c.navegarResultadoDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuResultadoDoencaInfectoContagiosaVisivel.menuResultadoDoencaInfectoContagiosaEnabled" class="ng-scope">Resultado de Doenças Infectocontagiosas</a></li><li class="ng-scope"><a style="cursor:pointer" ng-click="c.navegarReaplicacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeReaplicacao() || c.menu.exibeReaplicacaoResultado()" class="ng-scope">Solicita&ccedil;&atilde;o de Reaplica&ccedil;&atilde;o</a></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor:pointer" class="ng-scope">Alterar dados</a></li><li class="ng-scope"><a style="cursor:pointer;padding-left:30px" ng-click="c.navegarDadosPessoais()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeAlterarDadosInscricao()" class="ng-scope">Informa&ccedil;&otilde;es pessoais</a></li><li class="ng-scope"><a style="cursor:pointer;padding-left:30px" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope">Atendimento Especializado</a></li><li class="ng-scope"><a style="cursor:pointer;padding-left:40px" ng-click="c.navegarAtendimentosEspecializados()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope">Solicitar / Alterar Solicitação</a></li><li class="ng-scope"><a style="cursor:pointer;padding-left:30px" ng-click="c.navegarMunicipioProva()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuInformacoesProvaVisivel.inscricaoEmAndamento" class="ng-scope">Informa&ccedil;&otilde;es de prova</a></li><li class="ng-scope"><a style="cursor:pointer;padding-left:30px" ng-click="c.navegarJustificativaAusencia()" ng-if="c.validarExibicaoAcompanhamentoJustific()" class="ng-scope">Justificativa de aus&ecirc;ncia</a></li><li class="ng-scope"><a style="cursor:pointer;padding-left:30px" ng-click="c.navegarContato()" class="ng-scope">Contato</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; false" class="ng-scope"><a style="cursor:pointer;padding-left:30px" data-ui-sref="atualizarSenha" class="ng-scope">Senha</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuRecursoLaudoMedico" class="ng-scope"><a style="cursor:pointer;padding-left:30px" ng-click="c.navegarLaudoMedico()" class="ng-scope">Recurso Laudo M&eacute;dico</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuTratamentoNomeSocialVisivel.menuTratamentoNomeSocialEnabled" class="ng-scope"><a style="cursor:pointer;padding-left:30px" data-ui-sref="nomeSocial" class="ng-scope">Tratamento pelo Nome Social</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.recursoMenuTratamentoNomeSocialVisivel.recursoMenuTratamentoNomeSocialEnabled &amp;&amp; !!c.menuRecursoNomeSocial" class="ng-scope"><a style="cursor:pointer;padding-left:30px" data-ui-sref="reenvioNomeSocial" class="ng-scope">Recurso Nome Social</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menu.exibeBoletoCobranca()" class="ng-scope"><a style="cursor:pointer;padding-left:30px" data-ui-sref="boletoCobranca" class="ng-scope">Boleto de Cobrança</a></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultados()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor:pointer" class="ng-scope">Resultado</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2017()" class="ng-scope"><a style="cursor:pointer;padding-left:30px" data-ui-sref="resultado2017" class="ng-scope">ENCCEJA 2017</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2018()" class="ng-scope"><a style="cursor:pointer;padding-left:30px" data-ui-sref="resultado2018" class="ng-scope">ENCCEJA 2018</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2019()" class="ng-scope"><a style="cursor:pointer;padding-left:30px" data-ui-sref="resultado2019" class="ng-scope">ENCCEJA 2019</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2020()" class="ng-scope"><a style="cursor:pointer;padding-left:30px" data-ui-sref="resultado2020" class="ng-scope">ENCCEJA 2020</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2022()" class="ng-scope"><a style="cursor:pointer;padding-left:30px" data-ui-sref="resultado2022" class="ng-scope">ENCCEJA 2022</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2023()" class="ng-scope"><a style="cursor:pointer;padding-left:30px" data-ui-sref="resultado2023" class="ng-scope">ENCCEJA 2023</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2024()" class="ng-scope"><a style="cursor:pointer;padding-left:30px" data-ui-sref="resultado2024" class="ng-scope">ENCCEJA 2024</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2025()" class="ng-scope"><a style="cursor:pointer;padding-left:30px" data-ui-sref="resultado2025" class="ng-scope">ENCCEJA 2025</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2026()" class="ng-scope"><a style="cursor:pointer;padding-left:30px" data-ui-sref="resultado2026" class="ng-scope">ENCCEJA 2026</a></li></ul><ul inep-sidebar="inep-sidebar" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor:pointer" ng-click="c.sair()" class="ng-scope">Sair</a></li></ul></nav></section></div><div class="col-sm-9 col-sm-offset-3 col-md-10 col-md-offset-2"><div class="panel-box ng-scope"><div><div ng-controller="InformarSenhaController as c"><header><div class="page-header with-space-top"><h1 class="h3">Inscri&ccedil;&atilde;o > ENCCEJA <small>informar senha</small></h1></div></header><div class="row"><div class="col-md-12"><form autocomplete="off" inep-message-bag="inep-message-bag" message-bag-header-error="O formulário abaixo está inválido pelos seguintes erros:" name="informarSenhaForm" novalidate="true" role="form"><div tabindex="0"><div class="text-center text-primary"><label>Os campos com <i alt="asterisco" class="fa fa-asterisk"><span class="hidden-accessibility">asterisco</span></i> são de preenchimento obrigatório</label></div><div class="row with-space-bottom"></div></div><div class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Senha</h2></div><div class="panel-body"><div class="row"><div class="col-md-12"><p tabindex="0"><span class="attention-label">Aten&ccedil;&atilde;o:</span> Esta senha ser&aacute; utilizada para o acompanhamento de sua inscri&ccedil;&atilde;o e obten&ccedil;&atilde;o de seus resultados.\n A senha somente poder&aacute; ser recuperada via e-mail ou SMS.</p></div></div><div class="row"><br></div><div class="row"><inep-password np-value="c.informarSenha.senha" np-id="inputSenha" np-label="Senha:" np-optional="false" np-size="4" np-minlength="6" np-maxlength="10" np-pattern="\'[0-9a-zA-Z]{1,10}\'" np-pattern-message="A senha informada é inválida. Siga a regra de criação de senha apresentada abaixo do campo." np-accessibility-message="{{c.mensagens.MSGA022}}"></inep-password></div><div class="row"><div class="col-md-12">M&iacute;nimo de 6 e m&aacute;ximo de 10 caracteres, podendo conter apenas\n n&uacute;meros e letras, com distin&ccedil;&atilde;o de mai&uacute;sculas e\n min&uacute;sculas.</div></div><div class="row"><br></div><div class="row"><inep-password np-value="c.informarSenha.confirmaSenha" np-id="inputConfirmarSenha" np-label="Confirmar senha:" np-optional="false" np-size="4" np-confirm-value="c.informarSenha.senha" np-maxlength="10" np-pattern="\'[0-9a-zA-Z]{1,10}\'" np-pattern-message="A senha informada é inválida. Siga a regra de criação de senha apresentada abaixo do campo." np-confirm-password="true" np-confirm-message="Os dados devem coincidir com os inseridos no campo senha." np-accessibility-message="{{c.mensagens.MSGA023}}"></inep-password></div></div></div></form></div></div></div></div><div class="clearfix"><ul class="pagination margin-bottom-none pull-right"><li class="primary"><button data-ng-href="#/" ng-click="c.salvarSenha()" role="button" class="btn btn-primary">Salvar</button></li></ul></div></div><div inep-modal="inep-modal" np-buttons="c.buttons" np-show="c.modalShow" np-id="modal" np-options="c.modalOptions" np-header="Aviso"><p tabindex="0">{{ c.modalMessage }}</p></div><div inep-modal="inep-modal" np-id="modalCarencia" np-buttons="c.modalCarencia.buttons" np-show="c.modalCarencia.show" np-options="c.modalCarencia.options" np-header="Aviso"><p tabindex="0">{{ c.modalCarencia.message }}</p></div><div inep-modal="inep-modal" np-id="modalExibirMensagem" np-buttons="c.modalExibirMensagem.buttons" np-show="c.modalExibirMensagem.show" np-options="c.modalExibirMensagem.options" np-header="Avaliar serviço"><p tabindex="0">{{ c.modalExibirMensagem.saudacao }}</p><p tabindex="0">{{ c.modalExibirMensagem.message }}</p></div><div inep-modal="inep-modal" np-buttons="c.modalSair.buttons" np-show="c.modalSair.show" np-id="modalSair" np-options="c.modalSair.options" np-header="Aviso"><p tabindex="0">{{ c.modalSair.saudacao }}</p><p tabindex="0">{{ c.modalSair.message }}</p></div></div></div></section></main>'),a.put("views/acompanhamento/autenticidade.html",'<header role="banner"><h1 class="hide"> - </h1><nav role="navigation" aria-labelledby="#nav" ng-controller="NavigationBarController" class="navbar navbar-default navbar-fixed-top"><h2 id="nav" class="hide">Navegação Principal</h2><div class="container-fluid"><div class="navbar-header text-center"><button type="button" data-toggle="offcanvas" class="navbar-toggle collapsed left"><span class="sr-only">Toggle navigation</span><span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span></button><div aria-label="Bem vindo ao INEP" class="navbar-brand"><img src="images/logo_inep.svg" alt="Instituto Nacional de Estudos e Pesquisas Educacionais Anísio Teixeira"></div><button type="button" data-toggle="collapse" data-target="#navbar-collapse" class="navbar-toggle collapsed right p-n"><span class="sr-only">Toggle navigation</span><i class="fa fa-gear text-white"></i></button></div><script type="text/ng-template" id="warning-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Você ainda está aí?</h3></div><div idle-countdown="countdown" class="modal-body"><uib-progressbar max="30" value="countdown" animate="true" class="progress-striped active"></uib-progressbar>Sua sessão será encerrada em {{countdown}} segundos.</div></div></script><script type="text/ng-template" id="timedout-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Sess&atilde;o encerrada.</h3></div><div class="modal-body"><p></p>Sua sess&atilde;o foi encerrada por inatividade.</div></div></script></div></nav></header><main role="main"><section class="login"><h1 class="hide">Painel de entrada</h1><style>body{font-family:Arial;font-size:12px}.rosaFundo{background:#EC008B;color:#FFF;padding:5px 0}.rosaFundoCor{background:#EC008B;color:#FFF}.rosaBebeFundo{background:#FBBFE5}.rosaFonte{color:#DF0786}.rosaBorder{border:1px solid #DF0786}.fundoPreto{background:#000;color:#FFF}.padding{padding:1px 15px}.centro{text-align:center}.umTerco{width:33%}.header{width:50%}.tabela{width:100%;border-collapse:collapse;margin:2px 0}.marginZero{margin:0}.td75{width:75%}.bordaTabela{border-top:2px solid #000}.marginMenos{margin-top:-1px}.blocoTitulo{display:block;font-size:11px}.bordaBottom{border-bottom:1px solid #000}.h1{text-decoration:underline;font-size:12px}.h2{font-size:14px}.negrito{font-weight:700}.normal{font-weight:400;text-align:left}.bordaBrancaLeftTop{border-left:2px solid #fff;border-top:2px solid #DF0786}.marginMaior{margin:4px 0}.paddingTableRecuo{padding:2px 0 2px 20px}.justificado{text-align:justify}.direita{text-align:right}.esquerda{text-align:left}.centro{text-align:center}.paddingTd{vertical-align:text-top;font-size:10px}.width20{width:20%}.tabelaTopo{width:72%;margin-left:12%}.headerTabela{color:#FFF;background:#2DA27F;font-weight:700;text-align:center}.headerTabelaLeft{color:#FFF;background:#2DA27F;font-weight:700;text-align:left}.headerTabelaCenter{color:#FFF;background:#2DA27F;font-weight:700;text-align:center}@media print{.yesprint{visibility:visible!important;display:block}.notprint{display:none}}#tbNotas tr:nth-child(odd){background:#CCC}#tbJust tr:nth-child(odd){background:#CCC}body.contrast .headerTabela,body.contrast .headerTabelaLeft,body.contrast .rosaFundo{background-color:grey}body.contrast #tbNotas tr:nth-child(odd){color:#000}.atencao{text-align:justify;padding-top:30px;font-family:Arial,Helvetica,sans-serif;font-size:11px}.fundoPadraoSistema{color:#FFF;padding:0 30px 0 30px;font-weight:700;background-color:#2C3E50;border-botton:2px solid #2C3E50}</style><div ng-controller="AutenticidadeController as c"><div class="panel"><div class="panel-body"><div class="row"><div class="col-md-12"><table style="border-collapse:collapse;margin:2px 0;width:100%;margin:4px 0"><tr style="border-collapse:collapse;margin:2px 0;width:100%;margin:4px 0"><td style="width:25%">&nbsp;</td><td style="width:50%;text-align:center"><div style="background-color:#2C3E50;color:#FFF;padding:5px 0"><span style="white-space:nowrap;text-decoration:underline">EXAME NACIONAL PARA CERTIFICA&Ccedil;&Atilde;O DE COMPET&Ecirc;NCIAS DE JOVENS E ADULTOS - ENCCEJA 20{{c.ano}}</span><br><span style="white-space:nowrap;font-size:14px"><strong>RESULTADOS 20{{c.ano}}</strong></span></div></td><td style="width:25%"><figure><img ng-src="images/Logo-Encceja20{{c.ano}}.png" style="width:110px;float:right"></figure></td></tr></table><br></div></div></div></div><div ng-if="!!c.messageError" class="row"><div class="col-md-12 text-center"><div role="alert" class="alert alert-danger yesprint"><span tabindex="0">{{c.messageError}}</span></div></div></div><div ng-if="!!c.dadosResultado.provaObjetiva &amp;&amp; !c.dadosResultado.eliminado" class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Dados de identifica&ccedil;ão do participante</h2></div><div class="panel-body"><div ng-if="!c.dadosResultado.nomeSocial" class="row"><div class="col-md-12"><b class="impressaoFonte7">Nome:</b><label class="impressaoFonte7">{{c.dadosResultado.nome}}</label></div></div><div ng-if="!!c.dadosResultado.nomeSocial" class="row"><div class="col-md-12"><b class="impressaoFonte7">Nome:</b><label class="impressaoFonte7">{{c.dadosResultado.nomeSocial}}</label></div></div><div class="row"><div class="col-md-12"><b class="impressaoFonte7">Número de Inscri&ccedil;ão:</b><label class="impressaoFonte7">{{c.dadosResultado.inscricao}}</label></div></div><div class="row"><div class="col-md-12"><b class="impressaoFonte7">CPF:</b><inep-output-text np-id="cpfFormatado" ng-model="c.dadosResultado.cpf" np-mask="999.999.999-99" class="impressaoFonte7"></inep-output-text></div></div><div class="row"><div class="col-md-12"><b class="impressaoFonte7">Data de Nascimento:</b><label class="impressaoFonte7">{{c.dadosResultado.dataNascimento}}</label></div></div><div class="row"><div class="col-md-12"><b class="impressaoFonte7">Etapa de Ensino:</b><label class="impressaoFonte7">{{c.dadosResultado.etapaEnsino}}</label></div></div><div class="row"><div class="col-md-12"><b class="impressaoFonte7">Institui&ccedil;ão certificadora:</b><label class="impressaoFonte7">{{c.dadosResultado.certificadora.nome}}</label></div></div></div></div><div ng-if="!!c.dadosResultado.eliminado"><span class="fundoPreto padding negrito">Eliminado</span><table class="with-space-bottom tabela bordaTabela marginMenos bordaBottom"><tr><td style="padding:0 30px 0 30px" class="headerTabela"><span style="white-space:nowrape" class="impressaoFonte7">Motivo Elimina&ccedil;ão Exame</span></td></tr><tr ng-repeat="item in c.justificativasEliminacao track by $index"><td style="padding:0 30px 0 30px" class="centro"><span style="color:#000" class="impressaoFonte7">{{item.descricaoMotivo}}</span></td></tr></table></div><div ng-if="c.dadosResultado.provaObjetiva.length &gt; 0 &amp;&amp; !c.dadosResultado.eliminado"><br><span class="fundoPreto padding negrito">Prova Objetiva</span><table id="tbNotasObjetivas" class="with-space-bottom tabela bordaTabela marginMenos bordaBottom"><tr><td class="fundoPadraoSistema"><span style="white-space:nowrap" class="impressaoFonte7">&Aacute;rea de conhecimento</span></td><td class="fundoPadraoSistema"><span style="white-space:nowrap" class="impressaoFonte7">Situa&ccedil;&atilde;o</span></td><td class="fundoPadraoSistema"><span style="white-space:nowrap" class="impressaoFonte7">Nota</span></td></tr><tr ng-repeat="item in c.dadosResultado.provaObjetiva"><td style="padding:0 30px 0 30px"><span style="white-space:nowrap" class="impressaoFonte7">{{item.areaDeConhecimento}}</span></td><td style="padding:0 30px 0 30px;width:20%" class="centro"><span class="impressaoFonte7">{{ item.situacao }}</span></td><td style="padding:0 30px 0 30px;width:20%" class="centro"><span class="impressaoFonte7">{{ item.situacao === \'Presente\' ? item.nota : \'-\' }}</span></td></tr></table></div><div ng-if="!!c.dadosResultado.provaRedacao &amp;&amp; !c.dadosResultado.eliminado"><br><span ng-if="c.dadosResultado.provaRedacao" class="fundoPreto padding negrito">     \nReda&ccedil;&atilde;o</span><table id="tbNotasRedacao" class="with-space-bottom tabela bordaTabela marginMenos bordaBottom"><tr><td class="fundoPadraoSistema"><span style="white-space:nowrap" class="impressaoFonte7">&Aacute;rea de conhecimento</span></td><td class="fundoPadraoSistema"><span style="white-space:nowrap" class="impressaoFonte7">Situa&ccedil;&atilde;o</span></td><td class="fundoPadraoSistema"><span style="white-space:nowrap" class="impressaoFonte7">Nota</span></td></tr><tr><td style="padding:0 30px 0 30px"><span style="white-space:nowrap" class="impressaoFonte7">{{c.dadosResultado.provaRedacao.areaDeConhecimento}}</span></td><td style="padding:0 30px 0 30px;width:20%" class="centro"><span class="impressaoFonte7">{{ c.dadosResultado.provaRedacao.situacao }}</span></td><td style="padding:0 30px 0 30px;width:20%" class="centro"><span class="impressaoFonte7">{{ c.dadosResultado.provaRedacao.situacao === \'Presente\' ? c.dadosResultado.provaRedacao.nota : \'-\' }}</span></td></tr></table></div><div ng-if="!!c.showMotivos"><table id="tbJust" class="with-space-bottom tabela bordaTabela marginMenos bordaBottom"><tr><td style="padding:0 30px 0 30px" class="headerTabelaCenter"><span style="white-space:nowrap" class="impressaoFonte7">Motivo</span></td></tr><tr ng-repeat="item in c.justificativas track by $index"><td style="padding:0 30px 0 30px" class="centro"><span class="impressaoFonte7">{{item.motivo}}</span></td></tr></table></div><div ng-if="!c.dadosResultado.eliminado" class="atencao"><p class="left"><strong>Importante:</strong>&nbsp;Para solicitar certificado em nível de conclus&atilde;o do {{c.dadosResultado.etapaEnsino}}. Você deverá atingir o mínimo de 100 (cem) pontos em cada uma das provas objetivas e o mínimo de 5 (cinco) pontos na Reda&ccedil;ão.<strong>&nbsp;Quando se alcan&ccedil;a a pontua&ccedil;&atilde;o mínima de 100 pontos na prova de Linguagens, mas n&atilde;o o mínimo de 5 pontos na Reda&ccedil;&atilde;o, ou vice-versa.</strong>&nbsp;Nesse caso, n&atilde;o há certifica&ccedil;&atilde;o e será necessário refazer a prova de Linguagens e a Reda&ccedil;&atilde;o.</p><div class="clearfix"><ul class="pagination margin-bottom-none pull-right"><li class="primary"><button ng-click="c.sair()" role="button" class="btn btn-primary">Sair</button></li></ul><ul class="pagination margin-bottom-none pull-right"><li class="primary"><button ng-click="c.imprimir()" role="button" class="btn btn-primary">Imprimir</button></li></ul></div></div></div></section></main>'),a.put("views/acompanhamento/bemvindo.html",'<header role="banner"><h1 class="hide"> - </h1><nav role="navigation" aria-labelledby="#nav" ng-controller="NavigationBarController" class="navbar navbar-default navbar-fixed-top"><h2 id="nav" class="hide">Navegação Principal</h2><div class="container-fluid"><div class="navbar-header text-center"><button type="button" data-toggle="offcanvas" class="navbar-toggle collapsed left"><span class="sr-only">Toggle navigation</span><span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span></button><div aria-label="Bem vindo ao INEP" class="navbar-brand"><img src="images/logo_inep.svg" alt="Instituto Nacional de Estudos e Pesquisas Educacionais Anísio Teixeira"/></div><button type="button" data-toggle="collapse" data-target="#navbar-collapse" class="navbar-toggle collapsed right p-n"><span class="sr-only">Toggle navigation</span><i class="fa fa-gear text-white"></i></button></div><!--#navbar-collapse.collapse.navbar-collapse--><!--  ul.nav.navbar-nav--><!--    li.active--><!--      span.logo-inep.h3.m-n.font-700(data-toggle=\'tooltip\', data-placement=\'bottom\', title=project.name) #{project.abbr}--><!----><!--  ul.nav.navbar-nav.navbar-right--><!--    if !login--><!--      li--><!--        span(data-toggle=\'dropdown\') #[i.fa.fa-user] Participante: {{nomeParticipanteLogado}}--><!--    li--><!--      a.contrast(href=\'#\', inep-contrast="", data-toggle=\'tooltip\', data-placement=\'bottom\', aria-label=\'Contraste\') #[i.fa.fa-adjust]--><script type="text/ng-template" id="warning-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Você ainda está aí?</h3></div><div idle-countdown="countdown" class="modal-body"><uib-progressbar max="30" value="countdown" animate="true" class="progress-striped active"></uib-progressbar>Sua sessão será encerrada em {{countdown}} segundos.</div></div></script><script type="text/ng-template" id="timedout-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Sess&atilde;o encerrada.</h3></div><div class="modal-body"><p></p>Sua sess&atilde;o foi encerrada por inatividade.</div></div></script></div></nav></header><main role="main"><section class="login"><h1 class="hide">Painel de entrada</h1><div ng-controller="AcompanhamentoController as c" ng-init="c.init()"><div id="sideBar" class="col-sm-3 col-md-2 sidebar sidebar-offcanvas"><section><header></header><nav aria-labeledby="#nav"><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeEspelho()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" ng-click="c.navegarEspelho()" ng-if="!c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Acompanhar inscri&ccedil;&atilde;o {{c.anoEdicao}}</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.downloadDeclaracao()", ng-if="!c.isLoginLocalProva && c.menu.exibeDeclaracaoComparecimento()") Declara&ccedil;&atilde;o Comparecimento--><a style="cursor: pointer" ng-click="c.downloadDeclaracao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Declara&ccedil;&atilde;o Comparecimento</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarCartaoConfirmacao()", ng-if="!c.isLoginLocalProva && !c.menu.exibeCartaoConfirmacao()") Local de Prova/Cart&atilde;o Confirma&ccedil;&atilde;o--><a style="cursor: pointer" ng-click="c.navegarCartaoConfirmacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Local de Prova/Cart&atilde;o Confirma&ccedil;&atilde;o</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarDoencaInfectocontagiosa()", ng-if="!c.isLoginLocalProva && c.menu.exibeDoencaInfectocontagiosa()") Doenças Infectocontagiosas--><a style="cursor: pointer" ng-click="c.navegarDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuDoencaInfectoContagiosaVisivel.menuDoencaInfectoContagiosaEnabled" class="ng-scope">Doenças Infectocontagiosas</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarResultadoDoencaInfectocontagiosa()", ng-if="!c.isLoginLocalProva && c.menu.exibeResultadoDoencaInfectocontagiosa()") Resultado de Doenças Infectocontagiosas--><a style="cursor: pointer" ng-click="c.navegarResultadoDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuResultadoDoencaInfectoContagiosaVisivel.menuResultadoDoencaInfectoContagiosaEnabled" class="ng-scope">Resultado de Doenças Infectocontagiosas</a></li><li class="ng-scope"><a style="cursor: pointer" ng-click="c.navegarReaplicacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeReaplicacao() || c.menu.exibeReaplicacaoResultado()" class="ng-scope">Solicita&ccedil;&atilde;o de Reaplica&ccedil;&atilde;o</a><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarReaplicacao()", ng-if="!c.isLoginLocalProva && c.solicitarEnccejaReaplicacaoVisivel.exibirSolicitarEnccejaReaplicacaoEnabled") Registro de Ocorr&ecirc;ncias de Aplica&ccedil;&atilde;o--></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" class="ng-scope">Alterar dados</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarDadosPessoais()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeAlterarDadosInscricao()" class="ng-scope">Informa&ccedil;&otilde;es pessoais</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope"><!--ng-click="c.navegarAtendimentosEspecializados()",--><!--ng-if="!c.isLoginLocalProva && c.menu.exibeAlterarDadosInscricao()")-->Atendimento Especializado</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 40px" ng-click="c.navegarAtendimentosEspecializados()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope">Solicitar / Alterar Solicitação</a><!--ng-if="!c.isLoginLocalProva && false") Atendimento Especializado--></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer; padding-left: 30px", ng-click="c.navegarMunicipioProva()", ng-if="!c.isLoginLocalProva && c.menu.exibeAlterarDadosInscricao()") Informa&ccedil;&otilde;es de prova--><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarMunicipioProva()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuInformacoesProvaVisivel.inscricaoEmAndamento" class="ng-scope">Informa&ccedil;&otilde;es de prova</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer; padding-left: 30px", ng-click="c.navegarJustificativaAusencia()", ng-if="!c.isLoginLocalProva && c.menu.exibeAcompanhamentoJustificativa()") Justificativa de aus&ecirc;ncia--><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarJustificativaAusencia()" ng-if="c.validarExibicaoAcompanhamentoJustific()" class="ng-scope">Justificativa de aus&ecirc;ncia</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarContato()" class="ng-scope">Contato</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; false" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="atualizarSenha" class="ng-scope">Senha</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeLaudoMedico() && !!c.menuRecursoLaudoMedico")--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuRecursoLaudoMedico" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarLaudoMedico()" class="ng-scope">Recurso Laudo M&eacute;dico</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeTratamentoSocial()")--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuTratamentoNomeSocialVisivel.menuTratamentoNomeSocialEnabled" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="nomeSocial" class="ng-scope">Tratamento pelo Nome Social</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeReenvioTratamentoSocial()") verificar se eh recurso ou resultado--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.recursoMenuTratamentoNomeSocialVisivel.recursoMenuTratamentoNomeSocialEnabled &amp;&amp; !!c.menuRecursoNomeSocial" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="reenvioNomeSocial" class="ng-scope">Recurso Nome Social</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menu.exibeBoletoCobranca()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="boletoCobranca" class="ng-scope">Boleto de Cobrança</a></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultados()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" class="ng-scope">Resultado</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2017()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2017" class="ng-scope">ENCCEJA 2017</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2018()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2018" class="ng-scope">ENCCEJA 2018</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2019()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2019" class="ng-scope">ENCCEJA 2019</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2020()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2020" class="ng-scope">ENCCEJA 2020</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2022()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2022" class="ng-scope">ENCCEJA 2022</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2023()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2023" class="ng-scope">ENCCEJA 2023</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2024()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2024" class="ng-scope">ENCCEJA 2024</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2025()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2025" class="ng-scope">ENCCEJA 2025</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2026()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2026" class="ng-scope">ENCCEJA 2026</a></li></ul><ul inep-sidebar="inep-sidebar" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" ng-click="c.sair()" class="ng-scope">Sair</a></li></ul></nav></section></div><div class="col-sm-9 col-sm-offset-3 col-md-10 col-md-offset-2"><div class="panel-box ng-scope"><h1 tabindex="0" focus-me="focus-me" class="h4 panel-title text-center text-primary">Bem vindo &agrave; P&aacute;gina do Participante do ENCCEJA.</h1></div><div inep-modal="inep-modal" np-buttons="c.buttons" np-show="c.modalShow" np-id="modal" np-options="c.modalOptions" np-header="Aviso"><p tabindex="0">{{ c.modalMessage }}</p></div><div inep-modal="inep-modal" np-id="modalCarencia" np-buttons="c.modalCarencia.buttons" np-show="c.modalCarencia.show" np-options="c.modalCarencia.options" np-header="Aviso"><p tabindex="0">{{ c.modalCarencia.message }}</p></div><div inep-modal="inep-modal" np-id="modalExibirMensagem" np-buttons="c.modalExibirMensagem.buttons" np-show="c.modalExibirMensagem.show" np-options="c.modalExibirMensagem.options" np-header="Avaliar serviço"><p tabindex="0">{{ c.modalExibirMensagem.saudacao }}</p><p tabindex="0">{{ c.modalExibirMensagem.message }}</p></div><div inep-modal="inep-modal" np-buttons="c.modalSair.buttons" np-show="c.modalSair.show" np-id="modalSair" np-options="c.modalSair.options" np-header="Aviso"><p tabindex="0">{{ c.modalSair.saudacao }}</p><p tabindex="0">{{ c.modalSair.message }}</p></div></div></div></section></main>'),
a.put("views/acompanhamento/boletoCobranca.html",'<header role="banner"><h1 class="hide"> - </h1><nav role="navigation" aria-labelledby="#nav" ng-controller="NavigationBarController" class="navbar navbar-default navbar-fixed-top"><h2 id="nav" class="hide">Navegação Principal</h2><div class="container-fluid"><div class="navbar-header text-center"><button type="button" data-toggle="offcanvas" class="navbar-toggle collapsed left"><span class="sr-only">Toggle navigation</span><span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span></button><div aria-label="Bem vindo ao INEP" class="navbar-brand"><img src="images/logo_inep.svg" alt="Instituto Nacional de Estudos e Pesquisas Educacionais Anísio Teixeira"/></div><button type="button" data-toggle="collapse" data-target="#navbar-collapse" class="navbar-toggle collapsed right p-n"><span class="sr-only">Toggle navigation</span><i class="fa fa-gear text-white"></i></button></div><!--#navbar-collapse.collapse.navbar-collapse--><!--  ul.nav.navbar-nav--><!--    li.active--><!--      span.logo-inep.h3.m-n.font-700(data-toggle=\'tooltip\', data-placement=\'bottom\', title=project.name) #{project.abbr}--><!----><!--  ul.nav.navbar-nav.navbar-right--><!--    if !login--><!--      li--><!--        span(data-toggle=\'dropdown\') #[i.fa.fa-user] Participante: {{nomeParticipanteLogado}}--><!--    li--><!--      a.contrast(href=\'#\', inep-contrast="", data-toggle=\'tooltip\', data-placement=\'bottom\', aria-label=\'Contraste\') #[i.fa.fa-adjust]--><script type="text/ng-template" id="warning-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Você ainda está aí?</h3></div><div idle-countdown="countdown" class="modal-body"><uib-progressbar max="30" value="countdown" animate="true" class="progress-striped active"></uib-progressbar>Sua sessão será encerrada em {{countdown}} segundos.</div></div></script><script type="text/ng-template" id="timedout-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Sess&atilde;o encerrada.</h3></div><div class="modal-body"><p></p>Sua sess&atilde;o foi encerrada por inatividade.</div></div></script></div></nav></header><main role="main"><section class="login"><h1 class="hide">Painel de entrada</h1><div ng-controller="AcompanhamentoController as c" ng-init="c.init()"><div id="sideBar" class="col-sm-3 col-md-2 sidebar sidebar-offcanvas"><section><header></header><nav aria-labeledby="#nav"><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeEspelho()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" ng-click="c.navegarEspelho()" ng-if="!c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Acompanhar inscri&ccedil;&atilde;o {{c.anoEdicao}}</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.downloadDeclaracao()", ng-if="!c.isLoginLocalProva && c.menu.exibeDeclaracaoComparecimento()") Declara&ccedil;&atilde;o Comparecimento--><a style="cursor: pointer" ng-click="c.downloadDeclaracao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Declara&ccedil;&atilde;o Comparecimento</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarCartaoConfirmacao()", ng-if="!c.isLoginLocalProva && !c.menu.exibeCartaoConfirmacao()") Local de Prova/Cart&atilde;o Confirma&ccedil;&atilde;o--><a style="cursor: pointer" ng-click="c.navegarCartaoConfirmacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Local de Prova/Cart&atilde;o Confirma&ccedil;&atilde;o</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarDoencaInfectocontagiosa()", ng-if="!c.isLoginLocalProva && c.menu.exibeDoencaInfectocontagiosa()") Doenças Infectocontagiosas--><a style="cursor: pointer" ng-click="c.navegarDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuDoencaInfectoContagiosaVisivel.menuDoencaInfectoContagiosaEnabled" class="ng-scope">Doenças Infectocontagiosas</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarResultadoDoencaInfectocontagiosa()", ng-if="!c.isLoginLocalProva && c.menu.exibeResultadoDoencaInfectocontagiosa()") Resultado de Doenças Infectocontagiosas--><a style="cursor: pointer" ng-click="c.navegarResultadoDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuResultadoDoencaInfectoContagiosaVisivel.menuResultadoDoencaInfectoContagiosaEnabled" class="ng-scope">Resultado de Doenças Infectocontagiosas</a></li><li class="ng-scope"><a style="cursor: pointer" ng-click="c.navegarReaplicacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeReaplicacao() || c.menu.exibeReaplicacaoResultado()" class="ng-scope">Solicita&ccedil;&atilde;o de Reaplica&ccedil;&atilde;o</a><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarReaplicacao()", ng-if="!c.isLoginLocalProva && c.solicitarEnccejaReaplicacaoVisivel.exibirSolicitarEnccejaReaplicacaoEnabled") Registro de Ocorr&ecirc;ncias de Aplica&ccedil;&atilde;o--></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" class="ng-scope">Alterar dados</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarDadosPessoais()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeAlterarDadosInscricao()" class="ng-scope">Informa&ccedil;&otilde;es pessoais</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope"><!--ng-click="c.navegarAtendimentosEspecializados()",--><!--ng-if="!c.isLoginLocalProva && c.menu.exibeAlterarDadosInscricao()")-->Atendimento Especializado</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 40px" ng-click="c.navegarAtendimentosEspecializados()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope">Solicitar / Alterar Solicitação</a><!--ng-if="!c.isLoginLocalProva && false") Atendimento Especializado--></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer; padding-left: 30px", ng-click="c.navegarMunicipioProva()", ng-if="!c.isLoginLocalProva && c.menu.exibeAlterarDadosInscricao()") Informa&ccedil;&otilde;es de prova--><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarMunicipioProva()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuInformacoesProvaVisivel.inscricaoEmAndamento" class="ng-scope">Informa&ccedil;&otilde;es de prova</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer; padding-left: 30px", ng-click="c.navegarJustificativaAusencia()", ng-if="!c.isLoginLocalProva && c.menu.exibeAcompanhamentoJustificativa()") Justificativa de aus&ecirc;ncia--><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarJustificativaAusencia()" ng-if="c.validarExibicaoAcompanhamentoJustific()" class="ng-scope">Justificativa de aus&ecirc;ncia</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarContato()" class="ng-scope">Contato</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; false" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="atualizarSenha" class="ng-scope">Senha</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeLaudoMedico() && !!c.menuRecursoLaudoMedico")--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuRecursoLaudoMedico" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarLaudoMedico()" class="ng-scope">Recurso Laudo M&eacute;dico</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeTratamentoSocial()")--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuTratamentoNomeSocialVisivel.menuTratamentoNomeSocialEnabled" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="nomeSocial" class="ng-scope">Tratamento pelo Nome Social</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeReenvioTratamentoSocial()") verificar se eh recurso ou resultado--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.recursoMenuTratamentoNomeSocialVisivel.recursoMenuTratamentoNomeSocialEnabled &amp;&amp; !!c.menuRecursoNomeSocial" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="reenvioNomeSocial" class="ng-scope">Recurso Nome Social</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menu.exibeBoletoCobranca()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="boletoCobranca" class="ng-scope">Boleto de Cobrança</a></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultados()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" class="ng-scope">Resultado</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2017()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2017" class="ng-scope">ENCCEJA 2017</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2018()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2018" class="ng-scope">ENCCEJA 2018</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2019()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2019" class="ng-scope">ENCCEJA 2019</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2020()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2020" class="ng-scope">ENCCEJA 2020</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2022()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2022" class="ng-scope">ENCCEJA 2022</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2023()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2023" class="ng-scope">ENCCEJA 2023</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2024()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2024" class="ng-scope">ENCCEJA 2024</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2025()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2025" class="ng-scope">ENCCEJA 2025</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2026()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2026" class="ng-scope">ENCCEJA 2026</a></li></ul><ul inep-sidebar="inep-sidebar" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" ng-click="c.sair()" class="ng-scope">Sair</a></li></ul></nav></section></div><div class="col-sm-9 col-sm-offset-3 col-md-10 col-md-offset-2"><div class="panel-box ng-scope"><header><div class="page-header with-space-top"><h1 class="h3">Inscri&ccedil;&atilde;o > ENCCEJA <small>Boleto de cobrança</small></h1></div></header><div class="row"><div class="col-md-12"><form name="boletoCobrancaForm" role="form" novalidate="true" autocomplete="off" inep-message-bag="inep-message-bag" message-bag-header-error="O formulário abaixo está inválido pelos seguintes erros:" ng-controller="BoletoCobrancaController"><div class="panel panel-info with-space-top"><div tabindex="0" class="panel-heading"><h1 class="h4 panel-title text-left text-primary">Dados para pagamento</h1></div><div class="panel-body"><div inep-modal="inep-modal" np-buttons="buttons" np-show="modalShow" np-id="modal" np-options="modalOptions" np-header="ENCCEJA- Página do Participante."><p tabindex="0">{{ modalMessage }}</p></div><div ng-if="!!htmlBoletoCobranca" ng-bind-html="htmlBoletoCobranca"></div><div ng-if="!htmlBoletoCobranca">O registro do boleto junto à Instituição Financeira pode levar algum tempo. \nPor favor, acesse novamente a Página do Participante dentro de duas horas para gerar seu boleto. </div><br/></div></div><div class="clearfix"><ul class="pagination margin-bottom-none pull-right"><li class="primary"><button ng-disabled="desabilitarBotaoGerar" ng-click="obterDadosPessoais()" role="button" class="btn btn-primary">Gerar boleto</button></li><li class="primary"><button ng-disabled="desabilitarBotaoImprimir" ng-click="imprimirBoletoAction()" role="button" class="btn btn-primary">Imprimir boleto</button></li></ul></div></form></div></div></div><div inep-modal="inep-modal" np-buttons="c.buttons" np-show="c.modalShow" np-id="modal" np-options="c.modalOptions" np-header="Aviso"><p tabindex="0">{{ c.modalMessage }}</p></div><div inep-modal="inep-modal" np-id="modalCarencia" np-buttons="c.modalCarencia.buttons" np-show="c.modalCarencia.show" np-options="c.modalCarencia.options" np-header="Aviso"><p tabindex="0">{{ c.modalCarencia.message }}</p></div><div inep-modal="inep-modal" np-id="modalExibirMensagem" np-buttons="c.modalExibirMensagem.buttons" np-show="c.modalExibirMensagem.show" np-options="c.modalExibirMensagem.options" np-header="Avaliar serviço"><p tabindex="0">{{ c.modalExibirMensagem.saudacao }}</p><p tabindex="0">{{ c.modalExibirMensagem.message }}</p></div><div inep-modal="inep-modal" np-buttons="c.modalSair.buttons" np-show="c.modalSair.show" np-id="modalSair" np-options="c.modalSair.options" np-header="Aviso"><p tabindex="0">{{ c.modalSair.saudacao }}</p><p tabindex="0">{{ c.modalSair.message }}</p></div></div></div></section></main>'),a.put("views/acompanhamento/cartaoConfirmacao.html",'<header role="banner"><h1 class="hide"> - </h1><nav role="navigation" aria-labelledby="#nav" ng-controller="NavigationBarController" class="navbar navbar-default navbar-fixed-top"><h2 id="nav" class="hide">Navegação Principal</h2><div class="container-fluid"><div class="navbar-header text-center"><button type="button" data-toggle="offcanvas" class="navbar-toggle collapsed left"><span class="sr-only">Toggle navigation</span><span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span></button><div aria-label="Bem vindo ao INEP" class="navbar-brand"><img src="images/logo_inep.svg" alt="Instituto Nacional de Estudos e Pesquisas Educacionais Anísio Teixeira"/></div><button type="button" data-toggle="collapse" data-target="#navbar-collapse" class="navbar-toggle collapsed right p-n"><span class="sr-only">Toggle navigation</span><i class="fa fa-gear text-white"></i></button></div><!--#navbar-collapse.collapse.navbar-collapse--><!--  ul.nav.navbar-nav--><!--    li.active--><!--      span.logo-inep.h3.m-n.font-700(data-toggle=\'tooltip\', data-placement=\'bottom\', title=project.name) #{project.abbr}--><!----><!--  ul.nav.navbar-nav.navbar-right--><!--    if !login--><!--      li--><!--        span(data-toggle=\'dropdown\') #[i.fa.fa-user] Participante: {{nomeParticipanteLogado}}--><!--    li--><!--      a.contrast(href=\'#\', inep-contrast="", data-toggle=\'tooltip\', data-placement=\'bottom\', aria-label=\'Contraste\') #[i.fa.fa-adjust]--><script type="text/ng-template" id="warning-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Você ainda está aí?</h3></div><div idle-countdown="countdown" class="modal-body"><uib-progressbar max="30" value="countdown" animate="true" class="progress-striped active"></uib-progressbar>Sua sessão será encerrada em {{countdown}} segundos.</div></div></script><script type="text/ng-template" id="timedout-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Sess&atilde;o encerrada.</h3></div><div class="modal-body"><p></p>Sua sess&atilde;o foi encerrada por inatividade.</div></div></script></div></nav></header><main role="main"><section class="login"><h1 class="hide">Painel de entrada</h1><div ng-controller="AcompanhamentoController as c" ng-init="c.init()"><div id="sideBar" class="col-sm-3 col-md-2 sidebar sidebar-offcanvas"><section><header></header><nav aria-labeledby="#nav"><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeEspelho()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" ng-click="c.navegarEspelho()" ng-if="!c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Acompanhar inscri&ccedil;&atilde;o {{c.anoEdicao}}</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.downloadDeclaracao()", ng-if="!c.isLoginLocalProva && c.menu.exibeDeclaracaoComparecimento()") Declara&ccedil;&atilde;o Comparecimento--><a style="cursor: pointer" ng-click="c.downloadDeclaracao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Declara&ccedil;&atilde;o Comparecimento</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarCartaoConfirmacao()", ng-if="!c.isLoginLocalProva && !c.menu.exibeCartaoConfirmacao()") Local de Prova/Cart&atilde;o Confirma&ccedil;&atilde;o--><a style="cursor: pointer" ng-click="c.navegarCartaoConfirmacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Local de Prova/Cart&atilde;o Confirma&ccedil;&atilde;o</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarDoencaInfectocontagiosa()", ng-if="!c.isLoginLocalProva && c.menu.exibeDoencaInfectocontagiosa()") Doenças Infectocontagiosas--><a style="cursor: pointer" ng-click="c.navegarDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuDoencaInfectoContagiosaVisivel.menuDoencaInfectoContagiosaEnabled" class="ng-scope">Doenças Infectocontagiosas</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarResultadoDoencaInfectocontagiosa()", ng-if="!c.isLoginLocalProva && c.menu.exibeResultadoDoencaInfectocontagiosa()") Resultado de Doenças Infectocontagiosas--><a style="cursor: pointer" ng-click="c.navegarResultadoDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuResultadoDoencaInfectoContagiosaVisivel.menuResultadoDoencaInfectoContagiosaEnabled" class="ng-scope">Resultado de Doenças Infectocontagiosas</a></li><li class="ng-scope"><a style="cursor: pointer" ng-click="c.navegarReaplicacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeReaplicacao() || c.menu.exibeReaplicacaoResultado()" class="ng-scope">Solicita&ccedil;&atilde;o de Reaplica&ccedil;&atilde;o</a><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarReaplicacao()", ng-if="!c.isLoginLocalProva && c.solicitarEnccejaReaplicacaoVisivel.exibirSolicitarEnccejaReaplicacaoEnabled") Registro de Ocorr&ecirc;ncias de Aplica&ccedil;&atilde;o--></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" class="ng-scope">Alterar dados</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarDadosPessoais()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeAlterarDadosInscricao()" class="ng-scope">Informa&ccedil;&otilde;es pessoais</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope"><!--ng-click="c.navegarAtendimentosEspecializados()",--><!--ng-if="!c.isLoginLocalProva && c.menu.exibeAlterarDadosInscricao()")-->Atendimento Especializado</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 40px" ng-click="c.navegarAtendimentosEspecializados()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope">Solicitar / Alterar Solicitação</a><!--ng-if="!c.isLoginLocalProva && false") Atendimento Especializado--></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer; padding-left: 30px", ng-click="c.navegarMunicipioProva()", ng-if="!c.isLoginLocalProva && c.menu.exibeAlterarDadosInscricao()") Informa&ccedil;&otilde;es de prova--><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarMunicipioProva()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuInformacoesProvaVisivel.inscricaoEmAndamento" class="ng-scope">Informa&ccedil;&otilde;es de prova</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer; padding-left: 30px", ng-click="c.navegarJustificativaAusencia()", ng-if="!c.isLoginLocalProva && c.menu.exibeAcompanhamentoJustificativa()") Justificativa de aus&ecirc;ncia--><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarJustificativaAusencia()" ng-if="c.validarExibicaoAcompanhamentoJustific()" class="ng-scope">Justificativa de aus&ecirc;ncia</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarContato()" class="ng-scope">Contato</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; false" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="atualizarSenha" class="ng-scope">Senha</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeLaudoMedico() && !!c.menuRecursoLaudoMedico")--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuRecursoLaudoMedico" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarLaudoMedico()" class="ng-scope">Recurso Laudo M&eacute;dico</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeTratamentoSocial()")--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuTratamentoNomeSocialVisivel.menuTratamentoNomeSocialEnabled" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="nomeSocial" class="ng-scope">Tratamento pelo Nome Social</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeReenvioTratamentoSocial()") verificar se eh recurso ou resultado--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.recursoMenuTratamentoNomeSocialVisivel.recursoMenuTratamentoNomeSocialEnabled &amp;&amp; !!c.menuRecursoNomeSocial" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="reenvioNomeSocial" class="ng-scope">Recurso Nome Social</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menu.exibeBoletoCobranca()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="boletoCobranca" class="ng-scope">Boleto de Cobrança</a></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultados()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" class="ng-scope">Resultado</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2017()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2017" class="ng-scope">ENCCEJA 2017</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2018()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2018" class="ng-scope">ENCCEJA 2018</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2019()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2019" class="ng-scope">ENCCEJA 2019</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2020()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2020" class="ng-scope">ENCCEJA 2020</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2022()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2022" class="ng-scope">ENCCEJA 2022</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2023()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2023" class="ng-scope">ENCCEJA 2023</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2024()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2024" class="ng-scope">ENCCEJA 2024</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2025()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2025" class="ng-scope">ENCCEJA 2025</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2026()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2026" class="ng-scope">ENCCEJA 2026</a></li></ul><ul inep-sidebar="inep-sidebar" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" ng-click="c.sair()" class="ng-scope">Sair</a></li></ul></nav></section></div><div class="col-sm-9 col-sm-offset-3 col-md-10 col-md-offset-2"><div class="panel-box ng-scope"><div ng-controller="CartaoConfirmacaoController as c" ng-init="c.init()"><div inep-modal="inep-modal" np-buttons="c.modal.buttons" np-show="c.modal.show" np-id="c.modal" np-options="c.modalOptions" np-header="ENCCEJA &gt; Declaração de Comparecimento"><p>Caso necessite comprovar a presença no Encceja 2025, imprima a Declaração de Comparecimento aqui na Página do Participante e apresente-a ao chefe de sala para a confirmação de sua presença,<strong> em cada turno da aplicação</strong>.</p><div class="row"><inep-boolean-checkbox np-id="checkLiModal" np-value="c.modal.txtLiModal" np-selected-value="c.modal.liModal" np-optional="false"></inep-boolean-checkbox></div></div><form autocomplete="off" inep-message-bag="inep-message-bag" message-bag-header-error="O formulário abaixo está inválido pelos seguintes erros:" name="concluirInscricaoForm" novalidate="true" role="form"><table style="border-collapse: collapse;margin: 2px 0;width: 100%;margin: 4px 0;"><tr style="border-collapse: collapse;margin: 2px 0;width: 100%;margin: 4px 0;"><td style="width: 25%;">&nbsp;</td><td style="width: 50%; text-align: center;"><div style="background-color: #2C3E50; color: #FFF; padding: 5px 0;"><span style="white-space: nowrap; font-size: 14px;"><strong>CART&Atilde;O DE CONFIRMA&Ccedil;&Atilde;O DE INSCRI&Ccedil;&Atilde;O</strong></span><br/><span style="white-space: nowrap; text-decoration: underline">ENCCEJA NACIONAL 2026</span></div></td><td style="width: 25%;"><figure><img src="images/Logo-Encceja2026.png" style="width:110px; float: right"/></figure></td></tr></table><br/></form><div class="panel panel-info"><div tabindex="0" class="panel-heading"><h2 text-left="text-left" text-primary="text-primary" class="h4 panel-title">Dados de Identifica&ccedil;&atilde;o do Participante</h2></div><div class="panel-body"><div tabindex="0" class="with-space-top"><div ng-if="c.espelho.nomeSocialEspelhoDto &amp;&amp; c.espelho.nomeSocialEspelhoDto.nomeSocial" class="row"><div class="col-md-12"><b>Nome:&nbsp;</b><inep-output-text np-id="nome" ng-model="c.espelho.nomeSocialEspelhoDto.nomeSocial" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div class="row"><div class="col-md-12"><b ng-if="c.espelho.nomeSocialEspelhoDto &amp;&amp; c.espelho.nomeSocialEspelhoDto.nomeSocial">Nome civil:&nbsp;</b><b ng-if="!c.espelho.nomeSocialEspelhoDto">Nome:&nbsp;</b><inep-output-text np-id="nome" ng-model="c.espelho.nome" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div class="row"><div class="col-md-12"><b>N&uacute;mero de inscri&ccedil;&atilde;o:&nbsp;</b><inep-output-text np-id="numInscricao" ng-model="c.espelho.numeroInscricao" np-empty-Value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div class="row"><div class="col-md-12"><b>CPF:&nbsp;</b><inep-output-text np-id="cpfFormatado" ng-model="c.espelho.cpf" np-mask="999.999.999-99" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div class="row"><div class="col-md-12"><b>Data de nascimento:&nbsp;</b><inep-output-text np-id="dataNascimento" ng-model="c.espelho.dataNascimento" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div></div></div><div tabindex="1" class="panel-heading"><h2 text-left="text-left" text-primary="text-primary" class="h4 panel-title">Dados de Identificação da Prova</h2></div><div class="panel-body"><div class="with-space-top"><div class="row with-space-bottom col-md-12"><div><p>Dia da aplicação da prova: <label class="texto-azul">{{c.cartaoConfirmacao.diaProva}}/{{c.cartaoConfirmacao.mesProva}}/{{c.cartaoConfirmacao.anoProva}}</label></p><p>Nível Certificação: <label class="texto-azul">{{c.nivelCertificacao.nivel}}</label></p><!--b Data da prova: {{c.cartaoConfirmacao.diaProva}} de {{c.cartaoConfirmacao.mesProva}} de {{c.cartaoConfirmacao.anoProva}} | HOR&AacuteRIO DE BRAS&IacuteLIA/DF--><!--table.tabela.justificado(style=\'border: 1px solid;cellpadding: 2px; border-radius: 5px; width: 260px;\')--><!--    tr--><!--      td.header.centro(style=\'border: 1px; solid;cellpadding: 2px;text-align: center;font-weight: bold;\')--><!--        | Dia da Prova--><!--      td.header.centro(style=\'border: 1px solid;cellpadding: 2px;text-align: center;font-weight: bold;\')--><!--        | Nível Certificação--><!--    tr--><!--      td.header.centro(style=\'border: 1px solid;cellpadding: 2px;text-align: center;\')--><!--        label.texto-azul {{c.cartaoConfirmacao.diaProva}}/{{c.cartaoConfirmacao.mesProva}}/{{c.cartaoConfirmacao.anoProva}}--><!--        //label.texto-azul 28/08/2022--><!--      td.header.centro(style=\'border: 1px solid;cellspacing: 2px;text-align: center;\')--><!--        label.texto-azul {{c.nivelCertificacao.nivel}}--><!--        //label.texto-azul Nível Fundamental--><!--br     --></div><p ng-if="!!c.cartaoConfirmacao.ensalamentosMatutino &amp;&amp; c.cartaoConfirmacao.ensalamentosMatutino.length &gt; 0">Provas:</p><div ng-repeat="a in c.cartaoConfirmacao.ensalamentosMatutino"><inep-output-text ng-model="a.prova" np-empty-Value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text><br/></div><div ng-if="!!c.cartaoConfirmacao.ensalamentosMatutino &amp;&amp; c.cartaoConfirmacao.ensalamentosMatutino.length &gt; 0"><div><!--b Per&iacute;odo Manh&atilde - Abertura dos port&otildees: 08h00 - Fechamento dos port&otildees: 8h45 - In&iacutecio das provas: 09h00--><table style="border: 1px solid;cellpadding: 2px; border-radius: 5px; width: 500px;" class="tabela justificado"><tr><td style="border: 1px; solid;cellpadding: 2px;text-align: center;width: 80px;font-weight: bold;" class="header centro">Período</td><td style="border: 1px solid;cellpadding: 2px;text-align: center;font-weight: bold;" class="header centro">Abertura dos Portões</td><td style="border: 1px solid;cellpadding: 2px;text-align: center;font-weight: bold;" class="header centro">Fechamento dos Portões  </td><td style="border: 1px solid;cellpadding: 2px;text-align: center;font-weight: bold;" class="header centro">Início das Provas</td><td style="border: 1px solid;cellpadding: 2px;text-align: center;font-weight: bold;" class="header centro">Fim das Provas  </td></tr><tr><td style="border: 1px solid;cellpadding: 2px;text-align: center;width: 80px;" class="header centro"><!--label.texto-azul {{c.cartaoConfirmacao.diaProva}}/{{c.cartaoConfirmacao.mesProva}}/{{c.cartaoConfirmacao.anoProva}}--><label class="texto-azul">Manhã</label></td><td style="border: 1px solid;cellspacing: 2px;text-align: center;" class="header centro"><label class="texto-azul">8h</label></td><td style="border: 1px solid;cellspacing: 2px;text-align: center;" class="header centro"><label class="texto-azul">8h45</label></td><td style="border: 1px solid;cellspacing: 2px;text-align: center;" class="header centro"><label class="texto-azul">9h</label></td><td style="border: 1px solid;cellspacing: 2px;text-align: center;" class="header centro"><label class="texto-azul">13h</label></td></tr></table><div></div><!--b {{c.ensalamentoManha.bloco}} - {{c.ensalamentoManha.andar ? c.ensalamentoManha.andar + \' -\' : \'\'}} {{c.ensalamentoManha.sala}}--></div><br/></div><p ng-if="!!c.cartaoConfirmacao.ensalamentosVespertino &amp;&amp; c.cartaoConfirmacao.ensalamentosVespertino.length &gt; 0">Provas:</p><div ng-repeat="a in c.cartaoConfirmacao.ensalamentosVespertino"><inep-output-text ng-model="a.prova" np-empty-Value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text><br/></div><div ng-if="!!c.cartaoConfirmacao.ensalamentosVespertino &amp;&amp; c.cartaoConfirmacao.ensalamentosVespertino.length &gt; 0"><div><!--b Per&iacute;odo Tarde - Abertura dos port&otildees: 14h30 - Fechamento dos port&otildees: 15h15 – In&iacutecio das provas: 15h30min--><!--b Per&iacute;odo Tarde - Abertura dos port&otildees: 14h00 - Fechamento dos port&otildees: 14h45 – In&iacutecio das provas: 15h00--><table style="border: 1px solid;cellpadding: 2px; border-radius: 5px; width: 500px;" class="tabela justificado"><tr><td style="border: 1px solid;cellpadding: 2px;text-align: center;width: 80px;font-weight: bold;" class="header centro">Período</td><td style="border: 1px solid;cellpadding: 2px;text-align: center;font-weight: bold;" class="header centro">Abertura dos Portões</td><td style="border: 1px solid;cellpadding: 2px;text-align: center;font-weight: bold;" class="header centro">Fechamento dos Portões  </td><td style="border: 1px solid;cellpadding: 2px;text-align: center;font-weight: bold;" class="header centro">Início das Provas</td><td style="border: 1px solid;cellpadding: 2px;text-align: center;font-weight: bold;" class="header centro">Fim das Provas  </td></tr><tr><td style="border: 1px solid;cellpadding: 2px;text-align: center;width: 80px;" class="header centro"><!--label.texto-azul {{c.cartaoConfirmacao.diaProva}}/{{c.cartaoConfirmacao.mesProva}}/{{c.cartaoConfirmacao.anoProva}}--><label class="texto-azul">Tarde</label></td><td style="border: 1px solid;cellspacing: 2px;text-align: center;" class="header centro"><label class="texto-azul">14h30</label></td><td style="border: 1px solid;cellspacing: 2px;text-align: center;" class="header centro"><label class="texto-azul">15h15</label></td><td style="border: 1px solid;cellspacing: 2px;text-align: center;" class="header centro"><label class="texto-azul">15h30</label></td><td style="border: 1px solid;cellspacing: 2px;text-align: center;" class="header centro"><label class="texto-azul">20h30</label></td></tr></table><div></div><!--b {{c.ensalamentoTarde.bloco}} - {{c.ensalamentoTarde.andar ? c.ensalamentoTarde.andar + \' -\' : \'\'}} {{c.ensalamentoTarde.sala}}--></div></div><br/><p>*Os hor&aacute;rios abaixo se referem ao hor&aacute;rio de Bras&iacute;lia/DF        </p></div></div></div><div tabindex="2" class="panel-heading"><h2 text-left="text-left" text-primary="text-primary" class="h4 panel-title">Local de Prova</h2></div><div class="panel-body"><div class="row col-md-12 with-space-top"><b>Nome do local de provas:&nbsp;</b><b style="color: #0e377d">{{c.cartaoConfirmacao.localDeProva}}</b><br/><b>Endereço do local de provas:&nbsp;</b><b ng-if="!!c.ensalamentoManha &amp;&amp; !!c.ensalamentoTarde" style="color: #0e377d">{{c.cartaoConfirmacao.enderecoProva}}/{{c.ensalamentoManha.bloco}} - {{c.ensalamentoManha.andar}}</b><b ng-if="!!c.ensalamentoManha &amp;&amp; !c.ensalamentoTarde" style="color: #0e377d">{{c.cartaoConfirmacao.enderecoProva}}/{{c.ensalamentoManha.bloco}} - {{c.ensalamentoManha.andar}}</b><b ng-if="!c.ensalamentoManha &amp;&amp; !!c.ensalamentoTarde" style="color: #0e377d">{{c.cartaoConfirmacao.enderecoProva}}/{{c.ensalamentoTarde.bloco}} - {{c.ensalamentoTarde.andar}}</b><br/><b>Município/UF:&nbsp;</b><b style="color: #0e377d">{{c.cartaoConfirmacao.municipioUfProva}}</b><br/><b>Sala de provas:&nbsp;</b><b ng-if="!!c.ensalamentoManha &amp;&amp; !!c.ensalamentoTarde" style="color: #0e377d">{{c.ensalamentoManha.sala}}</b><b ng-if="!!c.ensalamentoManha &amp;&amp; !c.ensalamentoTarde" style="color: #0e377d">{{c.ensalamentoManha.sala}}</b><b ng-if="!c.ensalamentoManha &amp;&amp; !!c.ensalamentoTarde" style="color: #0e377d">{{c.ensalamentoTarde.sala}}</b></div></div><!--.panel-heading(tabindex="3")--><!--  h2.h4.panel-title(text-left, text-primary) Nível Certificação--><!--.panel-body--><!--  include ./cartaoConfirmacao_nivelCertificacao--><div tabindex="4" ng-if="c.possuiEspecializado() || c.possuiEspecifico || c.possuiRecursoEspecializado || c.possuiRecursoEspecifico || (!!c.espelho.atendimentoNomeSocial &amp;&amp; c.espelho.nomeSocialEspelhoDto.status === &quot;Aprovado&quot;)" class="panel-heading"><h2 text-left="text-left" text-primary="text-primary" class="h4 panel-title">Atendimento(s) e recurso(s) de acessibilidade aprovados</h2></div><div class="panel-body"><br/><div ng-if="c.possuiEspecializado() || c.possuiEspecifico" class="with-space-top"><legend><b>Atendimentos</b></legend><div class="row with-space-bottom col-md-12"><ul><li ng-if="c.possuiEspecializado" ng-repeat="a in c.especializados"><label style="font-weight: normal;">{{ a.descricao }}</label><div ng-if="!!a.informacaoCartao" class="box-describe"><b style="color: red">ATENÇÃO:</b>&#160;{{ a.informacaoCartao }}</div><div ng-if="!!a.informacaoCartao2" class="box-describe"><b style="color: red">ATENÇÃO:</b>&#160;{{ a.informacaoCartao2 }}</div></li><li ng-if="c.possuiEspecifico" ng-repeat="a in c.especificos"><label style="font-weight: normal;">{{ a.descricao }}</label><div ng-if="!!a.informacaoCartao" class="box-describe"><b style="color: red">ATENÇÃO:</b>{{ a.informacaoCartao }}</div></li></ul></div></div><div ng-if="c.possuiRecursoEspecializado || c.possuiRecursoEspecifico" class="with-space-top"><br/><legend><b>Recurso de acessibilidade</b></legend><div class="row col-sm-12"><ul><li ng-if="c.possuiRecursoEspecializado" ng-repeat="r in c.recursosEspecializadosMarcados">{{ r.descricao }}<div ng-if="!!r.informacaoCartao" class="box-describe">{{ r.informacaoCartao }}</div><div ng-if="!r.informacaoCartao &amp;&amp; !!r.informacao" class="box-describe">{{ r.informacao }}</div></li><li ng-if="c.possuiRecursoEspecifico" ng-repeat="r in c.recursosEspecificosMarcados">{{ r.descricao }}<div ng-if="!!r.informacaoCartao" class="box-describe">{{ r.informacaoCartao }}</div><div ng-if="!r.informacaoCartao &amp;&amp; !!r.informacao" class="box-describe">{{ r.informacao }}</div></li></ul></div></div><!--include ./cartaoConfirmacao_nomeSocial--></div><div tabindex="5" class="panel-heading"><h2 text-center="text-center" text-primary="text-primary" class="h4 panel-title">Orientações para a realização do Exame</h2></div><div class="panel-body"><div tabindex="0" class="with-space-top"><!--.row.col-sm-12: ul--><!--  li--><!--    | Conhecer o local de suas provas com antecedência.--><!--.row--><!--  .col-md-12--><!--    p.text-justify--><div class="row col-sm-12"><ul><li> Comparecer ao local de realização da prova, com antecedência de, no mínimo, 1 (uma) hora do horário fixado para o início da aplicação.</li></ul></div><div class="row col-sm-12"><ul><li>Responder as provas com caneta preta, fabricada em material transparente.</li></ul></div><div class="row col-sm-12"><ul><li> Levar para identificação, no dia do Exame, documento oficial original com foto. Consideram-se documentos válidos para a identificação:<div class="row col-sm-12"><ul><li class="with-space-top">Do participante brasileiro:<p class="text-justify with-space-left with-space-top">a) Cédulas de Identidade expedidas por Secretarias de Segurança Pública, Forças Armadas, Polícia Militar e Polícia Federal;</p><p class="text-justify with-space-left">b) Identificação fornecida por ordens ou conselhos de classes que, por lei, tenha validade como documento de identidade;</p><p class="text-justify with-space-left">c) Passaporte;</p><p class="text-justify with-space-left">d) Carteira Nacional de Habilitação, na forma da Lei nº 9.503, de 23 de setembro de 1997;</p><p class="text-justify with-space-left">e) Carteira de Trabalho e Previdência Social impressa e expedida após 27 de janeiro de 1997;</p><p class="text-justify with-space-left">f) Documentos digitais com foto (e-Título, CNH digital, RG digital e CIN digital) apresentados nos respectivos aplicativos oficiais ou no aplicativo Gov.br.</p></li><li class="with-space-top">Do participante estrangeiro:<p class="text-justify with-space-left with-space-top">a) Passaporte;</p><p class="text-justify with-space-left">b) Identidade expedida pelo Ministério da Justiça para estrangeiros, inclusive aqueles reconhecidos como refugiados, em consonância com a Lei nº 9.474, de 22 de julho de 1997;</p><p class="text-justify with-space-left">c) Carteira de Registro Nacional Migratório, de que trata a Portaria nº 11.264, de 24 de janeiro de 2020;</p><p class="text-justify with-space-left">d) Documento Provisório de Registro Nacional Migratório, de que trata a Portaria nº 11.264, de 24 de janeiro de 2020;</p><p class="text-justify with-space-left">e) Cédula de identidade civil ou documento estrangeiro equivalente, emitido por Estado parte ou associado ao Mercosul, nos termos do Acordo sobre Documentos de Viagem dos Estados Partes do Mercosul e Estados Associados.</p><p class="text-justify with-space-left">f) Documentos digitais com foto (Carteira de Registro Nacional Migratório [CRNM] e Documento Provisório de Registro Nacional [DPRNM]) apresentados no aplicativo Carteira Digital do Migrante.</p></li></ul></div></li></ul></div><div class="row col-sm-12"><ul><li>Realizar a impressão da Declaração Comparecimento e apresentá-la ao chefe de sala, antes de entrar na sala de provas, por turno, se precisar.</li></ul></div><div class="row col-sm-12"><ul><li>Não usar óculos escuros e artigos de chapelaria, tais como: boné, véu, quipá, chapéu, viseira, gorro e similares no dia de prova.</li></ul></div><div class="row col-sm-12"><ul><li>Não utilizar no dia de provas lápis, caneta de material não transparente, lapiseira, borrachas,\ncorretivos, livros, manuais, impressos, anotações, protetor auricular e quaisquer dispositivos\neletrônicos, tais como: garrafa/copo digital, cigarro eletrônico,  wearable tech, máquinas\ncalculadoras, agendas eletrônicas ou similares, telefones celulares, smartphones, tablets,\nIpods®, pen drives, mp3 ou similar, gravadores, relógios, alarmes de qualquer espécie, chaves\ncom alarme ou com qualquer outro componente eletrônico, fones de ouvido ou qualquer transmissor,\ngravador ou receptor de dados, imagens, vídeos e mensagens e quaisquer outros materiais estranhos\nà realização da prova.</li></ul></div><div class="row col-sm-12"><ul><li>Manter aparelhos eletrônicos como celular, tablet, pulseiras e relógios inteligentes com todos os aplicativos,\nfunções e sistemas desativados e desligados, incluindo alarmes, no envelope porta-objetos.</li></ul></div><!--.row.col-sm-12: ul--><!--  li--><!--    | Leve sua garrafinha de água para evitar o uso do bebedouro.--><!--.row.col-sm-12: ul--><!--  li--><!--    | Você pode levar seu próprio álcool em gel para higienização de suas mãos durante a aplicação das provas.--><!--.row.col-sm-12: ul--><!--  li--><!--    | O local de provas foi higienizado e os procedimentos de aplicação adaptados para sua segurança na realização do Encceja.--><div class="row"><div class="col-md-12 text-center"><figure><img src="images/contato.png" style="margin-left: 4%;"/></figure></div></div></div></div></div><div class="clearfix"><ul class="pagination margin-bottom-none pull-right"><li class="primary"><button ng-click="c.imprimir()" role="button" class="btn btn-primary">Imprimir</button></li><li ng-if="c.exibeCancelarCarencia()" class="primary"><button ng-click="c.exibirModalCarencia()" role="button" class="btn btn-primary">Cancelar carência</button></li><li ng-if="c.exibeSolicitarCarencia()" class="primary"><button ng-click="c.navegarCarencia()" role="button" class="btn btn-primary">Solicitar carência</button></li></ul></div></div></div><div inep-modal="inep-modal" np-buttons="c.buttons" np-show="c.modalShow" np-id="modal" np-options="c.modalOptions" np-header="Aviso"><p tabindex="0">{{ c.modalMessage }}</p></div><div inep-modal="inep-modal" np-id="modalCarencia" np-buttons="c.modalCarencia.buttons" np-show="c.modalCarencia.show" np-options="c.modalCarencia.options" np-header="Aviso"><p tabindex="0">{{ c.modalCarencia.message }}</p></div><div inep-modal="inep-modal" np-id="modalExibirMensagem" np-buttons="c.modalExibirMensagem.buttons" np-show="c.modalExibirMensagem.show" np-options="c.modalExibirMensagem.options" np-header="Avaliar serviço"><p tabindex="0">{{ c.modalExibirMensagem.saudacao }}</p><p tabindex="0">{{ c.modalExibirMensagem.message }}</p></div><div inep-modal="inep-modal" np-buttons="c.modalSair.buttons" np-show="c.modalSair.show" np-id="modalSair" np-options="c.modalSair.options" np-header="Aviso"><p tabindex="0">{{ c.modalSair.saudacao }}</p><p tabindex="0">{{ c.modalSair.message }}</p></div></div></div></section></main>'),
a.put("views/acompanhamento/declararCarencia.html",'<header role="banner"><h1 class="hide"> - </h1><nav role="navigation" aria-labelledby="#nav" ng-controller="NavigationBarController" class="navbar navbar-default navbar-fixed-top"><h2 id="nav" class="hide">Navegação Principal</h2><div class="container-fluid"><div class="navbar-header text-center"><button type="button" data-toggle="offcanvas" class="navbar-toggle collapsed left"><span class="sr-only">Toggle navigation</span><span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span></button><div aria-label="Bem vindo ao INEP" class="navbar-brand"><img src="images/logo_inep.svg" alt="Instituto Nacional de Estudos e Pesquisas Educacionais Anísio Teixeira"/></div><button type="button" data-toggle="collapse" data-target="#navbar-collapse" class="navbar-toggle collapsed right p-n"><span class="sr-only">Toggle navigation</span><i class="fa fa-gear text-white"></i></button></div><!--#navbar-collapse.collapse.navbar-collapse--><!--  ul.nav.navbar-nav--><!--    li.active--><!--      span.logo-inep.h3.m-n.font-700(data-toggle=\'tooltip\', data-placement=\'bottom\', title=project.name) #{project.abbr}--><!----><!--  ul.nav.navbar-nav.navbar-right--><!--    if !login--><!--      li--><!--        span(data-toggle=\'dropdown\') #[i.fa.fa-user] Participante: {{nomeParticipanteLogado}}--><!--    li--><!--      a.contrast(href=\'#\', inep-contrast="", data-toggle=\'tooltip\', data-placement=\'bottom\', aria-label=\'Contraste\') #[i.fa.fa-adjust]--><script type="text/ng-template" id="warning-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Você ainda está aí?</h3></div><div idle-countdown="countdown" class="modal-body"><uib-progressbar max="30" value="countdown" animate="true" class="progress-striped active"></uib-progressbar>Sua sessão será encerrada em {{countdown}} segundos.</div></div></script><script type="text/ng-template" id="timedout-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Sess&atilde;o encerrada.</h3></div><div class="modal-body"><p></p>Sua sess&atilde;o foi encerrada por inatividade.</div></div></script></div></nav></header><main role="main"><section class="login"><h1 class="hide">Painel de entrada</h1><div ng-controller="AcompanhamentoController as c" ng-init="c.init()"><div id="sideBar" class="col-sm-3 col-md-2 sidebar sidebar-offcanvas"><section><header></header><nav aria-labeledby="#nav"><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeEspelho()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" ng-click="c.navegarEspelho()" ng-if="!c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Acompanhar inscri&ccedil;&atilde;o {{c.anoEdicao}}</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.downloadDeclaracao()", ng-if="!c.isLoginLocalProva && c.menu.exibeDeclaracaoComparecimento()") Declara&ccedil;&atilde;o Comparecimento--><a style="cursor: pointer" ng-click="c.downloadDeclaracao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Declara&ccedil;&atilde;o Comparecimento</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarCartaoConfirmacao()", ng-if="!c.isLoginLocalProva && !c.menu.exibeCartaoConfirmacao()") Local de Prova/Cart&atilde;o Confirma&ccedil;&atilde;o--><a style="cursor: pointer" ng-click="c.navegarCartaoConfirmacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Local de Prova/Cart&atilde;o Confirma&ccedil;&atilde;o</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarDoencaInfectocontagiosa()", ng-if="!c.isLoginLocalProva && c.menu.exibeDoencaInfectocontagiosa()") Doenças Infectocontagiosas--><a style="cursor: pointer" ng-click="c.navegarDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuDoencaInfectoContagiosaVisivel.menuDoencaInfectoContagiosaEnabled" class="ng-scope">Doenças Infectocontagiosas</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarResultadoDoencaInfectocontagiosa()", ng-if="!c.isLoginLocalProva && c.menu.exibeResultadoDoencaInfectocontagiosa()") Resultado de Doenças Infectocontagiosas--><a style="cursor: pointer" ng-click="c.navegarResultadoDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuResultadoDoencaInfectoContagiosaVisivel.menuResultadoDoencaInfectoContagiosaEnabled" class="ng-scope">Resultado de Doenças Infectocontagiosas</a></li><li class="ng-scope"><a style="cursor: pointer" ng-click="c.navegarReaplicacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeReaplicacao() || c.menu.exibeReaplicacaoResultado()" class="ng-scope">Solicita&ccedil;&atilde;o de Reaplica&ccedil;&atilde;o</a><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarReaplicacao()", ng-if="!c.isLoginLocalProva && c.solicitarEnccejaReaplicacaoVisivel.exibirSolicitarEnccejaReaplicacaoEnabled") Registro de Ocorr&ecirc;ncias de Aplica&ccedil;&atilde;o--></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" class="ng-scope">Alterar dados</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarDadosPessoais()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeAlterarDadosInscricao()" class="ng-scope">Informa&ccedil;&otilde;es pessoais</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope"><!--ng-click="c.navegarAtendimentosEspecializados()",--><!--ng-if="!c.isLoginLocalProva && c.menu.exibeAlterarDadosInscricao()")-->Atendimento Especializado</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 40px" ng-click="c.navegarAtendimentosEspecializados()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope">Solicitar / Alterar Solicitação</a><!--ng-if="!c.isLoginLocalProva && false") Atendimento Especializado--></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer; padding-left: 30px", ng-click="c.navegarMunicipioProva()", ng-if="!c.isLoginLocalProva && c.menu.exibeAlterarDadosInscricao()") Informa&ccedil;&otilde;es de prova--><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarMunicipioProva()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuInformacoesProvaVisivel.inscricaoEmAndamento" class="ng-scope">Informa&ccedil;&otilde;es de prova</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer; padding-left: 30px", ng-click="c.navegarJustificativaAusencia()", ng-if="!c.isLoginLocalProva && c.menu.exibeAcompanhamentoJustificativa()") Justificativa de aus&ecirc;ncia--><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarJustificativaAusencia()" ng-if="c.validarExibicaoAcompanhamentoJustific()" class="ng-scope">Justificativa de aus&ecirc;ncia</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarContato()" class="ng-scope">Contato</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; false" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="atualizarSenha" class="ng-scope">Senha</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeLaudoMedico() && !!c.menuRecursoLaudoMedico")--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuRecursoLaudoMedico" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarLaudoMedico()" class="ng-scope">Recurso Laudo M&eacute;dico</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeTratamentoSocial()")--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuTratamentoNomeSocialVisivel.menuTratamentoNomeSocialEnabled" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="nomeSocial" class="ng-scope">Tratamento pelo Nome Social</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeReenvioTratamentoSocial()") verificar se eh recurso ou resultado--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.recursoMenuTratamentoNomeSocialVisivel.recursoMenuTratamentoNomeSocialEnabled &amp;&amp; !!c.menuRecursoNomeSocial" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="reenvioNomeSocial" class="ng-scope">Recurso Nome Social</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menu.exibeBoletoCobranca()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="boletoCobranca" class="ng-scope">Boleto de Cobrança</a></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultados()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" class="ng-scope">Resultado</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2017()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2017" class="ng-scope">ENCCEJA 2017</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2018()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2018" class="ng-scope">ENCCEJA 2018</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2019()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2019" class="ng-scope">ENCCEJA 2019</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2020()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2020" class="ng-scope">ENCCEJA 2020</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2022()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2022" class="ng-scope">ENCCEJA 2022</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2023()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2023" class="ng-scope">ENCCEJA 2023</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2024()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2024" class="ng-scope">ENCCEJA 2024</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2025()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2025" class="ng-scope">ENCCEJA 2025</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2026()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2026" class="ng-scope">ENCCEJA 2026</a></li></ul><ul inep-sidebar="inep-sidebar" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" ng-click="c.sair()" class="ng-scope">Sair</a></li></ul></nav></section></div><div class="col-sm-9 col-sm-offset-3 col-md-10 col-md-offset-2"><div class="panel-box ng-scope"><div ng-controller="FinalizarInscricaoController as c"><header><div class="page-header with-space-top"><h1 class="h3">Inscri&ccedil;&atilde;o > ENCCEJA <small>{{ c.fi.concluinte ? \'justificar aus&ecirc;ncia\' : \'taxa de inscri&ccedil;&atilde;o\' }}</small></h1></div></header><div class="row"><div class="col-md-12"><div tabindex="0"><div class="text-center text-primary"><label>Os campos com <i alt="asterisco" class="fa fa-asterisk"><span class="hidden-accessibility">asterisco</span></i> são de preenchimento obrigatório</label></div><div class="row with-space-bottom"></div></div><div inep-modal="inep-modal" np-buttons="c.modal.bototes" np-show="c.modal.exibe" np-id="modal" np-header="Aviso"><p tabindex="0">{{ c.modal.mensagem }}</p></div><div inep-modal="inep-modal" np-id="modalWizard" np-buttons="c.modalSair.botoes" np-show="c.modalSair.exibe"><h2 aria-labelledby="texto" tabindex="0" class="titulo-modal h5 panel-title text-center text-primary">{{c.modalSair.mensagem}}\n</h2></div><div ng-if="c.fi.concluinte"><div class="panel panel-info"><div tabindex="0" class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Justificativa de aus&ecirc;ncia no Encceja 2018</h2></div><div class="panel-body"><div class="row"><div class="col-md-12"><p>Voc&ecirc; solicitou isen&ccedil;&atilde;o da taxa de inscri&ccedil;&atilde;o do Encceja 2018 e n&atilde;o\n compareceu para realizar as provas. Conforme estabelecido no item 3.3.7 do Edital n&ordm; 10,\n de 14 de abril de 2016, e na Portaria n&ordm; 483, de 14 de maio de 2015, voc&ecirc; deve justificar\n sua aus&ecirc;ncia para que tenha direito &agrave; nova solicita&ccedil;&atilde;o de\n isen&ccedil;&atilde;o de taxa para o Encceja 2018. Voc&ecirc; deseja justificar sua aus&ecirc;ncia?</p></div></div><div class="row"><inep-radiobutton np-id="radioJustificarAusencia" np-label="Você deseja justificar sua ausência?" np-values="c.options.justificarAusencia" np-selected-value="c.fi.justificarAusencia" np-inline="true" np-optional="false"></inep-radiobutton></div><div ng-if="c.fi.justificarAusencia === \'false\'" class="row"><enem-fieldset np-tab="0"><span class="attention-label">Aten&ccedil;&atilde;o:</span><span class="text-justify"> ser&aacute; gerado uma GRU Cobran&ccedil;a para voc&ecirc; concluir sua inscri&ccedil;&atilde;o no Encceja 2018.</span></enem-fieldset></div></div></div><div ng-show="c.fi.justificarAusencia === &quot;true&quot;" class="panel panel-info"><div tabindex="0" class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Motivo da aus&ecirc;ncia</h2></div><div class="panel-body"><div class="row"><inep-radiobutton np-id="radioMotivoAusencia" np-label="Selecione uma das opções abaixo, de acordo com a situação que justifica sua ausência do Encceja 2018:" np-values="c.options.motivosAusencia" np-selected-value="c.fi.motivoAusencia" np-inline="false" np-optional="c.fi.justificarAusencia !== &quot;true&quot;"></inep-radiobutton></div></div></div></div><div ng-if="!c.fi.concluinte"><div class="panel panel-info"><div tabindex="0" class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Conclus&atilde;o da inscri&ccedil;&atilde;o</h2></div><div class="panel-body"><div class="row"><inep-radiobutton np-id="radioTipoConclusao" np-label="Indique a opção de finalização da inscrição:" np-values="c.options.tiposConclusoes" np-selected-value="c.fi.tipoConclusao" np-inline="false" np-on-change="c.changeTipoConclusao()" np-optional="false"></inep-radiobutton></div></div></div><div ng-show="c.showJustificarAusencia()" class="panel panel-info"><div tabindex="0" class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Justificativa de aus&ecirc;ncia no Encceja 2018</h2></div><div class="panel-body"><div class="row"><div class="col-md-12"><p>Voc&ecirc; solicitou isen&ccedil;&atilde;o da taxa de inscri&ccedil;&atilde;o do Encceja  201 e n&atilde;o\n compareceu para realizar as provas. Conforme estabelecido no item 3.3.7 do Edital n&ordm; 10,\n de 14 de abril de 2016, e na Portaria n&ordm; 483, de 14 de maio de 2015, voc&ecirc; deve justificar\n sua aus&ecirc;ncia para que tenha direito &agrave; nova solicita&ccedil;&atilde;o de\n isen&ccedil;&atilde;o de taxa para o Encceja 2018. Voc&ecirc; deseja justificar sua aus&ecirc;ncia?</p></div></div><div class="row"><inep-radiobutton np-id="radioJustificarAusencia" np-label="Você deseja justificar sua ausência?" np-values="c.options.justificarAusencia" np-selected-value="c.fi.justificarAusencia" np-inline="true" np-optional="!c.showJustificarAusencia()" np-on-change="c.changeJustificarAusencia()"></inep-radiobutton></div><div ng-if="c.showAlertJustificarAusencia()" class="row"><enem-fieldset np-tab="0"><span class="attention-label">Aten&ccedil;&atilde;o:</span><span class="text-justify"> ser&aacute; gerado uma GRU Cobran&ccedil;a para voc&ecirc; concluir sua inscri&ccedil;&atilde;o no Encceja 2018.</span></enem-fieldset></div></div></div><div ng-show="c.showMotivosAusencia()" class="panel panel-info"><div tabindex="0" class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Motivo da aus&ecirc;ncia</h2></div><div class="panel-body"><div class="row"><inep-radiobutton np-id="radioMotivoAusencia" np-label="Selecione uma das opções abaixo, de acordo com a situação que justifica sua ausência do Encceja 2016:" np-values="c.options.motivosAusencia" np-selected-value="c.fi.motivoAusencia" np-inline="false" np-optional="!c.showMotivosAusencia()"></inep-radiobutton></div></div></div><div ng-show="c.showTipoCarencia()" class="panel panel-info"><div tabindex="0" class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Tipo de car&ecirc;ncia</h2></div><div class="panel-body"><div class="row"><inep-radiobutton np-id="radioTipoCarencia" np-label="Indique a opção de carência que deseja solicitar:" np-values="c.options.tiposCarencia" np-selected-value="c.fi.tipoCarencia" np-inline="false" np-optional="!c.showTipoCarencia()" np-on-change="c.changeTipoCarencia()"></inep-radiobutton></div></div></div><div ng-show="c.showInformarNis()" class="panel panel-info"><div tabindex="0" class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Informa&ccedil;&otilde;es sobre o N&uacute;mero de Identifica&ccedil;&atilde;o Social (NIS)</h2></div><div class="panel-body"><div class="row"><inep-radiobutton np-id="radioPossuiCadUnico" np-label="Possui inscrição no CadUnico?" np-values="c.options.possuiCadUnico" np-selected-value="c.fi.possuiCadUnico" np-on-change="c.changePossuiCadUnico()" np-inline="true" np-optional="!c.showInformarNis()"></inep-radiobutton></div><div ng-show="c.showPossuiNis()" class="row"><inep-radiobutton np-id="radioPossuiNis" np-label="Possui NIS?" np-values="c.options.possuiNis" np-selected-value="c.fi.possuiNis" np-on-change="c.changePossuiNis()" np-inline="true" np-optional="!c.showPossuiNis()"></inep-radiobutton></div><div ng-if="c.showDeclaroNaoPossuiNis()" class="row"><enem-fieldset np-tab="0"><inep-boolean-checkbox np-id="checkDeclaroNaoPossuiNis" np-value="c.txtDeclaroNaoPossuiNis" np-selected-value="c.fi.declaracaoNaoPossuiNis" np-optional="!c.showDeclaroNaoPossuiNis()"></inep-boolean-checkbox></enem-fieldset></div><div ng-show="c.showNis()" class="row"><inep-input-text np-id="inputNis" np-label="NIS" ng-model="c.fi.nis" np-optional="!c.showNis()" ng-model-options="{ debounce: 500 }" np-maxlength="11" np-size="4" inep-validator="c.exibeErroNis()" np-accessibility-message="\'Informe aqui o número do seu nis.\'"></inep-input-text><div style="margin-top 20px" class="col-md-3"><a target="_blank" title="{{c.mensagens.MSGA073}}" href="http://www.mds.gov.br/consultacidadao ">Consulte seu NIS<span style="position: absolute; left: -999em;">{{c.mensagens.MSGA056}}</span></a></div></div><div ng-if="c.showDeclaroNisNaoEncontrado()" class="row"><enem-fieldset np-tab="0"><inep-boolean-checkbox np-id="checkDeclaroNaoPossuiNis" np-value="c.txtDeclaroNisNaoEncontrado" np-selected-value="c.fi.declaracaoNisNaoEncontrado" np-optional="!c.showDeclaroNisNaoEncontrado()"></inep-boolean-checkbox></enem-fieldset></div></div></div></div></div></div><div class="clearfix"><ul class="pagination margin-bottom-none pull-right"><li class="primary"><button ng-click="c.validar(salvarCarencia)" role="button" class="btn btn-primary">Salvar</button></li></ul></div></div></div><div inep-modal="inep-modal" np-buttons="c.buttons" np-show="c.modalShow" np-id="modal" np-options="c.modalOptions" np-header="Aviso"><p tabindex="0">{{ c.modalMessage }}</p></div><div inep-modal="inep-modal" np-id="modalCarencia" np-buttons="c.modalCarencia.buttons" np-show="c.modalCarencia.show" np-options="c.modalCarencia.options" np-header="Aviso"><p tabindex="0">{{ c.modalCarencia.message }}</p></div><div inep-modal="inep-modal" np-id="modalExibirMensagem" np-buttons="c.modalExibirMensagem.buttons" np-show="c.modalExibirMensagem.show" np-options="c.modalExibirMensagem.options" np-header="Avaliar serviço"><p tabindex="0">{{ c.modalExibirMensagem.saudacao }}</p><p tabindex="0">{{ c.modalExibirMensagem.message }}</p></div><div inep-modal="inep-modal" np-buttons="c.modalSair.buttons" np-show="c.modalSair.show" np-id="modalSair" np-options="c.modalSair.options" np-header="Aviso"><p tabindex="0">{{ c.modalSair.saudacao }}</p><p tabindex="0">{{ c.modalSair.message }}</p></div></div></div></section></main>'),a.put("views/acompanhamento/doencaInfectocontagiosa.html",'<header role="banner"><h1 class="hide"> - </h1><nav role="navigation" aria-labelledby="#nav" ng-controller="NavigationBarController" class="navbar navbar-default navbar-fixed-top"><h2 id="nav" class="hide">Navegação Principal</h2><div class="container-fluid"><div class="navbar-header text-center"><button type="button" data-toggle="offcanvas" class="navbar-toggle collapsed left"><span class="sr-only">Toggle navigation</span><span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span></button><div aria-label="Bem vindo ao INEP" class="navbar-brand"><img src="images/logo_inep.svg" alt="Instituto Nacional de Estudos e Pesquisas Educacionais Anísio Teixeira"/></div><button type="button" data-toggle="collapse" data-target="#navbar-collapse" class="navbar-toggle collapsed right p-n"><span class="sr-only">Toggle navigation</span><i class="fa fa-gear text-white"></i></button></div><!--#navbar-collapse.collapse.navbar-collapse--><!--  ul.nav.navbar-nav--><!--    li.active--><!--      span.logo-inep.h3.m-n.font-700(data-toggle=\'tooltip\', data-placement=\'bottom\', title=project.name) #{project.abbr}--><!----><!--  ul.nav.navbar-nav.navbar-right--><!--    if !login--><!--      li--><!--        span(data-toggle=\'dropdown\') #[i.fa.fa-user] Participante: {{nomeParticipanteLogado}}--><!--    li--><!--      a.contrast(href=\'#\', inep-contrast="", data-toggle=\'tooltip\', data-placement=\'bottom\', aria-label=\'Contraste\') #[i.fa.fa-adjust]--><script type="text/ng-template" id="warning-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Você ainda está aí?</h3></div><div idle-countdown="countdown" class="modal-body"><uib-progressbar max="30" value="countdown" animate="true" class="progress-striped active"></uib-progressbar>Sua sessão será encerrada em {{countdown}} segundos.</div></div></script><script type="text/ng-template" id="timedout-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Sess&atilde;o encerrada.</h3></div><div class="modal-body"><p></p>Sua sess&atilde;o foi encerrada por inatividade.</div></div></script></div></nav></header><main role="main"><section class="login"><h1 class="hide">Painel de entrada</h1><div ng-controller="AcompanhamentoController as c" ng-init="c.init()"><div id="sideBar" class="col-sm-3 col-md-2 sidebar sidebar-offcanvas"><section><header></header><nav aria-labeledby="#nav"><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeEspelho()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" ng-click="c.navegarEspelho()" ng-if="!c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Acompanhar inscri&ccedil;&atilde;o {{c.anoEdicao}}</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.downloadDeclaracao()", ng-if="!c.isLoginLocalProva && c.menu.exibeDeclaracaoComparecimento()") Declara&ccedil;&atilde;o Comparecimento--><a style="cursor: pointer" ng-click="c.downloadDeclaracao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Declara&ccedil;&atilde;o Comparecimento</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarCartaoConfirmacao()", ng-if="!c.isLoginLocalProva && !c.menu.exibeCartaoConfirmacao()") Local de Prova/Cart&atilde;o Confirma&ccedil;&atilde;o--><a style="cursor: pointer" ng-click="c.navegarCartaoConfirmacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Local de Prova/Cart&atilde;o Confirma&ccedil;&atilde;o</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarDoencaInfectocontagiosa()", ng-if="!c.isLoginLocalProva && c.menu.exibeDoencaInfectocontagiosa()") Doenças Infectocontagiosas--><a style="cursor: pointer" ng-click="c.navegarDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuDoencaInfectoContagiosaVisivel.menuDoencaInfectoContagiosaEnabled" class="ng-scope">Doenças Infectocontagiosas</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarResultadoDoencaInfectocontagiosa()", ng-if="!c.isLoginLocalProva && c.menu.exibeResultadoDoencaInfectocontagiosa()") Resultado de Doenças Infectocontagiosas--><a style="cursor: pointer" ng-click="c.navegarResultadoDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuResultadoDoencaInfectoContagiosaVisivel.menuResultadoDoencaInfectoContagiosaEnabled" class="ng-scope">Resultado de Doenças Infectocontagiosas</a></li><li class="ng-scope"><a style="cursor: pointer" ng-click="c.navegarReaplicacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeReaplicacao() || c.menu.exibeReaplicacaoResultado()" class="ng-scope">Solicita&ccedil;&atilde;o de Reaplica&ccedil;&atilde;o</a><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarReaplicacao()", ng-if="!c.isLoginLocalProva && c.solicitarEnccejaReaplicacaoVisivel.exibirSolicitarEnccejaReaplicacaoEnabled") Registro de Ocorr&ecirc;ncias de Aplica&ccedil;&atilde;o--></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" class="ng-scope">Alterar dados</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarDadosPessoais()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeAlterarDadosInscricao()" class="ng-scope">Informa&ccedil;&otilde;es pessoais</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope"><!--ng-click="c.navegarAtendimentosEspecializados()",--><!--ng-if="!c.isLoginLocalProva && c.menu.exibeAlterarDadosInscricao()")-->Atendimento Especializado</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 40px" ng-click="c.navegarAtendimentosEspecializados()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope">Solicitar / Alterar Solicitação</a><!--ng-if="!c.isLoginLocalProva && false") Atendimento Especializado--></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer; padding-left: 30px", ng-click="c.navegarMunicipioProva()", ng-if="!c.isLoginLocalProva && c.menu.exibeAlterarDadosInscricao()") Informa&ccedil;&otilde;es de prova--><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarMunicipioProva()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuInformacoesProvaVisivel.inscricaoEmAndamento" class="ng-scope">Informa&ccedil;&otilde;es de prova</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer; padding-left: 30px", ng-click="c.navegarJustificativaAusencia()", ng-if="!c.isLoginLocalProva && c.menu.exibeAcompanhamentoJustificativa()") Justificativa de aus&ecirc;ncia--><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarJustificativaAusencia()" ng-if="c.validarExibicaoAcompanhamentoJustific()" class="ng-scope">Justificativa de aus&ecirc;ncia</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarContato()" class="ng-scope">Contato</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; false" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="atualizarSenha" class="ng-scope">Senha</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeLaudoMedico() && !!c.menuRecursoLaudoMedico")--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuRecursoLaudoMedico" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarLaudoMedico()" class="ng-scope">Recurso Laudo M&eacute;dico</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeTratamentoSocial()")--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuTratamentoNomeSocialVisivel.menuTratamentoNomeSocialEnabled" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="nomeSocial" class="ng-scope">Tratamento pelo Nome Social</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeReenvioTratamentoSocial()") verificar se eh recurso ou resultado--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.recursoMenuTratamentoNomeSocialVisivel.recursoMenuTratamentoNomeSocialEnabled &amp;&amp; !!c.menuRecursoNomeSocial" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="reenvioNomeSocial" class="ng-scope">Recurso Nome Social</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menu.exibeBoletoCobranca()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="boletoCobranca" class="ng-scope">Boleto de Cobrança</a></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultados()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" class="ng-scope">Resultado</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2017()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2017" class="ng-scope">ENCCEJA 2017</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2018()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2018" class="ng-scope">ENCCEJA 2018</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2019()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2019" class="ng-scope">ENCCEJA 2019</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2020()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2020" class="ng-scope">ENCCEJA 2020</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2022()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2022" class="ng-scope">ENCCEJA 2022</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2023()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2023" class="ng-scope">ENCCEJA 2023</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2024()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2024" class="ng-scope">ENCCEJA 2024</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2025()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2025" class="ng-scope">ENCCEJA 2025</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2026()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2026" class="ng-scope">ENCCEJA 2026</a></li></ul><ul inep-sidebar="inep-sidebar" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" ng-click="c.sair()" class="ng-scope">Sair</a></li></ul></nav></section></div><div class="col-sm-9 col-sm-offset-3 col-md-10 col-md-offset-2"><div class="panel-box ng-scope"><div ng-controller="DoencaInfectocontagiosaController as c" ng-init="c.init()"><form autocomplete="off" inep-message-bag="inep-message-bag" message-bag-header-error="O formulário abaixo está inválido pelos seguintes erros:" name="doencaInfectocontagiosaForm" novalidate="true" role="form"><table style="border-collapse: collapse;margin: 2px 0;width: 100%;margin: 4px 0;"><tr style="border-collapse: collapse;margin: 2px 0;width: 100%;margin: 4px 0;"><td style="width: 25%;">&nbsp;</td><td style="width: 50%; text-align: center;"><div style="background-color: #2C3E50; color: #FFF; padding: 5px 0;"><span style="white-space: nowrap; font-size: 14px;"></span><strong>DOENÇAS INFECTOCONTAGIOSAS</strong><br/><span style="white-space: nowrap; text-decoration: underline">ENCCEJA NACIONAL 2020</span></div></td><td style="width: 25%;"><figure><img src="images/Logo-Encceja2026.png" style="width:110px; float: right"/></figure></td></tr><br/></table><div class="panel panel-info"><div tabindex="0" class="panel-heading"><h2 text-left="text-left" text-primary="text-primary" class="h4 panel-title">Doenças Infectocontagiosas</h2></div><div class="panel-body"><div inep-modal="inep-modal" np-buttons="c.buttons" np-show="c.modalShow" np-id="modal" np-options="c.modalOptions" np-header="Doenças Infectocontagiosas"><p tabindex="0">{{ c.modalMessage }}</p></div><div tabindex="0" class="with-space-top"><div class="row"><div class="col-md-12">Esse espaço é reservado, exclusivamente, para o participante que não poderá comparecer à<!--|  aplicação do Encceja no dia 29/8/2021, por estar com uma das doenças infectocontagiosas--> aplicação do Encceja no dia {{ c.diaDaProva }}, por estar com uma das doenças infectocontagiosas\n previstas no Edital, listadas a seguir, e que deseja informar essa condição ao INEP para que seja\n analisada uma possível participação na reaplicação do Exame, em data a ser divulgada.</div></div><br/><div class="row"><div class="col-md-12"><ul><li>Coqueluche</li><li>Difteria</li><li>Doença Invasiva por Haemophilus Influenza</li><li>Doença Meningocócica e outras meningites</li><li>Varíola</li><li>Influenza humana A e B</li><li>Poliomielite por poliovírus selvagem</li><li>Sarampo</li><li>Rubéola </li><li>Varícela</li><li>Covid-19</li></ul></div></div><br/><div class="row"><div class="col-md-12"></div><inep-radiobutton np-id="radioDoencaInfectocontagiosa" np-label="Você está com alguma das doenças infectocontagiosas listadas acima?" np-values="c.comboSimNao()" np-selected-value="c.valorRespostaDoencaInfectocontagiosa" np-inline="true" np-on-change="c.doencaInfectocontagiosaChanged()" np-optional="true"></inep-radiobutton></div><br/><div ng-if="c.valorRespostaDoencaInfectocontagiosa == &quot;true&quot;" class="row"><div class="col-md-12"><!--| O envio do documento comprobatório pode ser feito até às 12h-->O envio do documento comprobatório pose ser feito até às {{ c.recuperarDataEventoDoencaInfectoContagiosa.horaFimEvento }}\ndo dia {{ c.recuperarDataEventoDoencaInfectoContagiosa.dataFimEvento }}<!--| do dia 27/8/2021.--></div></div><br/><div ng-if="c.valorRespostaDoencaInfectocontagiosa == &quot;true&quot;" class="row with-space-bottom"><enem-fieldset><div class="col-md-12"><inep-input-text ng-if="c.file.nomeArquivo != null &amp;&amp; c.file.nomeArquivo != undefined" np-id="nomeArquivo" np-maxlength="150" np-size="6" ng-model="c.file.nomeArquivo" np-readonly="true" np-optional="true" np-label="Laudo: " np-name="selectedFile"></inep-input-text><button type="button" ng-click="c.alterarArquivo()" ng-if="c.file.nomeArquivo != null &amp;&amp; c.file.nomeArquivo != undefined" style="margin-top: 23px;margin-left: -18px;" class="btn btn-default">Salvar novo arquivo</button><inep-input-file ng-if="!c.file.nomeArquivo || c.file.nomeArquivo == null || c.file.nomeArquivo == undefined" np-id="laudoDoencaInfectocontagiosa}" np-label="Laudo: " np-value="c.file" np-max-file-size="c.maxFileSize" np-show-icon="true" np-size="6" np-max-file-message="Tamanho de arquivo inválido." np-content-type-message="Formato de arquivo inválido." np-disabled="" np-optional="false" inep-validator="c.validarArquivo()" np-content-types="c.contentTypes" np-empty-message="{{c.mensagens.MSG_ARQUIVO_VAZIO}}"></inep-input-file></div><div ng-if="c.isFileValid() &amp;&amp; !c.file.send" class="col-md-4"><button id="enviarLaudoDoencaInfectocontagiosa" ng-click="c.enviarArquivo()" class="btn btn-default align-button-upload">Salvar laudo</button></div><div ng-if="c.file.send" class="col-md-6"><inep-output-text id="mensagem_laudo" style="font-size: 16px" ng-model="c.file.msgEnvio"></inep-output-text></div></enem-fieldset></div><br/><div ng-if="c.file.send || c.mostraSalvar" class="clearfix"><ul class="pagination margin-bottom-none pull-right"><inep-output-text ng-if="c.file.msgSalvar != undefined &amp;&amp; c.file.msgSalvar != \'\'" id="mensagem_laudo" style="font-size: 16px" ng-model="c.file.msgSalvar"></inep-output-text><li class="primary"><button ng-click="c.salvarSituacaoDoencaInfectocontagiosa()" role="button" class="btn btn-primary">Enviar</button></li></ul></div></div></div></div></form></div></div><div inep-modal="inep-modal" np-buttons="c.buttons" np-show="c.modalShow" np-id="modal" np-options="c.modalOptions" np-header="Aviso"><p tabindex="0">{{ c.modalMessage }}</p></div><div inep-modal="inep-modal" np-id="modalCarencia" np-buttons="c.modalCarencia.buttons" np-show="c.modalCarencia.show" np-options="c.modalCarencia.options" np-header="Aviso"><p tabindex="0">{{ c.modalCarencia.message }}</p></div><div inep-modal="inep-modal" np-id="modalExibirMensagem" np-buttons="c.modalExibirMensagem.buttons" np-show="c.modalExibirMensagem.show" np-options="c.modalExibirMensagem.options" np-header="Avaliar serviço"><p tabindex="0">{{ c.modalExibirMensagem.saudacao }}</p><p tabindex="0">{{ c.modalExibirMensagem.message }}</p></div><div inep-modal="inep-modal" np-buttons="c.modalSair.buttons" np-show="c.modalSair.show" np-id="modalSair" np-options="c.modalSair.options" np-header="Aviso"><p tabindex="0">{{ c.modalSair.saudacao }}</p><p tabindex="0">{{ c.modalSair.message }}</p></div></div></div></section></main>'),
a.put("views/acompanhamento/espelho.html",'<header role="banner"><h1 class="hide"> - </h1><nav role="navigation" aria-labelledby="#nav" ng-controller="NavigationBarController" class="navbar navbar-default navbar-fixed-top"><h2 id="nav" class="hide">Navegação Principal</h2><div class="container-fluid"><div class="navbar-header text-center"><button type="button" data-toggle="offcanvas" class="navbar-toggle collapsed left"><span class="sr-only">Toggle navigation</span><span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span></button><div aria-label="Bem vindo ao INEP" class="navbar-brand"><img src="images/logo_inep.svg" alt="Instituto Nacional de Estudos e Pesquisas Educacionais Anísio Teixeira"/></div><button type="button" data-toggle="collapse" data-target="#navbar-collapse" class="navbar-toggle collapsed right p-n"><span class="sr-only">Toggle navigation</span><i class="fa fa-gear text-white"></i></button></div><!--#navbar-collapse.collapse.navbar-collapse--><!--  ul.nav.navbar-nav--><!--    li.active--><!--      span.logo-inep.h3.m-n.font-700(data-toggle=\'tooltip\', data-placement=\'bottom\', title=project.name) #{project.abbr}--><!----><!--  ul.nav.navbar-nav.navbar-right--><!--    if !login--><!--      li--><!--        span(data-toggle=\'dropdown\') #[i.fa.fa-user] Participante: {{nomeParticipanteLogado}}--><!--    li--><!--      a.contrast(href=\'#\', inep-contrast="", data-toggle=\'tooltip\', data-placement=\'bottom\', aria-label=\'Contraste\') #[i.fa.fa-adjust]--><script type="text/ng-template" id="warning-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Você ainda está aí?</h3></div><div idle-countdown="countdown" class="modal-body"><uib-progressbar max="30" value="countdown" animate="true" class="progress-striped active"></uib-progressbar>Sua sessão será encerrada em {{countdown}} segundos.</div></div></script><script type="text/ng-template" id="timedout-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Sess&atilde;o encerrada.</h3></div><div class="modal-body"><p></p>Sua sess&atilde;o foi encerrada por inatividade.</div></div></script></div></nav></header><main role="main"><section class="login"><h1 class="hide">Painel de entrada</h1><div ng-controller="AcompanhamentoController as c" ng-init="c.init()"><div id="sideBar" class="col-sm-3 col-md-2 sidebar sidebar-offcanvas"><section><header></header><nav aria-labeledby="#nav"><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeEspelho()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" ng-click="c.navegarEspelho()" ng-if="!c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Acompanhar inscri&ccedil;&atilde;o {{c.anoEdicao}}</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.downloadDeclaracao()", ng-if="!c.isLoginLocalProva && c.menu.exibeDeclaracaoComparecimento()") Declara&ccedil;&atilde;o Comparecimento--><a style="cursor: pointer" ng-click="c.downloadDeclaracao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Declara&ccedil;&atilde;o Comparecimento</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarCartaoConfirmacao()", ng-if="!c.isLoginLocalProva && !c.menu.exibeCartaoConfirmacao()") Local de Prova/Cart&atilde;o Confirma&ccedil;&atilde;o--><a style="cursor: pointer" ng-click="c.navegarCartaoConfirmacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Local de Prova/Cart&atilde;o Confirma&ccedil;&atilde;o</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarDoencaInfectocontagiosa()", ng-if="!c.isLoginLocalProva && c.menu.exibeDoencaInfectocontagiosa()") Doenças Infectocontagiosas--><a style="cursor: pointer" ng-click="c.navegarDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuDoencaInfectoContagiosaVisivel.menuDoencaInfectoContagiosaEnabled" class="ng-scope">Doenças Infectocontagiosas</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarResultadoDoencaInfectocontagiosa()", ng-if="!c.isLoginLocalProva && c.menu.exibeResultadoDoencaInfectocontagiosa()") Resultado de Doenças Infectocontagiosas--><a style="cursor: pointer" ng-click="c.navegarResultadoDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuResultadoDoencaInfectoContagiosaVisivel.menuResultadoDoencaInfectoContagiosaEnabled" class="ng-scope">Resultado de Doenças Infectocontagiosas</a></li><li class="ng-scope"><a style="cursor: pointer" ng-click="c.navegarReaplicacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeReaplicacao() || c.menu.exibeReaplicacaoResultado()" class="ng-scope">Solicita&ccedil;&atilde;o de Reaplica&ccedil;&atilde;o</a><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarReaplicacao()", ng-if="!c.isLoginLocalProva && c.solicitarEnccejaReaplicacaoVisivel.exibirSolicitarEnccejaReaplicacaoEnabled") Registro de Ocorr&ecirc;ncias de Aplica&ccedil;&atilde;o--></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" class="ng-scope">Alterar dados</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarDadosPessoais()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeAlterarDadosInscricao()" class="ng-scope">Informa&ccedil;&otilde;es pessoais</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope"><!--ng-click="c.navegarAtendimentosEspecializados()",--><!--ng-if="!c.isLoginLocalProva && c.menu.exibeAlterarDadosInscricao()")-->Atendimento Especializado</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 40px" ng-click="c.navegarAtendimentosEspecializados()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope">Solicitar / Alterar Solicitação</a><!--ng-if="!c.isLoginLocalProva && false") Atendimento Especializado--></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer; padding-left: 30px", ng-click="c.navegarMunicipioProva()", ng-if="!c.isLoginLocalProva && c.menu.exibeAlterarDadosInscricao()") Informa&ccedil;&otilde;es de prova--><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarMunicipioProva()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuInformacoesProvaVisivel.inscricaoEmAndamento" class="ng-scope">Informa&ccedil;&otilde;es de prova</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer; padding-left: 30px", ng-click="c.navegarJustificativaAusencia()", ng-if="!c.isLoginLocalProva && c.menu.exibeAcompanhamentoJustificativa()") Justificativa de aus&ecirc;ncia--><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarJustificativaAusencia()" ng-if="c.validarExibicaoAcompanhamentoJustific()" class="ng-scope">Justificativa de aus&ecirc;ncia</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarContato()" class="ng-scope">Contato</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; false" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="atualizarSenha" class="ng-scope">Senha</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeLaudoMedico() && !!c.menuRecursoLaudoMedico")--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuRecursoLaudoMedico" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarLaudoMedico()" class="ng-scope">Recurso Laudo M&eacute;dico</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeTratamentoSocial()")--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuTratamentoNomeSocialVisivel.menuTratamentoNomeSocialEnabled" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="nomeSocial" class="ng-scope">Tratamento pelo Nome Social</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeReenvioTratamentoSocial()") verificar se eh recurso ou resultado--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.recursoMenuTratamentoNomeSocialVisivel.recursoMenuTratamentoNomeSocialEnabled &amp;&amp; !!c.menuRecursoNomeSocial" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="reenvioNomeSocial" class="ng-scope">Recurso Nome Social</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menu.exibeBoletoCobranca()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="boletoCobranca" class="ng-scope">Boleto de Cobrança</a></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultados()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" class="ng-scope">Resultado</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2017()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2017" class="ng-scope">ENCCEJA 2017</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2018()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2018" class="ng-scope">ENCCEJA 2018</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2019()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2019" class="ng-scope">ENCCEJA 2019</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2020()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2020" class="ng-scope">ENCCEJA 2020</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2022()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2022" class="ng-scope">ENCCEJA 2022</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2023()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2023" class="ng-scope">ENCCEJA 2023</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2024()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2024" class="ng-scope">ENCCEJA 2024</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2025()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2025" class="ng-scope">ENCCEJA 2025</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2026()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2026" class="ng-scope">ENCCEJA 2026</a></li></ul><ul inep-sidebar="inep-sidebar" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" ng-click="c.sair()" class="ng-scope">Sair</a></li></ul></nav></section></div><div class="col-sm-9 col-sm-offset-3 col-md-10 col-md-offset-2"><div class="panel-box ng-scope"><div ng-controller="EspelhoController as c" ng-init="c.init()"><form autocomplete="off" inep-message-bag="inep-message-bag" message-bag-header-error="O formulário abaixo está inválido pelos seguintes erros:" name="concluirInscricaoForm" novalidate="true" role="form"><div class="row"><div class="col-md-4"></div><enem-fieldset><div tabindex="0" ng-if="c.espelho.situacaoIncricao != &quot;Não confirmada&quot;" class="msg-inscricao-sucesso">Inscri&ccedil;&atilde;o conclu&iacute;da com sucesso.</div><div tabindex="0" ng-if="c.espelho.situacaoIncricao == &quot;Não confirmada&quot;" class="msg-inscricao-aviso">Inscrição concluída – Pendente de pagamento da taxa de ressarcimento</div></enem-fieldset><div class="col-md-4"></div></div><div ng-if="c.espelho.situacaoIncricao == &quot;Não confirmada&quot;" class="row"><enem-fieldset><span class="text-justify"> Você foi ausente em todas as áreas de conhecimento em que estava inscrito no Encceja 2025 e não justificou sua ausência ou teve sua justificativa reprovada. Acesse o menu lateral para ter acesso a sua GRU Cobrança. Sua inscrição será confirmada apenas após o pagamento da GRU.</span></enem-fieldset></div></form><div ng-if="!!c.pagante"><div ng-if="c.pagante || c.possuiGru" class="panel panel-info hidden-print"><div tabindex="0" class="panel-heading"><h2 id="imprimirGRU" class="h4 panel-title text-left text-primary">Imprimir GRU</h2></div><div class="panel-body"><div class="row"><div class="col-mg-12"><div id="printGruArea" ng-bind-html="c.gruHtml"></div></div></div><div class="row with-space"><div style="padding-right: 20px" class="col-mg-12 pull-right"><button ng-click="c.imprimirGRU()" class="with-space-bottom btn btn-primary">Imprimir GRU</button></div></div></div></div></div><div class="panel panel-info"><div tabindex="0" class="panel-heading"><h2 text-left="text-left" text-primary="text-primary" class="h4 panel-title">Confirma&ccedil;&atilde;o dos dados</h2></div><div class="panel-body"><div tabindex="0" class="with-space-top"><br/><legend><b>Dados da inscri&ccedil;&atilde;o</b></legend><div class="row"><div class="col-md-12"><p>Guarde o seu n&uacute;mero de inscri&ccedil;&atilde;o, informado abaixo.</p></div></div><div class="row"><div class="col-md-12"><b>N&uacute;mero de inscri&ccedil;&atilde;o:&nbsp;</b><inep-output-text np-id="numInscricao" ng-model="c.espelho.numeroInscricao" np-empty-Value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div class="row"><div class="col-md-12"><b>Situa&ccedil;&atilde;o da inscri&ccedil;&atilde;o:&nbsp;</b><inep-output-text np-id="situacaoInscricao" ng-model="c.espelho.situacaoIncricao" np-empty-Value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div class="row"><div class="col-md-12"><b>Ano ENCCEJA:&nbsp;</b><inep-output-text np-id="anoEnem" ng-model="c.anoEdicao" np-empty-Value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div></div><div tabindex="0" class="with-space-top"><br/><legend><b>Dados pessoais</b></legend><div class="row"><div class="col-md-3"><b>CPF:&nbsp;</b><inep-output-text np-id="cpfFormatado" ng-model="c.espelho.cpf" np-mask="999.999.999-99" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div><div class="col-md-6"><b>Nome completo:&nbsp;</b><inep-output-text np-id="nome" ng-model="c.espelho.nome" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div><div class="col-md-3"><b>Data de nascimento:&nbsp;</b><inep-output-text np-id="dataNascimento" ng-model="c.espelho.dataNascimento" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div class="row"><div ng-if="!!c.espelho.nomeSocialEspelhoDto &amp;&amp; c.espelho.nomeSocialEspelhoDto.status == \'Aprovado\'" class="col-md-6"><b>Nome Social:&nbsp;</b><inep-output-text np-id="nomeSocial" ng-model="c.espelho.nomeSocialEspelhoDto.nomeSocial" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div><div class="col-md-6"><b>Nome completo da m&atilde;e:&nbsp;</b><inep-output-text np-id="nomeDaMae" ng-model="c.espelho.nomeDaMae" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div class="row"><div class="col-md-6"><b>Nome completo do pai:&nbsp;</b><inep-output-text np-id="nomeDoPai" ng-model="c.espelho.nomeDoPai" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div class="row"><div class="col-md-3"><b>Sexo:&nbsp;</b><inep-output-text np-id="sexo" ng-model="c.espelho.sexo" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div><div class="col-md-3"><b>Cor ou Ra&ccedil;a:&nbsp;</b><inep-output-text np-id="nomeEtnia" ng-model="c.espelho.etnia" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div class="row"><div class="col-md-3"><b>Estado civil:&nbsp;</b><inep-output-text np-id="nomeEstadoCivil" ng-model="c.espelho.estadoCivil" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div><div class="col-md-6"><b>Nacionalidade:&nbsp;</b><inep-output-text np-id="nacionalidade" ng-model="c.espelho.nacionalidade" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div class="row"><div ng-if="!!c.espelho.nascimentoMunicipio"><div class="col-md-3"><b>UF de nascimento:&nbsp;</b><inep-output-text np-id="nomeUfNascimento" ng-model="c.espelho.ufNascimento" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div><div class="col-md-3"><b>Munic&iacute;pio de nascimento:&nbsp;</b><inep-output-text np-id="nomeMunicipioNascimento" ng-model="c.espelho.nascimentoMunicipio" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div></div></div><div tabindex="0" class="with-space-top"><br/><legend><b>Endere&ccedil;o residencial</b></legend><div class="row"><div class="col-md-12"><b>CEP:&nbsp;</b><inep-output-text np-id="cepFormatado" ng-model="c.espelho.cep" np-mask="99.999-999" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div class="row"><div class="col-md-5"><b>Endere&ccedil;o:&nbsp;</b><inep-output-text np-id="logradouro" ng-model="c.espelho.logradouro" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div><div class="col-md-3"><b>N&uacute;mero:&nbsp;</b><inep-output-text np-id="numeroEndereco" ng-model="c.espelho.residenciaNumero" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div><div class="col-md-4"><b>Complemento:&nbsp;</b><inep-output-text np-id="complemento" ng-model="c.espelho.complemento" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div class="row"><div class="col-md-5"><b>Bairro:&nbsp;</b><inep-output-text np-id="bairro" ng-model="c.espelho.bairro" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div><div class="col-md-4"><b>Munic&iacute;pio:&nbsp;</b><inep-output-text np-id="nomeMunicipioEndereco" ng-model="c.espelho.residenciaMunicipio" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div><div class="col-md-3"><b>UF:&nbsp;</b><inep-output-text np-id="nomeUfEndereco" ng-model="c.espelho.residenciaUf" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div></div><div tabindex="0" class="with-space-top"><br/><legend><b>Contato</b></legend><div class="row"><div class="col-md-6"><b>Telefone fixo:&nbsp;</b><inep-output-text np-id="telefoneFixo" ng-model="c.espelho.fixo" np-mask="(99) 9999-9999" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div><div class="col-md-6"><b>Celular:&nbsp;</b><inep-output-text np-id="telefoneMovel" ng-model="c.espelho.celular" np-mask="(99) 99999-9999" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div class="row"><div class="col-md-12"><b>E-mail:&nbsp;</b><inep-output-text np-id="email" ng-model="c.espelho.email" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div></div><div class="with-space-top"><br/><legend><b>Atendimento especializado</b></legend><div class="row"><div class="col-md-12"><b>Necessita de atendimento especializado para realização das provas:&nbsp;</b><inep-output-text np-id="possuiEspecializado" ng-model="c.possuiEspecializadoValue" np-empty-Value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div ng-if="c.possuiEspecializado()" class="row with-space-bottom"><div class="col-md-12"><ul><li ng-if="a.statusItem === c.constantes.MARCADO" ng-repeat="a in c.especializados"><label style="font-weight: normal;">{{ a.descricao }}</label><div ng-if="!!a.informacao" class="box-describe">{{ a.informacao }}</div><div ng-if="!!a.cid" class="with-space-bottom"><b>{{ a.cid }}</b></div><div ng-if="a.statusItem === c.constantes.MARCADO &amp;&amp; a.dependencia.regras.indexOf(&quot;RNE005&quot;) &gt; -1"><enem-regra005 ng-model="a" np-disabled="true" np-optional="true"></enem-regra005></div><div ng-if="!!a.statusLaudo"><b>Laudo:<span ng-if="a.statusLaudo === 1" style="color: green;"> Aprovado</span><span ng-if="a.statusLaudo === 6" style="color: green;"> Aprovado em edições anteriores</span><span ng-if="a.statusLaudo === 11 || a.statusLaudo === 10" style="color: red;"> Reprovado, mantido o atendimento</span><div ng-if="(a.statusLaudo === 11 || a.statusLaudo === 10) &amp;&amp; a.exibirCriterios" ng-repeat="r in a.textoReprovacao"><span style="color: red;">{{r}} <br></span></div><span ng-if="a.statusLaudo === a.ZERO || a.statusLaudo === 3" style="color: red;"> Reprovado por não atender o(s) seguinte(s) critério(s): <br> </span><div ng-if="a.statusLaudo === a.ZERO || a.statusLaudo === 3" ng-repeat="r in a.textoReprovacao"><span style="color: red;">{{r}} <br></span></div><span ng-if="a.statusLaudo === 2 || a.statusLaudo === 12" style="color: orange;"> Em An&aacute;lise</span></b></div></li></ul></div></div><div ng-if="c.possuiEspecializado()" class="row"><div class="col-sm-12"><p><b>Aux&iacute;lio que necessitar&aacute; para realiza&ccedil;&atilde;o da prova:</b></p></div><div class="col-sm-12"><ul><li ng-if="r.statusItemAdicional !== c.constantes.OCULTO" ng-repeat="r in c.recursosEspecializados">{{ r.descricao }}<b ng-if="r.codigo !== 30" class="{{ c.verificarCorCampoInformado(r.statusItem) }}">: {{ c.opcaoSimNao(r.statusItem) }}</b><div ng-if="r.informacao != null &amp;&amp; r.statusItem === c.constantes.MARCADO" class="box-describe">{{ r.informacao }}</div></li></ul></div></div></div><!----><!--.with-space-top--><!--  br/--><!--  legend: b Atendimento espec&iacute;fico--><!--  .row: .col-md-12--><!--    b Possui necessidade de atendimento específico:&nbsp;--><!--    inep-output-text(np-id=\'possuiEspecifico\',--><!--    ng-model=\'c.possuiEspecificoValue\',--><!--    np-empty-Value=\'{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}\')--><!----><!--  .row.with-space-bottom(ng-if=\'c.possuiEspecifico\'): .col-md-12--><!--    ul--><!--      li(ng-if=\'a.statusItem === c.constantes.MARCADO\', ng-repeat=\'a in c.especificos\')--><!--        label(style=\'font-weight: normal;\')--><!--          | {{ a.descricao }}--><!--        div(class=\'box-describe\', ng-if=\'!!a.informacao\') {{ a.informacao }}--><!--        div.with-space-bottom(ng-if=\'!!a.cid\'): b {{ a.cid }}--><!--        div(ng-if=\'a.statusItem === c.constantes.MARCADO && a.dependencia.regras.indexOf("RNE005") > -1\')--><!--          enem-regra005(ng-model=\'a\', np-disabled=\'true\', np-optional=\'true\')--><!--        div(ng-if=\'!!a.statusLaudo\')--><!--          b Laudo:--><!--            span(ng-if=\'a.statusLaudo === 1\', style=\'color: green;\')  Aprovado--><!--            span(ng-if=\'a.statusLaudo === 3\', style=\'color: red;\')  Reprovado--><!--            span(ng-if=\'a.statusLaudo === 2\', style=\'color: orange;\')  Em An&aacute;lise--><!----><!--  .row(ng-if=\'c.possuiRecursoEspecifico\')--><!--    .col-sm-12: p: b Aux&iacute;lio que necessitar&aacute; para realiza&ccedil;&atilde;o da prova:--><!--    .col-sm-12: ul--><!--      li(ng-if=\'r.statusItemAdicional !== c.constantes.OCULTO\', ng-repeat=\'r in c.recursosEspecificos\') {{ r.descricao }}--><!--        b(ng-if=\'r.codigo !== 30\', class=\'{{ c.verificarCorCampoInformado(r.statusItem) }}\') : {{ c.opcaoSimNao(r.statusItem) }}--><!--        div(ng-if=\'r.informacao != null && r.statusItem === c.constantes.MARCADO\', class=\'box-describe\') {{ r.informacao }}--><!-- include ./confirmarDados_doencaInfectocontagiosa--><!--include ./confirmarDados_nomeSocial--><!--include ../atendimentoRecursos/confirmacao/atendimento--><div tabindex="0" class="with-space-top"><br/><legend><b>Prova</b></legend><div class="row"><div class="col-md-12"><b>Nível de ensino escolhido para o qual quero a certificação:</b><inep-output-text np-id="liguaEstrangeira" ng-model="c.espelho.opcaoConclusao" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text><!--.row.with-space: b.col-md-8 Provas que farei no Encceja 2020:--><div class="row with-space"><b class="col-md-8">Provas que farei no Encceja 2026:<ul></ul><li ng-repeat="a in c.espelho.listaDisciplinas"><label style="font-weight: normal;">{{ a }}</label></li></b></div></div></div></div><div tabindex="0" class="with-space-top"><br/><legend><b>UF e cidade onde farei as provas:</b></legend><div class="row"><div class="col-md-9"><b>UF:&nbsp;</b><inep-output-text np-id="ufProva" ng-model="c.espelho.ufProva" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text>,<inep-output-text np-id="municipioProva" ng-model="c.espelho.cidadeProva" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div></div><div ng-if="c.espelho.ensinoMedio !== null" tabindex="0" class="with-space-top"><br/><legend><b>Instituição Certificadora onde solicitarei o certificado de conclusão ou a declaração parcial de proficiência se conseguir a nota mínima exigida:</b></legend><div class="row espacoLinha"><div class="col-md-3"><b>UF da instituição certificadora:</b><inep-output-text np-id="situacaoEnsinoMedio" ng-model="c.espelho.ufEntidadeCertificadora" np-empty-Value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div><div class="col-md-6"><b>Instituição:&nbsp;<inep-output-text np-id="ufEntidadeCertidicadora" ng-model="c.espelho.entidadeCertificadora" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></b></div></div></div><div ng-if="c.espelho.ausenciaDto.inAusente" tabindex="0" class="with-space-top"><br/><legend><b>Justificativa de ausência:</b></legend><div class="row espacoLinha"><div class="col-md-12"><inep-output-text np-id="justificativaAusencia" ng-model="c.espelho.ausenciaDto.justificativaAusencia.label" np-empty-Value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div></div></div></div><div class="panel panel-info hidden-print"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Junte-se a nós</h2></div><div class="panel-body"><div class="row"><div class="col-md-12"><p class="left"><strong>Faça parte do Conselho de Usuários de Serviços do INEP!</strong></p></div></div><div class="row"><div class="col-md-12"><p class="left"><strong>Acesse a plataforma, se cadastre e contribua com a melhoria dos nossos serviços.</strong></p></div></div><div class="row"><div style="padding-bottom: 10px" class="col-md-12"><button style="margin-left: 10px;" ng-click="c.openNewTab(\'https://conselhodeusuarios.cgu.gov.br/inicio\')" role="button" class="btn btn-primary">PARTICIPAR</button><button style="margin-left: 10px;" ng-click="c.openNewTab(\'https://www.gov.br/inep/pt-br/acesso-a-informacao/participacao-social/conselhos-e-orgaos-colegiados/conselho-de-usuarios\')" role="button" class="btn btn-primary">SAIBA MAIS</button></div></div></div></div><div class="clearfix"><ul class="pagination margin-bottom-none pull-right"><li class="primary"><button ng-click="c.imprimir()" role="button" class="btn btn-primary">Imprimir</button></li><li ng-if="c.exibeCancelarCarencia()" class="primary"><button ng-click="c.exibirModalCarencia()" role="button" class="btn btn-primary">Cancelar carência</button></li><li ng-if="c.exibeSolicitarCarencia()" class="primary"><button ng-click="c.navegarCarencia()" role="button" class="btn btn-primary">Solicitar carência</button></li></ul></div></div></div><div inep-modal="inep-modal" np-buttons="c.buttons" np-show="c.modalShow" np-id="modal" np-options="c.modalOptions" np-header="Aviso"><p tabindex="0">{{ c.modalMessage }}</p></div><div inep-modal="inep-modal" np-id="modalCarencia" np-buttons="c.modalCarencia.buttons" np-show="c.modalCarencia.show" np-options="c.modalCarencia.options" np-header="Aviso"><p tabindex="0">{{ c.modalCarencia.message }}</p></div><div inep-modal="inep-modal" np-id="modalExibirMensagem" np-buttons="c.modalExibirMensagem.buttons" np-show="c.modalExibirMensagem.show" np-options="c.modalExibirMensagem.options" np-header="Avaliar serviço"><p tabindex="0">{{ c.modalExibirMensagem.saudacao }}</p><p tabindex="0">{{ c.modalExibirMensagem.message }}</p></div><div inep-modal="inep-modal" np-buttons="c.modalSair.buttons" np-show="c.modalSair.show" np-id="modalSair" np-options="c.modalSair.options" np-header="Aviso"><p tabindex="0">{{ c.modalSair.saudacao }}</p><p tabindex="0">{{ c.modalSair.message }}</p></div></div></div></section></main>'),a.put("views/acompanhamento/justificativaAusencia.html",'<header role="banner"><h1 class="hide"> - </h1><nav role="navigation" aria-labelledby="#nav" ng-controller="NavigationBarController" class="navbar navbar-default navbar-fixed-top"><h2 id="nav" class="hide">Navegação Principal</h2><div class="container-fluid"><div class="navbar-header text-center"><button type="button" data-toggle="offcanvas" class="navbar-toggle collapsed left"><span class="sr-only">Toggle navigation</span><span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span></button><div aria-label="Bem vindo ao INEP" class="navbar-brand"><img src="images/logo_inep.svg" alt="Instituto Nacional de Estudos e Pesquisas Educacionais Anísio Teixeira"/></div><button type="button" data-toggle="collapse" data-target="#navbar-collapse" class="navbar-toggle collapsed right p-n"><span class="sr-only">Toggle navigation</span><i class="fa fa-gear text-white"></i></button></div><!--#navbar-collapse.collapse.navbar-collapse--><!--  ul.nav.navbar-nav--><!--    li.active--><!--      span.logo-inep.h3.m-n.font-700(data-toggle=\'tooltip\', data-placement=\'bottom\', title=project.name) #{project.abbr}--><!----><!--  ul.nav.navbar-nav.navbar-right--><!--    if !login--><!--      li--><!--        span(data-toggle=\'dropdown\') #[i.fa.fa-user] Participante: {{nomeParticipanteLogado}}--><!--    li--><!--      a.contrast(href=\'#\', inep-contrast="", data-toggle=\'tooltip\', data-placement=\'bottom\', aria-label=\'Contraste\') #[i.fa.fa-adjust]--><script type="text/ng-template" id="warning-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Você ainda está aí?</h3></div><div idle-countdown="countdown" class="modal-body"><uib-progressbar max="30" value="countdown" animate="true" class="progress-striped active"></uib-progressbar>Sua sessão será encerrada em {{countdown}} segundos.</div></div></script><script type="text/ng-template" id="timedout-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Sess&atilde;o encerrada.</h3></div><div class="modal-body"><p></p>Sua sess&atilde;o foi encerrada por inatividade.</div></div></script></div></nav></header><main role="main"><section class="login"><h1 class="hide">Painel de entrada</h1><div ng-controller="AcompanhamentoController as c" ng-init="c.init()"><div id="sideBar" class="col-sm-3 col-md-2 sidebar sidebar-offcanvas"><section><header></header><nav aria-labeledby="#nav"><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeEspelho()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" ng-click="c.navegarEspelho()" ng-if="!c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Acompanhar inscri&ccedil;&atilde;o {{c.anoEdicao}}</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.downloadDeclaracao()", ng-if="!c.isLoginLocalProva && c.menu.exibeDeclaracaoComparecimento()") Declara&ccedil;&atilde;o Comparecimento--><a style="cursor: pointer" ng-click="c.downloadDeclaracao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Declara&ccedil;&atilde;o Comparecimento</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarCartaoConfirmacao()", ng-if="!c.isLoginLocalProva && !c.menu.exibeCartaoConfirmacao()") Local de Prova/Cart&atilde;o Confirma&ccedil;&atilde;o--><a style="cursor: pointer" ng-click="c.navegarCartaoConfirmacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Local de Prova/Cart&atilde;o Confirma&ccedil;&atilde;o</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarDoencaInfectocontagiosa()", ng-if="!c.isLoginLocalProva && c.menu.exibeDoencaInfectocontagiosa()") Doenças Infectocontagiosas--><a style="cursor: pointer" ng-click="c.navegarDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuDoencaInfectoContagiosaVisivel.menuDoencaInfectoContagiosaEnabled" class="ng-scope">Doenças Infectocontagiosas</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarResultadoDoencaInfectocontagiosa()", ng-if="!c.isLoginLocalProva && c.menu.exibeResultadoDoencaInfectocontagiosa()") Resultado de Doenças Infectocontagiosas--><a style="cursor: pointer" ng-click="c.navegarResultadoDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuResultadoDoencaInfectoContagiosaVisivel.menuResultadoDoencaInfectoContagiosaEnabled" class="ng-scope">Resultado de Doenças Infectocontagiosas</a></li><li class="ng-scope"><a style="cursor: pointer" ng-click="c.navegarReaplicacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeReaplicacao() || c.menu.exibeReaplicacaoResultado()" class="ng-scope">Solicita&ccedil;&atilde;o de Reaplica&ccedil;&atilde;o</a><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarReaplicacao()", ng-if="!c.isLoginLocalProva && c.solicitarEnccejaReaplicacaoVisivel.exibirSolicitarEnccejaReaplicacaoEnabled") Registro de Ocorr&ecirc;ncias de Aplica&ccedil;&atilde;o--></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" class="ng-scope">Alterar dados</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarDadosPessoais()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeAlterarDadosInscricao()" class="ng-scope">Informa&ccedil;&otilde;es pessoais</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope"><!--ng-click="c.navegarAtendimentosEspecializados()",--><!--ng-if="!c.isLoginLocalProva && c.menu.exibeAlterarDadosInscricao()")-->Atendimento Especializado</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 40px" ng-click="c.navegarAtendimentosEspecializados()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope">Solicitar / Alterar Solicitação</a><!--ng-if="!c.isLoginLocalProva && false") Atendimento Especializado--></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer; padding-left: 30px", ng-click="c.navegarMunicipioProva()", ng-if="!c.isLoginLocalProva && c.menu.exibeAlterarDadosInscricao()") Informa&ccedil;&otilde;es de prova--><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarMunicipioProva()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuInformacoesProvaVisivel.inscricaoEmAndamento" class="ng-scope">Informa&ccedil;&otilde;es de prova</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer; padding-left: 30px", ng-click="c.navegarJustificativaAusencia()", ng-if="!c.isLoginLocalProva && c.menu.exibeAcompanhamentoJustificativa()") Justificativa de aus&ecirc;ncia--><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarJustificativaAusencia()" ng-if="c.validarExibicaoAcompanhamentoJustific()" class="ng-scope">Justificativa de aus&ecirc;ncia</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarContato()" class="ng-scope">Contato</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; false" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="atualizarSenha" class="ng-scope">Senha</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeLaudoMedico() && !!c.menuRecursoLaudoMedico")--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuRecursoLaudoMedico" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarLaudoMedico()" class="ng-scope">Recurso Laudo M&eacute;dico</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeTratamentoSocial()")--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuTratamentoNomeSocialVisivel.menuTratamentoNomeSocialEnabled" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="nomeSocial" class="ng-scope">Tratamento pelo Nome Social</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeReenvioTratamentoSocial()") verificar se eh recurso ou resultado--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.recursoMenuTratamentoNomeSocialVisivel.recursoMenuTratamentoNomeSocialEnabled &amp;&amp; !!c.menuRecursoNomeSocial" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="reenvioNomeSocial" class="ng-scope">Recurso Nome Social</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menu.exibeBoletoCobranca()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="boletoCobranca" class="ng-scope">Boleto de Cobrança</a></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultados()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" class="ng-scope">Resultado</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2017()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2017" class="ng-scope">ENCCEJA 2017</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2018()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2018" class="ng-scope">ENCCEJA 2018</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2019()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2019" class="ng-scope">ENCCEJA 2019</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2020()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2020" class="ng-scope">ENCCEJA 2020</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2022()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2022" class="ng-scope">ENCCEJA 2022</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2023()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2023" class="ng-scope">ENCCEJA 2023</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2024()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2024" class="ng-scope">ENCCEJA 2024</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2025()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2025" class="ng-scope">ENCCEJA 2025</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2026()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2026" class="ng-scope">ENCCEJA 2026</a></li></ul><ul inep-sidebar="inep-sidebar" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" ng-click="c.sair()" class="ng-scope">Sair</a></li></ul></nav></section></div><div class="col-sm-9 col-sm-offset-3 col-md-10 col-md-offset-2"><div class="panel-box ng-scope"><div ng-controller="AcompanharJustificativaAusenciaController as c" ng-init="init()"><header><!--.page-header.with-space-top: h1.h3 Inscri&ccedil;&atilde;o > ENCCEJA {{ c.anoEdicao }} #[small Justificativa de Ausência ]--><div class="page-header with-space-top"><h1 class="h3">Inscri&ccedil;&atilde;o > <small>Justificativa de Ausência </small></h1></div></header><div class="row"><div class="col-md-12"><form autocomplete="off" inep-message-bag="inep-message-bag" message-bag-header-error="O formulário abaixo está inválido pelos seguintes erros:" name="informacoesPessoaisForm" novalidate="true" role="form"><div class="panel panel-info"><div tabindex="0" class="panel-heading"><!--h2.h4.panel-title(text-left, text-primary) Acompanhar Justificativa de Ausência Encceja 2019--><!--h2.h4.panel-title(text-left, text-primary) Acompanhar Justificativa de Ausência Encceja {{ c.dados.anoProjetoJustificaAusencia + 1 }}--><h2 text-left="text-left" text-primary="text-primary" class="h4 panel-title">Acompanhar Justificativa de Ausência Encceja {{ c.anoEdicao }}</h2></div><div class="panel-body"><dd style="padding-left: 15px"><ul></ul><li ng-if="!c.dados.eventos.resultadoSolicitacaoAberto">O resultado da sua justificativa de ausência será divulgado aqui na Página do Participante.</li><li>Se a justificativa de ausência for reprovada, você poderá solicitar recurso na data prevista no edital do Exame, disponível no endereço&ensp;<a target="_blank" href="https://www.gov.br/inep/pt-br/centrais-de-conteudo/legislacao/encceja">https://www.gov.br/inep/pt-br/centrais-de-conteudo/legislacao/encceja.</a></li><li>A aprovação da justificativa de ausência no Encceja Nacional 2025 não significa que a inscrição para o Encceja Nacional 2026 foi realizada.</li><li>A inscrição do participante deve ser realizada no endereço&ensp;<a target="_blank" href="http://enccejanacional.inep.gov.br/encceja">enccejanacional.inep.gov.br/encceja</a>, conforme cronograma disponível no edital do Exame, disponível no endereço&ensp;<a target="_blank" href="https://www.gov.br/inep/pt-br/areas-de-atuacao/avaliacao-e-exames-educacionais/encceja">https://www.gov.br/inep/pt-br/areas-de-atuacao/avaliacao-e-exames-educacionais/encceja</a>.</li></dd><div tabindex="0" class="with-space-top"><br/><legend><b>Dados pessoais</b></legend><div class="row"><div class="col-md-3"><b>CPF:&nbsp;</b><inep-output-text np-id="cpfFormatado" ng-model="c.dados.dadosPessoais.cpf" np-mask="999.999.999-99" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div><div class="col-md-6"><b>Nome:&nbsp;</b><inep-output-text np-id="nome" ng-model="c.dados.dadosPessoais.nome" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div><div class="col-md-3"><b>Data de nascimento:&nbsp;</b><inep-output-text np-id="dataNascimento" ng-model="c.dataDeNascimento" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div class="row"><div class="col-md-6"><b>Nome da m&atilde;e:&nbsp;</b><inep-output-text np-id="nomeDaMae" ng-model="c.dados.dadosPessoais.nomeMae" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div></div><div ng-if="!!c.dados.dadosRecurso" tabindex="0" class="with-space-top"><br/><legend><b ng-if="c.dados.eventos.resultadoRecursoAberto">Recurso {{c.dados.dadosRecurso.justificativa.txSituacao}}</b><b ng-if="!c.dados.eventos.resultadoRecursoAberto">Recurso aguardando análise</b></legend><div ng-if="(c.dados.dadosRecurso.criterios.length &gt; 0 || c.dados.dadosRecurso.justificativa.coMotivo == 14) &amp;&amp; c.dados.eventos.resultadoRecursoAberto" class="row"><!--.col-md-3--><!--    b Data da an&aacutelise:&nbsp;--><!--    inep-output-text(np-id="dataAnalise", ng-model=\'c.dataAnaliseRecurso\', np-empty-value=\'{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}\')--><div class="col-md-9"><b>Situa&ccedil;&atilde;o:&nbsp;</b><inep-output-text np-id="nome" ng-model="c.dados.dadosRecurso.justificativa.txSituacao" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div ng-if="(c.dados.dadosRecurso.criterios.length &gt; 0 || c.dados.dadosRecurso.justificativa.coMotivo == 14) &amp;&amp; c.dados.eventos.resultadoRecursoAberto" class="row"><div class="col-md-12"><b>Motivos:&nbsp;</b><dd><ul><li ng-repeat="a in c.dados.dadosRecurso.criterios">{{a}}</li><li ng-if="c.dados.dadosRecurso.justificativa.coMotivo == 14">Sua justificativa de ausência para o Encceja 2025 não atende aos critérios estabelecidos no Edital do Encceja, disponível em&nbsp;<a target="_blank" href="https://www.gov.br/inep/pt-br/centrais-de-conteudo/legislacao/encceja">https://www.gov.br/inep/pt-br/centrais-de-conteudo/legislacao/encceja.</a></li></ul></dd></div></div></div><div ng-if="!!c.dados.dadosRecurso" tabindex="0" class="with-space-top"><br/><legend><b>Recurso</b></legend><div class="row"><div class="col-md-3"><b>Data do envio:&nbsp;</b><!--inep-output-text(np-id="dtAnalise", ng-model=\'c.dataJustificativa\', np-empty-value=\'{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}\')--><inep-output-text np-id="dtAnalise" ng-model="c.dataJustificativaRecurso" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div class="row"><div class="col-md-9"><!--b Qual a justificativa para a sua aus&ecirc;ncia ao Encceja 2019?&nbsp;--><!--b Qual a justificativa para a sua aus&ecirc;ncia ao Encceja {{ c.dados.anoProjetoJustificaAusencia }}?&nbsp;--><b>Qual a justificativa para a sua aus&ecirc;ncia ao Encceja {{ c.anoEdicao }}?&nbsp;</b><inep-output-text np-id="nome" ng-model="c.motivoSelecionadoRecurso.label" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div class="row"><div class="col-sm-12"><div class="col-sm-6"><div ng-if="!!c.dados.dadosRecurso.documentos.primeiroDocumento"><table class="table table-striped table-bordered table-hover table-condensed table-responsive table-anexo-documento"><tr><th>Arquivo</th><th>Ações</th></tr><tr><td>{{c.motivoSelecionadoRecurso.arquivos[0].label}}</td><td><a ng-click="$event.stopPropagation(); c.downloadArquivo(1, 1);" href=""><i style="margin:3px; font-size: 21px" title="Download" aria-hidden="true" class="fa fa-download"></i></a></td></tr><tr ng-if="!!c.dados.dadosRecurso.documentos.segundoDocumento"><td>{{c.motivoSelecionadoRecurso.arquivos[1].label}}</td><td><a ng-click="$event.stopPropagation(); c.downloadArquivo(1, 2);" href=""><i style="margin:3px; font-size: 21px" title="Download" aria-hidden="true" class="fa fa-download"></i></a></td></tr></table></div></div></div></div></div><div tabindex="0" class="with-space-top"><br/><legend><b ng-if="c.dados.eventos.resultadoSolicitacaoAberto">Justificativa {{c.dados.dadosJustificativa.justificativa.txSituacao}}</b><b ng-if="!c.dados.eventos.resultadoSolicitacaoAberto">Justificativa aguardando análise</b></legend><div ng-if="(c.dados.dadosJustificativa.criterios.length &gt; 0 || c.dados.dadosJustificativa.justificativa.coMotivo == 14) &amp;&amp; c.dados.eventos.resultadoSolicitacaoAberto" class="row"><!--.col-md-3--><!--    b Data da an&aacutelise:&nbsp;--><!--    inep-output-text(np-id="dataAnalise", ng-model=\'c.dataAnalise\', np-empty-value=\'{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}\')--><div class="col-md-9"><b>Situa&ccedil;&atilde;o:&nbsp;</b><inep-output-text np-id="nome" ng-model="c.dados.dadosJustificativa.justificativa.txSituacao" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div ng-if="(c.dados.dadosJustificativa.criterios.length &gt; 0 || c.dados.dadosJustificativa.justificativa.coMotivo == 14) &amp;&amp; c.dados.eventos.resultadoSolicitacaoAberto" class="row"><div class="col-md-12"><b>Motivos:&nbsp;</b><dd><ul><li ng-repeat="a in c.dados.dadosJustificativa.criterios">{{a}}</li><li ng-if="c.dados.dadosJustificativa.justificativa.coMotivo == 14">Sua justificativa de ausência para o Encceja 2025 não atende aos critérios estabelecidos no Edital do Encceja, disponível em&nbsp;<a target="_blank" href="https://www.gov.br/inep/pt-br/centrais-de-conteudo/legislacao/encceja">https://www.gov.br/inep/pt-br/centrais-de-conteudo/legislacao/encceja.</a></li></ul></dd></div></div></div><div tabindex="0" class="with-space-top"><br/><legend><b>Justificativa de Aus&ecirc;ncia</b></legend><div class="row"><div class="col-md-3"><b>Data do envio:&nbsp;</b><inep-output-text np-id="dtAnalise" ng-model="c.dataJustificativa" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div class="row"><div class="col-md-9"><!--b Qual a justificativa para a sua aus&ecirc;ncia ao Encceja 2019?&nbsp;--><!--b Qual a justificativa para a sua aus&ecirc;ncia ao Encceja {{ c.dados.anoProjetoJustificaAusencia }}?&nbsp;--><b>Qual a justificativa para a sua aus&ecirc;ncia ao Encceja {{ c.anoEdicao }}?&nbsp;</b><inep-output-text np-id="nome" ng-model="c.motivoSelecionadoJustificativa.label" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div class="row"><div class="col-sm-12"><div class="col-sm-6"><div ng-if="!!c.dados.dadosJustificativa.documentos.primeiroDocumento"><table class="table table-striped table-bordered table-hover table-condensed table-responsive table-anexo-documento"><tr><th>Arquivo</th><th>Ações</th></tr><tr><td>{{c.motivoSelecionadoJustificativa.arquivos[0].label}}</td><td><a ng-click="$event.stopPropagation(); c.downloadArquivo(0, 1);" href=""><i style="margin:3px; font-size: 21px" title="Download" aria-hidden="true" class="fa fa-download"></i></a></td></tr><tr ng-if="!!c.dados.dadosJustificativa.documentos.segundoDocumento"><td>{{c.motivoSelecionadoJustificativa.arquivos[1].label}}</td><td><a ng-click="$event.stopPropagation(); c.downloadArquivo(0, 2);" href=""><i style="margin:3px; font-size: 21px" title="Download" aria-hidden="true" class="fa fa-download"></i></a></td></tr></table></div></div></div></div></div><div class="clearfix"><ul class="pagination margin-bottom-none pull-right"><li class="primary"><button ng-click="c.imprimir()" role="button" class="btn btn-primary">Imprimir</button></li><li class="primary"><button ng-if="c.dados.eventos.recursoAberto &amp;&amp; c.dados.dadosJustificativa.justificativa.tpSituacao == 3" ng-click="c.solicitarRecurso()" role="button" class="btn btn-primary">Solicitar recurso</button></li></ul></div></div></div></form></div></div></div></div><div inep-modal="inep-modal" np-buttons="c.buttons" np-show="c.modalShow" np-id="modal" np-options="c.modalOptions" np-header="Aviso"><p tabindex="0">{{ c.modalMessage }}</p></div><div inep-modal="inep-modal" np-id="modalCarencia" np-buttons="c.modalCarencia.buttons" np-show="c.modalCarencia.show" np-options="c.modalCarencia.options" np-header="Aviso"><p tabindex="0">{{ c.modalCarencia.message }}</p></div><div inep-modal="inep-modal" np-id="modalExibirMensagem" np-buttons="c.modalExibirMensagem.buttons" np-show="c.modalExibirMensagem.show" np-options="c.modalExibirMensagem.options" np-header="Avaliar serviço"><p tabindex="0">{{ c.modalExibirMensagem.saudacao }}</p><p tabindex="0">{{ c.modalExibirMensagem.message }}</p></div><div inep-modal="inep-modal" np-buttons="c.modalSair.buttons" np-show="c.modalSair.show" np-id="modalSair" np-options="c.modalSair.options" np-header="Aviso"><p tabindex="0">{{ c.modalSair.saudacao }}</p><p tabindex="0">{{ c.modalSair.message }}</p></div></div></div></section></main>'),
a.put("views/acompanhamento/laudoMedico.html",'<header role="banner"><h1 class="hide"> - </h1><nav role="navigation" aria-labelledby="#nav" ng-controller="NavigationBarController" class="navbar navbar-default navbar-fixed-top"><h2 id="nav" class="hide">Navegação Principal</h2><div class="container-fluid"><div class="navbar-header text-center"><button type="button" data-toggle="offcanvas" class="navbar-toggle collapsed left"><span class="sr-only">Toggle navigation</span><span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span></button><div aria-label="Bem vindo ao INEP" class="navbar-brand"><img src="images/logo_inep.svg" alt="Instituto Nacional de Estudos e Pesquisas Educacionais Anísio Teixeira"/></div><button type="button" data-toggle="collapse" data-target="#navbar-collapse" class="navbar-toggle collapsed right p-n"><span class="sr-only">Toggle navigation</span><i class="fa fa-gear text-white"></i></button></div><!--#navbar-collapse.collapse.navbar-collapse--><!--  ul.nav.navbar-nav--><!--    li.active--><!--      span.logo-inep.h3.m-n.font-700(data-toggle=\'tooltip\', data-placement=\'bottom\', title=project.name) #{project.abbr}--><!----><!--  ul.nav.navbar-nav.navbar-right--><!--    if !login--><!--      li--><!--        span(data-toggle=\'dropdown\') #[i.fa.fa-user] Participante: {{nomeParticipanteLogado}}--><!--    li--><!--      a.contrast(href=\'#\', inep-contrast="", data-toggle=\'tooltip\', data-placement=\'bottom\', aria-label=\'Contraste\') #[i.fa.fa-adjust]--><script type="text/ng-template" id="warning-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Você ainda está aí?</h3></div><div idle-countdown="countdown" class="modal-body"><uib-progressbar max="30" value="countdown" animate="true" class="progress-striped active"></uib-progressbar>Sua sessão será encerrada em {{countdown}} segundos.</div></div></script><script type="text/ng-template" id="timedout-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Sess&atilde;o encerrada.</h3></div><div class="modal-body"><p></p>Sua sess&atilde;o foi encerrada por inatividade.</div></div></script></div></nav></header><main role="main"><section class="login"><h1 class="hide">Painel de entrada</h1><div ng-controller="AcompanhamentoController as c" ng-init="c.init()"><div id="sideBar" class="col-sm-3 col-md-2 sidebar sidebar-offcanvas"><section><header></header><nav aria-labeledby="#nav"><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeEspelho()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" ng-click="c.navegarEspelho()" ng-if="!c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Acompanhar inscri&ccedil;&atilde;o {{c.anoEdicao}}</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.downloadDeclaracao()", ng-if="!c.isLoginLocalProva && c.menu.exibeDeclaracaoComparecimento()") Declara&ccedil;&atilde;o Comparecimento--><a style="cursor: pointer" ng-click="c.downloadDeclaracao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Declara&ccedil;&atilde;o Comparecimento</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarCartaoConfirmacao()", ng-if="!c.isLoginLocalProva && !c.menu.exibeCartaoConfirmacao()") Local de Prova/Cart&atilde;o Confirma&ccedil;&atilde;o--><a style="cursor: pointer" ng-click="c.navegarCartaoConfirmacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Local de Prova/Cart&atilde;o Confirma&ccedil;&atilde;o</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarDoencaInfectocontagiosa()", ng-if="!c.isLoginLocalProva && c.menu.exibeDoencaInfectocontagiosa()") Doenças Infectocontagiosas--><a style="cursor: pointer" ng-click="c.navegarDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuDoencaInfectoContagiosaVisivel.menuDoencaInfectoContagiosaEnabled" class="ng-scope">Doenças Infectocontagiosas</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarResultadoDoencaInfectocontagiosa()", ng-if="!c.isLoginLocalProva && c.menu.exibeResultadoDoencaInfectocontagiosa()") Resultado de Doenças Infectocontagiosas--><a style="cursor: pointer" ng-click="c.navegarResultadoDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuResultadoDoencaInfectoContagiosaVisivel.menuResultadoDoencaInfectoContagiosaEnabled" class="ng-scope">Resultado de Doenças Infectocontagiosas</a></li><li class="ng-scope"><a style="cursor: pointer" ng-click="c.navegarReaplicacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeReaplicacao() || c.menu.exibeReaplicacaoResultado()" class="ng-scope">Solicita&ccedil;&atilde;o de Reaplica&ccedil;&atilde;o</a><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarReaplicacao()", ng-if="!c.isLoginLocalProva && c.solicitarEnccejaReaplicacaoVisivel.exibirSolicitarEnccejaReaplicacaoEnabled") Registro de Ocorr&ecirc;ncias de Aplica&ccedil;&atilde;o--></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" class="ng-scope">Alterar dados</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarDadosPessoais()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeAlterarDadosInscricao()" class="ng-scope">Informa&ccedil;&otilde;es pessoais</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope"><!--ng-click="c.navegarAtendimentosEspecializados()",--><!--ng-if="!c.isLoginLocalProva && c.menu.exibeAlterarDadosInscricao()")-->Atendimento Especializado</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 40px" ng-click="c.navegarAtendimentosEspecializados()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope">Solicitar / Alterar Solicitação</a><!--ng-if="!c.isLoginLocalProva && false") Atendimento Especializado--></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer; padding-left: 30px", ng-click="c.navegarMunicipioProva()", ng-if="!c.isLoginLocalProva && c.menu.exibeAlterarDadosInscricao()") Informa&ccedil;&otilde;es de prova--><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarMunicipioProva()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuInformacoesProvaVisivel.inscricaoEmAndamento" class="ng-scope">Informa&ccedil;&otilde;es de prova</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer; padding-left: 30px", ng-click="c.navegarJustificativaAusencia()", ng-if="!c.isLoginLocalProva && c.menu.exibeAcompanhamentoJustificativa()") Justificativa de aus&ecirc;ncia--><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarJustificativaAusencia()" ng-if="c.validarExibicaoAcompanhamentoJustific()" class="ng-scope">Justificativa de aus&ecirc;ncia</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarContato()" class="ng-scope">Contato</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; false" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="atualizarSenha" class="ng-scope">Senha</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeLaudoMedico() && !!c.menuRecursoLaudoMedico")--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuRecursoLaudoMedico" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarLaudoMedico()" class="ng-scope">Recurso Laudo M&eacute;dico</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeTratamentoSocial()")--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuTratamentoNomeSocialVisivel.menuTratamentoNomeSocialEnabled" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="nomeSocial" class="ng-scope">Tratamento pelo Nome Social</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeReenvioTratamentoSocial()") verificar se eh recurso ou resultado--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.recursoMenuTratamentoNomeSocialVisivel.recursoMenuTratamentoNomeSocialEnabled &amp;&amp; !!c.menuRecursoNomeSocial" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="reenvioNomeSocial" class="ng-scope">Recurso Nome Social</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menu.exibeBoletoCobranca()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="boletoCobranca" class="ng-scope">Boleto de Cobrança</a></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultados()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" class="ng-scope">Resultado</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2017()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2017" class="ng-scope">ENCCEJA 2017</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2018()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2018" class="ng-scope">ENCCEJA 2018</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2019()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2019" class="ng-scope">ENCCEJA 2019</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2020()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2020" class="ng-scope">ENCCEJA 2020</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2022()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2022" class="ng-scope">ENCCEJA 2022</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2023()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2023" class="ng-scope">ENCCEJA 2023</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2024()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2024" class="ng-scope">ENCCEJA 2024</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2025()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2025" class="ng-scope">ENCCEJA 2025</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2026()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2026" class="ng-scope">ENCCEJA 2026</a></li></ul><ul inep-sidebar="inep-sidebar" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" ng-click="c.sair()" class="ng-scope">Sair</a></li></ul></nav></section></div><div class="col-sm-9 col-sm-offset-3 col-md-10 col-md-offset-2"><div class="panel-box ng-scope"><header><div class="page-header with-space-top"><h1 class="h3">Inscri&ccedil;&atilde;o > ENCCEJA <small>Laudo m&eacute;dico</small></h1></div></header><div class="row"><div class="col-md-12"><form name="laudoMedicoForm" role="form" novalidate="true" autocomplete="off" inep-message-bag="inep-message-bag" message-bag-header-error="O formulário abaixo está inválido pelos seguintes erros:" ng-controller="LaudoMedicoController as c" ng-init="c.recuperarDadosLaudo()"><div class="panel"><div class="panel-body"><div class="row"><div class="col-md-12"><legend><b tabindex="0" focus-me="focus-me">Envio de recurso laudo(s) reprovado(s)</b></legend></div></div></div></div><div ng-if="!!c.laudos &amp;&amp; c.laudos.length &gt; 0" class="panel panel-info"><div tabindex="0" class="panel-heading"><h1 class="h4 panel-title text-left text-primary">Documenta&ccedil;&atilde;o comprobat&oacute;ria</h1></div><div class="panel-body"><div class="row with-space-top"><div class="col-md-12"><enem-fieldset np-tab="0"><span class="attention-label">Aten&ccedil;&atilde;o:</span><span ng-bind-html="c.trust(c.constantes.INSCRICAO.TEXTO_TELA_LAUDOS_MSG_I)" class="text-justify"></span></enem-fieldset></div><div class="col-md-12"><enem-fieldset np-tab="0"><span class="attention-label">Aten&ccedil;&atilde;o:</span><span class="text-justify"> {{c.mensagens.MSG_UPLOAD_LAUDO}}</span></enem-fieldset></div></div><div class="row with-space-top"><div ng-repeat="laudo in c.laudos"><div class="row"><div class="col-md-10 col-md-offset-1"><label>{{ laudo.nomeItem }} &nbsp;&nbsp;</label><!--span(ng-if=\'laudo.situacaoLaudo != "Em análise"\' style=\'color: red;\') ({{laudo.situacaoLaudo}})--><!--span(ng-if=\'laudo.situacaoLaudo == "Em análise"\' style=\'color: darkOrange;\') ({{laudo.situacaoLaudo}})--></div></div><div class="row with-space-bottom"><div class="col-md-10 col-md-offset-1"><!--i(class="fa fa-check-circle fa-2x icon-upload icon-sucess", ng-if="laudo.possuiArquivo")--><!--i(class="fa fa-times-circle fa-2x icon-upload icon-error", ng-if="!laudo.possuiArquivo")--><inep-input-text ng-if="!!laudo.cid" np-id="cid_{{laudo.cid.id}}" np-label="CID" ng-model="laudo.cid.codigo" np-size="2" np-optional="false" np-maxlength="7" inep-validator="c.validarCid(laudo)" to-upper-case="to-upper-case" np-on-blur="c.consultarCid(laudo)" np-placeholder="Informe o CID aqui"></inep-input-text><inep-input-text ng-if="!!laudo.cid" np-id="cid_desc_{{laudo.cid.id}}" np-label="Descrição" ng-model="laudo.cid.descricao" np-size="7" np-maxlength="100" np-optional="true" np-readonly="true"></inep-input-text><button type="button" ng-if="!!laudo.cid &amp;&amp; c.mudouCid(laudo.cid)" ng-click="c.alterarCid(laudo)" class="btn btn-default align-button-upload">Salvar CID</button></div></div><div class="row with-space-bottom"><div class="col-md-10 col-md-offset-1"><inep-input-file np-id="upload_{{laudo.codigoItem}}" np-label="Laudo: " np-value="laudo.arquivo" np-max-file-size="c.maxFileSize" np-show-icon="true" np-content-types="c.contentTypes" np-size="6" np-max-file-message="Tamanho de arquivo inválido." np-content-type-message="Formato de arquivo inválido." np-disabled="" np-on-change="c.showPreview(laudo)" np-empty-message="{{c.mensagens.MSG_ARQUIVO_VAZIO}}"></inep-input-file><!--button(type="button",--><!--ng-if="!!laudo.possuiArquivo && laudo.situacaoLaudo == \'Em análise\'",--><!--class="btn btn-default align-button-upload",--><!--ng-click="c.download(laudo.codigoItem)") Download--><button type="button" id="botaoEnvio_{{laudo.codigoItem}}" ng-click="c.enviarLaudo(laudo)" ng-disabled="" ng-if="c.isFileValid(laudo, c.maxFileSize, c.contentTypes)" class="btn btn-default align-button-upload">Enviar</button></div></div><div class="row with-space-bottom"><div class="col-md-10 col-md-offset-1"><span ng-show="!!laudo.msgReenvioLaudo"><inep-output-text np-id="msgReenvioLaudo_{{laudo.codigoItem}}" ng-model="laudo.msgReenvioLaudo"></inep-output-text></span></div></div><div class="row with-space-bottom"><div id="preview_{{laudo.codigoItem}}" ng-if="!!laudo.blob" class="col-md-10 col-md-offset-1"><img style="width:220px; height: 220px;" ng-src="{{laudo.blob}}"/></div></div></div></div></div></div></form></div></div></div><div inep-modal="inep-modal" np-buttons="c.buttons" np-show="c.modalShow" np-id="modal" np-options="c.modalOptions" np-header="Aviso"><p tabindex="0">{{ c.modalMessage }}</p></div><div inep-modal="inep-modal" np-id="modalCarencia" np-buttons="c.modalCarencia.buttons" np-show="c.modalCarencia.show" np-options="c.modalCarencia.options" np-header="Aviso"><p tabindex="0">{{ c.modalCarencia.message }}</p></div><div inep-modal="inep-modal" np-id="modalExibirMensagem" np-buttons="c.modalExibirMensagem.buttons" np-show="c.modalExibirMensagem.show" np-options="c.modalExibirMensagem.options" np-header="Avaliar serviço"><p tabindex="0">{{ c.modalExibirMensagem.saudacao }}</p><p tabindex="0">{{ c.modalExibirMensagem.message }}</p></div><div inep-modal="inep-modal" np-buttons="c.modalSair.buttons" np-show="c.modalSair.show" np-id="modalSair" np-options="c.modalSair.options" np-header="Aviso"><p tabindex="0">{{ c.modalSair.saudacao }}</p><p tabindex="0">{{ c.modalSair.message }}</p></div></div></div></section></main>'),a.put("views/acompanhamento/localDeProva.html",'<header role="banner"><h1 class="hide"> - </h1><nav role="navigation" aria-labelledby="#nav" ng-controller="NavigationBarController" class="navbar navbar-default navbar-fixed-top"><h2 id="nav" class="hide">Navegação Principal</h2><div class="container-fluid"><div class="navbar-header text-center"><button type="button" data-toggle="offcanvas" class="navbar-toggle collapsed left"><span class="sr-only">Toggle navigation</span><span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span></button><div aria-label="Bem vindo ao INEP" class="navbar-brand"><img src="images/logo_inep.svg" alt="Instituto Nacional de Estudos e Pesquisas Educacionais Anísio Teixeira"/></div><button type="button" data-toggle="collapse" data-target="#navbar-collapse" class="navbar-toggle collapsed right p-n"><span class="sr-only">Toggle navigation</span><i class="fa fa-gear text-white"></i></button></div><!--#navbar-collapse.collapse.navbar-collapse--><!--  ul.nav.navbar-nav--><!--    li.active--><!--      span.logo-inep.h3.m-n.font-700(data-toggle=\'tooltip\', data-placement=\'bottom\', title=project.name) #{project.abbr}--><!----><!--  ul.nav.navbar-nav.navbar-right--><!--    if !login--><!--      li--><!--        span(data-toggle=\'dropdown\') #[i.fa.fa-user] Participante: {{nomeParticipanteLogado}}--><!--    li--><!--      a.contrast(href=\'#\', inep-contrast="", data-toggle=\'tooltip\', data-placement=\'bottom\', aria-label=\'Contraste\') #[i.fa.fa-adjust]--><script type="text/ng-template" id="warning-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Você ainda está aí?</h3></div><div idle-countdown="countdown" class="modal-body"><uib-progressbar max="30" value="countdown" animate="true" class="progress-striped active"></uib-progressbar>Sua sessão será encerrada em {{countdown}} segundos.</div></div></script><script type="text/ng-template" id="timedout-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Sess&atilde;o encerrada.</h3></div><div class="modal-body"><p></p>Sua sess&atilde;o foi encerrada por inatividade.</div></div></script></div></nav></header><main role="main"><section class="login"><h1 class="hide">Painel de entrada</h1><div ng-controller="AcompanhamentoController as c" ng-init="c.init()"><div id="sideBar" class="col-sm-3 col-md-2 sidebar sidebar-offcanvas"><section><header></header><nav aria-labeledby="#nav"><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeEspelho()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" ng-click="c.navegarEspelho()" ng-if="!c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Acompanhar inscri&ccedil;&atilde;o {{c.anoEdicao}}</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.downloadDeclaracao()", ng-if="!c.isLoginLocalProva && c.menu.exibeDeclaracaoComparecimento()") Declara&ccedil;&atilde;o Comparecimento--><a style="cursor: pointer" ng-click="c.downloadDeclaracao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Declara&ccedil;&atilde;o Comparecimento</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarCartaoConfirmacao()", ng-if="!c.isLoginLocalProva && !c.menu.exibeCartaoConfirmacao()") Local de Prova/Cart&atilde;o Confirma&ccedil;&atilde;o--><a style="cursor: pointer" ng-click="c.navegarCartaoConfirmacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Local de Prova/Cart&atilde;o Confirma&ccedil;&atilde;o</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarDoencaInfectocontagiosa()", ng-if="!c.isLoginLocalProva && c.menu.exibeDoencaInfectocontagiosa()") Doenças Infectocontagiosas--><a style="cursor: pointer" ng-click="c.navegarDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuDoencaInfectoContagiosaVisivel.menuDoencaInfectoContagiosaEnabled" class="ng-scope">Doenças Infectocontagiosas</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarResultadoDoencaInfectocontagiosa()", ng-if="!c.isLoginLocalProva && c.menu.exibeResultadoDoencaInfectocontagiosa()") Resultado de Doenças Infectocontagiosas--><a style="cursor: pointer" ng-click="c.navegarResultadoDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuResultadoDoencaInfectoContagiosaVisivel.menuResultadoDoencaInfectoContagiosaEnabled" class="ng-scope">Resultado de Doenças Infectocontagiosas</a></li><li class="ng-scope"><a style="cursor: pointer" ng-click="c.navegarReaplicacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeReaplicacao() || c.menu.exibeReaplicacaoResultado()" class="ng-scope">Solicita&ccedil;&atilde;o de Reaplica&ccedil;&atilde;o</a><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarReaplicacao()", ng-if="!c.isLoginLocalProva && c.solicitarEnccejaReaplicacaoVisivel.exibirSolicitarEnccejaReaplicacaoEnabled") Registro de Ocorr&ecirc;ncias de Aplica&ccedil;&atilde;o--></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" class="ng-scope">Alterar dados</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarDadosPessoais()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeAlterarDadosInscricao()" class="ng-scope">Informa&ccedil;&otilde;es pessoais</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope"><!--ng-click="c.navegarAtendimentosEspecializados()",--><!--ng-if="!c.isLoginLocalProva && c.menu.exibeAlterarDadosInscricao()")-->Atendimento Especializado</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 40px" ng-click="c.navegarAtendimentosEspecializados()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope">Solicitar / Alterar Solicitação</a><!--ng-if="!c.isLoginLocalProva && false") Atendimento Especializado--></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer; padding-left: 30px", ng-click="c.navegarMunicipioProva()", ng-if="!c.isLoginLocalProva && c.menu.exibeAlterarDadosInscricao()") Informa&ccedil;&otilde;es de prova--><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarMunicipioProva()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuInformacoesProvaVisivel.inscricaoEmAndamento" class="ng-scope">Informa&ccedil;&otilde;es de prova</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer; padding-left: 30px", ng-click="c.navegarJustificativaAusencia()", ng-if="!c.isLoginLocalProva && c.menu.exibeAcompanhamentoJustificativa()") Justificativa de aus&ecirc;ncia--><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarJustificativaAusencia()" ng-if="c.validarExibicaoAcompanhamentoJustific()" class="ng-scope">Justificativa de aus&ecirc;ncia</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarContato()" class="ng-scope">Contato</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; false" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="atualizarSenha" class="ng-scope">Senha</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeLaudoMedico() && !!c.menuRecursoLaudoMedico")--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuRecursoLaudoMedico" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarLaudoMedico()" class="ng-scope">Recurso Laudo M&eacute;dico</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeTratamentoSocial()")--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuTratamentoNomeSocialVisivel.menuTratamentoNomeSocialEnabled" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="nomeSocial" class="ng-scope">Tratamento pelo Nome Social</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeReenvioTratamentoSocial()") verificar se eh recurso ou resultado--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.recursoMenuTratamentoNomeSocialVisivel.recursoMenuTratamentoNomeSocialEnabled &amp;&amp; !!c.menuRecursoNomeSocial" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="reenvioNomeSocial" class="ng-scope">Recurso Nome Social</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menu.exibeBoletoCobranca()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="boletoCobranca" class="ng-scope">Boleto de Cobrança</a></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultados()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" class="ng-scope">Resultado</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2017()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2017" class="ng-scope">ENCCEJA 2017</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2018()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2018" class="ng-scope">ENCCEJA 2018</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2019()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2019" class="ng-scope">ENCCEJA 2019</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2020()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2020" class="ng-scope">ENCCEJA 2020</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2022()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2022" class="ng-scope">ENCCEJA 2022</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2023()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2023" class="ng-scope">ENCCEJA 2023</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2024()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2024" class="ng-scope">ENCCEJA 2024</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2025()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2025" class="ng-scope">ENCCEJA 2025</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2026()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2026" class="ng-scope">ENCCEJA 2026</a></li></ul><ul inep-sidebar="inep-sidebar" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" ng-click="c.sair()" class="ng-scope">Sair</a></li></ul></nav></section></div><div class="col-sm-9 col-sm-offset-3 col-md-10 col-md-offset-2"><div class="panel-box ng-scope"><header><div class="page-header with-space-top"><h1 class="h3">Inscri&ccedil;&atilde;o > ENCCEJA <small>Local de Prova</small></h1></div></header><div class="row"><div class="col-md-12"><form name="localDeProvaForm" role="form" novalidate="true" autocomplete="off" inep-message-bag="inep-message-bag" message-bag-header-error="O formulário abaixo está inválido pelos seguintes erros:" ng-controller="LocalDeProvaController as c"><div ng-if="c.localDeProvaHtml != &quot;&quot;" class="panel-body"><div class="row"><div class="col-mg-12"><div id="printGruArea" ng-bind-html="c.localDeProvaHtml"></div></div></div><div class="row with-space"><div style="padding-right: 20px" class="col-mg-12 pull-right"><button ng-click="c.imprimirLocalDeProva()" class="with-space-bottom btn btn-primary">Imprimir Local de Prova</button></div></div></div><div ng-if="c.localDeProvaCarregado &amp;&amp; c.localDeProvaHtml === &quot;&quot; &amp;&amp; c.localDeProvaErro === &quot;&quot;" class="panel-body"><div class="row"><div class="col-mg-12"><table style="border-width: 1px" class="tabela justificado"><tr><td class="header centro"><div role="alert" class="alert alert-danger">Aguarde a confirma&ccedil;&atilde;o do seu local de prova. Efetue nova consulta nos pr&oacute;ximos dias.</div></td></tr></table></div></div></div><div ng-if="c.localDeProvaCarregado &amp;&amp; c.localDeProvaHtml === &quot;&quot; &amp;&amp; c.localDeProvaErro === &quot;ESCOLA_OCUPADA&quot;" class="panel-body"><div class="row"><div class="col-mg-12"><p>Prezado (a)  Participante,</p><br/><br/><p>Seu Exame foi adiado. <b>A nova aplica&ccedil;&atilde;o ocorrer&aacute; nos dias 03 e 04 de dezembro, em local a ser divulgado oportunamente</b>. Acompanhe sua inscri&ccedil;&atilde;o na p&aacute;gina do participante e confira, em breve, o seu novo local de provas.</p><br/><p>Informamos, ainda, que o motivo de adiamento foi a ocupa&ccedil;&atilde;o, at&eacute; o dia 31/10, da escola ou institui&ccedil;&atilde;o de ensino superior onde voc&ecirc; faria  o Exame.</p><br/><p>O seu resultado ser&aacute; divulgado junto com o dos  demais participantes e voc&ecirc; n&atilde;o ter&aacute; preju&iacute;zo quanto ao uso para acesso aos  Programas do Minist&eacute;rio da Educa&ccedil;&atilde;o como: Sisu, Prouni e Fies.</p><br/><p>Qualquer d&uacute;vida, entrar em contato por meio do telefone 0800616161.</p><br/><br/><p>Agradecemos a sua compreens&atilde;o.</p><br/><p>INEP/MEC</p></div></div></div></form></div></div></div><div inep-modal="inep-modal" np-buttons="c.buttons" np-show="c.modalShow" np-id="modal" np-options="c.modalOptions" np-header="Aviso"><p tabindex="0">{{ c.modalMessage }}</p></div><div inep-modal="inep-modal" np-id="modalCarencia" np-buttons="c.modalCarencia.buttons" np-show="c.modalCarencia.show" np-options="c.modalCarencia.options" np-header="Aviso"><p tabindex="0">{{ c.modalCarencia.message }}</p></div><div inep-modal="inep-modal" np-id="modalExibirMensagem" np-buttons="c.modalExibirMensagem.buttons" np-show="c.modalExibirMensagem.show" np-options="c.modalExibirMensagem.options" np-header="Avaliar serviço"><p tabindex="0">{{ c.modalExibirMensagem.saudacao }}</p><p tabindex="0">{{ c.modalExibirMensagem.message }}</p></div><div inep-modal="inep-modal" np-buttons="c.modalSair.buttons" np-show="c.modalSair.show" np-id="modalSair" np-options="c.modalSair.options" np-header="Aviso"><p tabindex="0">{{ c.modalSair.saudacao }}</p><p tabindex="0">{{ c.modalSair.message }}</p></div></div></div></section></main>'),a.put("views/acompanhamento/login.html",'<header role="banner"><h1 class="hide"> - </h1><nav role="navigation" aria-labelledby="#nav" ng-controller="NavigationBarController" class="navbar navbar-default navbar-fixed-top"><h2 id="nav" class="hide">Navegação Principal</h2><div class="container-fluid"><div class="navbar-header text-center"><button type="button" data-toggle="offcanvas" class="navbar-toggle collapsed left"><span class="sr-only">Toggle navigation</span><span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span></button><div aria-label="Bem vindo ao INEP" class="navbar-brand"><img src="images/logo_inep.svg" alt="Instituto Nacional de Estudos e Pesquisas Educacionais Anísio Teixeira"/></div><button type="button" data-toggle="collapse" data-target="#navbar-collapse" class="navbar-toggle collapsed right p-n"><span class="sr-only">Toggle navigation</span><i class="fa fa-gear text-white"></i></button></div><!--#navbar-collapse.collapse.navbar-collapse--><!--  ul.nav.navbar-nav--><!--    li.active--><!--      span.logo-inep.h3.m-n.font-700(data-toggle=\'tooltip\', data-placement=\'bottom\', title=project.name) #{project.abbr}--><!----><!--  ul.nav.navbar-nav.navbar-right--><!--    if !login--><!--      li--><!--        span(data-toggle=\'dropdown\') #[i.fa.fa-user] Participante: {{nomeParticipanteLogado}}--><!--    li--><!--      a.contrast(href=\'#\', inep-contrast="", data-toggle=\'tooltip\', data-placement=\'bottom\', aria-label=\'Contraste\') #[i.fa.fa-adjust]--><script type="text/ng-template" id="warning-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Você ainda está aí?</h3></div><div idle-countdown="countdown" class="modal-body"><uib-progressbar max="30" value="countdown" animate="true" class="progress-striped active"></uib-progressbar>Sua sessão será encerrada em {{countdown}} segundos.</div></div></script><script type="text/ng-template" id="timedout-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Sess&atilde;o encerrada.</h3></div><div class="modal-body"><p></p>Sua sess&atilde;o foi encerrada por inatividade.</div></div></script></div></nav></header><main role="main"><section class="login"><h1 class="hide">Painel de entrada</h1><div class="container-fluid"><article><header class="text-center m-b"><div class="row"><div class="col-md-12 fundo-logo"><figure><img src="images/Logo-Encceja2026.png" alt="Exame Nacional para Certificação de Competências de Jovens e Adultos" style="width: 505px;"/></figure></div></div></header></article></div><div class="container"><div class="row"><div class="col-sm-8 col-sm-offset-2 col-lg-4 col-lg-offset-4"><form autocomplete="off" inep-message-bag="inep-message-bag" message-bag-header-error="O formulário abaixo está inválido pelos seguintes erros:" name="loginForm" novalidate="true" ng-controller="LoginParticipanteController as c"><div class="panel panel-info"><div class="panel-heading"><h2 tabindex="0" focus-me="focus-me" class="h4 panel-title text-center text-primary">P&aacute;gina do Participante\n</h2></div><div class="panel-body"><h2 class="h6 text-dark"><p tabindex="0">Para acessar a página do participante informe os dados abaixo e clique em enviar:</p></h2><div inep-modal="inep-modal" np-buttons="c.buttons" np-show="c.modalShow" np-id="c.modal" np-options="c.modalOptions" np-header="ENCCEJA- Página do Participante."><p tabindex="0">{{ c.modalMessage }}</p></div><div class="row"><inep-cpf np-accessibility-message="{{c.mensagens.MSGA001}}" np-black-list="c.pessoaFisica.blacklist" np-id="c.numeroCpf" np-label="CPF: " np-optional="false" np-value="c.cpf" np-size="12"></inep-cpf></div><!--.row--><!--  inep-password(--><!--  np-value="c.senha",--><!--  np-id="c.inputSenha",--><!--  np-label="Senha: ",--><!--  np-size="12",--><!--  np-minlength="6",--><!--  np-maxlength="10",--><!--  np-pattern="\'[0-9a-zA-Z]{1,10}\'",--><!--  np-accessibility-message="{{c.mensagens.MSGA022}}")--><!----><!--.row.with-space--><!--  inep-visual-captcha--></div><ul class="list-group"><li class="list-group-item"><a ui-sref="inicial" title="{{c.mensagens.MSGA000_}}"><i class="fa fa-sign-out text-dark"></i>Sair<span style="position: absolute; left: -999em;">{{c.mensagens.MSGA000_}}</span></a><!--span.pull-right--><!--  a(style=\'cursor: pointer\', ng-click=\'c.esqueciMinhaSenha()\')--><!--    | Esqueci minha senha&nbsp;--><!--    i.fa.fa-arrow-circle-right.text-dark--></li></ul><footer class="panel-footer p-n"><button type="submit" ng-disabled="loginForm.$invalid" ng-click="c.enviar()" class="btn btn-default btn-block"><i class="fa fa-paper-plane-o"></i>&nbsp Enviar</button></footer></div></form></div></div></div></section></main>'),
a.put("views/acompanhamento/loginAutenticidade.html",'<header role="banner"><h1 class="hide"> - </h1><nav role="navigation" aria-labelledby="#nav" ng-controller="NavigationBarController" class="navbar navbar-default navbar-fixed-top"><h2 id="nav" class="hide">Navegação Principal</h2><div class="container-fluid"><div class="navbar-header text-center"><button type="button" data-toggle="offcanvas" class="navbar-toggle collapsed left"><span class="sr-only">Toggle navigation</span><span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span></button><div aria-label="Bem vindo ao INEP" class="navbar-brand"><img src="images/logo_inep.svg" alt="Instituto Nacional de Estudos e Pesquisas Educacionais Anísio Teixeira"/></div><button type="button" data-toggle="collapse" data-target="#navbar-collapse" class="navbar-toggle collapsed right p-n"><span class="sr-only">Toggle navigation</span><i class="fa fa-gear text-white"></i></button></div><!--#navbar-collapse.collapse.navbar-collapse--><!--  ul.nav.navbar-nav--><!--    li.active--><!--      span.logo-inep.h3.m-n.font-700(data-toggle=\'tooltip\', data-placement=\'bottom\', title=project.name) #{project.abbr}--><!----><!--  ul.nav.navbar-nav.navbar-right--><!--    if !login--><!--      li--><!--        span(data-toggle=\'dropdown\') #[i.fa.fa-user] Participante: {{nomeParticipanteLogado}}--><!--    li--><!--      a.contrast(href=\'#\', inep-contrast="", data-toggle=\'tooltip\', data-placement=\'bottom\', aria-label=\'Contraste\') #[i.fa.fa-adjust]--><script type="text/ng-template" id="warning-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Você ainda está aí?</h3></div><div idle-countdown="countdown" class="modal-body"><uib-progressbar max="30" value="countdown" animate="true" class="progress-striped active"></uib-progressbar>Sua sessão será encerrada em {{countdown}} segundos.</div></div></script><script type="text/ng-template" id="timedout-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Sess&atilde;o encerrada.</h3></div><div class="modal-body"><p></p>Sua sess&atilde;o foi encerrada por inatividade.</div></div></script></div></nav></header><main role="main"><section class="login"><h1 class="hide">Painel de entrada</h1><div class="container-fluid"><article><header class="text-center m-b"><div class="row"><div class="col-md-12 fundo-logo"><figure><img src="images/Logo-Encceja2025.png" alt="Exame Nacional para Certificação de Competências de Jovens e Adultos" style="width: 505px;"/></figure></div></div></header></article></div><div class="container"><div class="row"><div class="col-sm-8 col-sm-offset-2 col-lg-4 col-lg-offset-4"><form autocomplete="off" inep-message-bag="inep-message-bag" message-bag-header-error="O formulário abaixo está inválido pelos seguintes erros:" name="loginForm" novalidate="true" ng-controller="LoginAutenticidadeController as c"><div class="panel panel-info"><div class="panel-heading"><h2 tabindex="0" focus-me="focus-me" class="h4 panel-title text-center text-primary">Autentica&ccedil;&atilde;o de resultado\n</h2></div><div class="panel-body"><h2 class="h6 text-dark"><p tabindex="0">Esta funcionalidade &eacute; de uso exclusivo das Unidades Certificadoras:</p></h2><div inep-modal="inep-modal" np-buttons="c.buttons" np-show="c.modalShow" np-id="c.modal" np-options="c.modalOptions" np-header="ENCCEJA- Autenticidade das informações"><p tabindex="0">{{ c.modalMessage }}</p></div></div><div class="row margin-tamanho-tres"><inep-input-text np-id="idKey" np-label="Chave: " ng-model="c.senha" np-optional="false" np-title-message="Código de validação" np-minlength="24" np-maxlength="24" np-minlength-message="Código inválido" np-size="12"></inep-input-text></div><div class="row with-space margin-tamanho-tres"><inep-visual-captcha></inep-visual-captcha></div><ul class="list-group"><li class="list-group-item"><a ui-sref="inicial" title="{{c.mensagens.MSGA000_}}"><i class="fa fa-sign-out text-dark"></i>Sair<span style="position: absolute; left: -999em;">{{c.mensagens.MSGA000_}}</span></a></li></ul><footer class="panel-footer p-n"><button type="submit" ng-disabled="loginForm.$invalid" ng-click="c.enviar()" class="btn btn-default btn-block"><i class="fa fa-paper-plane-o"></i>&nbsp Enviar</button></footer></div></form></div></div></div></section></main>'),a.put("views/acompanhamento/loginCertificadora.html",'<header role="banner"><h1 class="hide"> - </h1><nav role="navigation" aria-labelledby="#nav" ng-controller="NavigationBarController" class="navbar navbar-default navbar-fixed-top"><h2 id="nav" class="hide">Navegação Principal</h2><div class="container-fluid"><div class="navbar-header text-center"><button type="button" data-toggle="offcanvas" class="navbar-toggle collapsed left"><span class="sr-only">Toggle navigation</span><span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span></button><div aria-label="Bem vindo ao INEP" class="navbar-brand"><img src="images/logo_inep.svg" alt="Instituto Nacional de Estudos e Pesquisas Educacionais Anísio Teixeira"/></div><button type="button" data-toggle="collapse" data-target="#navbar-collapse" class="navbar-toggle collapsed right p-n"><span class="sr-only">Toggle navigation</span><i class="fa fa-gear text-white"></i></button></div><!--#navbar-collapse.collapse.navbar-collapse--><!--  ul.nav.navbar-nav--><!--    li.active--><!--      span.logo-inep.h3.m-n.font-700(data-toggle=\'tooltip\', data-placement=\'bottom\', title=project.name) #{project.abbr}--><!----><!--  ul.nav.navbar-nav.navbar-right--><!--    if !login--><!--      li--><!--        span(data-toggle=\'dropdown\') #[i.fa.fa-user] Participante: {{nomeParticipanteLogado}}--><!--    li--><!--      a.contrast(href=\'#\', inep-contrast="", data-toggle=\'tooltip\', data-placement=\'bottom\', aria-label=\'Contraste\') #[i.fa.fa-adjust]--><script type="text/ng-template" id="warning-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Você ainda está aí?</h3></div><div idle-countdown="countdown" class="modal-body"><uib-progressbar max="30" value="countdown" animate="true" class="progress-striped active"></uib-progressbar>Sua sessão será encerrada em {{countdown}} segundos.</div></div></script><script type="text/ng-template" id="timedout-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Sess&atilde;o encerrada.</h3></div><div class="modal-body"><p></p>Sua sess&atilde;o foi encerrada por inatividade.</div></div></script></div></nav></header><main role="main"><section class="login"><h1 class="hide">Painel de entrada</h1><div class="container-fluid"><article><header class="text-center m-b"><div class="row"><div class="col-md-12 fundo-logo"><figure><img src="images/Logo-Encceja2026.png" alt="Exame Nacional para Certificação de Competências de Jovens e Adultos" style="margin-left: 4%;"/></figure></div></div></header></article></div><div class="container"><div class="row"><div class="col-sm-8 col-sm-offset-2 col-lg-4 col-lg-offset-4"><form autocomplete="off" inep-message-bag="inep-message-bag" message-bag-header-error="O formulário abaixo está inválido pelos seguintes erros:" name="loginForm" novalidate="true" ng-controller="LoginCertificadoraController as c"><div class="panel panel-info"><div class="panel-heading"><h2 tabindex="0" focus-me="focus-me" class="h4 panel-title text-center text-primary">Encceja Certificadoras\n</h2></div><div class="panel-body"><div inep-modal="inep-modal" np-buttons="c.buttons" np-show="c.modalShow" np-id="c.modal" np-options="c.modalOptions" np-header="ENCCEJA- Página do Participante."><p tabindex="0">{{ c.modalMessage }}</p></div><div class="row"><inep-cpf np-accessibility-message="{{c.mensagens.MSGA001}}" np-black-list="c.pessoaFisica.blacklist" np-id="c.numeroCpf" np-label="CPF: " np-optional="false" np-value="c.cpf" np-size="12"></inep-cpf></div><div class="row"><inep-password np-value="c.senha" np-id="c.inputSenha" np-label="Senha: " np-size="12" np-allow-paste="true" np-accessibility-message="{{c.mensagens.MSGA022}}"></inep-password></div><div class="row with-space"><inep-visual-captcha></inep-visual-captcha></div></div><ul class="list-group"><li class="list-group-item"><a ui-sref="inicial" title="{{c.mensagens.MSGA000_}}"><i class="fa fa-sign-out text-dark"></i>Sair<span style="position: absolute; left: -999em;">{{c.mensagens.MSGA000_}}</span></a><span class="pull-right"><a ui-sref="recuperarSenha" title="Recuperar senha." style="cursor: pointer"><i class="fa fa-sign-out text-dark"></i>Recuperar senha</a></span></li></ul><footer class="panel-footer p-n"><button type="submit" ng-disabled="loginForm.$invalid" ng-click="c.enviar()" class="btn btn-default btn-block"><i class="fa fa-paper-plane-o"></i>&nbsp Enviar</button></footer></div></form></div></div></div></section></main>'),a.put("views/acompanhamento/loginUnico.html",'<form autocomplete="off" name="loginForm" novalidate="true" ng-controller="LoginUnicoController as c"><div inep-modal="inep-modal" np-buttons="buttons" np-show="modalShow" np-id="modal" np-options="modalOptions" np-header="Conta de acesso única do Governo"><p tabindex="0">{{ modalMessage }}</p></div></form>'),a.put("views/acompanhamento/nomeSocial.html",'<header role="banner"><h1 class="hide"> - </h1><nav role="navigation" aria-labelledby="#nav" ng-controller="NavigationBarController" class="navbar navbar-default navbar-fixed-top"><h2 id="nav" class="hide">Navegação Principal</h2><div class="container-fluid"><div class="navbar-header text-center"><button type="button" data-toggle="offcanvas" class="navbar-toggle collapsed left"><span class="sr-only">Toggle navigation</span><span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span></button><div aria-label="Bem vindo ao INEP" class="navbar-brand"><img src="images/logo_inep.svg" alt="Instituto Nacional de Estudos e Pesquisas Educacionais Anísio Teixeira"/></div><button type="button" data-toggle="collapse" data-target="#navbar-collapse" class="navbar-toggle collapsed right p-n"><span class="sr-only">Toggle navigation</span><i class="fa fa-gear text-white"></i></button></div><!--#navbar-collapse.collapse.navbar-collapse--><!--  ul.nav.navbar-nav--><!--    li.active--><!--      span.logo-inep.h3.m-n.font-700(data-toggle=\'tooltip\', data-placement=\'bottom\', title=project.name) #{project.abbr}--><!----><!--  ul.nav.navbar-nav.navbar-right--><!--    if !login--><!--      li--><!--        span(data-toggle=\'dropdown\') #[i.fa.fa-user] Participante: {{nomeParticipanteLogado}}--><!--    li--><!--      a.contrast(href=\'#\', inep-contrast="", data-toggle=\'tooltip\', data-placement=\'bottom\', aria-label=\'Contraste\') #[i.fa.fa-adjust]--><script type="text/ng-template" id="warning-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Você ainda está aí?</h3></div><div idle-countdown="countdown" class="modal-body"><uib-progressbar max="30" value="countdown" animate="true" class="progress-striped active"></uib-progressbar>Sua sessão será encerrada em {{countdown}} segundos.</div></div></script><script type="text/ng-template" id="timedout-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Sess&atilde;o encerrada.</h3></div><div class="modal-body"><p></p>Sua sess&atilde;o foi encerrada por inatividade.</div></div></script></div></nav></header><main role="main"><section class="login"><h1 class="hide">Painel de entrada</h1><div ng-controller="AcompanhamentoController as c" ng-init="c.init()"><div id="sideBar" class="col-sm-3 col-md-2 sidebar sidebar-offcanvas"><section><header></header><nav aria-labeledby="#nav"><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeEspelho()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" ng-click="c.navegarEspelho()" ng-if="!c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Acompanhar inscri&ccedil;&atilde;o {{c.anoEdicao}}</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.downloadDeclaracao()", ng-if="!c.isLoginLocalProva && c.menu.exibeDeclaracaoComparecimento()") Declara&ccedil;&atilde;o Comparecimento--><a style="cursor: pointer" ng-click="c.downloadDeclaracao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Declara&ccedil;&atilde;o Comparecimento</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarCartaoConfirmacao()", ng-if="!c.isLoginLocalProva && !c.menu.exibeCartaoConfirmacao()") Local de Prova/Cart&atilde;o Confirma&ccedil;&atilde;o--><a style="cursor: pointer" ng-click="c.navegarCartaoConfirmacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Local de Prova/Cart&atilde;o Confirma&ccedil;&atilde;o</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarDoencaInfectocontagiosa()", ng-if="!c.isLoginLocalProva && c.menu.exibeDoencaInfectocontagiosa()") Doenças Infectocontagiosas--><a style="cursor: pointer" ng-click="c.navegarDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuDoencaInfectoContagiosaVisivel.menuDoencaInfectoContagiosaEnabled" class="ng-scope">Doenças Infectocontagiosas</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarResultadoDoencaInfectocontagiosa()", ng-if="!c.isLoginLocalProva && c.menu.exibeResultadoDoencaInfectocontagiosa()") Resultado de Doenças Infectocontagiosas--><a style="cursor: pointer" ng-click="c.navegarResultadoDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuResultadoDoencaInfectoContagiosaVisivel.menuResultadoDoencaInfectoContagiosaEnabled" class="ng-scope">Resultado de Doenças Infectocontagiosas</a></li><li class="ng-scope"><a style="cursor: pointer" ng-click="c.navegarReaplicacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeReaplicacao() || c.menu.exibeReaplicacaoResultado()" class="ng-scope">Solicita&ccedil;&atilde;o de Reaplica&ccedil;&atilde;o</a><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarReaplicacao()", ng-if="!c.isLoginLocalProva && c.solicitarEnccejaReaplicacaoVisivel.exibirSolicitarEnccejaReaplicacaoEnabled") Registro de Ocorr&ecirc;ncias de Aplica&ccedil;&atilde;o--></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" class="ng-scope">Alterar dados</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarDadosPessoais()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeAlterarDadosInscricao()" class="ng-scope">Informa&ccedil;&otilde;es pessoais</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope"><!--ng-click="c.navegarAtendimentosEspecializados()",--><!--ng-if="!c.isLoginLocalProva && c.menu.exibeAlterarDadosInscricao()")-->Atendimento Especializado</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 40px" ng-click="c.navegarAtendimentosEspecializados()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope">Solicitar / Alterar Solicitação</a><!--ng-if="!c.isLoginLocalProva && false") Atendimento Especializado--></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer; padding-left: 30px", ng-click="c.navegarMunicipioProva()", ng-if="!c.isLoginLocalProva && c.menu.exibeAlterarDadosInscricao()") Informa&ccedil;&otilde;es de prova--><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarMunicipioProva()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuInformacoesProvaVisivel.inscricaoEmAndamento" class="ng-scope">Informa&ccedil;&otilde;es de prova</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer; padding-left: 30px", ng-click="c.navegarJustificativaAusencia()", ng-if="!c.isLoginLocalProva && c.menu.exibeAcompanhamentoJustificativa()") Justificativa de aus&ecirc;ncia--><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarJustificativaAusencia()" ng-if="c.validarExibicaoAcompanhamentoJustific()" class="ng-scope">Justificativa de aus&ecirc;ncia</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarContato()" class="ng-scope">Contato</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; false" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="atualizarSenha" class="ng-scope">Senha</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeLaudoMedico() && !!c.menuRecursoLaudoMedico")--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuRecursoLaudoMedico" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarLaudoMedico()" class="ng-scope">Recurso Laudo M&eacute;dico</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeTratamentoSocial()")--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuTratamentoNomeSocialVisivel.menuTratamentoNomeSocialEnabled" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="nomeSocial" class="ng-scope">Tratamento pelo Nome Social</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeReenvioTratamentoSocial()") verificar se eh recurso ou resultado--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.recursoMenuTratamentoNomeSocialVisivel.recursoMenuTratamentoNomeSocialEnabled &amp;&amp; !!c.menuRecursoNomeSocial" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="reenvioNomeSocial" class="ng-scope">Recurso Nome Social</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menu.exibeBoletoCobranca()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="boletoCobranca" class="ng-scope">Boleto de Cobrança</a></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultados()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" class="ng-scope">Resultado</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2017()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2017" class="ng-scope">ENCCEJA 2017</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2018()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2018" class="ng-scope">ENCCEJA 2018</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2019()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2019" class="ng-scope">ENCCEJA 2019</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2020()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2020" class="ng-scope">ENCCEJA 2020</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2022()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2022" class="ng-scope">ENCCEJA 2022</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2023()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2023" class="ng-scope">ENCCEJA 2023</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2024()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2024" class="ng-scope">ENCCEJA 2024</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2025()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2025" class="ng-scope">ENCCEJA 2025</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2026()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2026" class="ng-scope">ENCCEJA 2026</a></li></ul><ul inep-sidebar="inep-sidebar" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" ng-click="c.sair()" class="ng-scope">Sair</a></li></ul></nav></section></div><div class="col-sm-9 col-sm-offset-3 col-md-10 col-md-offset-2"><div class="panel-box ng-scope"><header><div class="page-header with-space-top"><h1 class="h3">Inscri&ccedil;&atilde;o > ENCCEJA <small>Tratamento pelo nome social</small></h1></div></header><div class="row"><div class="col-md-12"><form name="nomeSocialForm" role="form" novalidate="true" autocomplete="off" inep-message-bag="inep-message-bag" message-bag-header-error="O formulário abaixo está inválido pelos seguintes erros:" ng-controller="NomeSocialController as nsc"><!--.panel.panel-body\n  .row\n    .col-md-12\n      legend\n        b(tabindex = "0", focus-me) Tratamento pelo nome social\n  .row\n    .col-md-12\n      p(tabindex = "0")\n        | Esse tratamento é exclusivo para os participantes travestis, transexuais ou transgêneros que se identificam e querem ser reconhecidos socialmente em consonância com sua identidade \n        | de gênero, desde que tenham feito esse cadastro na Receita Federal do Brasil. Você quer ser tratado pelo nome social?--><div class="panel panel-info with-space-top"><div tabindex="0" class="panel-heading"><h1 class="h4 panel-title text-left text-primary">Tratamento pelo nome social</h1></div><div class="panel-body"><div class="row"><div class="col-md-12"><p tabindex="0">Esse tratamento é exclusivo para os participantes travestis, transexuais ou transgêneros que se identificam e querem ser reconhecidos socialmente em consonância com sua identidade \nde gênero, desde que tenham feito esse cadastro na Receita Federal do Brasil. Você quer ser tratado pelo nome social?</p></div></div><div ng-if="!dtoReceita.nomeSocialReceita" style="padding: 15px"><div class="row"><p>Não identificamos na base da Receita Federal a existência do Nome Social.</p><p>Para ser tratado pelo Nome Social é necessário o cadastro dessa condição junto \nà Receita Federal do Brasil. Você pode concluir a sua inscrição, atualizar essa \ninformação na Receita Federal e informar o nome social na Página do \nParticipante até o último dia de inscrição, previsto no edital do Encceja, disponível no endereço <a href="https://www.gov.br/inep/pt-br/areas-de-atuacao/avaliacao-e-exames-educacionais/encceja" target="_blank">https://www.gov.br/inep/pt-br/areas-de-atuacao/avaliacao-e-exames-educacionais/encceja.</a></p></div></div><div ng-if="dtoReceita.nomeSocialReceita" style="padding: 15px"><div class="row"><inep-radiobutton np-id="radioNomeSocialReceita" np-label="Identificamos, na base da Receita Federal, a existência do nome social {{dtoReceita.nomeSocialReceita}} para o seu CPF. Você deseja ser identificado em todas as fases do Exame por seu nome social?" np-values="comboSimNao" np-selected-value="nsc.utilizarNomeReceita" np-inline="true" np-on-change="nsc.changeValueNomeReceita(nsc.utilizarNomeReceita)" np-optional="false"></inep-radiobutton></div></div><!--div.row\n  span {{utilizarNomeReceita}}\n.row.with-space-top(ng-if="!dtoReceita.nomeSocialReceita")\n  .col-md-12\n    inep-input-text(\n    np-id="nomeSocialInput",\n    np-label="Nome social: ",\n    ng-model="dto.nomeSocial",\n    np-size="6",\n    np-optional="false",\n    np-maxlength="150",\n    np-accessibility-message="{{mensagens.MSGA059}}",\n    np-on-change="limparDeclaro()")\n\n.row.with-space-bottom(ng-if="dtoReceita.nomeSocialReceita")\n    .col-md-12(style="padding: 0px")\n      enem-fieldset(np-tab = "0")\n        table\n          tr\n            td\n              //- ng-bind-html Identificamos, na base da Receita Federal, a existência do nome social \n              //- | {{dtoReceita.nomeSocialReceita}} para o seu CPF. Deseja utilizar essa informação para solicitação \n              //- | de tratamento pelo nome social?\n              br\n              inep-radiobutton(np-id=\'radioNomeSocialReceita\',\n                np-label=\'Identificamos, na base da Receita Federal, a existência do nome social {{dtoReceita.nomeSocialReceita}} para o seu CPF. Deseja utilizar essa informação para solicitação de tratamento pelo nome social?\',\n                np-values=\'comboSimNao\',\n                np-selected-value=\'nsc.utilizarNomeReceita\',\n                np-inline="true",\n                np-disabled="!!possuiNomeSocialCadastrado"\n                np-on-change="nsc.changeValueNomeReceita(nsc.utilizarNomeReceita)",\n                np-optional="false")\n\n.box-describe(ng-if="!dtoReceita.nomeSocialReceita", tabindex="0")\n  | Nome Social é destinado a pessoa que se identifica e quer ser reconhecida socialmente em consonância com sua identidade de gênero.\n\n//np-readonly="!!possuiNomeSocialCadastrado",\n.row.with-space-top\n  //- .col-md-12\n  //-   inep-radiobutton(\n  //-   np-id="sanitarioRadio",\n  //-   np-label=\'Banheiro a ser utilizado nos dias do exame: \',\n  //-   np-values="tipoSanitario",\n  //-   np-selected-value="dto.ambienteSanitario",\n  //-   np-optional="false",\n  //-   np-inline="true",\n  //-   np-disabled="!!possuiNomeSocialCadastrado",\n  //-   np-accessibility-message="{{mensagens.MSGA060}}",\n  //-   np-on-change="limparDeclaro()")\n\n  .row.with-space-bottom\n    .col-md-12\n      enem-fieldset(np-tab = "0")\n        table\n          tr\n            td\n              row\n                inep-boolean-checkbox(\n                np-id="declaracaoNomeSocial",\n                np-selected-value="declaro.declaroNomeSocial",\n                np-value="!dtoReceita.nomeSocialReceita ? txtDeclaroComum : (!nsc.utilizarNomeReceita || nsc.utilizarNomeReceita == \'true\') ? txtDeclaroReceitaSim : txtDeclaroReceitaNao",\n                np-disabled="!!possuiNomeSocialCadastrado",\n                np-optional="false",\n                np-required-message="Declaração de tratamento pelo nome social obrigatória.")\n              \n                //- ng-bind-html(ng-if="!dtoReceita.nomeSocialReceita") Declaro que estou ciente da condição informada \n                //-   | para Tratamento pelo Nome Social de que a confirmação da solicitação está condicionada ao envio \n                //-   | e a aprovação dos documentos previstos no edital do Encceja Nacional 2023; que os documentos \n                //-   | comprobatórios estão em conformidade com o solicitado; que poderei ter que prestar informações \n                //-   | complementares, quando me forem solicitadas; que em caso de reprovação da solicitação a \n                //-   | identificação no Exame será realizada com o nome civil.\n\n                //- ng-bind-html(ng-if="dtoReceita.nomeSocialReceita && (!nsc.utilizarNomeReceita || nsc.utilizarNomeReceita == \'true\')") Declaro que estou \n                //-   | ciente da condição informada para Tratamento pelo Nome Social conforme nome apresentado na base da Receita Federal. Deseja solicitar \n                //-   | o tratamento pelo nome social?\n\n                //- ng-bind-html(ng-if="dtoReceita.nomeSocialReceita && nsc.utilizarNomeReceita == \'false\'") Declaro que estou ciente \n                //-   | que não utilizarei o Nome Social cadastrado na Receita Federal. \n                //-   | Dessa forma, serei tratado pelo nome civil. Deseja salvar?\n              \n              //- ng-bind-html Declaro que estou ciente da condição informada para Tratamento pelo Nome Social \n              //- | e de que a confirmação da solicitação está condicionada ao envio dos documentos previstos no item 4.8.2 do edital \n              //- | do Encceja Nacional 2020. Os documentos comprobatórios estão em conformidade com os solicitados, legíveis para \n              //- | análise e deferimento, sob pena de serem considerados inválidos para comprovação Tratamento pelo Nome Social. \n              //- | Estou ciente de que deverei manter os meus dados de contato (e-mail e telefone) atualizados e poderei \n              //- | prestar informações complementares, quando me forem solicitadas.\n--><!--div(ng-if=\'!!declaro.declaroNomeSocial && !dtoReceita.nomeSocialReceita\')//include nomeSocialUpload--><!--.clearfix(ng-if="!dtoReceita.nomeSocialReceita")ul.pagination.margin-bottom-none.pull-right\n  li.primary()\n    button.btn.btn-primary(ng-click="exibirModalSolicitacao(dto)", role="button")\n      | {{atualizar === 0 ? \'Solicitar tratamento por nome social\' : \'Atualizar solicita&ccedil;&atilde;o\'}}--><div ng-if="dtoReceita.nomeSocialReceita" class="clearfix"><ul class="pagination margin-bottom-none pull-right"><li class="primary"><button ng-click="exibirModalSolicitacaoReceita(dto)" role="button" class="btn btn-primary">Salvar</button></li></ul></div><div inep-modal="inep-modal" np-id="modalNomeSocial" np-buttons="modalNomeSocial.buttons" np-show="modalNomeSocial.show" np-options="modalNomeSocial.options" np-header="Aviso"><p tabindex="0">{{ modalNomeSocial.message }}</p></div></div></div></form></div></div></div><div inep-modal="inep-modal" np-buttons="c.buttons" np-show="c.modalShow" np-id="modal" np-options="c.modalOptions" np-header="Aviso"><p tabindex="0">{{ c.modalMessage }}</p></div><div inep-modal="inep-modal" np-id="modalCarencia" np-buttons="c.modalCarencia.buttons" np-show="c.modalCarencia.show" np-options="c.modalCarencia.options" np-header="Aviso"><p tabindex="0">{{ c.modalCarencia.message }}</p></div><div inep-modal="inep-modal" np-id="modalExibirMensagem" np-buttons="c.modalExibirMensagem.buttons" np-show="c.modalExibirMensagem.show" np-options="c.modalExibirMensagem.options" np-header="Avaliar serviço"><p tabindex="0">{{ c.modalExibirMensagem.saudacao }}</p><p tabindex="0">{{ c.modalExibirMensagem.message }}</p></div><div inep-modal="inep-modal" np-buttons="c.modalSair.buttons" np-show="c.modalSair.show" np-id="modalSair" np-options="c.modalSair.options" np-header="Aviso"><p tabindex="0">{{ c.modalSair.saudacao }}</p><p tabindex="0">{{ c.modalSair.message }}</p></div></div></div></section></main>'),a.put("views/acompanhamento/nomeSocialUpload.html",'<div class="panel panel-info with-space-top"><div tabindex="0" class="panel-heading"><h1 class="h4 panel-title text-left text-primary">Anexar arquivos</h1></div><div class="panel-body"><div class="row with-space-top"><div class="col-md-12"><p tabindex="0">Anexe aqui os arquivos solicitados. Somente serão aceitos arquivos nos formatos PDF,\nPNG e JPG, com tamanho máximo 2 MB. Para inserir o arquivo clique em\n<strong> Escolher Arquivo </strong>\n, selecione o arquivo desejado para cada documento e, em seguida, clique\nem &quot;Solicitar tratamento por nome social&quot;.</p></div></div><div ng-if="fotoRecente.nomeArquivo != null &amp;&amp; fotoRecente.nomeArquivo != undefined"><div class="row with-space-top"><div class="col-md-10 col-md-offset-2"><i ng-if="!!fotoRecente.possuiArquivo || !!fotoRecente.arquivo" class="fa fa-check-circle fa-2x icon-upload icon-sucess"></i><i ng-if="!fotoRecente.possuiArquivo &amp;&amp; !fotoRecente.arquivo" class="fa fa-times-circle fa-2x icon-upload icon-error"></i><inep-input-text np-id="fotoRecenteName" np-maxlength="150" np-size="6" ng-model="fotoRecente.nomeArquivo" np-readonly="true" np-optional="true" np-label="Foto recente:" np-name="selectedFile"></inep-input-text><button type="button" ng-click="alterarArquivo(1)" style="margin-top: 23px;margin-left: -18px;" class="btn btn-default">Enviar novo arquivo</button><button type="button" ng-if="fotoRecente.possuiArquivo" ng-click="download(1)" style="margin-top: 23px;margin-left: 10px;" class="btn btn-default align-button-upload">Download</button></div></div></div><div ng-if="!fotoRecente.nomeArquivo || fotoRecente.nomeArquivo == null || fotoRecente.nomeArquivo == undefined"><div class="row with-space-top"><div class="col-md-10 col-md-offset-2"><i ng-if="!!fotoRecente.arquivo" class="fa fa-check-circle fa-2x icon-upload icon-sucess"></i><i ng-if="!fotoRecente.arquivo" class="fa fa-times-circle fa-2x icon-upload icon-error"></i><inep-input-file np-id="fotoRecenteUpload" np-label="Foto recente: " np-value="fotoRecente.arquivo" np-max-file-size="maxFileSize" np-show-icon="true" np-content-types="contentTypes" np-size="8" np-max-file-message="Tamanho de arquivo inválido." np-content-type-message="Formato de arquivo inválido." np-disabled="" np-on-change="showPreview(fotoRecente)" np-empty-message="{{mensagens.MSG_ARQUIVO_VAZIO}}" np-optional="fotoRecente.possuiArquivo"></inep-input-file><button type="button" ng-if="!!fotoRecente.arquivo" ng-click="exibirModalExcluirArquivo(\'fotoRecente\')" style="margin-top: 23px;margin-left: 10px;" class="btn btn-default align-button-upload">Excluir arquivo</button></div><div class="row with-space-bottom"><div class="col-md-10 col-md-offset-2"><span ng-show="!!fotoRecente.possuiArquivo"><inep-output-text np-id="msgEnvioFotoRecente" ng-model="fotoRecente.msgEnvio"></inep-output-text></span></div></div><div class="row with-space-bottom"><div id="previewFotoRecente" ng-if="!!fotoRecente.blob" class="col-md-10 col-md-offset-2"><img style="width:220px; height: 220px;" ng-src="{{fotoRecente.blob}}"/></div></div></div></div><div ng-if="identificacao.nomeArquivo != null &amp;&amp; identificacao.nomeArquivo != undefined"><div class="row with-space-top"><div class="col-md-10 col-md-offset-2"><i ng-if="!!identificacao.possuiArquivo || !!identificacao.arquivo" class="fa fa-check-circle fa-2x icon-upload icon-sucess"></i><i ng-if="!identificacao.possuiArquivo &amp;&amp; !identificacao.arquivo" class="fa fa-times-circle fa-2x icon-upload icon-error"></i><inep-input-text np-id="identificacaoUpload" np-maxlength="150" np-size="6" ng-model="identificacao.nomeArquivo" np-readonly="true" np-optional="true" np-label="Documento de identificação com foto de acordo com o edital: " np-name="selectedFile"></inep-input-text><button type="button" ng-click="alterarArquivo(2)" style="margin-top: 23px;margin-left: -18px;" class="btn btn-default">Enviar novo arquivo</button><button type="button" ng-if="!!identificacao.possuiArquivo" ng-click="download(2)" style="margin-top: 23px;margin-left: 10px;" class="btn btn-default align-button-upload">Download</button></div></div></div><div ng-if="!identificacao.nomeArquivo || identificacao.nomeArquivo == null || identificacao.nomeArquivo == undefined"><div class="row with-space-top"><div class="col-md-10 col-md-offset-2"><i ng-if="!!identificacao.arquivo" class="fa fa-check-circle fa-2x icon-upload icon-sucess"></i><i ng-if="!identificacao.arquivo" class="fa fa-times-circle fa-2x icon-upload icon-error"></i><inep-input-file np-id="identificacaoUpload" np-label="Documento de identificação com foto de acordo com o edital: " np-value="identificacao.arquivo" np-max-file-size="maxFileSize" np-show-icon="true" np-content-types="contentTypes" np-size="8" np-max-file-message="Tamanho de arquivo inválido." np-content-type-message="Formato de arquivo inválido." np-disabled="" np-on-change="showPreview(identificacao)" np-empty-message="{{mensagens.MSG_ARQUIVO_VAZIO}}" np-optional="identificacao.possuiArquivo"></inep-input-file><button type="button" ng-if="!!identificacao.arquivo" ng-click="exibirModalExcluirArquivo(\'identificacao\')" style="margin-top: 23px;margin-left: 10px;" class="btn btn-default align-button-upload">Excluir arquivo</button></div><div class="row with-space-bottom"><div class="col-md-10 col-md-offset-2"><span ng-show="!!identificacao.possuiArquivo"><inep-output-text np-id="msgEnvioIdentificacao" ng-model="identificacao.msgEnvio"></inep-output-text></span></div></div><div class="row with-space-bottom"><div id="previewIdentificacao" ng-if="!!identificacao.blob" class="col-md-10 col-md-offset-2"><img style="width:220px; height: 220px;" ng-src="{{identificacao.blob}}"/></div></div></div></div></div></div>'),
a.put("views/acompanhamento/principal.html",'<header role="banner"><h1 class="hide"> - </h1><nav role="navigation" aria-labelledby="#nav" ng-controller="NavigationBarController" class="navbar navbar-default navbar-fixed-top"><h2 id="nav" class="hide">Navegação Principal</h2><div class="container-fluid"><div class="navbar-header text-center"><button type="button" data-toggle="offcanvas" class="navbar-toggle collapsed left"><span class="sr-only">Toggle navigation</span><span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span></button><div aria-label="Bem vindo ao INEP" class="navbar-brand"><img src="images/logo_inep.svg" alt="Instituto Nacional de Estudos e Pesquisas Educacionais Anísio Teixeira"/></div><button type="button" data-toggle="collapse" data-target="#navbar-collapse" class="navbar-toggle collapsed right p-n"><span class="sr-only">Toggle navigation</span><i class="fa fa-gear text-white"></i></button></div><!--#navbar-collapse.collapse.navbar-collapse--><!--  ul.nav.navbar-nav--><!--    li.active--><!--      span.logo-inep.h3.m-n.font-700(data-toggle=\'tooltip\', data-placement=\'bottom\', title=project.name) #{project.abbr}--><!----><!--  ul.nav.navbar-nav.navbar-right--><!--    if !login--><!--      li--><!--        span(data-toggle=\'dropdown\') #[i.fa.fa-user] Participante: {{nomeParticipanteLogado}}--><!--    li--><!--      a.contrast(href=\'#\', inep-contrast="", data-toggle=\'tooltip\', data-placement=\'bottom\', aria-label=\'Contraste\') #[i.fa.fa-adjust]--><script type="text/ng-template" id="warning-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Você ainda está aí?</h3></div><div idle-countdown="countdown" class="modal-body"><uib-progressbar max="30" value="countdown" animate="true" class="progress-striped active"></uib-progressbar>Sua sessão será encerrada em {{countdown}} segundos.</div></div></script><script type="text/ng-template" id="timedout-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Sess&atilde;o encerrada.</h3></div><div class="modal-body"><p></p>Sua sess&atilde;o foi encerrada por inatividade.</div></div></script></div></nav></header><main role="main"><section class="login"><h1 class="hide">Painel de entrada</h1><div ng-controller="AcompanhamentoController as c" ng-init="c.init()"><div id="sideBar" class="col-sm-3 col-md-2 sidebar sidebar-offcanvas"><section><header></header><nav aria-labeledby="#nav"><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeEspelho()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" ng-click="c.navegarEspelho()" ng-if="!c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Acompanhar inscri&ccedil;&atilde;o {{c.anoEdicao}}</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.downloadDeclaracao()", ng-if="!c.isLoginLocalProva && c.menu.exibeDeclaracaoComparecimento()") Declara&ccedil;&atilde;o Comparecimento--><a style="cursor: pointer" ng-click="c.downloadDeclaracao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Declara&ccedil;&atilde;o Comparecimento</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarCartaoConfirmacao()", ng-if="!c.isLoginLocalProva && !c.menu.exibeCartaoConfirmacao()") Local de Prova/Cart&atilde;o Confirma&ccedil;&atilde;o--><a style="cursor: pointer" ng-click="c.navegarCartaoConfirmacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Local de Prova/Cart&atilde;o Confirma&ccedil;&atilde;o</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarDoencaInfectocontagiosa()", ng-if="!c.isLoginLocalProva && c.menu.exibeDoencaInfectocontagiosa()") Doenças Infectocontagiosas--><a style="cursor: pointer" ng-click="c.navegarDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuDoencaInfectoContagiosaVisivel.menuDoencaInfectoContagiosaEnabled" class="ng-scope">Doenças Infectocontagiosas</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarResultadoDoencaInfectocontagiosa()", ng-if="!c.isLoginLocalProva && c.menu.exibeResultadoDoencaInfectocontagiosa()") Resultado de Doenças Infectocontagiosas--><a style="cursor: pointer" ng-click="c.navegarResultadoDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuResultadoDoencaInfectoContagiosaVisivel.menuResultadoDoencaInfectoContagiosaEnabled" class="ng-scope">Resultado de Doenças Infectocontagiosas</a></li><li class="ng-scope"><a style="cursor: pointer" ng-click="c.navegarReaplicacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeReaplicacao() || c.menu.exibeReaplicacaoResultado()" class="ng-scope">Solicita&ccedil;&atilde;o de Reaplica&ccedil;&atilde;o</a><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarReaplicacao()", ng-if="!c.isLoginLocalProva && c.solicitarEnccejaReaplicacaoVisivel.exibirSolicitarEnccejaReaplicacaoEnabled") Registro de Ocorr&ecirc;ncias de Aplica&ccedil;&atilde;o--></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" class="ng-scope">Alterar dados</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarDadosPessoais()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeAlterarDadosInscricao()" class="ng-scope">Informa&ccedil;&otilde;es pessoais</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope"><!--ng-click="c.navegarAtendimentosEspecializados()",--><!--ng-if="!c.isLoginLocalProva && c.menu.exibeAlterarDadosInscricao()")-->Atendimento Especializado</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 40px" ng-click="c.navegarAtendimentosEspecializados()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope">Solicitar / Alterar Solicitação</a><!--ng-if="!c.isLoginLocalProva && false") Atendimento Especializado--></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer; padding-left: 30px", ng-click="c.navegarMunicipioProva()", ng-if="!c.isLoginLocalProva && c.menu.exibeAlterarDadosInscricao()") Informa&ccedil;&otilde;es de prova--><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarMunicipioProva()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuInformacoesProvaVisivel.inscricaoEmAndamento" class="ng-scope">Informa&ccedil;&otilde;es de prova</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer; padding-left: 30px", ng-click="c.navegarJustificativaAusencia()", ng-if="!c.isLoginLocalProva && c.menu.exibeAcompanhamentoJustificativa()") Justificativa de aus&ecirc;ncia--><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarJustificativaAusencia()" ng-if="c.validarExibicaoAcompanhamentoJustific()" class="ng-scope">Justificativa de aus&ecirc;ncia</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarContato()" class="ng-scope">Contato</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; false" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="atualizarSenha" class="ng-scope">Senha</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeLaudoMedico() && !!c.menuRecursoLaudoMedico")--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuRecursoLaudoMedico" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarLaudoMedico()" class="ng-scope">Recurso Laudo M&eacute;dico</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeTratamentoSocial()")--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuTratamentoNomeSocialVisivel.menuTratamentoNomeSocialEnabled" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="nomeSocial" class="ng-scope">Tratamento pelo Nome Social</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeReenvioTratamentoSocial()") verificar se eh recurso ou resultado--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.recursoMenuTratamentoNomeSocialVisivel.recursoMenuTratamentoNomeSocialEnabled &amp;&amp; !!c.menuRecursoNomeSocial" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="reenvioNomeSocial" class="ng-scope">Recurso Nome Social</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menu.exibeBoletoCobranca()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="boletoCobranca" class="ng-scope">Boleto de Cobrança</a></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultados()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" class="ng-scope">Resultado</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2017()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2017" class="ng-scope">ENCCEJA 2017</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2018()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2018" class="ng-scope">ENCCEJA 2018</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2019()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2019" class="ng-scope">ENCCEJA 2019</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2020()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2020" class="ng-scope">ENCCEJA 2020</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2022()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2022" class="ng-scope">ENCCEJA 2022</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2023()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2023" class="ng-scope">ENCCEJA 2023</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2024()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2024" class="ng-scope">ENCCEJA 2024</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2025()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2025" class="ng-scope">ENCCEJA 2025</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2026()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2026" class="ng-scope">ENCCEJA 2026</a></li></ul><ul inep-sidebar="inep-sidebar" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" ng-click="c.sair()" class="ng-scope">Sair</a></li></ul></nav></section></div><div class="col-sm-9 col-sm-offset-3 col-md-10 col-md-offset-2"><div class="panel-box ng-scope"></div><div inep-modal="inep-modal" np-buttons="c.buttons" np-show="c.modalShow" np-id="modal" np-options="c.modalOptions" np-header="Aviso"><p tabindex="0">{{ c.modalMessage }}</p></div><div inep-modal="inep-modal" np-id="modalCarencia" np-buttons="c.modalCarencia.buttons" np-show="c.modalCarencia.show" np-options="c.modalCarencia.options" np-header="Aviso"><p tabindex="0">{{ c.modalCarencia.message }}</p></div><div inep-modal="inep-modal" np-id="modalExibirMensagem" np-buttons="c.modalExibirMensagem.buttons" np-show="c.modalExibirMensagem.show" np-options="c.modalExibirMensagem.options" np-header="Avaliar serviço"><p tabindex="0">{{ c.modalExibirMensagem.saudacao }}</p><p tabindex="0">{{ c.modalExibirMensagem.message }}</p></div><div inep-modal="inep-modal" np-buttons="c.modalSair.buttons" np-show="c.modalSair.show" np-id="modalSair" np-options="c.modalSair.options" np-header="Aviso"><p tabindex="0">{{ c.modalSair.saudacao }}</p><p tabindex="0">{{ c.modalSair.message }}</p></div></div></div></section></main>'),a.put("views/acompanhamento/reaplicacao.html",'<header role="banner"><h1 class="hide"> - </h1><nav role="navigation" aria-labelledby="#nav" ng-controller="NavigationBarController" class="navbar navbar-default navbar-fixed-top"><h2 id="nav" class="hide">Navegação Principal</h2><div class="container-fluid"><div class="navbar-header text-center"><button type="button" data-toggle="offcanvas" class="navbar-toggle collapsed left"><span class="sr-only">Toggle navigation</span><span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span></button><div aria-label="Bem vindo ao INEP" class="navbar-brand"><img src="images/logo_inep.svg" alt="Instituto Nacional de Estudos e Pesquisas Educacionais Anísio Teixeira"/></div><button type="button" data-toggle="collapse" data-target="#navbar-collapse" class="navbar-toggle collapsed right p-n"><span class="sr-only">Toggle navigation</span><i class="fa fa-gear text-white"></i></button></div><!--#navbar-collapse.collapse.navbar-collapse--><!--  ul.nav.navbar-nav--><!--    li.active--><!--      span.logo-inep.h3.m-n.font-700(data-toggle=\'tooltip\', data-placement=\'bottom\', title=project.name) #{project.abbr}--><!----><!--  ul.nav.navbar-nav.navbar-right--><!--    if !login--><!--      li--><!--        span(data-toggle=\'dropdown\') #[i.fa.fa-user] Participante: {{nomeParticipanteLogado}}--><!--    li--><!--      a.contrast(href=\'#\', inep-contrast="", data-toggle=\'tooltip\', data-placement=\'bottom\', aria-label=\'Contraste\') #[i.fa.fa-adjust]--><script type="text/ng-template" id="warning-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Você ainda está aí?</h3></div><div idle-countdown="countdown" class="modal-body"><uib-progressbar max="30" value="countdown" animate="true" class="progress-striped active"></uib-progressbar>Sua sessão será encerrada em {{countdown}} segundos.</div></div></script><script type="text/ng-template" id="timedout-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Sess&atilde;o encerrada.</h3></div><div class="modal-body"><p></p>Sua sess&atilde;o foi encerrada por inatividade.</div></div></script></div></nav></header><main role="main"><section class="login"><h1 class="hide">Painel de entrada</h1><div ng-controller="AcompanhamentoController as c" ng-init="c.init()"><div id="sideBar" class="col-sm-3 col-md-2 sidebar sidebar-offcanvas"><section><header></header><nav aria-labeledby="#nav"><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeEspelho()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" ng-click="c.navegarEspelho()" ng-if="!c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Acompanhar inscri&ccedil;&atilde;o {{c.anoEdicao}}</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.downloadDeclaracao()", ng-if="!c.isLoginLocalProva && c.menu.exibeDeclaracaoComparecimento()") Declara&ccedil;&atilde;o Comparecimento--><a style="cursor: pointer" ng-click="c.downloadDeclaracao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Declara&ccedil;&atilde;o Comparecimento</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarCartaoConfirmacao()", ng-if="!c.isLoginLocalProva && !c.menu.exibeCartaoConfirmacao()") Local de Prova/Cart&atilde;o Confirma&ccedil;&atilde;o--><a style="cursor: pointer" ng-click="c.navegarCartaoConfirmacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Local de Prova/Cart&atilde;o Confirma&ccedil;&atilde;o</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarDoencaInfectocontagiosa()", ng-if="!c.isLoginLocalProva && c.menu.exibeDoencaInfectocontagiosa()") Doenças Infectocontagiosas--><a style="cursor: pointer" ng-click="c.navegarDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuDoencaInfectoContagiosaVisivel.menuDoencaInfectoContagiosaEnabled" class="ng-scope">Doenças Infectocontagiosas</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarResultadoDoencaInfectocontagiosa()", ng-if="!c.isLoginLocalProva && c.menu.exibeResultadoDoencaInfectocontagiosa()") Resultado de Doenças Infectocontagiosas--><a style="cursor: pointer" ng-click="c.navegarResultadoDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuResultadoDoencaInfectoContagiosaVisivel.menuResultadoDoencaInfectoContagiosaEnabled" class="ng-scope">Resultado de Doenças Infectocontagiosas</a></li><li class="ng-scope"><a style="cursor: pointer" ng-click="c.navegarReaplicacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeReaplicacao() || c.menu.exibeReaplicacaoResultado()" class="ng-scope">Solicita&ccedil;&atilde;o de Reaplica&ccedil;&atilde;o</a><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarReaplicacao()", ng-if="!c.isLoginLocalProva && c.solicitarEnccejaReaplicacaoVisivel.exibirSolicitarEnccejaReaplicacaoEnabled") Registro de Ocorr&ecirc;ncias de Aplica&ccedil;&atilde;o--></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" class="ng-scope">Alterar dados</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarDadosPessoais()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeAlterarDadosInscricao()" class="ng-scope">Informa&ccedil;&otilde;es pessoais</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope"><!--ng-click="c.navegarAtendimentosEspecializados()",--><!--ng-if="!c.isLoginLocalProva && c.menu.exibeAlterarDadosInscricao()")-->Atendimento Especializado</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 40px" ng-click="c.navegarAtendimentosEspecializados()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope">Solicitar / Alterar Solicitação</a><!--ng-if="!c.isLoginLocalProva && false") Atendimento Especializado--></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer; padding-left: 30px", ng-click="c.navegarMunicipioProva()", ng-if="!c.isLoginLocalProva && c.menu.exibeAlterarDadosInscricao()") Informa&ccedil;&otilde;es de prova--><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarMunicipioProva()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuInformacoesProvaVisivel.inscricaoEmAndamento" class="ng-scope">Informa&ccedil;&otilde;es de prova</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer; padding-left: 30px", ng-click="c.navegarJustificativaAusencia()", ng-if="!c.isLoginLocalProva && c.menu.exibeAcompanhamentoJustificativa()") Justificativa de aus&ecirc;ncia--><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarJustificativaAusencia()" ng-if="c.validarExibicaoAcompanhamentoJustific()" class="ng-scope">Justificativa de aus&ecirc;ncia</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarContato()" class="ng-scope">Contato</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; false" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="atualizarSenha" class="ng-scope">Senha</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeLaudoMedico() && !!c.menuRecursoLaudoMedico")--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuRecursoLaudoMedico" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarLaudoMedico()" class="ng-scope">Recurso Laudo M&eacute;dico</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeTratamentoSocial()")--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuTratamentoNomeSocialVisivel.menuTratamentoNomeSocialEnabled" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="nomeSocial" class="ng-scope">Tratamento pelo Nome Social</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeReenvioTratamentoSocial()") verificar se eh recurso ou resultado--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.recursoMenuTratamentoNomeSocialVisivel.recursoMenuTratamentoNomeSocialEnabled &amp;&amp; !!c.menuRecursoNomeSocial" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="reenvioNomeSocial" class="ng-scope">Recurso Nome Social</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menu.exibeBoletoCobranca()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="boletoCobranca" class="ng-scope">Boleto de Cobrança</a></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultados()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" class="ng-scope">Resultado</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2017()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2017" class="ng-scope">ENCCEJA 2017</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2018()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2018" class="ng-scope">ENCCEJA 2018</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2019()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2019" class="ng-scope">ENCCEJA 2019</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2020()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2020" class="ng-scope">ENCCEJA 2020</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2022()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2022" class="ng-scope">ENCCEJA 2022</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2023()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2023" class="ng-scope">ENCCEJA 2023</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2024()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2024" class="ng-scope">ENCCEJA 2024</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2025()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2025" class="ng-scope">ENCCEJA 2025</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2026()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2026" class="ng-scope">ENCCEJA 2026</a></li></ul><ul inep-sidebar="inep-sidebar" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" ng-click="c.sair()" class="ng-scope">Sair</a></li></ul></nav></section></div><div class="col-sm-9 col-sm-offset-3 col-md-10 col-md-offset-2"><div class="panel-box ng-scope"><header><div class="page-header with-space-top"><h1 class="h3">Inscri&ccedil;&atilde;o > ENCCEJA <small>Reaplicação</small></h1></div></header><div class="row"><div class="col-md-12"><form name="reaplicacaoForm" role="form" novalidate="true" autocomplete="off" inep-message-bag="inep-message-bag" message-bag-header-error="O formulário abaixo está inválido pelos seguintes erros:" ng-controller="ReaplicacaoController as c"><div class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Registro de Ocorr&ecirc;ncias de Aplica&ccedil;&atilde;o ENCCEJA {{ c.anoEdicao }}</h2></div><div tabindex="0"><div class="text-center text-primary"><label>Os campos com <i alt="asterisco" class="fa fa-asterisk"><span class="hidden-accessibility">asterisco</span></i> são de preenchimento obrigatório</label></div><div class="row with-space-bottom"></div></div><div class="panel-body"><div ng-if="!!c.isSolicitacao" class="row"><div class="col-md-12"><p tabindex="0">Conforme previsto em Edital, o participante que se sentiu prejudicado por problemas logísticos\ndurante a aplicação ou que estava acometido por alguma doença infectocontagiosa no dia do Exame\npoderá solicitar reaplicação da prova indicando o turno, o motivo e a justificativa da ocorrência.</p><!--p(tanindex = "0")--><!--span(style="color: red;") Atenção:--><!--  | Esse não é o momento de justificar ausência ao Exame. Você poderá fazer essa justificativa na edição do Encceja do ano que vem.--></div></div><div ng-if="!c.isSolicitacao" class="row"><div class="col-md-12"><p tabindex="0">A sua solicitação foi recebida. Acompanhe no quadro abaixo o seu pedido de reaplicação.</p></div></div><div class="row"><div class="col-md-12 with-space-top"><b>Nome:&nbsp;</b><inep-output-text np-id="nome" ng-model="c.tela.pessoaFisica.nome" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div class="row"><div class="col-md-12"><b>Exame:&nbsp;</b><inep-output-text np-id="exame" ng-model="c.tela.exame" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div ng-if="c.tela.matutinoPermitido == true" class="row"><inep-radiobutton np-id="checkboxMatutino" np-values="c.opcoesSimNao" np-selected-value="c.tela.possuiMatutino" np-label="Você compareceu no local de provas no turno matutino?" np-inline="true" np-optional="false" np-size="5" np-disabled="!c.isSolicitacao" np-accessibility-message="{{c.mensagens.MSGA029}}"></inep-radiobutton></div><div ng-if="c.tela.possuiMatutino == \'false\'" class="row"><inep-radiobutton np-id="checkboxMatutinoInfecto" np-values="c.opcoesSimNao" np-selected-value="c.tela.possuiMatutinoInfecto" np-label="Você foi acometido por alguma doença infectocontagiosa no dia de aplicação das provas?" np-inline="true" np-optional="false" np-size="5" np-disabled="!c.isSolicitacao" np-accessibility-message="{{c.mensagens.MSGA029}}"></inep-radiobutton></div><div ng-if="c.tela.vespertinoPermitido == true" class="row"><inep-radiobutton np-id="checkboxVespertino" np-values="c.opcoesSimNao" np-selected-value="c.tela.possuiVespertino" np-label="Você compareceu no local de provas no turno vespertino?" np-inline="true" np-optional="false" np-size="5" np-disabled="!c.isSolicitacao" np-accessibility-message="{{c.mensagens.MSGA029}}"></inep-radiobutton></div><div ng-if="c.tela.possuiVespertino == \'false\'" class="row"><inep-radiobutton np-id="checkboxVespertinoInfecto" np-values="c.opcoesSimNao" np-selected-value="c.tela.possuiVespertinoInfecto" np-label="Você foi acometido por alguma doença infectocontagiosa no dia de aplicação das provas?" np-inline="true" np-optional="false" np-size="5" np-disabled="!c.isSolicitacao" np-accessibility-message="{{c.mensagens.MSGA029}}"></inep-radiobutton></div><div ng-if="c.tela.possuiMatutino == \'true\' || !!c.tela.possuiMatutinoInfecto" class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Matutino</h2></div><div class="panel-body"><div ng-if="c.tela.possuiMatutino == \'true\'" class="row"><inep-combobox np-id="comboMotivos" np-label="Motivo: " np-values="c.tela.motivosReaplicacao" np-selected-value="c.dtoMatutino.motivo" np-size="6" np-optional="false" np-disabled="!c.isSolicitacao" np-accessibility-message="{{c.mensagens.MSGA055}}"></inep-combobox></div><div ng-if="c.tela.possuiMatutinoInfecto == \'true\' &amp;&amp; c.tela.possuiMatutino == \'false\'" style="margin-left: 0" class="row"><div class="col-12"><p>Envie um documento que comprove uma das doenças infectocontagiosas citadas abaixo, de acordo com o edital.<ul><li>Tuberculose</li><li>Coqueluche</li><li>Difteria</li><li>Doença Invasiva por Haemophilus Influenzae</li><li>Doença Meningocócica e outras meningites</li><li>Varíola</li><li>Influenza humana A e B</li><li>Poliomielite por poliovírus selvagem</li><li>Sarampo</li><li>Rubéola</li><li>Varicela (catapora)</li><li>Varíola dos macacos (monkeypox)</li><li>Covid-19</li></ul></p></div></div><div ng-if="c.tela.possuiMatutino == \'true\'" class="row"><inep-text-area np-id="descricaoReaplicacao" np-size="12" np-rows="20" np-maxlength="500" ng-model="c.dtoMatutino.justificativa" np-readonly="!c.isSolicitacao" np-resize="false" np-optional="false" np-label="Justificativa" np-editor="false"></inep-text-area></div><div ng-if="!c.isSolicitacao &amp;&amp; !!c.tela.exibirResultado" class="row"><inep-input-text np-id="inputSituacao" np-label="Situação: " ng-model="c.dtoMatutino.situacao" np-optional="true" np-readonly="!c.isSolicitacao" np-size="4" np-accessibility-message="{{c.mensagens.MSGA004}}"></inep-input-text></div><div ng-if="c.tela.possuiMatutinoInfecto == \'true\' &amp;&amp; c.tela.possuiMatutino == \'false\'" class="row"><inep-input-text ng-if="c.fileMatutino.nomeArquivo != null &amp;&amp; c.fileMatutino.nomeArquivo != undefined" np-id="nomeArquivo" np-maxlength="150" np-size="6" ng-model="c.fileMatutino.nomeArquivo" np-readonly="true" np-optional="true" np-label="Laudo: " np-name="selectedFile"></inep-input-text><inep-input-file ng-if="!c.fileMatutino.nomeArquivo || c.fileMatutino.nomeArquivo == null || c.fileMatutino.nomeArquivo == undefined" np-id="laudoDoencaInfectocontagiosaMatutino" np-label="Laudo: " np-value="c.fileMatutino" np-max-file-size="c.maxFileSize" np-show-icon="true" np-size="6" np-max-file-message="Tamanho de arquivo inválido." np-content-type-message="Formato de arquivo inválido." np-disabled="" np-optional="false" inep-validator="c.validarArquivo(c.fileMatutino)" np-content-types="c.contentTypes" np-empty-message="{{c.mensagens.MSG_ARQUIVO_VAZIO}}"></inep-input-file><div ng-if="c.isFileValid(c.fileMatutino) &amp;&amp; !c.fileMatutino.send" class="col-md-4"><button id="enviarLaudoDoencaInfectocontagiosa" ng-click="c.enviarArquivo(c.fileMatutino)" class="btn btn-default align-button-upload">Salvar laudo</button></div></div><div ng-if="c.tela.possuiMatutino == \'false\' &amp;&amp; c.tela.possuiMatutinoInfecto == \'false\'" class="row"><div class="col-md-12"><p tabindex="0">O não comparecimento nos locais de provas, nas datas e nos horários informados pelo\nInep caracterizará ausência do participante, não havendo segunda oportunidade para a\nrealização das provas.  O participante que não compareceu para a realização das\nprovas de todas as áreas do conhecimento em que se inscreveu para o Encceja Nacional\n2026 e quiser realizar uma nova inscrição gratuita na próxima edição do Encceja\nNacional deverá justificar sua ausência na próxima edição do Exame.</p></div></div><div ng-if="c.tela.possuiMatutinoInfecto == &quot;true&quot; &amp;&amp; c.fileMatutino.send" class="col-md-6"><inep-output-text id="mensagem_laudo" style="font-size: 16px" ng-model="c.fileMatutino.msgEnvio"></inep-output-text></div><div ng-if="c.dtoMatutino.situacao === \'Reprovado\' &amp;&amp; c.dtoMatutino.txIndeferimento !== null &amp;&amp; c.dtoMatutino.txIndeferimento !== undefined &amp;&amp; !!c.tela.exibirResultado" class="row"><inep-text-area np-id="descricaoMotivoIndeferimento" np-size="12" np-rows="20" np-maxlength="500" ng-model="c.dtoMatutino.txIndeferimento" np-readonly="true" np-resize="false" np-optional="true" np-label="Motivo da Reprovação:" np-editor="false"></inep-text-area></div></div></div><div ng-if="c.tela.possuiVespertino == \'true\' || !!c.tela.possuiVespertinoInfecto" class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Vespertino</h2></div><div class="panel-body"><div ng-if="c.tela.possuiVespertino == \'true\'" class="row"><inep-combobox np-id="comboMotivos" np-label="Motivo: " np-values="c.tela.motivosReaplicacao" np-selected-value="c.dtoVespertino.motivo" np-size="6" np-optional="false" np-disabled="!c.isSolicitacao" np-accessibility-message="{{c.mensagens.MSGA055}}"></inep-combobox></div><div ng-if="c.tela.possuiVespertinoInfecto == \'true\' &amp;&amp; c.tela.possuiVespertino == \'false\'" style="margin-left: 0" class="row"><div class="col-12"><p>Envie um documento que comprove uma das doenças infectocontagiosas citadas abaixo, de acordo com o edital.<ul><li>Tuberculose</li><li>Coqueluche</li><li>Difteria</li><li>Doença Invasiva por Haemophilus Influenzae</li><li>Doença Meningocócica e outras meningites</li><li>Varíola</li><li>Influenza humana A e B</li><li>Poliomielite por poliovírus selvagem</li><li>Sarampo</li><li>Rubéola</li><li>Varicela (catapora)</li><li>Varíola dos macacos (monkeypox)</li><li>Covid-19</li></ul></p></div></div><div ng-if="c.tela.possuiVespertino == \'true\'" class="row"><inep-text-area np-id="descricaoReaplicacao" np-size="12" np-rows="20" np-maxlength="500" ng-model="c.dtoVespertino.justificativa" np-readonly="!c.isSolicitacao" np-resize="false" np-optional="false" np-label="Justificativa" np-editor="false"></inep-text-area></div><div ng-if="!c.isSolicitacao &amp;&amp; !!c.tela.exibirResultado" class="row"><inep-input-text np-id="inputSituacao" np-label="Situação: " ng-model="c.dtoVespertino.situacao" np-optional="true" np-readonly="!c.isSolicitacao" np-size="4" np-accessibility-message="{{c.mensagens.MSGA004}}"></inep-input-text></div><div ng-if="c.tela.possuiVespertinoInfecto == \'true\' &amp;&amp; c.tela.possuiVespertino == \'false\'" class="row"><inep-input-text ng-if="c.fileVespertino.nomeArquivo != null &amp;&amp; c.fileVespertino.nomeArquivo != undefined" np-id="nomeArquivo" np-maxlength="150" np-size="6" ng-model="c.fileVespertino.nomeArquivo" np-readonly="true" np-optional="true" np-label="Laudo: " np-name="selectedFile"></inep-input-text><inep-input-file ng-if="!c.fileVespertino.nomeArquivo || c.fileVespertino.nomeArquivo == null || c.fileVespertino.nomeArquivo == undefined" np-id="laudoDoencaInfectocontagiosaVespertino" np-label="Laudo: " np-value="c.fileVespertino" np-max-file-size="c.maxFileSize" np-show-icon="true" np-size="6" np-max-file-message="Tamanho de arquivo inválido." np-content-type-message="Formato de arquivo inválido." np-disabled="" np-optional="false" inep-validator="c.validarArquivo(c.fileVespertino)" np-content-types="c.contentTypes" np-empty-message="{{c.mensagens.MSG_ARQUIVO_VAZIO}}"></inep-input-file><div ng-if="c.isFileValid(c.fileVespertino) &amp;&amp; !c.fileVespertino.send" class="col-md-4"><button id="enviarLaudoDoencaInfectocontagiosa" ng-click="c.enviarArquivo(c.fileVespertino)" class="btn btn-default align-button-upload">Salvar laudo</button></div></div><div ng-if="c.tela.possuiVespertino == \'false\' &amp;&amp; c.tela.possuiVespertinoInfecto == \'false\'" class="row"><div class="col-md-12"><p tabindex="0">O não comparecimento nos locais de provas, nas datas e nos horários informados pelo\nInep caracterizará ausência do participante, não havendo segunda oportunidade para a\nrealização das provas.  O participante que não compareceu para a realização das\nprovas de todas as áreas do conhecimento em que se inscreveu para o Encceja Nacional\n2026 e quiser realizar uma nova inscrição gratuita na próxima edição do Encceja\nNacional deverá justificar sua ausência na próxima edição do Exame.</p></div></div><div ng-if="c.tela.possuiVespertinoInfecto == &quot;true&quot; &amp;&amp; c.fileVespertino.send" class="col-md-6"><inep-output-text id="mensagem_laudo" style="font-size: 16px" ng-model="c.fileVespertino.msgEnvio"></inep-output-text></div><div ng-if="c.dtoVespertino.situacao === \'Reprovado\' &amp;&amp; c.dtoVespertino.motivoIndeferimento !== null  &amp;&amp; c.dtoVespertino.txIndeferimento !== undefined &amp;&amp; !!c.tela.exibirResultado" class="row"><inep-text-area np-id="descricaoMotivoIndeferimento" np-size="12" np-rows="20" np-maxlength="500" ng-model="c.dtoVespertino.txIndeferimento" np-readonly="true" np-resize="false" np-optional="true" np-label="Motivo da Reprovação:" np-editor="false"></inep-text-area></div></div></div><div ng-if="(c.dtoMatutino.situacao == \'Aprovado\' || c.dtoVespertino.situacao == \'Aprovado\') &amp;&amp; c.resultadoEnccejaReaplicacaoVisivel" class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Comunicado</h2></div><div class="panel-body"><div class="with-space-top"><div class="row with-space-bottom col-md-12"><div><p>Você teve a solicitação de Reaplicação do Encceja 2026 APROVADA!</p><br/><div ng-if="c.tela.ensino === 1"><p><b>A reaplicação será realizada no dia 23 de setembro de 2026 para o Ensino Fundamental.</b></p></div><div ng-if="c.tela.ensino === 2"><p><b>A reaplicação será realizada no dia 24 de setembro de 2026 para o Ensino Médio.</b></p></div><br/><!--div(ng-if="c.dtoMatutino.situacao === \'Aprovado\'")--><!--  b Horários Manhã:&nbsp;--><!--  | (horário de Brasília/DF)--><!--  br--><!--  | Abertura dos Portões: 8h--><!--  br--><!--  | Fechamento dos Portões: 8h45--><!--  br--><!--  br--><!--div(ng-if="c.dtoVespertino.situacao === \'Aprovado\'")--><!--  b Horários Tarde:&nbsp;--><!--  | (horário de Brasília/DF)--><!--  br--><!--  | Abertura dos Portões: 14h30--><!--  br--><!--  | Fechamento dos Portões: 15h15--><!--  br--><!--  br--><p>Em breve divulgaremos seu local de provas. Fique atento a essa Página do Participante para consultar seu local de provas.</p><p>Para esclarecimentos adicionais, entre em contato com a Central de Atendimento pelo telefone: 0800 61 61 61.</p><br/><p>Boa prova!</p></div></div></div></div></div></div><div class="clearfix"><ul class="pagination margin-bottom-none pull-right"><li ng-if="c.isSolicitacao" class="primary"><button ng-click="c.salvar()" role="button" type="submit" class="btn btn-primary">Salvar</button></li></ul></div></div><div inep-modal="inep-modal" np-id="modalReaplicacao" np-buttons="modalReaplicacao.buttons" np-show="modalReaplicacao.show" np-options="modalReaplicacao.options" np-header="Aviso"><p tabindex="0">{{ modalReaplicacao.message }}</p></div></form></div></div></div><div inep-modal="inep-modal" np-buttons="c.buttons" np-show="c.modalShow" np-id="modal" np-options="c.modalOptions" np-header="Aviso"><p tabindex="0">{{ c.modalMessage }}</p></div><div inep-modal="inep-modal" np-id="modalCarencia" np-buttons="c.modalCarencia.buttons" np-show="c.modalCarencia.show" np-options="c.modalCarencia.options" np-header="Aviso"><p tabindex="0">{{ c.modalCarencia.message }}</p></div><div inep-modal="inep-modal" np-id="modalExibirMensagem" np-buttons="c.modalExibirMensagem.buttons" np-show="c.modalExibirMensagem.show" np-options="c.modalExibirMensagem.options" np-header="Avaliar serviço"><p tabindex="0">{{ c.modalExibirMensagem.saudacao }}</p><p tabindex="0">{{ c.modalExibirMensagem.message }}</p></div><div inep-modal="inep-modal" np-buttons="c.modalSair.buttons" np-show="c.modalSair.show" np-id="modalSair" np-options="c.modalSair.options" np-header="Aviso"><p tabindex="0">{{ c.modalSair.saudacao }}</p><p tabindex="0">{{ c.modalSair.message }}</p></div></div></div></section></main>'),
a.put("views/acompanhamento/reaplicacaoSucesso.html",'<div class="with-space-top"><div class="row with-space-bottom col-md-12"><div><p>Você teve a solicitação de Reaplicação do Encceja 2026 APROVADA!</p><br/><div ng-if="c.tela.ensino === 1"><p><b>A reaplicação será realizada no dia 23 de setembro de 2026 para o Ensino Fundamental.</b></p></div><div ng-if="c.tela.ensino === 2"><p><b>A reaplicação será realizada no dia 24 de setembro de 2026 para o Ensino Médio.</b></p></div><br/><!--div(ng-if="c.dtoMatutino.situacao === \'Aprovado\'")--><!--  b Horários Manhã:&nbsp;--><!--  | (horário de Brasília/DF)--><!--  br--><!--  | Abertura dos Portões: 8h--><!--  br--><!--  | Fechamento dos Portões: 8h45--><!--  br--><!--  br--><!--div(ng-if="c.dtoVespertino.situacao === \'Aprovado\'")--><!--  b Horários Tarde:&nbsp;--><!--  | (horário de Brasília/DF)--><!--  br--><!--  | Abertura dos Portões: 14h30--><!--  br--><!--  | Fechamento dos Portões: 15h15--><!--  br--><!--  br--><p>Em breve divulgaremos seu local de provas. Fique atento a essa Página do Participante para consultar seu local de provas.</p><p>Para esclarecimentos adicionais, entre em contato com a Central de Atendimento pelo telefone: 0800 61 61 61.</p><br/><p>Boa prova!</p></div></div></div>'),a.put("views/acompanhamento/recuperarSenha.html",'<header role="banner"><h1 class="hide"> - </h1><nav role="navigation" aria-labelledby="#nav" ng-controller="NavigationBarController" class="navbar navbar-default navbar-fixed-top"><h2 id="nav" class="hide">Navegação Principal</h2><div class="container-fluid"><div class="navbar-header text-center"><button type="button" data-toggle="offcanvas" class="navbar-toggle collapsed left"><span class="sr-only">Toggle navigation</span><span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span></button><div aria-label="Bem vindo ao INEP" class="navbar-brand"><img src="images/logo_inep.svg" alt="Instituto Nacional de Estudos e Pesquisas Educacionais Anísio Teixeira"/></div><button type="button" data-toggle="collapse" data-target="#navbar-collapse" class="navbar-toggle collapsed right p-n"><span class="sr-only">Toggle navigation</span><i class="fa fa-gear text-white"></i></button></div><!--#navbar-collapse.collapse.navbar-collapse--><!--  ul.nav.navbar-nav--><!--    li.active--><!--      span.logo-inep.h3.m-n.font-700(data-toggle=\'tooltip\', data-placement=\'bottom\', title=project.name) #{project.abbr}--><!----><!--  ul.nav.navbar-nav.navbar-right--><!--    if !login--><!--      li--><!--        span(data-toggle=\'dropdown\') #[i.fa.fa-user] Participante: {{nomeParticipanteLogado}}--><!--    li--><!--      a.contrast(href=\'#\', inep-contrast="", data-toggle=\'tooltip\', data-placement=\'bottom\', aria-label=\'Contraste\') #[i.fa.fa-adjust]--><script type="text/ng-template" id="warning-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Você ainda está aí?</h3></div><div idle-countdown="countdown" class="modal-body"><uib-progressbar max="30" value="countdown" animate="true" class="progress-striped active"></uib-progressbar>Sua sessão será encerrada em {{countdown}} segundos.</div></div></script><script type="text/ng-template" id="timedout-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Sess&atilde;o encerrada.</h3></div><div class="modal-body"><p></p>Sua sess&atilde;o foi encerrada por inatividade.</div></div></script></div></nav></header><main role="main"><section class="login"><h1 class="hide">Painel de entrada</h1><div class="container-fluid"><article><header class="text-center m-b"><div class="row"><div class="col-md-12 fundo-logo"><figure><img src="images/Logo-Encceja2026.png" alt="Exame Nacional para Certificação de Competências de Jovens e Adultos" style="margin-left: 4%;"/></figure></div></div></header></article></div><div class="container"><div class="row"><div class="col-sm-8 col-sm-offset-2 col-lg-4 col-lg-offset-4"><form autocomplete="off" inep-message-bag="inep-message-bag" message-bag-header-error="O formulário abaixo está inválido pelos seguintes erros:" name="recuperarSenhaForm" novalidate="true" ng-controller="RecuperarSenhaCertificadoraController as c"><div class="panel panel-info"><div class="panel-heading"><h2 tabindex="0" focus-me="focus-me" class="h4 panel-title text-center text-primary">Encceja Certificadoras\n</h2></div><div class="panel-body"><div inep-modal="inep-modal" np-buttons="c.buttons" np-show="c.modalShow" np-id="c.modal" np-options="c.modalOptions" np-header="ENCCEJA- Certificadoras."><p tabindex="0">{{ c.modalMessage }}</p></div><p tabindex="0">Para realizar a recupera&ccedil;&atilde;o de senha &eacute; necess&aacute;rio preencher as\ninforma&ccedil;&otilde;es corretamente e\naguardar o recebimento do e-mail contendo as devidas instru&ccedil;&otilde;es.</p><div class="row"><inep-input-text np-accessibility-message="{{c.mensagens.MSGA001}}" np-id="nome" np-label="Nome completo: " ng-model="c.dto.nome" np-optional="false" np-size="12"></inep-input-text></div><div class="row"><div class="col-sm-12"><inep-calendar np-accessibility-message="{{ c.mensagens.MSGA003 }}" np-clear-text="Limpar" np-close-text="Fechar" np-current-text="Hoje" np-hide-icon="true" np-id="calendar" np-label="Data de nascimento:" np-min-date="minDate" ng-model="c.dto.dataDeNascimento" np-optional="false" np-starting-day="0" np-type="popup" np-width="12" np-year-range="20"></inep-calendar></div></div><div class="row"><inep-email np-id="inputEmail" np-label="E-mail: " np-optional="false" np-value="c.dto.email" np-allow-copy="false" np-allow-cut="false" np-allow-paste="false" np-size="12" np-maxlength="255" np-accessibility-message="{{c.mensagens.MSGA006}}"></inep-email></div><div class="row"><inep-email np-id="inputEmail" np-label="Confirme o email: " np-confirm-value="c.dto.email" np-optional="false" np-value="c.dto.emailconfirme" np-allow-copy="false" np-allow-cut="false" np-allow-paste="false" np-size="12" np-maxlength="255" np-accessibility-message="{{c.mensagens.MSGA006}}"></inep-email></div><div class="row with-space"><inep-visual-captcha></inep-visual-captcha></div></div><ul class="list-group"><li class="list-group-item"><a ui-sref="loginCertificadora" title="{{c.mensagens.MSGA000_}}"><i class="fa fa-sign-out text-dark"></i>Sair<span style="position: absolute; left: -999em;">{{c.mensagens.MSGA000_}}</span></a><span class="pull-right"><a ui-sref="recuperarSenhaToken" title="Recuperar senha via Token." style="cursor: pointer"><i class="fa fa-sign-out text-dark"></i>Alterar Senha Recuperada via TOKEN</a></span></li></ul><footer class="panel-footer p-n"><button type="submit" ng-disabled="recuperarSenhaForm.$invalid" ng-click="c.enviar()" class="btn btn-default btn-block"><i class="fa fa-paper-plane-o"></i>&nbsp Confirmar</button></footer></div></form></div></div></div></section></main>'),a.put("views/acompanhamento/recuperarSenhaToken.html",'<header role="banner"><h1 class="hide"> - </h1><nav role="navigation" aria-labelledby="#nav" ng-controller="NavigationBarController" class="navbar navbar-default navbar-fixed-top"><h2 id="nav" class="hide">Navegação Principal</h2><div class="container-fluid"><div class="navbar-header text-center"><button type="button" data-toggle="offcanvas" class="navbar-toggle collapsed left"><span class="sr-only">Toggle navigation</span><span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span></button><div aria-label="Bem vindo ao INEP" class="navbar-brand"><img src="images/logo_inep.svg" alt="Instituto Nacional de Estudos e Pesquisas Educacionais Anísio Teixeira"/></div><button type="button" data-toggle="collapse" data-target="#navbar-collapse" class="navbar-toggle collapsed right p-n"><span class="sr-only">Toggle navigation</span><i class="fa fa-gear text-white"></i></button></div><!--#navbar-collapse.collapse.navbar-collapse--><!--  ul.nav.navbar-nav--><!--    li.active--><!--      span.logo-inep.h3.m-n.font-700(data-toggle=\'tooltip\', data-placement=\'bottom\', title=project.name) #{project.abbr}--><!----><!--  ul.nav.navbar-nav.navbar-right--><!--    if !login--><!--      li--><!--        span(data-toggle=\'dropdown\') #[i.fa.fa-user] Participante: {{nomeParticipanteLogado}}--><!--    li--><!--      a.contrast(href=\'#\', inep-contrast="", data-toggle=\'tooltip\', data-placement=\'bottom\', aria-label=\'Contraste\') #[i.fa.fa-adjust]--><script type="text/ng-template" id="warning-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Você ainda está aí?</h3></div><div idle-countdown="countdown" class="modal-body"><uib-progressbar max="30" value="countdown" animate="true" class="progress-striped active"></uib-progressbar>Sua sessão será encerrada em {{countdown}} segundos.</div></div></script><script type="text/ng-template" id="timedout-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Sess&atilde;o encerrada.</h3></div><div class="modal-body"><p></p>Sua sess&atilde;o foi encerrada por inatividade.</div></div></script></div></nav></header><main role="main"><section class="login"><h1 class="hide">Painel de entrada</h1><div class="container-fluid"><article><header class="text-center m-b"><div class="row"><div class="col-md-12 fundo-logo"><figure><img src="images/Logo-Encceja2026.png" alt="Exame Nacional para Certificação de Competências de Jovens e Adultos" style="margin-left: 4%;"/></figure></div></div></header></article></div><div class="container"><div class="row"><div class="col-sm-8 col-sm-offset-2 col-lg-4 col-lg-offset-4"><form autocomplete="off" inep-message-bag="inep-message-bag" message-bag-header-error="O formulário abaixo está inválido pelos seguintes erros:" name="recuperarSenhaTokenForm" novalidate="true" ng-controller="RecuperarSenhaTokenController as c"><div class="panel panel-info"><div class="panel-heading"><h2 tabindex="0" focus-me="focus-me" class="h4 panel-title text-center text-primary">Encceja Certificadoras\n</h2></div><div class="panel-body"><div inep-modal="inep-modal" np-buttons="c.buttons" np-show="c.modalShow" np-id="c.modal" np-options="c.modalOptions" np-header="ENCCEJA- Certificadoras."><p tabindex="0">{{ c.modalMessage }}</p></div><p tabindex="0">Para realizar a altera&ccedil;&atilde;o da senha &eacute; necess&aacute;rio preencher de acordo com o padr&atilde;o de valida&ccedil;&atilde;o.</p><div class="row"><div class="col-sm-12"><label tabindex="0">Validação da Senha Nova:</label><div style="padding-bottom: 15px;"><div tabindex="0" ng-repeat="regra in regras"><i ng-class="regra.className()"></i>{{regra.descricao}}</div></div></div></div><div class="row"><inep-input-text np-accessibility-message="{{c.mensagens.MSGA001}}" np-id="nome" np-label="Token: " ng-model="c.dto.token" np-optional="false" np-readonly="c.tokenDisabled" np-size="12"></inep-input-text></div><div class="row"><inep-password np-value="c.dto.senhaNova" np-label="Senha Nova: " np-id="senhaNova" np-maxlength="20" np-optional="false" np-size="12" np-title-password="Senha Nova" np-allow-paste="false" np-accessibility-message="O campo é obrigatório. A senha deve possuir um tamanho de {{passwordMinlength}} a 20 dígitos alfanuméricos, com pelo menos um número, uma letra minúscula e uma maiúscula, e um dos símbolos !@#$%&amp;*." np-show-strench="true"></inep-password></div><div class="row"><inep-password np-value="c.dto.senhaConfirmacao" np-label="Confirmação da Senha Nova: " np-id="senhaConfirmacao" np-maxlength="20" np-optional="false" np-size="12" np-title-password="Confirmação da Senha Nova" np-confirm-value="c.dto.senhaNova" np-allow-paste="false" np-accessibility-message="O campo é obrigatório. A senha de confirmação deve ser igual à senha nova."></inep-password></div><div class="row with-space"><inep-visual-captcha></inep-visual-captcha></div></div><ul class="list-group"><li class="list-group-item"><a ui-sref="loginCertificadora" title="{{c.mensagens.MSGA000_}}"><i class="fa fa-sign-out text-dark"></i>Sair<span style="position: absolute; left: -999em;">{{c.mensagens.MSGA000_}}</span></a></li></ul><footer class="panel-footer p-n"><button type="submit" ng-disabled="recuperarSenhaTokenForm.$invalid" ng-click="c.enviar()" class="btn btn-default btn-block"><i class="fa fa-paper-plane-o"></i>&nbsp Confirmar</button></footer></div></form></div></div></div></section></main>'),a.put("views/acompanhamento/recursoJustificativaAusencia.html",'<header role="banner"><h1 class="hide"> - </h1><nav role="navigation" aria-labelledby="#nav" ng-controller="NavigationBarController" class="navbar navbar-default navbar-fixed-top"><h2 id="nav" class="hide">Navegação Principal</h2><div class="container-fluid"><div class="navbar-header text-center"><button type="button" data-toggle="offcanvas" class="navbar-toggle collapsed left"><span class="sr-only">Toggle navigation</span><span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span></button><div aria-label="Bem vindo ao INEP" class="navbar-brand"><img src="images/logo_inep.svg" alt="Instituto Nacional de Estudos e Pesquisas Educacionais Anísio Teixeira"/></div><button type="button" data-toggle="collapse" data-target="#navbar-collapse" class="navbar-toggle collapsed right p-n"><span class="sr-only">Toggle navigation</span><i class="fa fa-gear text-white"></i></button></div><!--#navbar-collapse.collapse.navbar-collapse--><!--  ul.nav.navbar-nav--><!--    li.active--><!--      span.logo-inep.h3.m-n.font-700(data-toggle=\'tooltip\', data-placement=\'bottom\', title=project.name) #{project.abbr}--><!----><!--  ul.nav.navbar-nav.navbar-right--><!--    if !login--><!--      li--><!--        span(data-toggle=\'dropdown\') #[i.fa.fa-user] Participante: {{nomeParticipanteLogado}}--><!--    li--><!--      a.contrast(href=\'#\', inep-contrast="", data-toggle=\'tooltip\', data-placement=\'bottom\', aria-label=\'Contraste\') #[i.fa.fa-adjust]--><script type="text/ng-template" id="warning-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Você ainda está aí?</h3></div><div idle-countdown="countdown" class="modal-body"><uib-progressbar max="30" value="countdown" animate="true" class="progress-striped active"></uib-progressbar>Sua sessão será encerrada em {{countdown}} segundos.</div></div></script><script type="text/ng-template" id="timedout-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Sess&atilde;o encerrada.</h3></div><div class="modal-body"><p></p>Sua sess&atilde;o foi encerrada por inatividade.</div></div></script></div></nav></header><main role="main"><section class="login"><h1 class="hide">Painel de entrada</h1><div ng-controller="AcompanhamentoController as c" ng-init="c.init()"><div id="sideBar" class="col-sm-3 col-md-2 sidebar sidebar-offcanvas"><section><header></header><nav aria-labeledby="#nav"><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeEspelho()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" ng-click="c.navegarEspelho()" ng-if="!c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Acompanhar inscri&ccedil;&atilde;o {{c.anoEdicao}}</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.downloadDeclaracao()", ng-if="!c.isLoginLocalProva && c.menu.exibeDeclaracaoComparecimento()") Declara&ccedil;&atilde;o Comparecimento--><a style="cursor: pointer" ng-click="c.downloadDeclaracao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Declara&ccedil;&atilde;o Comparecimento</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarCartaoConfirmacao()", ng-if="!c.isLoginLocalProva && !c.menu.exibeCartaoConfirmacao()") Local de Prova/Cart&atilde;o Confirma&ccedil;&atilde;o--><a style="cursor: pointer" ng-click="c.navegarCartaoConfirmacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Local de Prova/Cart&atilde;o Confirma&ccedil;&atilde;o</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarDoencaInfectocontagiosa()", ng-if="!c.isLoginLocalProva && c.menu.exibeDoencaInfectocontagiosa()") Doenças Infectocontagiosas--><a style="cursor: pointer" ng-click="c.navegarDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuDoencaInfectoContagiosaVisivel.menuDoencaInfectoContagiosaEnabled" class="ng-scope">Doenças Infectocontagiosas</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarResultadoDoencaInfectocontagiosa()", ng-if="!c.isLoginLocalProva && c.menu.exibeResultadoDoencaInfectocontagiosa()") Resultado de Doenças Infectocontagiosas--><a style="cursor: pointer" ng-click="c.navegarResultadoDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuResultadoDoencaInfectoContagiosaVisivel.menuResultadoDoencaInfectoContagiosaEnabled" class="ng-scope">Resultado de Doenças Infectocontagiosas</a></li><li class="ng-scope"><a style="cursor: pointer" ng-click="c.navegarReaplicacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeReaplicacao() || c.menu.exibeReaplicacaoResultado()" class="ng-scope">Solicita&ccedil;&atilde;o de Reaplica&ccedil;&atilde;o</a><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarReaplicacao()", ng-if="!c.isLoginLocalProva && c.solicitarEnccejaReaplicacaoVisivel.exibirSolicitarEnccejaReaplicacaoEnabled") Registro de Ocorr&ecirc;ncias de Aplica&ccedil;&atilde;o--></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" class="ng-scope">Alterar dados</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarDadosPessoais()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeAlterarDadosInscricao()" class="ng-scope">Informa&ccedil;&otilde;es pessoais</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope"><!--ng-click="c.navegarAtendimentosEspecializados()",--><!--ng-if="!c.isLoginLocalProva && c.menu.exibeAlterarDadosInscricao()")-->Atendimento Especializado</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 40px" ng-click="c.navegarAtendimentosEspecializados()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope">Solicitar / Alterar Solicitação</a><!--ng-if="!c.isLoginLocalProva && false") Atendimento Especializado--></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer; padding-left: 30px", ng-click="c.navegarMunicipioProva()", ng-if="!c.isLoginLocalProva && c.menu.exibeAlterarDadosInscricao()") Informa&ccedil;&otilde;es de prova--><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarMunicipioProva()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuInformacoesProvaVisivel.inscricaoEmAndamento" class="ng-scope">Informa&ccedil;&otilde;es de prova</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer; padding-left: 30px", ng-click="c.navegarJustificativaAusencia()", ng-if="!c.isLoginLocalProva && c.menu.exibeAcompanhamentoJustificativa()") Justificativa de aus&ecirc;ncia--><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarJustificativaAusencia()" ng-if="c.validarExibicaoAcompanhamentoJustific()" class="ng-scope">Justificativa de aus&ecirc;ncia</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarContato()" class="ng-scope">Contato</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; false" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="atualizarSenha" class="ng-scope">Senha</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeLaudoMedico() && !!c.menuRecursoLaudoMedico")--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuRecursoLaudoMedico" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarLaudoMedico()" class="ng-scope">Recurso Laudo M&eacute;dico</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeTratamentoSocial()")--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuTratamentoNomeSocialVisivel.menuTratamentoNomeSocialEnabled" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="nomeSocial" class="ng-scope">Tratamento pelo Nome Social</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeReenvioTratamentoSocial()") verificar se eh recurso ou resultado--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.recursoMenuTratamentoNomeSocialVisivel.recursoMenuTratamentoNomeSocialEnabled &amp;&amp; !!c.menuRecursoNomeSocial" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="reenvioNomeSocial" class="ng-scope">Recurso Nome Social</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menu.exibeBoletoCobranca()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="boletoCobranca" class="ng-scope">Boleto de Cobrança</a></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultados()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" class="ng-scope">Resultado</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2017()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2017" class="ng-scope">ENCCEJA 2017</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2018()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2018" class="ng-scope">ENCCEJA 2018</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2019()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2019" class="ng-scope">ENCCEJA 2019</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2020()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2020" class="ng-scope">ENCCEJA 2020</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2022()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2022" class="ng-scope">ENCCEJA 2022</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2023()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2023" class="ng-scope">ENCCEJA 2023</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2024()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2024" class="ng-scope">ENCCEJA 2024</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2025()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2025" class="ng-scope">ENCCEJA 2025</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2026()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2026" class="ng-scope">ENCCEJA 2026</a></li></ul><ul inep-sidebar="inep-sidebar" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" ng-click="c.sair()" class="ng-scope">Sair</a></li></ul></nav></section></div><div class="col-sm-9 col-sm-offset-3 col-md-10 col-md-offset-2"><div class="panel-box ng-scope"><div ng-controller="RecursoJustificativaAusenciaController as c"><header><!--.page-header.with-space-top: h1.h3 Inscri&ccedil;&atilde;o > ENCCEJA {{ c.anoEdicao }} #[small justificativa de aus&ecirc;ncia]--><div class="page-header with-space-top"><h1 class="h3">Inscri&ccedil;&atilde;o > ENCCEJA <small>justificativa de aus&ecirc;ncia</small></h1></div></header><div class="row"><div class="col-md-12"><form autocomplete="off" inep-message-bag="inep-message-bag" message-bag-header-error="O formulário abaixo está inválido pelos seguintes erros:" name="justificativaForm" novalidate="true" role="form"><div inep-modal="inep-modal" np-id="modal" np-buttons="c.modal.buttons" np-show="c.modal.show" np-options="c.modal.options" np-header="Aviso"><p tabindex="0">{{ c.modal.message }}</p></div><div class="panel panel-info"><!--.panel-heading: h2.h4.panel-title.text-left.text-primary Motivo da Ausência no Encceja 2019--><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Motivo da Ausência no Encceja {{ c.anoEdicao }}</h2></div><div class="panel-body"><div class="row"><inep-radiobutton np-id="radioNivel" np-label="Qual a justificativa para a sua ausência ao Encceja {{ c.anoEdicao }}?" np-values="c.opcoesJustificativa" np-selected-value="c.informacoesJustificativa.coJustificativa" np-on-change="c.motivoJustificativaOnChange()" np-optional="false" np-size="12"></inep-radiobutton></div><div class="row with-space-top"><div ng-if="!!c.descricaoArquivo" class="col-md-12"><div class="box-describe"><span ng-bind-html="c.trust(c.descricaoArquivo)" class="text-justify"></span><br/><br/><span class="text-justify">Somente ser&atilde;o aceitos documentos no formato PDF, PNG ou JPG, no tamanho m&aacute;ximo de 2MB.</span></div></div></div><div ng-if="c.descricaoArquivo" ng-repeat="a in c.arquivos" class="row with-space-bottom"><enem-fieldset><div ng-if="!a.send" class="col-md-8"><span style="color: #0e377d;font-weight: bold;" class="text-justify">{{a.label}}</span><i ng-if="a.obrigatorio" style="margin-left: 2px" class="fa fa-asterisk fa"></i><inep-input-file np-id="arquivo_{{a.id}}" np-label="" np-value="a.file" np-max-file-size="c.maxFileSize" np-show-icon="true" np-size="12" np-max-file-message="Tamanho de arquivo inválido." np-content-type-message="Formato de arquivo inválido." np-disabled="" np-optional="!a.obrigatorio" inep-validator="c.isFileValid(a.file, c.maxFileSize, c.contentTypes)" np-content-types="c.contentTypes" np-empty-message="{{c.mensagens.MSG_ARQUIVO_VAZIO}}"></inep-input-file></div><div ng-if="c.isFileValid(a.file, c.maxFileSize, c.contentTypes) &amp;&amp; !a.send" style="padding-top: 17px;" class="col-md-4"><button id="enviar_arquivo_{{a.id}}" ng-click="c.enviarArquivo(a)" class="btn btn-default">Enviar arquivo</button></div><div ng-if="a.send" class="col-md-8"><span style="color: #0e377d;font-weight: bold;" class="text-justify">{{a.label}}</span><br/><inep-output-text id="mensagem_arquivo_{{a.id}}" ng-model="c.mensagemArquivoEnviado"></inep-output-text></div><div ng-if="a.send" class="col-md-4"><button id="excluir_arquivo_{{a.id}}" ng-click="c.excluirArquivo(a)" class="btn btn-default ">Excluir arquivo</button></div></enem-fieldset></div></div><div ng-if="c.isRecurso" class="clearfix"><ul class="pagination margin-bottom-none pull-right"><li class="primary"><button ng-click="c.cancelar()" role="button" class="btn btn-primary">Cancelar</button></li><li class="primary"><button ng-click="c.salvarRecurso()" role="button" class="btn btn-primary">Enviar recurso</button></li></ul></div></div></form></div></div></div></div><div inep-modal="inep-modal" np-buttons="c.buttons" np-show="c.modalShow" np-id="modal" np-options="c.modalOptions" np-header="Aviso"><p tabindex="0">{{ c.modalMessage }}</p></div><div inep-modal="inep-modal" np-id="modalCarencia" np-buttons="c.modalCarencia.buttons" np-show="c.modalCarencia.show" np-options="c.modalCarencia.options" np-header="Aviso"><p tabindex="0">{{ c.modalCarencia.message }}</p></div><div inep-modal="inep-modal" np-id="modalExibirMensagem" np-buttons="c.modalExibirMensagem.buttons" np-show="c.modalExibirMensagem.show" np-options="c.modalExibirMensagem.options" np-header="Avaliar serviço"><p tabindex="0">{{ c.modalExibirMensagem.saudacao }}</p><p tabindex="0">{{ c.modalExibirMensagem.message }}</p></div><div inep-modal="inep-modal" np-buttons="c.modalSair.buttons" np-show="c.modalSair.show" np-id="modalSair" np-options="c.modalSair.options" np-header="Aviso"><p tabindex="0">{{ c.modalSair.saudacao }}</p><p tabindex="0">{{ c.modalSair.message }}</p></div></div></div></section></main>'),a.put("views/acompanhamento/reenvioNomeSocial.html",'<header role="banner"><h1 class="hide"> - </h1><nav role="navigation" aria-labelledby="#nav" ng-controller="NavigationBarController" class="navbar navbar-default navbar-fixed-top"><h2 id="nav" class="hide">Navegação Principal</h2><div class="container-fluid"><div class="navbar-header text-center"><button type="button" data-toggle="offcanvas" class="navbar-toggle collapsed left"><span class="sr-only">Toggle navigation</span><span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span></button><div aria-label="Bem vindo ao INEP" class="navbar-brand"><img src="images/logo_inep.svg" alt="Instituto Nacional de Estudos e Pesquisas Educacionais Anísio Teixeira"/></div><button type="button" data-toggle="collapse" data-target="#navbar-collapse" class="navbar-toggle collapsed right p-n"><span class="sr-only">Toggle navigation</span><i class="fa fa-gear text-white"></i></button></div><!--#navbar-collapse.collapse.navbar-collapse--><!--  ul.nav.navbar-nav--><!--    li.active--><!--      span.logo-inep.h3.m-n.font-700(data-toggle=\'tooltip\', data-placement=\'bottom\', title=project.name) #{project.abbr}--><!----><!--  ul.nav.navbar-nav.navbar-right--><!--    if !login--><!--      li--><!--        span(data-toggle=\'dropdown\') #[i.fa.fa-user] Participante: {{nomeParticipanteLogado}}--><!--    li--><!--      a.contrast(href=\'#\', inep-contrast="", data-toggle=\'tooltip\', data-placement=\'bottom\', aria-label=\'Contraste\') #[i.fa.fa-adjust]--><script type="text/ng-template" id="warning-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Você ainda está aí?</h3></div><div idle-countdown="countdown" class="modal-body"><uib-progressbar max="30" value="countdown" animate="true" class="progress-striped active"></uib-progressbar>Sua sessão será encerrada em {{countdown}} segundos.</div></div></script><script type="text/ng-template" id="timedout-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Sess&atilde;o encerrada.</h3></div><div class="modal-body"><p></p>Sua sess&atilde;o foi encerrada por inatividade.</div></div></script></div></nav></header><main role="main"><section class="login"><h1 class="hide">Painel de entrada</h1><div ng-controller="AcompanhamentoController as c" ng-init="c.init()"><div id="sideBar" class="col-sm-3 col-md-2 sidebar sidebar-offcanvas"><section><header></header><nav aria-labeledby="#nav"><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeEspelho()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" ng-click="c.navegarEspelho()" ng-if="!c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Acompanhar inscri&ccedil;&atilde;o {{c.anoEdicao}}</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.downloadDeclaracao()", ng-if="!c.isLoginLocalProva && c.menu.exibeDeclaracaoComparecimento()") Declara&ccedil;&atilde;o Comparecimento--><a style="cursor: pointer" ng-click="c.downloadDeclaracao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Declara&ccedil;&atilde;o Comparecimento</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarCartaoConfirmacao()", ng-if="!c.isLoginLocalProva && !c.menu.exibeCartaoConfirmacao()") Local de Prova/Cart&atilde;o Confirma&ccedil;&atilde;o--><a style="cursor: pointer" ng-click="c.navegarCartaoConfirmacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Local de Prova/Cart&atilde;o Confirma&ccedil;&atilde;o</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarDoencaInfectocontagiosa()", ng-if="!c.isLoginLocalProva && c.menu.exibeDoencaInfectocontagiosa()") Doenças Infectocontagiosas--><a style="cursor: pointer" ng-click="c.navegarDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuDoencaInfectoContagiosaVisivel.menuDoencaInfectoContagiosaEnabled" class="ng-scope">Doenças Infectocontagiosas</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarResultadoDoencaInfectocontagiosa()", ng-if="!c.isLoginLocalProva && c.menu.exibeResultadoDoencaInfectocontagiosa()") Resultado de Doenças Infectocontagiosas--><a style="cursor: pointer" ng-click="c.navegarResultadoDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuResultadoDoencaInfectoContagiosaVisivel.menuResultadoDoencaInfectoContagiosaEnabled" class="ng-scope">Resultado de Doenças Infectocontagiosas</a></li><li class="ng-scope"><a style="cursor: pointer" ng-click="c.navegarReaplicacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeReaplicacao() || c.menu.exibeReaplicacaoResultado()" class="ng-scope">Solicita&ccedil;&atilde;o de Reaplica&ccedil;&atilde;o</a><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarReaplicacao()", ng-if="!c.isLoginLocalProva && c.solicitarEnccejaReaplicacaoVisivel.exibirSolicitarEnccejaReaplicacaoEnabled") Registro de Ocorr&ecirc;ncias de Aplica&ccedil;&atilde;o--></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" class="ng-scope">Alterar dados</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarDadosPessoais()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeAlterarDadosInscricao()" class="ng-scope">Informa&ccedil;&otilde;es pessoais</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope"><!--ng-click="c.navegarAtendimentosEspecializados()",--><!--ng-if="!c.isLoginLocalProva && c.menu.exibeAlterarDadosInscricao()")-->Atendimento Especializado</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 40px" ng-click="c.navegarAtendimentosEspecializados()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope">Solicitar / Alterar Solicitação</a><!--ng-if="!c.isLoginLocalProva && false") Atendimento Especializado--></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer; padding-left: 30px", ng-click="c.navegarMunicipioProva()", ng-if="!c.isLoginLocalProva && c.menu.exibeAlterarDadosInscricao()") Informa&ccedil;&otilde;es de prova--><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarMunicipioProva()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuInformacoesProvaVisivel.inscricaoEmAndamento" class="ng-scope">Informa&ccedil;&otilde;es de prova</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer; padding-left: 30px", ng-click="c.navegarJustificativaAusencia()", ng-if="!c.isLoginLocalProva && c.menu.exibeAcompanhamentoJustificativa()") Justificativa de aus&ecirc;ncia--><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarJustificativaAusencia()" ng-if="c.validarExibicaoAcompanhamentoJustific()" class="ng-scope">Justificativa de aus&ecirc;ncia</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarContato()" class="ng-scope">Contato</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; false" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="atualizarSenha" class="ng-scope">Senha</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeLaudoMedico() && !!c.menuRecursoLaudoMedico")--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuRecursoLaudoMedico" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarLaudoMedico()" class="ng-scope">Recurso Laudo M&eacute;dico</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeTratamentoSocial()")--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuTratamentoNomeSocialVisivel.menuTratamentoNomeSocialEnabled" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="nomeSocial" class="ng-scope">Tratamento pelo Nome Social</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeReenvioTratamentoSocial()") verificar se eh recurso ou resultado--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.recursoMenuTratamentoNomeSocialVisivel.recursoMenuTratamentoNomeSocialEnabled &amp;&amp; !!c.menuRecursoNomeSocial" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="reenvioNomeSocial" class="ng-scope">Recurso Nome Social</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menu.exibeBoletoCobranca()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="boletoCobranca" class="ng-scope">Boleto de Cobrança</a></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultados()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" class="ng-scope">Resultado</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2017()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2017" class="ng-scope">ENCCEJA 2017</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2018()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2018" class="ng-scope">ENCCEJA 2018</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2019()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2019" class="ng-scope">ENCCEJA 2019</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2020()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2020" class="ng-scope">ENCCEJA 2020</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2022()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2022" class="ng-scope">ENCCEJA 2022</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2023()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2023" class="ng-scope">ENCCEJA 2023</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2024()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2024" class="ng-scope">ENCCEJA 2024</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2025()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2025" class="ng-scope">ENCCEJA 2025</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2026()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2026" class="ng-scope">ENCCEJA 2026</a></li></ul><ul inep-sidebar="inep-sidebar" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" ng-click="c.sair()" class="ng-scope">Sair</a></li></ul></nav></section></div><div class="col-sm-9 col-sm-offset-3 col-md-10 col-md-offset-2"><div class="panel-box ng-scope"><header><div class="page-header with-space-top"><h1 class="h3">Inscri&ccedil;&atilde;o > ENCCEJA <small>Tratamento pelo nome social</small></h1></div></header><div class="row"><div class="col-md-12"><form name="nomeSocialForm" role="form" novalidate="true" autocomplete="off" inep-message-bag="inep-message-bag" message-bag-header-error="O formulário abaixo está inválido pelos seguintes erros:" ng-controller="NomeSocialController"><div class="panel"><div class="panel-body"><div class="row"><div class="col-md-12"><legend><b tabindex="0" focus-me="focus-me">Tratamento pelo nome social</b></legend></div></div><div class="row"><div class="col-md-12"><p tabindex="0">Esse tratamento é exclusivo para os participantes que se identificam e querem ser reconhecidos\nsocialmente em consonância com sua identidade de gênero. O participante que teve sua solicitação\nde Tratamento pelo Nome Social reprovada poderá, no período de 12/6/2023 a 16/6/2023, solicitar\nrecurso e enviar nova documentação:</p><p tabindex="0">a) Fotografia atual, nítida, individual, colorida, com fundo que enquadre desde a cabeça até os\nombros, de rosto inteiro, sem o uso de óculos escuros e artigos de chapelaria (boné, chapéu,\nviseira, gorro ou similares).</p><p tabindex="0">b) Cópia digitalizada da frente e do verso de um dos documentos de identificação oficiais com foto,\nconforme previsto em Edital.</p><p tabindex="0">Não serão aceitas outras formas de solicitação de atendimento, tais como: via postal, telefone,\nfax ou correio eletrônico.</p></div></div></div></div><div class="panel panel-info with-space-top"><div tabindex="0" class="panel-heading"><h1 class="h4 panel-title text-left text-primary">Informe seus dados</h1></div><div class="panel-body"><div class="row with-space-top"><div class="col-md-12"><inep-input-text np-id="nomeSocialInput" np-label="Nome social: " ng-model="dto.nomeSocial" np-size="6" np-optional="false" np-maxlength="150" np-accessibility-message="{{mensagens.MSGA059}}" np-on-change="limparDeclaro()"></inep-input-text><!--np-readonly="!!desabilitaNomeSocial",--></div></div><div tabindex="0" class="box-describe">Nome Social é destinado a pessoa que se identifica e quer ser reconhecida\nsocialmente em consonância com sua identidade de gênero.</div><div class="row with-space-top"></div><div class="row with-space-bottom"><div class="col-md-12"><enem-fieldset np-tab="0"><table><tr><td><inep-boolean-checkbox np-id="declaracaoNomeSocial" np-selected-value="declaro.declaroNomeSocial" np-disabled="!!possuiNomeSocialCadastrado" np-optional="false" np-required-message="Declaração de tratamento pelo nome social obrigatória."></inep-boolean-checkbox></td><td><ng-bind-html>Declaro que estou ciente da condição informada para Tratamento pelo Nome Social\nde que a confirmação da solicitação está condicionada ao envio e a aprovação dos documentos\nprevistos no edital do Encceja Nacional 2023; que os documentos comprobatórios estão em\nconformidade com o solicitado; que poderei ter que prestar informações complementares,\nquando me forem solicitadas; que em caso de reprovação da solicitação a identificação no\nExame será realizada com o nome civil.</ng-bind-html></td></tr></table></enem-fieldset></div></div></div></div><div ng-if="!!possuiNomeSocialCadastrado"><div class="panel panel-info with-space-top"><div tabindex="0" class="panel-heading"><h1 class="h4 panel-title text-left text-primary">Anexar arquivos</h1></div><div class="panel-body"><div class="row with-space-top"><div class="col-md-12"><p tabindex="0">Anexe aqui os arquivos solicitados. Somente serão aceitos arquivos nos formatos PDF,\nPNG e JPG, com tamanho máximo 2 MB. Para inserir o arquivo clique em\n<strong> Escolher Arquivo </strong>\n, selecione o arquivo desejado para cada documento e, em seguida, clique\nem &quot;Solicitar tratamento por nome social&quot;.</p></div></div><div ng-if="fotoRecente.nomeArquivo != null &amp;&amp; fotoRecente.nomeArquivo != undefined"><div class="row with-space-top"><div class="col-md-10 col-md-offset-2"><i ng-if="(!!fotoRecente.possuiArquivo || !!fotoRecente.arquivo) &amp;&amp; !!fotoRecente.desabilitaFotoRecente" class="fa fa-check-circle fa-2x icon-upload icon-sucess"></i><i ng-if="(!fotoRecente.possuiArquivo &amp;&amp; !fotoRecente.arquivo) || !fotoRecente.desabilitaFotoRecente" class="fa fa-times-circle fa-2x icon-upload icon-error"></i><inep-input-text np-id="fotoRecenteName" np-maxlength="150" np-size="6" ng-model="fotoRecente.nomeArquivo" np-readonly="true" np-optional="true" np-label="Foto recente:" np-name="selectedFile"></inep-input-text><button type="button" ng-if="!fotoRecente.desabilitaFotoRecente" ng-click="alterarArquivo(1)" style="margin-top: 23px;margin-left: -18px;" class="btn btn-default">Enviar novo arquivo</button><!----><!--button(type="button",--><!--ng-if="fotoRecente.possuiArquivo",--><!--class="btn btn-default align-button-upload",--><!--ng-click="download(1)",--><!--style="margin-top: 23px;margin-left: 10px;") Download--></div></div></div><div ng-if="!fotoRecente.nomeArquivo || fotoRecente.nomeArquivo == null || fotoRecente.nomeArquivo == undefined"><div class="row with-space-top"><div class="col-md-10 col-md-offset-2"><i ng-if="!!fotoRecente.arquivo" class="fa fa-check-circle fa-2x icon-upload icon-sucess"></i><i ng-if="!fotoRecente.arquivo" class="fa fa-times-circle fa-2x icon-upload icon-error"></i><inep-input-file np-id="fotoRecenteUpload" np-label="Foto recente: " np-value="fotoRecente.arquivo" np-max-file-size="maxFileSize" np-show-icon="true" np-content-types="contentTypes" np-size="8" np-max-file-message="Tamanho de arquivo inválido." np-content-type-message="Formato de arquivo inválido." np-disabled="" np-on-change="showPreview(fotoRecente)" np-empty-message="{{mensagens.MSG_ARQUIVO_VAZIO}}" np-optional="fotoRecente.possuiArquivo"></inep-input-file><button type="button" ng-if="!!fotoRecente.arquivo" ng-click="exibirModalExcluirArquivo(\'fotoRecente\')" style="margin-top: 23px;margin-left: 10px;" class="btn btn-default align-button-upload">Excluir arquivo</button></div><div class="row with-space-bottom"><div id="previewFotoRecente" ng-if="!!fotoRecente.blob" class="col-md-10 col-md-offset-2"><img style="width:220px; height: 220px;" ng-src="{{fotoRecente.blob}}"/></div></div></div></div><div ng-if="identificacao.nomeArquivo != null &amp;&amp; identificacao.nomeArquivo != undefined"><div class="row with-space-top"><div class="col-md-10 col-md-offset-2"><i ng-if="(!!identificacao.possuiArquivo || !!identificacao.arquivo) &amp;&amp; !!identificacao.desabilitaIdentificacao" class="fa fa-check-circle fa-2x icon-upload icon-sucess"></i><i ng-if="(!identificacao.possuiArquivo &amp;&amp; !identificacao.arquivo) || !identificacao.desabilitaIdentificacao" class="fa fa-times-circle fa-2x icon-upload icon-error"></i><inep-input-text np-id="identificacaoUpload" np-maxlength="150" np-size="6" ng-model="identificacao.nomeArquivo" np-readonly="true" np-optional="true" np-label="Documento de identificação com foto de acordo com o edital: " np-name="selectedFile"></inep-input-text><button type="button" ng-click="alterarArquivo(2)" ng-if="!identificacao.desabilitaIdentificacao" style="margin-top: 23px;margin-left: -18px;" class="btn btn-default">Enviar novo arquivo</button><!--button(type="button",--><!--ng-if="!!identificacao.possuiArquivo",--><!--class="btn btn-default align-button-upload",--><!--ng-click="download(2)",--><!--style="margin-top: 23px;margin-left: 10px;") Download--></div></div></div><div ng-if="!identificacao.nomeArquivo || identificacao.nomeArquivo == null || identificacao.nomeArquivo == undefined"><div class="row with-space-top"><div class="col-md-10 col-md-offset-2"><i ng-if="!!identificacao.arquivo" class="fa fa-check-circle fa-2x icon-upload icon-sucess"></i><i ng-if="!identificacao.arquivo" class="fa fa-times-circle fa-2x icon-upload icon-error"></i><inep-input-file np-id="identificacaoUpload" np-label="Documento de identificação com foto de acordo com o edital: " np-value="identificacao.arquivo" np-max-file-size="maxFileSize" np-show-icon="true" np-content-types="contentTypes" np-size="8" np-max-file-message="Tamanho de arquivo inválido." np-content-type-message="Formato de arquivo inválido." np-disabled="" np-on-change="showPreview(identificacao)" np-empty-message="{{mensagens.MSG_ARQUIVO_VAZIO}}" np-optional="identificacao.possuiArquivo"></inep-input-file><button type="button" ng-if="!!identificacao.arquivo" ng-click="exibirModalExcluirArquivo(\'identificacao\')" style="margin-top: 23px;margin-left: 10px;" class="btn btn-default align-button-upload">Excluir arquivo</button></div><div class="row with-space-bottom"><div id="previewIdentificacao" ng-if="!!identificacao.blob" class="col-md-10 col-md-offset-2"><img style="width:220px; height: 220px;" ng-src="{{identificacao.blob}}"/></div></div></div></div></div></div></div><div class="clearfix"><ul class="pagination margin-bottom-none pull-right"><li class="primary"><button ng-click="exibirModalSolicitacao()" role="button" class="btn btn-primary">{{atualizar === 0 ? \'Solicitar tratamento por nome social\' : \'Atualizar solicita&ccedil;&atilde;o\'}}</button></li></ul></div><div inep-modal="inep-modal" np-id="modalNomeSocial" np-buttons="modalNomeSocial.buttons" np-show="modalNomeSocial.show" np-options="modalNomeSocial.options" np-header="Aviso"><p tabindex="0">{{ modalNomeSocial.message }}</p></div></form></div></div></div><div inep-modal="inep-modal" np-buttons="c.buttons" np-show="c.modalShow" np-id="modal" np-options="c.modalOptions" np-header="Aviso"><p tabindex="0">{{ c.modalMessage }}</p></div><div inep-modal="inep-modal" np-id="modalCarencia" np-buttons="c.modalCarencia.buttons" np-show="c.modalCarencia.show" np-options="c.modalCarencia.options" np-header="Aviso"><p tabindex="0">{{ c.modalCarencia.message }}</p></div><div inep-modal="inep-modal" np-id="modalExibirMensagem" np-buttons="c.modalExibirMensagem.buttons" np-show="c.modalExibirMensagem.show" np-options="c.modalExibirMensagem.options" np-header="Avaliar serviço"><p tabindex="0">{{ c.modalExibirMensagem.saudacao }}</p><p tabindex="0">{{ c.modalExibirMensagem.message }}</p></div><div inep-modal="inep-modal" np-buttons="c.modalSair.buttons" np-show="c.modalSair.show" np-id="modalSair" np-options="c.modalSair.options" np-header="Aviso"><p tabindex="0">{{ c.modalSair.saudacao }}</p><p tabindex="0">{{ c.modalSair.message }}</p></div></div></div></section></main>'),
a.put("views/acompanhamento/reenvioNomeSocialUpload.html",'<div class="panel panel-info with-space-top"><div tabindex="0" class="panel-heading"><h1 class="h4 panel-title text-left text-primary">Anexar arquivos</h1></div><div class="panel-body"><div class="row with-space-top"><div class="col-md-12"><p tabindex="0">Anexe aqui os arquivos solicitados. Somente serão aceitos arquivos nos formatos PDF,\nPNG e JPG, com tamanho máximo 2 MB. Para inserir o arquivo clique em\n<strong> Escolher Arquivo </strong>\n, selecione o arquivo desejado para cada documento e, em seguida, clique\nem &quot;Solicitar tratamento por nome social&quot;.</p></div></div><div ng-if="fotoRecente.nomeArquivo != null &amp;&amp; fotoRecente.nomeArquivo != undefined"><div class="row with-space-top"><div class="col-md-10 col-md-offset-2"><i ng-if="(!!fotoRecente.possuiArquivo || !!fotoRecente.arquivo) &amp;&amp; !!fotoRecente.desabilitaFotoRecente" class="fa fa-check-circle fa-2x icon-upload icon-sucess"></i><i ng-if="(!fotoRecente.possuiArquivo &amp;&amp; !fotoRecente.arquivo) || !fotoRecente.desabilitaFotoRecente" class="fa fa-times-circle fa-2x icon-upload icon-error"></i><inep-input-text np-id="fotoRecenteName" np-maxlength="150" np-size="6" ng-model="fotoRecente.nomeArquivo" np-readonly="true" np-optional="true" np-label="Foto recente:" np-name="selectedFile"></inep-input-text><button type="button" ng-if="!fotoRecente.desabilitaFotoRecente" ng-click="alterarArquivo(1)" style="margin-top: 23px;margin-left: -18px;" class="btn btn-default">Enviar novo arquivo</button><!----><!--button(type="button",--><!--ng-if="fotoRecente.possuiArquivo",--><!--class="btn btn-default align-button-upload",--><!--ng-click="download(1)",--><!--style="margin-top: 23px;margin-left: 10px;") Download--></div></div></div><div ng-if="!fotoRecente.nomeArquivo || fotoRecente.nomeArquivo == null || fotoRecente.nomeArquivo == undefined"><div class="row with-space-top"><div class="col-md-10 col-md-offset-2"><i ng-if="!!fotoRecente.arquivo" class="fa fa-check-circle fa-2x icon-upload icon-sucess"></i><i ng-if="!fotoRecente.arquivo" class="fa fa-times-circle fa-2x icon-upload icon-error"></i><inep-input-file np-id="fotoRecenteUpload" np-label="Foto recente: " np-value="fotoRecente.arquivo" np-max-file-size="maxFileSize" np-show-icon="true" np-content-types="contentTypes" np-size="8" np-max-file-message="Tamanho de arquivo inválido." np-content-type-message="Formato de arquivo inválido." np-disabled="" np-on-change="showPreview(fotoRecente)" np-empty-message="{{mensagens.MSG_ARQUIVO_VAZIO}}" np-optional="fotoRecente.possuiArquivo"></inep-input-file><button type="button" ng-if="!!fotoRecente.arquivo" ng-click="exibirModalExcluirArquivo(\'fotoRecente\')" style="margin-top: 23px;margin-left: 10px;" class="btn btn-default align-button-upload">Excluir arquivo</button></div><div class="row with-space-bottom"><div id="previewFotoRecente" ng-if="!!fotoRecente.blob" class="col-md-10 col-md-offset-2"><img style="width:220px; height: 220px;" ng-src="{{fotoRecente.blob}}"/></div></div></div></div><div ng-if="identificacao.nomeArquivo != null &amp;&amp; identificacao.nomeArquivo != undefined"><div class="row with-space-top"><div class="col-md-10 col-md-offset-2"><i ng-if="(!!identificacao.possuiArquivo || !!identificacao.arquivo) &amp;&amp; !!identificacao.desabilitaIdentificacao" class="fa fa-check-circle fa-2x icon-upload icon-sucess"></i><i ng-if="(!identificacao.possuiArquivo &amp;&amp; !identificacao.arquivo) || !identificacao.desabilitaIdentificacao" class="fa fa-times-circle fa-2x icon-upload icon-error"></i><inep-input-text np-id="identificacaoUpload" np-maxlength="150" np-size="6" ng-model="identificacao.nomeArquivo" np-readonly="true" np-optional="true" np-label="Documento de identificação com foto de acordo com o edital: " np-name="selectedFile"></inep-input-text><button type="button" ng-click="alterarArquivo(2)" ng-if="!identificacao.desabilitaIdentificacao" style="margin-top: 23px;margin-left: -18px;" class="btn btn-default">Enviar novo arquivo</button><!--button(type="button",--><!--ng-if="!!identificacao.possuiArquivo",--><!--class="btn btn-default align-button-upload",--><!--ng-click="download(2)",--><!--style="margin-top: 23px;margin-left: 10px;") Download--></div></div></div><div ng-if="!identificacao.nomeArquivo || identificacao.nomeArquivo == null || identificacao.nomeArquivo == undefined"><div class="row with-space-top"><div class="col-md-10 col-md-offset-2"><i ng-if="!!identificacao.arquivo" class="fa fa-check-circle fa-2x icon-upload icon-sucess"></i><i ng-if="!identificacao.arquivo" class="fa fa-times-circle fa-2x icon-upload icon-error"></i><inep-input-file np-id="identificacaoUpload" np-label="Documento de identificação com foto de acordo com o edital: " np-value="identificacao.arquivo" np-max-file-size="maxFileSize" np-show-icon="true" np-content-types="contentTypes" np-size="8" np-max-file-message="Tamanho de arquivo inválido." np-content-type-message="Formato de arquivo inválido." np-disabled="" np-on-change="showPreview(identificacao)" np-empty-message="{{mensagens.MSG_ARQUIVO_VAZIO}}" np-optional="identificacao.possuiArquivo"></inep-input-file><button type="button" ng-if="!!identificacao.arquivo" ng-click="exibirModalExcluirArquivo(\'identificacao\')" style="margin-top: 23px;margin-left: 10px;" class="btn btn-default align-button-upload">Excluir arquivo</button></div><div class="row with-space-bottom"><div id="previewIdentificacao" ng-if="!!identificacao.blob" class="col-md-10 col-md-offset-2"><img style="width:220px; height: 220px;" ng-src="{{identificacao.blob}}"/></div></div></div></div></div></div>'),a.put("views/acompanhamento/relatorioCertificadora.html",'<header role="banner"><h1 class="hide"> - </h1><nav role="navigation" aria-labelledby="#nav" ng-controller="NavigationBarController" class="navbar navbar-default navbar-fixed-top"><h2 id="nav" class="hide">Navegação Principal</h2><div class="container-fluid"><div class="navbar-header text-center"><button type="button" data-toggle="offcanvas" class="navbar-toggle collapsed left"><span class="sr-only">Toggle navigation</span><span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span></button><div aria-label="Bem vindo ao INEP" class="navbar-brand"><img src="images/logo_inep.svg" alt="Instituto Nacional de Estudos e Pesquisas Educacionais Anísio Teixeira"/></div><button type="button" data-toggle="collapse" data-target="#navbar-collapse" class="navbar-toggle collapsed right p-n"><span class="sr-only">Toggle navigation</span><i class="fa fa-gear text-white"></i></button></div><!--#navbar-collapse.collapse.navbar-collapse--><!--  ul.nav.navbar-nav--><!--    li.active--><!--      span.logo-inep.h3.m-n.font-700(data-toggle=\'tooltip\', data-placement=\'bottom\', title=project.name) #{project.abbr}--><!----><!--  ul.nav.navbar-nav.navbar-right--><!--    if !login--><!--      li--><!--        span(data-toggle=\'dropdown\') #[i.fa.fa-user] Participante: {{nomeParticipanteLogado}}--><!--    li--><!--      a.contrast(href=\'#\', inep-contrast="", data-toggle=\'tooltip\', data-placement=\'bottom\', aria-label=\'Contraste\') #[i.fa.fa-adjust]--><script type="text/ng-template" id="warning-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Você ainda está aí?</h3></div><div idle-countdown="countdown" class="modal-body"><uib-progressbar max="30" value="countdown" animate="true" class="progress-striped active"></uib-progressbar>Sua sessão será encerrada em {{countdown}} segundos.</div></div></script><script type="text/ng-template" id="timedout-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Sess&atilde;o encerrada.</h3></div><div class="modal-body"><p></p>Sua sess&atilde;o foi encerrada por inatividade.</div></div></script></div></nav></header><main role="main"><section class="login"><h1 class="hide">Painel de entrada</h1><style>body {\n    font-family: Arial;\n    font-size: 12px;\n}\n.rosaFundo {\n    background: #EC008B;\n    color: #FFF;\n    padding: 5px 0px;\n}\n.rosaFundoCor {\n    background: #EC008B;\n    color: #FFF;\n}\n.rosaBebeFundo {\n    background:  #FBBFE5;\n}\n.rosaFonte {\n    color: #DF0786;\n}\n.rosaBorder {\n    border: 1px solid #DF0786;\n}\n.fundoPreto {\n    background: #000;\n    color: #FFF;\n}\n.padding {\n    padding: 1px 15px;\n}\n.header {\n    width: 50%\n.h1 {\n    text-decoration: underline;\n    font-size: 12px;\n}\n.h2 {\n    font-size: 14px;\n}</style><form autocomplete="off" inep-message-bag="inep-message-bag" message-bag-header-error="O formulário abaixo está inválido pelos seguintes erros:" name="relatorioForm" novalidate="true" ng-controller="CertificadoraController as c"><div class="panel"><div class="panel-body"><div class="row"><div class="col-md-12"><table style="border-collapse: collapse;margin: 2px 0;width: 100%;margin: 4px 0;"><tr style="border-collapse: collapse;margin: 2px 0;width: 100%;margin: 4px 0;"><td style="width: 25%;">&nbsp;</td><td style="width: 50%; text-align: center;"><div style="background-color: #2D3E50; color: #FFF; padding: 5px 0;"><span style="white-space: nowrap; text-decoration: underline">EXAME NACIONAL PARA CERTIFICA&Ccedil;&Atilde;O DE COMPET&Ecirc;NCIAS DE JOVENS E ADULTOS - ENCCEJA 2023</span></div></td><td style="width: 25%;"><figure><img ng-src="images/Logo-Encceja2026.png" style="width:110px; float: right"/></figure></td></tr></table><br/></div></div></div></div><div class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Instituição certificadora</h2></div><div class="panel-body"><div class="row with-space-top"><div class="col-md-3"><inep-combobox np-id="anoProjeto" np-label="Ano:" np-optional="true" np-no-select-label="Selecione" np-size="12" np-values="c.anos" np-selected-value="c.ano" np-on-change="c.carregarProjeto()"></inep-combobox></div><div class="col-md-3"><inep-combobox np-id="exame" np-label="Exame:" np-optional="false" np-no-select-label="Selecione" np-size="12" np-values="c.exames" np-selected-value="c.exame" np-on-change="c.carregarEntidadesCertificadoras()"></inep-combobox></div></div><div class="row with-space-top"><div class="col-md-3"><inep-combobox np-id="ufCidadeProva" np-label="UF da instituição:" np-optional="false" np-no-select-label="Selecione" np-size="12" np-values="c.ufs" np-selected-value="c.informacoesProva.codigoUfCertificadora" np-on-change="c.carregarEntidadesCertificadoras()"></inep-combobox></div><div class="col-md-3"><inep-combobox np-id="etapaEnsino" np-label="Etapa de Ensino:" np-optional="false" np-no-select-label="Selecione" np-size="12" np-values="c.etapasEnsino" np-text-name="text" np-value-name="value" np-selected-value="c.etapaEnsino"></inep-combobox></div></div><div class="row with-space-top"><div class="col-md-12"><inep-combobox np-id="entidadeCertificadora" np-label="Instituição certificadora:" np-optional="true" np-no-select-label="Selecione" np-size="8" np-values="c.secretariasCertificadoras" np-selected-value="c.informacoesProva.codigoSecretariaCertificadora" np-order-by="id"></inep-combobox></div></div><div class="clearfix"><ul class="pagination margin-bottom-none pull-right"><li class="primary"><button ng-click="c.gerar()" role="button" ng-disabled="relatorioForm.$invalid" class="btn btn-primary">Gerar Excel</button></li></ul></div></div></div><div inep-modal="inep-modal" np-id="modalError" np-buttons="c.modalError.buttons" np-show="c.modalError.show" np-options="c.modalError.options" np-header="Aviso"><p tabindex="0">{{ c.modalError.message }}</p></div></form></section></main>'),a.put("views/acompanhamento/resultado2.html",'<header role="banner"><h1 class="hide"> - </h1><nav role="navigation" aria-labelledby="#nav" ng-controller="NavigationBarController" class="navbar navbar-default navbar-fixed-top"><h2 id="nav" class="hide">Navegação Principal</h2><div class="container-fluid"><div class="navbar-header text-center"><button type="button" data-toggle="offcanvas" class="navbar-toggle collapsed left"><span class="sr-only">Toggle navigation</span><span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span></button><div aria-label="Bem vindo ao INEP" class="navbar-brand"><img src="images/logo_inep.svg" alt="Instituto Nacional de Estudos e Pesquisas Educacionais Anísio Teixeira"/></div><button type="button" data-toggle="collapse" data-target="#navbar-collapse" class="navbar-toggle collapsed right p-n"><span class="sr-only">Toggle navigation</span><i class="fa fa-gear text-white"></i></button></div><!--#navbar-collapse.collapse.navbar-collapse--><!--  ul.nav.navbar-nav--><!--    li.active--><!--      span.logo-inep.h3.m-n.font-700(data-toggle=\'tooltip\', data-placement=\'bottom\', title=project.name) #{project.abbr}--><!----><!--  ul.nav.navbar-nav.navbar-right--><!--    if !login--><!--      li--><!--        span(data-toggle=\'dropdown\') #[i.fa.fa-user] Participante: {{nomeParticipanteLogado}}--><!--    li--><!--      a.contrast(href=\'#\', inep-contrast="", data-toggle=\'tooltip\', data-placement=\'bottom\', aria-label=\'Contraste\') #[i.fa.fa-adjust]--><script type="text/ng-template" id="warning-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Você ainda está aí?</h3></div><div idle-countdown="countdown" class="modal-body"><uib-progressbar max="30" value="countdown" animate="true" class="progress-striped active"></uib-progressbar>Sua sessão será encerrada em {{countdown}} segundos.</div></div></script><script type="text/ng-template" id="timedout-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Sess&atilde;o encerrada.</h3></div><div class="modal-body"><p></p>Sua sess&atilde;o foi encerrada por inatividade.</div></div></script></div></nav></header><main role="main"><section class="login"><h1 class="hide">Painel de entrada</h1><div ng-controller="AcompanhamentoController as c" ng-init="c.init()"><div id="sideBar" class="col-sm-3 col-md-2 sidebar sidebar-offcanvas"><section><header></header><nav aria-labeledby="#nav"><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeEspelho()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" ng-click="c.navegarEspelho()" ng-if="!c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Acompanhar inscri&ccedil;&atilde;o {{c.anoEdicao}}</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.downloadDeclaracao()", ng-if="!c.isLoginLocalProva && c.menu.exibeDeclaracaoComparecimento()") Declara&ccedil;&atilde;o Comparecimento--><a style="cursor: pointer" ng-click="c.downloadDeclaracao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Declara&ccedil;&atilde;o Comparecimento</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarCartaoConfirmacao()", ng-if="!c.isLoginLocalProva && !c.menu.exibeCartaoConfirmacao()") Local de Prova/Cart&atilde;o Confirma&ccedil;&atilde;o--><a style="cursor: pointer" ng-click="c.navegarCartaoConfirmacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Local de Prova/Cart&atilde;o Confirma&ccedil;&atilde;o</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarDoencaInfectocontagiosa()", ng-if="!c.isLoginLocalProva && c.menu.exibeDoencaInfectocontagiosa()") Doenças Infectocontagiosas--><a style="cursor: pointer" ng-click="c.navegarDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuDoencaInfectoContagiosaVisivel.menuDoencaInfectoContagiosaEnabled" class="ng-scope">Doenças Infectocontagiosas</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarResultadoDoencaInfectocontagiosa()", ng-if="!c.isLoginLocalProva && c.menu.exibeResultadoDoencaInfectocontagiosa()") Resultado de Doenças Infectocontagiosas--><a style="cursor: pointer" ng-click="c.navegarResultadoDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuResultadoDoencaInfectoContagiosaVisivel.menuResultadoDoencaInfectoContagiosaEnabled" class="ng-scope">Resultado de Doenças Infectocontagiosas</a></li><li class="ng-scope"><a style="cursor: pointer" ng-click="c.navegarReaplicacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeReaplicacao() || c.menu.exibeReaplicacaoResultado()" class="ng-scope">Solicita&ccedil;&atilde;o de Reaplica&ccedil;&atilde;o</a><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarReaplicacao()", ng-if="!c.isLoginLocalProva && c.solicitarEnccejaReaplicacaoVisivel.exibirSolicitarEnccejaReaplicacaoEnabled") Registro de Ocorr&ecirc;ncias de Aplica&ccedil;&atilde;o--></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" class="ng-scope">Alterar dados</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarDadosPessoais()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeAlterarDadosInscricao()" class="ng-scope">Informa&ccedil;&otilde;es pessoais</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope"><!--ng-click="c.navegarAtendimentosEspecializados()",--><!--ng-if="!c.isLoginLocalProva && c.menu.exibeAlterarDadosInscricao()")-->Atendimento Especializado</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 40px" ng-click="c.navegarAtendimentosEspecializados()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope">Solicitar / Alterar Solicitação</a><!--ng-if="!c.isLoginLocalProva && false") Atendimento Especializado--></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer; padding-left: 30px", ng-click="c.navegarMunicipioProva()", ng-if="!c.isLoginLocalProva && c.menu.exibeAlterarDadosInscricao()") Informa&ccedil;&otilde;es de prova--><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarMunicipioProva()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuInformacoesProvaVisivel.inscricaoEmAndamento" class="ng-scope">Informa&ccedil;&otilde;es de prova</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer; padding-left: 30px", ng-click="c.navegarJustificativaAusencia()", ng-if="!c.isLoginLocalProva && c.menu.exibeAcompanhamentoJustificativa()") Justificativa de aus&ecirc;ncia--><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarJustificativaAusencia()" ng-if="c.validarExibicaoAcompanhamentoJustific()" class="ng-scope">Justificativa de aus&ecirc;ncia</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarContato()" class="ng-scope">Contato</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; false" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="atualizarSenha" class="ng-scope">Senha</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeLaudoMedico() && !!c.menuRecursoLaudoMedico")--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuRecursoLaudoMedico" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarLaudoMedico()" class="ng-scope">Recurso Laudo M&eacute;dico</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeTratamentoSocial()")--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuTratamentoNomeSocialVisivel.menuTratamentoNomeSocialEnabled" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="nomeSocial" class="ng-scope">Tratamento pelo Nome Social</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeReenvioTratamentoSocial()") verificar se eh recurso ou resultado--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.recursoMenuTratamentoNomeSocialVisivel.recursoMenuTratamentoNomeSocialEnabled &amp;&amp; !!c.menuRecursoNomeSocial" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="reenvioNomeSocial" class="ng-scope">Recurso Nome Social</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menu.exibeBoletoCobranca()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="boletoCobranca" class="ng-scope">Boleto de Cobrança</a></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultados()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" class="ng-scope">Resultado</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2017()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2017" class="ng-scope">ENCCEJA 2017</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2018()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2018" class="ng-scope">ENCCEJA 2018</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2019()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2019" class="ng-scope">ENCCEJA 2019</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2020()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2020" class="ng-scope">ENCCEJA 2020</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2022()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2022" class="ng-scope">ENCCEJA 2022</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2023()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2023" class="ng-scope">ENCCEJA 2023</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2024()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2024" class="ng-scope">ENCCEJA 2024</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2025()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2025" class="ng-scope">ENCCEJA 2025</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2026()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2026" class="ng-scope">ENCCEJA 2026</a></li></ul><ul inep-sidebar="inep-sidebar" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" ng-click="c.sair()" class="ng-scope">Sair</a></li></ul></nav></section></div><div class="col-sm-9 col-sm-offset-3 col-md-10 col-md-offset-2"><div class="panel-box ng-scope"><style>body {\n    font-family: Arial;\n    font-size: 12px;\n}\n.rosaFundo {\n    background: #EC008B;\n    color: #FFF;\n    padding: 5px 0px;\n}\n.rosaFundoCor {\n    background: #EC008B;\n    color: #FFF;\n}\n.rosaBebeFundo {\n    background:  #FBBFE5;\n}\n.rosaFonte {\n    color: #DF0786;\n}\n.rosaBorder {\n    border: 1px solid #DF0786;\n}\n.fundoPreto {\n    background: #000;\n    color: #FFF;\n}\n.padding {\n    padding: 1px 15px;\n}\n.centro {\n    text-align: center;\n}\n.umTerco {\n    width:33%;\n}\n.header {\n    width: 50%\n}\n.tabela {\n    width:100%;\n    border-collapse: collapse;\n    margin:2px 0px;\n}\n.marginZero {\n    margin: 0px;\n}\n.td75 {\n    width:75%;\n}\n.bordaTabela {\n    border-top: 2px solid black;\n}\n.marginMenos {\n    margin-top: -1px;\n}\n.blocoTitulo {\n    display:block;\n    font-size: 11px;\n}\n.bordaBottom {\n    border-bottom: 1px solid black;\n}\n.h1 {\n    text-decoration: underline;\n    font-size: 12px;\n}\n.h2 {\n    font-size: 14px;\n}\n.negrito {\n    font-weight: bold;\n}\n.normal {\n    font-weight:  normal;\n    text-align: left;\n}\n.bordaBrancaLeftTop {\n    border-left: 2px solid white;\n    border-top: 2px solid #DF0786;\n}\n.marginMaior {\n    margin: 4px 0px;\n}\n.painel-azul {\n    background-color: #2D3E50; \n     color: #FFF; \n     padding: 5px 0; \n}\n.painel-verde {\n    background-color: #2DA27F; \n     color: #FFF; \n     padding: 5px 0; \n}\n.paddingTableRecuo {\n    padding: 2px 0px 2px 20px;\n}\n.justificado {\n    text-align: justify;\n}\n.direita {\n    text-align: right;\n}\n.esquerda {\n    text-align: left;\n}\n.centro {\n    text-align: center;\n}\n.paddingTd {\n    vertical-align: text-top;\n    font-size: 10px;\n}\n.width20 {\n    width: 20%;\n}\n.tabelaTopo {\n   width: 72%;\n   margin-left: 12%;\n }\n.headerTabela {\n    color: #FFFFFF;\n    background: #2D3E50;\n    font-weight: bold;\n    text-align: center;\n}\n.headerTabelaLeft {\n    color: #FFFFFF;\n    background: #2D3E50;\n    font-weight: bold;\n    text-align: left;\n}\n.headerTabelaCenter {\n    color: #FFFFFF;\n    background: #2D3E50;\n    font-weight: bold;\n    text-align: center;\n}\n@media print {\n  .yesprint {\n      visibility:visible !important;\n      display:block;\n  }\n  .notprint {\n      display:none;\n  }\n  #barra-brasil {\n      display:none;\n  }\n}\n#tbNotas tr:nth-child(odd){\n   background:#CCCCCC;\n}\n#tbJust tr:nth-child(odd){\n   background:#CCCCCC;\n}\nbody.contrast .headerTabela, body.contrast .headerTabelaLeft, body.contrast .rosaFundo {\n  background-color: grey;\n}\nbody.contrast #tbNotas tr:nth-child(odd) {\n  color: black;\n}\n.atencao {\n  text-align: justify;\n  padding-top: 30px;\n  font-family: Arial, Helvetica, sans-serif;\n  font-size: 11px;\n}</style><div ng-controller="ResultadoController as c"><div class="panel"><div class="panel-body"><div class="row"><div class="col-md-12"><table style="border-collapse: collapse;margin: 2px 0;width: 100%;margin: 4px 0;"><tr style="border-collapse: collapse;margin: 2px 0;width: 100%;margin: 4px 0;"><td style="width: 25%;">&nbsp;</td><td style="width: 50%; text-align: center;"><div class="painel-azul"><span style="white-space: nowrap; text-decoration: underline">EXAME NACIONAL PARA CERTIFICA&Ccedil;&Atilde;O DE COMPET&Ecirc;NCIAS DE JOVENS E ADULTOS - ENCCEJA 20{{c.ano}}</span><br/><span style="white-space: nowrap; font-size: 14px;"><strong>RESULTADOS 20{{c.ano}}</strong></span></div></td><td style="width: 25%;"><figure><img ng-src="images/Logo-Encceja20{{c.ano}}.png" style="width:110px; float: right"/></figure></td></tr></table><br/></div></div></div></div><div><div ng-if="!!c.messageError" class="row"><div class="col-md-12 text-center"> <div role="alert" class="alert alert-danger yesprint"><span tabindex="0">{{c.messageError}}</span></div></div></div><div ng-if="!!c.dadosResultado.provaObjetiva &amp;&amp; !c.dadosResultado.eliminado" class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Dados de identifica&ccedil;ão do participante</h2></div><div class="panel-body"><div ng-if="!c.dadosResultado.nomeSocial" class="row"><div class="col-md-12"><b class="impressaoFonte7">Nome:</b><label class="impressaoFonte7">{{c.dadosResultado.nome}}</label></div></div><div ng-if="!!c.dadosResultado.nomeSocial" class="row"><div class="col-md-12"><b class="impressaoFonte7">Nome:</b><label class="impressaoFonte7">{{c.dadosResultado.nomeSocial}}</label></div></div><div class="row"><div class="col-md-12"><b class="impressaoFonte7">Número de Inscri&ccedil;ão:</b><label class="impressaoFonte7">{{c.dadosResultado.inscricao}}</label></div></div><div class="row"><div class="col-md-12"><b class="impressaoFonte7">CPF:</b><inep-output-text np-id="cpfFormatado" ng-model="c.dadosResultado.cpf" np-mask="999.999.999-99" class="impressaoFonte7"></inep-output-text></div></div><div class="row"><div class="col-md-12"><b class="impressaoFonte7">Data de Nascimento:</b><label class="impressaoFonte7">{{c.dadosResultado.dataNascimento}}</label></div></div></div></div><div ng-if="!!c.dadosResultado.provaObjetiva &amp;&amp; !c.dadosResultado.eliminado" class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Instituição certificadora</h2></div><div class="panel-body"><div class="row"><div class="col-md-12"><b class="impressaoFonte7">Institui&ccedil;ão certificadora:</b><label class="impressaoFonte7">{{c.dadosResultado.certificadora.nome}}</label></div></div><div class="row"><div class="col-md-12"><b class="impressaoFonte7">Etapa de Ensino:</b><label class="impressaoFonte7">{{c.dadosResultado.etapaEnsino}}</label></div></div><div ng-if="c.ano == 22 &amp;&amp; c.showPlanilha" class="row"><div style="padding-bottom: 10px" class="col-md-12"><b style="color: red;" class="impressaoFonte7 hidden-print">Para consultar as escolas certificadoras, clique no botão ao lado.</b><button style="margin-left: 10px; margin-top: -23px;" ng-click="c.downloadPlanilha()" role="button" class="btn btn-primary">Consultar Escolas Certificadoras</button></div></div></div></div><div ng-if="!!c.dadosResultado.eliminado"><span class="fundoPreto padding negrito">Eliminado</span><table class="with-space-bottom tabela bordaTabela marginMenos bordaBottom"><tr><td style="padding: 0 30px 0 30px;" class="headerTabela"><span style="white-space: nowrape;" class="impressaoFonte7">Motivo Elimina&ccedil;ão Exame</span></td></tr><tr ng-repeat="item in c.justificativasEliminacao track by $index"><td style="padding: 0 30px 0 30px;" class="centro"><span style="color: #000000;" class="impressaoFonte7">{{item.descricaoMotivo}}</span></td></tr></table></div><div ng-if="c.dadosResultado.provaObjetiva.length &gt; 0 &amp;&amp; !c.dadosResultado.eliminado"><br/><span class="fundoPreto padding negrito">Provas</span><table id="tbNotasObjetivas" class="with-space-bottom tabela bordaTabela marginMenos bordaBottom"><tr><td style="padding: 0 30px 0 30px;" class="headerTabelaLeft"><span style="white-space: nowrap;" class="impressaoFonte7">&Aacute;rea de conhecimento</span></td><td class="headerTabela"><span style="white-space: nowrap;" class="impressaoFonte7">Situa&ccedil;&atilde;o</span></td><td class="headerTabela"><span style="white-space: nowrap;" class="impressaoFonte7">Nota</span></td></tr><tr ng-repeat="item in c.dadosResultado.provaObjetiva"><td style="padding: 0 30px 0 30px;"><span style="white-space: nowrap;" class="impressaoFonte7">{{item.areaDeConhecimento}}</span></td><td style="padding: 0 30px 0 30px; width:20%;" class="centro"><span class="impressaoFonte7">{{ item.situacao }}</span></td><td style="padding: 0 30px 0 30px; width:20%;" class="centro"><span class="impressaoFonte7">{{ item.situacao === \'Presente\' ? item.nota : \'-\' }}</span></td></tr></table></div><div ng-if="!!c.dadosResultado.provaRedacao &amp;&amp; !c.dadosResultado.eliminado"><br/><span ng-if="c.dadosResultado.provaRedacao" class="fundoPreto padding negrito">Reda&ccedil;&atilde;o</span><table id="tbNotasRedacao" class="with-space-bottom tabela bordaTabela marginMenos bordaBottom"><tr><td style="padding: 0 30px 0 30px;" class="headerTabelaLeft"><span style="white-space: nowrap;" class="impressaoFonte7">&Aacute;rea de conhecimento</span></td><td class="headerTabela"><span style="white-space: nowrap;" class="impressaoFonte7">Situa&ccedil;&atilde;o</span></td><td class="headerTabela"><span style="white-space: nowrap;" class="impressaoFonte7">Nota</span></td></tr><tr><td style="padding: 0 30px 0 30px;"><span style="white-space: nowrap;" class="impressaoFonte7">{{c.dadosResultado.provaRedacao.areaDeConhecimento}}</span></td><td style="padding: 0 30px 0 30px; width:20%;" class="centro"><span class="impressaoFonte7">{{ c.dadosResultado.provaRedacao.situacao }}</span></td><td style="padding: 0 30px 0 30px; width:20%;" class="centro"><span class="impressaoFonte7">{{ c.dadosResultado.provaRedacao.situacao === \'Presente\' ? c.dadosResultado.provaRedacao.nota : \'-\' }}</span></td></tr></table></div><div ng-if="!!c.showMotivos"><table id="tbJust" class="with-space-bottom tabela bordaTabela marginMenos bordaBottom"><tr><td style="padding: 0 30px 0 30px;" class="headerTabelaCenter"><span style="white-space: nowrap;" class="impressaoFonte7">Motivo</span></td></tr><tr ng-repeat="item in c.justificativas track by $index"><td style="padding: 0 30px 0 30px;" class="centro"><span class="impressaoFonte7">{{item.motivo}}</span></td></tr></table></div><div ng-if="!c.dadosResultado.eliminado" class="atencao"><div ng-if="c.ano != 19"><p class="left"><strong>Importante:</strong>&nbsp;Para solicitar o certificado de conclusão do Ensino Médio ou do Ensino Fundamental, o participante deve ter atingido o mínimo de 100 (cem)\npontos em cada uma das áreas do conhecimento e nota igual ou superior a 5 (cinco) pontos na Redação.<strong>&nbsp;Se você alcançou a pontuação mínima de 100 pontos na prova de Linguagens, mas não o mínimo de 5 pontos na Redação, ou vice-versa,</strong>&nbsp;não alcançou a pontuação necessária para a proficiência na prova de Linguagens e de Redação. Nesse caso, será necessário refazer a prova na próxima edição do Encceja.<!-- | &nbsp;Para poder solicitar do certificado de conclusão do ensino médio, o participante deve ter atingido no mínimo de 100 (cem) pontos em cada uma das provas objetivas e, no mínimo, 5 (cinco) pontos na Redação.--><!-- strong &nbsp;Se você alcançou a pontuação mínima de 100 pontos na prova de Linguagens, mas não o mínimo de 5 pontos na Redação, ou vice-versa,--><!-- | &nbsp;não alcançou a pontuação necessária para a proficiência na prova de Linguagens e de Redação. Nesse caso, será necessário refazer a prova na próxima edição do Encceja.--></p></div><div ng-if="c.ano == 19"><p class="left"><strong>Importante:</strong>&nbsp;Será considerado habilitado se o participante atingir o mínimo de 100 (cem) pontos em cada uma das áreas de conhecimento do Encceja\n&nbsp;e obtiver nota igual ou superior a 5,0 (cinco) pontos na prova de redação.<br/>Para atingir a proficiência na área de conhecimento de Língua Portuguesa, Língua Estrangeira Moderna, Artes e Educação Física, no Ensino Fundamental,\n&nbsp;e de Linguagens, Códigos e suas Tecnologias, no Ensino Médio, o participante deverá obter também pontuação igual ou superior a 5,0 (cinco) pontos na prova de redação.</p></div></div><div ng-if="!c.dadosResultado.eliminado"><div class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Autentica&ccedil;&atilde;o de resultado. Esta funcionalidade &eacute; de uso exclusivo das Unidades Certificadoras</h2></div><div class="panel-body"><div class="row"><div class="col-md-12"><label class="impressaoFonte7">Para valida&ccedil;&atilde;o do resultado, seguir os seguintes passos:</label></div></div><div class="row"><div class="col-md-12"><b class="impressaoFonte7">Passo 1:</b><label class="impressaoFonte7">Acessar o site "http://enccejanacional.inep.gov.br/encceja//#!/loginAutenticidade";</label></div></div><div class="row"><div class="col-md-12"><b class="impressaoFonte7">Passo 2:</b><label class="impressaoFonte7">Insira o código de valida&ccedil;&atilde;o e acione a op&ccedil;&atilde;o enviar.</label></div></div><div class="row"><div class="col-md-12"><b class="impressaoFonte7">Código de valida&ccedil;&atilde;o:</b><label class="impressaoFonte7">{{c.dadosResultado.chave}}</label></div></div></div></div></div><div ng-if="c.dadosResultado.possuiArquivoVistaPedagogica || c.dadosResultado.possuiArquivoRedacao || c.dadosResultado.possuiArquivoObjetivaMatutina || c.dadosResultado.possuiArquivoObjetivaVespertina"><div class="panel panel-info hidden-print"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Imagens</h2></div><div class="panel-body"><div class="row"><div style="padding-bottom: 10px" class="col-md-12"><button style="margin-left: 10px;" ng-click="c.redirecionaVistaPedagogica()" role="button" class="btn btn-primary">Vista Pedagógica</button><button ng-if="c.dadosResultado.possuiArquivoRedacao" style="margin-left: 10px;" ng-click="c.visualizarEspelhoRedacao()" role="button" class="btn btn-primary">Redação</button><button ng-if="c.dadosResultado.possuiArquivoObjetivaMatutina" style="margin-left: 10px;" ng-click="c.visualizarEspelhoObjetivaMatutina()" role="button" class="btn btn-primary">Cartão-Resposta Manhã</button><button ng-if="c.dadosResultado.possuiArquivoObjetivaVespertina" style="margin-left: 10px;" ng-click="c.visualizarEspelhoObjetivaVespertina()" role="button" class="btn btn-primary">Cartão-Resposta Tarde</button></div></div></div></div></div><div class="panel panel-info hidden-print"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Junte-se a nós</h2></div><div class="panel-body"><div class="row"><div class="col-md-12"><p class="left"><strong>Faça parte do Conselho de Usuários de Serviços do INEP!</strong></p></div></div><div class="row"><div class="col-md-12"><p class="left"><strong>Acesse a plataforma, se cadastre e contribua com a melhoria dos nossos serviços.</strong></p></div></div><div class="row"><div style="padding-bottom: 10px" class="col-md-12"><button style="margin-left: 10px;" ng-click="c.openNewTab(\'https://conselhodeusuarios.cgu.gov.br/inicio\')" role="button" class="btn btn-primary">PARTICIPAR</button><button style="margin-left: 10px;" ng-click="c.openNewTab(\'https://www.gov.br/inep/pt-br/acesso-a-informacao/participacao-social/conselhos-e-orgaos-colegiados/conselho-de-usuarios\')" role="button" class="btn btn-primary">SAIBA MAIS</button></div></div></div></div><div class="clearfix"><ul class="pagination margin-bottom-none pull-right"><li class="primary"><button style="margin-right: 10px;" ng-click="c.visualizarEspelhoRedacao()" ng-if="c.showBotaoRedacao" role="button" class="btn btn-primary">Baixar Redação</button><button style="margin-right: 10px;" ng-click="c.redirecionaVistaPedagogica()" ng-if="c.showBotaoVistaPedagogica" role="button" class="btn btn-primary">Vista Pedagógica</button><button ng-click="c.imprimir()" role="button" class="btn btn-primary">Imprimir</button></li></ul></div><div inep-modal="inep-modal" np-id="modalError" np-buttons="c.modalError.buttons" np-show="c.modalError.show" np-options="c.modalError.options" np-header="Aviso"><p tabindex="0">{{ c.modalError.message }}</p></div><div inep-modal="inep-modal" np-id="modalExibirMensagem" np-buttons="c.modalExibirMensagem.buttons" np-show="c.modalExibirMensagem.show" np-options="c.modalExibirMensagem.options" np-header="Avaliar serviço"><p tabindex="0">{{ c.modalExibirMensagem.saudacao }}</p><p tabindex="0">{{ c.modalExibirMensagem.message }}</p><div class="row"><inep-boolean-checkbox np-id="checkNaoExibir" np-value="\'Não exibir novamente\'" np-selected-value="c.modalExibirMensagem.checkNaoExibir" np-optional="true"></inep-boolean-checkbox></div></div><div inep-modal="inep-modal" np-id="modalVistaPedagogica" np-buttons="c.modalVistaPedagogica.buttons" np-show="c.modalVistaPedagogica.show" np-options="c.modalVistaPedagogica.options" np-header="Aviso"><p tabindex="0">{{ c.modalVistaPedagogica.message }}</p></div></div><!--div(ng-if="!c.isEnsinoMedio")--><!--  .row.with-space: .col-md-12--><!--    enem-fieldset(np-tab = \'0\')--><!--      span.attention-label Aten&ccedil;&atilde;o:&nbsp;--><!--      span.text-justify--><!--        | Os resultados do Exame Nacional para Certificação de Competências de Jovens e Adultos (Encceja Nacional) Ensino Fundamental, assim como das edições para Pessoas Privadas de Liberdade e Exterior permanecem na data prevista: a partir de dezembro 2018.--><!--        br--><!--        | Os casos omissos e eventuais dúvidas referentes a este Edital serão resolvidos e esclarecidos pelo Inep, entrar em contato com a Central de Atendimento (0800 616161);--></div></div><div inep-modal="inep-modal" np-buttons="c.buttons" np-show="c.modalShow" np-id="modal" np-options="c.modalOptions" np-header="Aviso"><p tabindex="0">{{ c.modalMessage }}</p></div><div inep-modal="inep-modal" np-id="modalCarencia" np-buttons="c.modalCarencia.buttons" np-show="c.modalCarencia.show" np-options="c.modalCarencia.options" np-header="Aviso"><p tabindex="0">{{ c.modalCarencia.message }}</p></div><div inep-modal="inep-modal" np-id="modalExibirMensagem" np-buttons="c.modalExibirMensagem.buttons" np-show="c.modalExibirMensagem.show" np-options="c.modalExibirMensagem.options" np-header="Avaliar serviço"><p tabindex="0">{{ c.modalExibirMensagem.saudacao }}</p><p tabindex="0">{{ c.modalExibirMensagem.message }}</p></div><div inep-modal="inep-modal" np-buttons="c.modalSair.buttons" np-show="c.modalSair.show" np-id="modalSair" np-options="c.modalSair.options" np-header="Aviso"><p tabindex="0">{{ c.modalSair.saudacao }}</p><p tabindex="0">{{ c.modalSair.message }}</p></div></div></div></section></main>'),
a.put("views/acompanhamento/resultadoDoencaInfectocontagiosa.html",'<header role="banner"><h1 class="hide"> - </h1><nav role="navigation" aria-labelledby="#nav" ng-controller="NavigationBarController" class="navbar navbar-default navbar-fixed-top"><h2 id="nav" class="hide">Navegação Principal</h2><div class="container-fluid"><div class="navbar-header text-center"><button type="button" data-toggle="offcanvas" class="navbar-toggle collapsed left"><span class="sr-only">Toggle navigation</span><span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span></button><div aria-label="Bem vindo ao INEP" class="navbar-brand"><img src="images/logo_inep.svg" alt="Instituto Nacional de Estudos e Pesquisas Educacionais Anísio Teixeira"/></div><button type="button" data-toggle="collapse" data-target="#navbar-collapse" class="navbar-toggle collapsed right p-n"><span class="sr-only">Toggle navigation</span><i class="fa fa-gear text-white"></i></button></div><!--#navbar-collapse.collapse.navbar-collapse--><!--  ul.nav.navbar-nav--><!--    li.active--><!--      span.logo-inep.h3.m-n.font-700(data-toggle=\'tooltip\', data-placement=\'bottom\', title=project.name) #{project.abbr}--><!----><!--  ul.nav.navbar-nav.navbar-right--><!--    if !login--><!--      li--><!--        span(data-toggle=\'dropdown\') #[i.fa.fa-user] Participante: {{nomeParticipanteLogado}}--><!--    li--><!--      a.contrast(href=\'#\', inep-contrast="", data-toggle=\'tooltip\', data-placement=\'bottom\', aria-label=\'Contraste\') #[i.fa.fa-adjust]--><script type="text/ng-template" id="warning-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Você ainda está aí?</h3></div><div idle-countdown="countdown" class="modal-body"><uib-progressbar max="30" value="countdown" animate="true" class="progress-striped active"></uib-progressbar>Sua sessão será encerrada em {{countdown}} segundos.</div></div></script><script type="text/ng-template" id="timedout-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Sess&atilde;o encerrada.</h3></div><div class="modal-body"><p></p>Sua sess&atilde;o foi encerrada por inatividade.</div></div></script></div></nav></header><main role="main"><section class="login"><h1 class="hide">Painel de entrada</h1><div ng-controller="AcompanhamentoController as c" ng-init="c.init()"><div id="sideBar" class="col-sm-3 col-md-2 sidebar sidebar-offcanvas"><section><header></header><nav aria-labeledby="#nav"><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeEspelho()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" ng-click="c.navegarEspelho()" ng-if="!c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Acompanhar inscri&ccedil;&atilde;o {{c.anoEdicao}}</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.downloadDeclaracao()", ng-if="!c.isLoginLocalProva && c.menu.exibeDeclaracaoComparecimento()") Declara&ccedil;&atilde;o Comparecimento--><a style="cursor: pointer" ng-click="c.downloadDeclaracao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Declara&ccedil;&atilde;o Comparecimento</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarCartaoConfirmacao()", ng-if="!c.isLoginLocalProva && !c.menu.exibeCartaoConfirmacao()") Local de Prova/Cart&atilde;o Confirma&ccedil;&atilde;o--><a style="cursor: pointer" ng-click="c.navegarCartaoConfirmacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Local de Prova/Cart&atilde;o Confirma&ccedil;&atilde;o</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarDoencaInfectocontagiosa()", ng-if="!c.isLoginLocalProva && c.menu.exibeDoencaInfectocontagiosa()") Doenças Infectocontagiosas--><a style="cursor: pointer" ng-click="c.navegarDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuDoencaInfectoContagiosaVisivel.menuDoencaInfectoContagiosaEnabled" class="ng-scope">Doenças Infectocontagiosas</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarResultadoDoencaInfectocontagiosa()", ng-if="!c.isLoginLocalProva && c.menu.exibeResultadoDoencaInfectocontagiosa()") Resultado de Doenças Infectocontagiosas--><a style="cursor: pointer" ng-click="c.navegarResultadoDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuResultadoDoencaInfectoContagiosaVisivel.menuResultadoDoencaInfectoContagiosaEnabled" class="ng-scope">Resultado de Doenças Infectocontagiosas</a></li><li class="ng-scope"><a style="cursor: pointer" ng-click="c.navegarReaplicacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeReaplicacao() || c.menu.exibeReaplicacaoResultado()" class="ng-scope">Solicita&ccedil;&atilde;o de Reaplica&ccedil;&atilde;o</a><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarReaplicacao()", ng-if="!c.isLoginLocalProva && c.solicitarEnccejaReaplicacaoVisivel.exibirSolicitarEnccejaReaplicacaoEnabled") Registro de Ocorr&ecirc;ncias de Aplica&ccedil;&atilde;o--></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" class="ng-scope">Alterar dados</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarDadosPessoais()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeAlterarDadosInscricao()" class="ng-scope">Informa&ccedil;&otilde;es pessoais</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope"><!--ng-click="c.navegarAtendimentosEspecializados()",--><!--ng-if="!c.isLoginLocalProva && c.menu.exibeAlterarDadosInscricao()")-->Atendimento Especializado</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 40px" ng-click="c.navegarAtendimentosEspecializados()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope">Solicitar / Alterar Solicitação</a><!--ng-if="!c.isLoginLocalProva && false") Atendimento Especializado--></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer; padding-left: 30px", ng-click="c.navegarMunicipioProva()", ng-if="!c.isLoginLocalProva && c.menu.exibeAlterarDadosInscricao()") Informa&ccedil;&otilde;es de prova--><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarMunicipioProva()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuInformacoesProvaVisivel.inscricaoEmAndamento" class="ng-scope">Informa&ccedil;&otilde;es de prova</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer; padding-left: 30px", ng-click="c.navegarJustificativaAusencia()", ng-if="!c.isLoginLocalProva && c.menu.exibeAcompanhamentoJustificativa()") Justificativa de aus&ecirc;ncia--><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarJustificativaAusencia()" ng-if="c.validarExibicaoAcompanhamentoJustific()" class="ng-scope">Justificativa de aus&ecirc;ncia</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarContato()" class="ng-scope">Contato</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; false" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="atualizarSenha" class="ng-scope">Senha</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeLaudoMedico() && !!c.menuRecursoLaudoMedico")--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuRecursoLaudoMedico" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarLaudoMedico()" class="ng-scope">Recurso Laudo M&eacute;dico</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeTratamentoSocial()")--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuTratamentoNomeSocialVisivel.menuTratamentoNomeSocialEnabled" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="nomeSocial" class="ng-scope">Tratamento pelo Nome Social</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeReenvioTratamentoSocial()") verificar se eh recurso ou resultado--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.recursoMenuTratamentoNomeSocialVisivel.recursoMenuTratamentoNomeSocialEnabled &amp;&amp; !!c.menuRecursoNomeSocial" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="reenvioNomeSocial" class="ng-scope">Recurso Nome Social</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menu.exibeBoletoCobranca()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="boletoCobranca" class="ng-scope">Boleto de Cobrança</a></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultados()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" class="ng-scope">Resultado</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2017()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2017" class="ng-scope">ENCCEJA 2017</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2018()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2018" class="ng-scope">ENCCEJA 2018</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2019()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2019" class="ng-scope">ENCCEJA 2019</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2020()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2020" class="ng-scope">ENCCEJA 2020</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2022()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2022" class="ng-scope">ENCCEJA 2022</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2023()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2023" class="ng-scope">ENCCEJA 2023</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2024()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2024" class="ng-scope">ENCCEJA 2024</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2025()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2025" class="ng-scope">ENCCEJA 2025</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2026()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2026" class="ng-scope">ENCCEJA 2026</a></li></ul><ul inep-sidebar="inep-sidebar" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" ng-click="c.sair()" class="ng-scope">Sair</a></li></ul></nav></section></div><div class="col-sm-9 col-sm-offset-3 col-md-10 col-md-offset-2"><div class="panel-box ng-scope"><div ng-controller="ResultadoDoencaInfectocontagiosaController as c" ng-init="c.init()"><form autocomplete="off" inep-message-bag="inep-message-bag" message-bag-header-error="O formulário abaixo está inválido pelos seguintes erros:" name="doencaInfectocontagiosaForm" novalidate="true" role="form"><table style="border-collapse: collapse;margin: 2px 0;width: 100%;margin: 4px 0;"><tr style="border-collapse: collapse;margin: 2px 0;width: 100%;margin: 4px 0;"><td style="width: 25%;">&nbsp;</td><td style="width: 50%; text-align: center;"><div style="background-color: #2C3E50; color: #FFF; padding: 5px 0;"><span style="white-space: nowrap; font-size: 14px;"></span><strong>RESULTADO DE DOENÇAS INFECTOCONTAGIOSAS</strong><br/><span style="white-space: nowrap; text-decoration: underline">ENCCEJA NACIONAL 2020</span></div></td><td style="width: 25%;"><figure><img src="images/Logo-Encceja2026.png" style="width:110px; float: right"/></figure></td></tr><br/></table><div class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Dados de identifica&ccedil;ão do participante</h2></div><div class="panel-body"><div class="row"><div class="col-md-12"><b class="impressaoFonte7">Nome:</b><label class="impressaoFonte7">{{c.dadosResultado.nome}}</label></div></div><div class="row"><div class="col-md-12"><b class="impressaoFonte7">Número de Inscri&ccedil;ão:</b><label class="impressaoFonte7">{{c.dadosResultado.inscricao}}</label></div></div><div class="row"><div class="col-md-12"><b class="impressaoFonte7">CPF:</b><inep-output-text np-id="cpfFormatado" ng-model="c.dadosResultado.cpf" np-mask="999.999.999-99" class="impressaoFonte7"></inep-output-text></div></div><div class="row"><div class="col-md-12"><b class="impressaoFonte7">Data de Nascimento:</b><label class="impressaoFonte7">{{c.dadosResultado.dataNascimento}}</label></div></div></div></div><div class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Doença Infectocontagiosa</h2></div><div class="panel-body"><div class="with-space-top"><div class="row"><div class="col-md-12"><b>Possui alguma doença infectocontagiosa: &nbsp;</b><inep-output-text np-id="possuidoencaInfectocontagiosa" ng-model="c.possuiDoencaInfectocontagiosaValue" np-empty-Value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div class="row"><div class="col-md-12"><b ng-if="!!c.doencaInfectocontagiosa">Laudo:&nbsp;</b><inep-output-text np-id="statusdoencaInfectocontagiosa" ng-if="c.doencaInfectocontagiosa.situacaoLaudo.includes(&quot;Aprovado&quot;)" ng-model="c.doencaInfectocontagiosa.situacaoLaudo" style="color: green;" np-empty-Value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"> </inep-output-text><inep-output-text np-id="statusdoencaInfectocontagiosa" ng-if="c.doencaInfectocontagiosa.situacaoLaudo.includes(&quot;Reprovado&quot;)" ng-model="c.doencaInfectocontagiosa.situacaoLaudo" style="color: red;" np-empty-Value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"> </inep-output-text><inep-output-text np-id="statusdoencaInfectocontagiosa" ng-if="c.doencaInfectocontagiosa.situacaoLaudo.includes(&quot;Em análise&quot;)" ng-model="c.doencaInfectocontagiosa.situacaoLaudo" style="color: orange;" np-empty-Value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"> </inep-output-text></div></div><div class="row"><div class="col-md-12"><b ng-if="!!c.doencaInfectocontagiosa &amp;&amp; c.doencaInfectocontagiosa.situacaoLaudo.includes(&quot;Reprovado&quot;)">Motivos:&nbsp;<ul ng-repeat="motivo in c.doencaInfectocontagiosa.motivos"><li style="color: #0e377d">{{ motivo }}</li></ul></b></div></div></div></div></div></form></div></div><div inep-modal="inep-modal" np-buttons="c.buttons" np-show="c.modalShow" np-id="modal" np-options="c.modalOptions" np-header="Aviso"><p tabindex="0">{{ c.modalMessage }}</p></div><div inep-modal="inep-modal" np-id="modalCarencia" np-buttons="c.modalCarencia.buttons" np-show="c.modalCarencia.show" np-options="c.modalCarencia.options" np-header="Aviso"><p tabindex="0">{{ c.modalCarencia.message }}</p></div><div inep-modal="inep-modal" np-id="modalExibirMensagem" np-buttons="c.modalExibirMensagem.buttons" np-show="c.modalExibirMensagem.show" np-options="c.modalExibirMensagem.options" np-header="Avaliar serviço"><p tabindex="0">{{ c.modalExibirMensagem.saudacao }}</p><p tabindex="0">{{ c.modalExibirMensagem.message }}</p></div><div inep-modal="inep-modal" np-buttons="c.modalSair.buttons" np-show="c.modalSair.show" np-id="modalSair" np-options="c.modalSair.options" np-header="Aviso"><p tabindex="0">{{ c.modalSair.saudacao }}</p><p tabindex="0">{{ c.modalSair.message }}</p></div></div></div></section></main>'),a.put("views/acompanhamento/vistaPedagogica.html",'<header role="banner"><h1 class="hide"> - </h1><nav role="navigation" aria-labelledby="#nav" ng-controller="NavigationBarController" class="navbar navbar-default navbar-fixed-top"><h2 id="nav" class="hide">Navegação Principal</h2><div class="container-fluid"><div class="navbar-header text-center"><button type="button" data-toggle="offcanvas" class="navbar-toggle collapsed left"><span class="sr-only">Toggle navigation</span><span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span></button><div aria-label="Bem vindo ao INEP" class="navbar-brand"><img src="images/logo_inep.svg" alt="Instituto Nacional de Estudos e Pesquisas Educacionais Anísio Teixeira"/></div><button type="button" data-toggle="collapse" data-target="#navbar-collapse" class="navbar-toggle collapsed right p-n"><span class="sr-only">Toggle navigation</span><i class="fa fa-gear text-white"></i></button></div><!--#navbar-collapse.collapse.navbar-collapse--><!--  ul.nav.navbar-nav--><!--    li.active--><!--      span.logo-inep.h3.m-n.font-700(data-toggle=\'tooltip\', data-placement=\'bottom\', title=project.name) #{project.abbr}--><!----><!--  ul.nav.navbar-nav.navbar-right--><!--    if !login--><!--      li--><!--        span(data-toggle=\'dropdown\') #[i.fa.fa-user] Participante: {{nomeParticipanteLogado}}--><!--    li--><!--      a.contrast(href=\'#\', inep-contrast="", data-toggle=\'tooltip\', data-placement=\'bottom\', aria-label=\'Contraste\') #[i.fa.fa-adjust]--><script type="text/ng-template" id="warning-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Você ainda está aí?</h3></div><div idle-countdown="countdown" class="modal-body"><uib-progressbar max="30" value="countdown" animate="true" class="progress-striped active"></uib-progressbar>Sua sessão será encerrada em {{countdown}} segundos.</div></div></script><script type="text/ng-template" id="timedout-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Sess&atilde;o encerrada.</h3></div><div class="modal-body"><p></p>Sua sess&atilde;o foi encerrada por inatividade.</div></div></script></div></nav></header><main role="main"><section class="login"><h1 class="hide">Painel de entrada</h1><div ng-controller="AcompanhamentoController as c" ng-init="c.init()"><div id="sideBar" class="col-sm-3 col-md-2 sidebar sidebar-offcanvas"><section><header></header><nav aria-labeledby="#nav"><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeEspelho()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" ng-click="c.navegarEspelho()" ng-if="!c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Acompanhar inscri&ccedil;&atilde;o {{c.anoEdicao}}</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.downloadDeclaracao()", ng-if="!c.isLoginLocalProva && c.menu.exibeDeclaracaoComparecimento()") Declara&ccedil;&atilde;o Comparecimento--><a style="cursor: pointer" ng-click="c.downloadDeclaracao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Declara&ccedil;&atilde;o Comparecimento</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarCartaoConfirmacao()", ng-if="!c.isLoginLocalProva && !c.menu.exibeCartaoConfirmacao()") Local de Prova/Cart&atilde;o Confirma&ccedil;&atilde;o--><a style="cursor: pointer" ng-click="c.navegarCartaoConfirmacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuLocalDeProvaVisivel.localDeProvaEnabled" class="ng-scope">Local de Prova/Cart&atilde;o Confirma&ccedil;&atilde;o</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarDoencaInfectocontagiosa()", ng-if="!c.isLoginLocalProva && c.menu.exibeDoencaInfectocontagiosa()") Doenças Infectocontagiosas--><a style="cursor: pointer" ng-click="c.navegarDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuDoencaInfectoContagiosaVisivel.menuDoencaInfectoContagiosaEnabled" class="ng-scope">Doenças Infectocontagiosas</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarResultadoDoencaInfectocontagiosa()", ng-if="!c.isLoginLocalProva && c.menu.exibeResultadoDoencaInfectocontagiosa()") Resultado de Doenças Infectocontagiosas--><a style="cursor: pointer" ng-click="c.navegarResultadoDoencaInfectocontagiosa()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuResultadoDoencaInfectoContagiosaVisivel.menuResultadoDoencaInfectoContagiosaEnabled" class="ng-scope">Resultado de Doenças Infectocontagiosas</a></li><li class="ng-scope"><a style="cursor: pointer" ng-click="c.navegarReaplicacao()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeReaplicacao() || c.menu.exibeReaplicacaoResultado()" class="ng-scope">Solicita&ccedil;&atilde;o de Reaplica&ccedil;&atilde;o</a><!--a(class="ng-scope", style="cursor: pointer", ng-click="c.navegarReaplicacao()", ng-if="!c.isLoginLocalProva && c.solicitarEnccejaReaplicacaoVisivel.exibirSolicitarEnccejaReaplicacaoEnabled") Registro de Ocorr&ecirc;ncias de Aplica&ccedil;&atilde;o--></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" class="ng-scope">Alterar dados</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarDadosPessoais()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeAlterarDadosInscricao()" class="ng-scope">Informa&ccedil;&otilde;es pessoais</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope"><!--ng-click="c.navegarAtendimentosEspecializados()",--><!--ng-if="!c.isLoginLocalProva && c.menu.exibeAlterarDadosInscricao()")-->Atendimento Especializado</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 40px" ng-click="c.navegarAtendimentosEspecializados()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuAtendimentoEspecializadoVisivel.menuAtendimentoEspecializadoEnabled" class="ng-scope">Solicitar / Alterar Solicitação</a><!--ng-if="!c.isLoginLocalProva && false") Atendimento Especializado--></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer; padding-left: 30px", ng-click="c.navegarMunicipioProva()", ng-if="!c.isLoginLocalProva && c.menu.exibeAlterarDadosInscricao()") Informa&ccedil;&otilde;es de prova--><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarMunicipioProva()" ng-if="!c.isLoginLocalProva &amp;&amp; c.menuInformacoesProvaVisivel.inscricaoEmAndamento" class="ng-scope">Informa&ccedil;&otilde;es de prova</a></li><li class="ng-scope"><!--a(class="ng-scope", style="cursor: pointer; padding-left: 30px", ng-click="c.navegarJustificativaAusencia()", ng-if="!c.isLoginLocalProva && c.menu.exibeAcompanhamentoJustificativa()") Justificativa de aus&ecirc;ncia--><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarJustificativaAusencia()" ng-if="c.validarExibicaoAcompanhamentoJustific()" class="ng-scope">Justificativa de aus&ecirc;ncia</a></li><li class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarContato()" class="ng-scope">Contato</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; false" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="atualizarSenha" class="ng-scope">Senha</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeLaudoMedico() && !!c.menuRecursoLaudoMedico")--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuRecursoLaudoMedico" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" ng-click="c.navegarLaudoMedico()" class="ng-scope">Recurso Laudo M&eacute;dico</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeTratamentoSocial()")--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menuTratamentoNomeSocialVisivel.menuTratamentoNomeSocialEnabled" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="nomeSocial" class="ng-scope">Tratamento pelo Nome Social</a></li><!--li(class="ng-scope", ng-if="!c.isLoginLocalProva && !!c.menu.exibeReenvioTratamentoSocial()") verificar se eh recurso ou resultado--><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.recursoMenuTratamentoNomeSocialVisivel.recursoMenuTratamentoNomeSocialEnabled &amp;&amp; !!c.menuRecursoNomeSocial" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="reenvioNomeSocial" class="ng-scope">Recurso Nome Social</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; !!c.menu.exibeBoletoCobranca()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="boletoCobranca" class="ng-scope">Boleto de Cobrança</a></li></ul><ul inep-sidebar="inep-sidebar" ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultados()" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" class="ng-scope">Resultado</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2017()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2017" class="ng-scope">ENCCEJA 2017</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2018()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2018" class="ng-scope">ENCCEJA 2018</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2019()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2019" class="ng-scope">ENCCEJA 2019</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2020()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2020" class="ng-scope">ENCCEJA 2020</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2022()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2022" class="ng-scope">ENCCEJA 2022</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2023()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2023" class="ng-scope">ENCCEJA 2023</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2024()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2024" class="ng-scope">ENCCEJA 2024</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2025()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2025" class="ng-scope">ENCCEJA 2025</a></li><li ng-if="!c.isLoginLocalProva &amp;&amp; c.menu.exibeResultado2026()" class="ng-scope"><a style="cursor: pointer; padding-left: 30px" data-ui-sref="resultado2026" class="ng-scope">ENCCEJA 2026</a></li></ul><ul inep-sidebar="inep-sidebar" class="nav nav-sidebar ng-scope"><li class="ng-scope"><a style="cursor: pointer" ng-click="c.sair()" class="ng-scope">Sair</a></li></ul></nav></section></div><div class="col-sm-9 col-sm-offset-3 col-md-10 col-md-offset-2"><div class="panel-box ng-scope"><style>@media print {\n  @page {\n       size: A4 portrait;\n       margin:1cm;\n     }\n  ::-webkit-scrollbar {\n       display: none;\n     }\n  #menu-barra-brasil {\n    display:none\n  }\n}</style><div ng-controller="VistaPedagogicaController as c"><div class="panel"><div class="panel-body"><div class="row"><div class="col-md-12"><table style="border-collapse: collapse;margin: 2px 0;width: 100%;margin: 4px 0;"><tr style="border-collapse: collapse;margin: 2px 0;width: 100%;margin: 4px 0;"><td style="width: 25%;">&nbsp;</td><td style="width: 50%; text-align: center;"><div style="background-color: #0e377d; color: #FFF; padding: 5px 0;"><span style="white-space: nowrap; text-decoration: underline">EXAME NACIONAL PARA CERTIFICA&Ccedil;&Atilde;O DE COMPET&Ecirc;NCIAS DE JOVENS E ADULTOS - ENCCEJA 20{{c.ano}}</span><br/><span style="white-space: nowrap; font-size: 14px;"><strong>Vista Pedagógica 20{{c.ano}}</strong></span></div></td><td style="width: 25%;"><figure><img src="images/Logo-Encceja20{{c.ano}}.png" style="width:110px; float: right"/></figure></td></tr></table><br/></div></div></div></div><div ng-show="!!c.dadosRedacao"><div class="panel panel-info"><div class="panel-heading"><h4 tabindex="0" focus-me="focus-me" class="h4 panel-title text-left text-primary">Dados Pessoais</h4></div><div class="panel-body"><div class="row"><div class="col-md-6"><b>Número de inscrição:</b><label>{{c.candidato.codigoInscricao}}</label></div><div class="col-md-6"><b>CPF:</b><inep-output-text np-id="cpfFormatado" ng-model="c.candidato.cpf" np-mask="999.999.999-99"></inep-output-text></div></div><div class="row"><div class="col-md-6"><b>Nome:</b><label>{{c.candidato.nome}}</label></div><div class="col-md-6"><b>Data de Nascimento:</b><label>{{c.candidato.dataNascimento}}</label></div></div></div></div><div class="panel panel-info"><div class="panel-heading"><h4 tabindex="0" class="h4 panel-title text-left text-primary">Competência 1</h4></div><div class="panel-body"><div class="row"><div class="col-md-12"><b>Demonstrar domínio da norma-padrão da língua portuguesa escrita.</b></div></div><div class="row"><div class="col-md-12">Sua nota nessa competência foi:<label>{{c.dadosRedacao.valorNotaCompetencia1}}</label><p class="with-space">{{c.dadosRedacao.textoFaixaCompetencia1}}</p></div></div></div></div><div class="panel panel-info"><div class="panel-heading"><h4 tabindex="0" class="h4 panel-title text-left text-primary">Competência 2</h4></div><div class="panel-body"><div class="row"><div class="col-md-12"><b>Elaborar um texto dissertativo-argumentativo dentro do tema proposto, aplicando conceitos das várias áreas do conhecimento para desenvolvê-lo.</b></div></div><div class="row"><div class="col-md-12">Sua nota nessa competência foi:<label>{{c.dadosRedacao.valorNotaCompetencia2}}</label><p class="with-space">{{c.dadosRedacao.textoFaixaCompetencia2}}</p></div></div></div></div><div class="panel panel-info"><div class="panel-heading"><h4 tabindex="0" class="h4 panel-title text-left text-primary">Competência 3</h4></div><div class="panel-body"><div class="row"><div class="col-md-12"><b>Selecionar, relacionar, organizar e interpretar informações, fatos, opiniões e argumentos em defesa de um ponto de vista.</b></div></div><div class="row"><div class="col-md-12">Sua nota nessa competência foi:<label>{{c.dadosRedacao.valorNotaCompetencia3}}</label><p class="with-space">{{c.dadosRedacao.textoFaixaCompetencia3}}</p></div></div></div></div><div class="panel panel-info"><div class="panel-heading"><h4 tabindex="0" class="h4 panel-title text-left text-primary">Competência 4</h4></div><div class="panel-body"><div class="row"><div class="col-md-12"><b>Demonstrar conhecimento dos mecanismos linguísticos necessários para a construção da argumentação.</b></div></div><div class="row"><div class="col-md-12">Sua nota nessa competência foi:<label>{{c.dadosRedacao.valorNotaCompetencia4}}</label><p class="with-space">{{c.dadosRedacao.textoFaixaCompetencia4}}</p></div></div></div></div><div ng-if="c.isEnsinoMedio" class="panel panel-info"><div class="panel-heading"><h4 tabindex="0" class="h4 panel-title text-left text-primary">Competência 5</h4></div><div class="panel-body"><div class="row"><div class="col-md-12"><b>Elaborar proposta de intervenção para o problema abordado, respeitando os direitos humanos.</b></div></div><div class="row"><div class="col-md-12">Sua nota nessa competência foi:<label>{{c.dadosRedacao.valorNotaCompetencia5}}</label><p class="with-space">{{c.dadosRedacao.textoFaixaCompetencia5}}</p></div></div></div></div><div class="panel panel-info"><div class="panel-heading"><h4 tabindex="0" class="h4 panel-title text-left text-primary">Nota Final</h4></div><div class="panel-body"><div class="row"><div class="col-md-12"><b>Situação:</b><label>{{c.tipoPresenca}}</label></div></div><div class="row"><div class="col-md-12"><b>Sua nota final foi:</b><label>{{c.valorNotaFinal}}</label></div></div><div class="row"><div class="col-md-12">No gráfico abaixo está destacado o grupo em que você se encontra.</div></div><div class="row"><div class="col-md-12">Assim, você poderá visualizar o seu desempenho em comparação aos demais participantes do Encceja.</div></div><div class="row"><div class="col-md-12 text-center with-space"><chartist chartist-data="c.grafico" chartist-chart-type="Bar" chartist-events="c.chartEvents" chartist-chart-options="c.configGrafico" class="ct-chart"></chartist></div></div></div></div><div class="clearfix"><ul class="pagination margin-bottom-none pull-right"><li class="primary"><button role="button" data-ui-sref="resultado20{{c.candidato.ano}}" class="btn btn-primary">Voltar</button></li><li class="primary"><button ng-click="c.imprimir()" role="button" class="btn btn-primary">Imprimir</button></li></ul></div></div><div inep-modal="inep-modal" np-id="modalVistaPedagogica" np-buttons="c.modalVistaPedagogica.buttons" np-show="c.modalVistaPedagogica.show" np-options="c.modalVistaPedagogica.options" np-header="Aviso"><p tabindex="0">{{ c.modalVistaPedagogica.message }}</p></div></div></div><div inep-modal="inep-modal" np-buttons="c.buttons" np-show="c.modalShow" np-id="modal" np-options="c.modalOptions" np-header="Aviso"><p tabindex="0">{{ c.modalMessage }}</p></div><div inep-modal="inep-modal" np-id="modalCarencia" np-buttons="c.modalCarencia.buttons" np-show="c.modalCarencia.show" np-options="c.modalCarencia.options" np-header="Aviso"><p tabindex="0">{{ c.modalCarencia.message }}</p></div><div inep-modal="inep-modal" np-id="modalExibirMensagem" np-buttons="c.modalExibirMensagem.buttons" np-show="c.modalExibirMensagem.show" np-options="c.modalExibirMensagem.options" np-header="Avaliar serviço"><p tabindex="0">{{ c.modalExibirMensagem.saudacao }}</p><p tabindex="0">{{ c.modalExibirMensagem.message }}</p></div><div inep-modal="inep-modal" np-buttons="c.modalSair.buttons" np-show="c.modalSair.show" np-id="modalSair" np-options="c.modalSair.options" np-header="Aviso"><p tabindex="0">{{ c.modalSair.saudacao }}</p><p tabindex="0">{{ c.modalSair.message }}</p></div></div></div></section></main>'),
a.put("template/partials/_govbar_footer.html",'<!--script(async, defer, src=\'barra-sistema.js\')--><!--script(async, defer,src=\'//barra.brasil.gov.br/barra.js\')--><footer role="contentinfo" class="bg-danger text-white pfix-b"><div class="container-fluid"><div class="row"><div class="col-sm-2"></div><div class="col-xs-5 col-sm-7 col-md-7 text-center"><p class="m-n">&copy; <strong>MEC</strong> - Minist&eacute;rio da Educa&ccedil;&atilde;o | <strong>INEP</strong> - Instituto Nacional de Estudos e Pesquisas Educacionais An&iacute;sio Teixeira</p></div><div class="col-xs-7 col-sm-1 col-md-3 text-right"><ul class="list-inline text-nowrap m-n"><li><strong aria-hidden="true" class="fa fa-desktop"></strong><strong>3.0.69</strong></li><li ng-if="!!version"><strong aria-hidden="true" class="fa fa-server"></strong><strong>{{version}}</strong></li></ul></div></div></div></footer>'),a.put("template/partials/_govbar_head.html",'<div id="barra-brasil" style="background:#7F7F7F; height: 20px; padding:0 0 0 10px;display:block;"><ul id="menu-barra-temp" style="list-style:none;"><li style="display:inline; float:left;padding-right:10px; margin-right:10px; border-right:1px solid #EDEDED"><a href="http://brasil.gov.br" style="font-family:sans,sans-serif; text-decoration:none; color:white;">Portal do Governo Brasileiro</a></li><li><a style="font-family:sans,sans-serif; text-decoration:none; color:white;" href="http://epwg.governoeletronico.gov.br/barra/atualize.html">Atualize sua Barra de Governo</a></li></ul></div>'),a.put("template/partials/_head.html",'<head><title>INEP - Instituto Nacional de Estudos e Pesquisas Educacionais Anísio Teixeira</title><meta charset="utf-8" version="3.0.69"/><link rel="stylesheet" type="text/css" href="css/style.css"/><link rel="shortcut icon" href="favicon2018.JPG?v=2" sizes="32x32"/><!--base(href="/encceja/")--><!--script(type=\'text/javascript\', src=\'http://public.inep.gov.br/ga/ga_UA-976559-10.js\')--><!--meta(property="creator.productor",content="http://estruturaorganizacional.dados.gov.br/id/unidade-organizacional/NUMERO")--><!--script.--><!--    (function (i, s, o, g, r, a, m) {--><!--        i[\'GoogleAnalyticsObject\'] = r;--><!--        i[r] = i[r] || function () {--><!--                (i[r].q = i[r].q || []).push(arguments)--><!--            }, i[r].l = 1 * new Date();--><!--        a = s.createElement(o),--><!--            m = s.getElementsByTagName(o)[0];--><!--        a.async = 1;--><!--        a.src = g;--><!--        m.parentNode.insertBefore(a, m)--><!--    })(window, document, \'script\', \'//www.google-analytics.com/analytics.js\', \'ga\');--><!----><!--    ga(\'create\', \'UA-93335532-1\', \'none\');//ga(\'send\', \'pageview\');--><script src="libs.js"></script><script src="app.js"></script></head>'),a.put("template/partials/_informaObrigatoriedade.html",'<div tabindex="0"><div class="text-center text-primary"><label>Os campos com <i alt="asterisco" class="fa fa-asterisk"><span class="hidden-accessibility">asterisco</span></i> s&atilde;o de preenchimento obrigat&oacute;rio</label></div><div class="row with-space-bottom"></div></div>'),a.put("enem-regra/template/regras/rne003.html",'<div ng-show=\'ngModel.dependencia.regras.indexOf("RNE003") > -1\'>\n  <div class="row">\n    <enem-fieldset>\n      <span class="attention-label">Aten&ccedil;&atilde;o:</span>\n      <span class="text-justify">insira a declara&ccedil;&atilde;o do hospital em que estiver internado para tratamento de sa&uacute;de, de acordo com o item 2 edital do ENEM. Somente ser&atilde;o aceitos documentos no formato PDF, PNG ou JPG, no tamanho m&aacute;ximo de 2MB.</span>\n    </enem-fieldset>\n  </div>\n\n  <div class="row with-space-bottom" ng-repeat="u in ngModel.uploads track by u.id">\n    <inep-input-file ng-if="!u.send" np-id="documento_comprobatorio_{{u.id}}" np-label="{{u.descricao}}" np-value="u.file" np-max-file-size="maxFileSize" np-show-icon="true" np-size="6" np-max-file-message="Tamanho de arquivo inválido." np-content-type-message="Formato de arquivo inválido." np-disabled="" np-optional="false" np-content-types="contentTypes" np-empty-message="{{mensagens.MSG_ARQUIVO_VAZIO}}">\n    </inep-input-file>\n    <div class="col-md-4" ng-if="isFileValid(u.id) && !u.send">\n      <button id="enviar_{{u.id}}" class="btn btn-default align-button-upload" ng-click="enviarArquivo(u.id)">Enviar arquivo\n      </button>\n    </div>\n    <div class="col-md-6" ng-if="u.send">\n      <inep-output-text id="mensagem_laudo_{{u.id}}" ng-model="u.ARQUIVO_ENVIADO_COM_SUCESSO">\n      </inep-output-text>\n    </div>\n    <div class="col-md-4" ng-if="u.send">\n      <button id="excluir_laudo_{{u.id}}" class="btn btn-default align-button-upload" ng-click="excluirArquivo(u.id)">Excluir arquivo\n      </button>\n    </div>\n  </div>\n</div>\n'),a.put("enem-regra/template/regras/rne004.html",'<div ng-show="ngModel.dependencia.regras.indexOf(\'RNE004\') > -1">\n  <enem-fieldset>\n    <inep-boolean-checkbox np-id="declaroGuardador" np-value="opcaoGuardador.text" np-selected-value="opcaoGuardador.value" np-required-message="{{mensagens.MSGOD03}}" np-optional="false">\n    </inep-boolean-checkbox>\n  </enem-fieldset>\n</div>\n'),a.put("enem-regra/template/regras/rne005.html",'<div ng-show="ngModel.dependencia.regras.indexOf(\'RNE005\') > -1">\n  <inep-radiobutton np-id="combocid_{{npId}}" np-label="Informe o tipo do CID (Classificação Internacional de Doença):" np-values="opcoesCID" np-selected-value="cidSelecionado" np-inline="false" np-on-click="carregarMascaraCid()" np-optional="npOptional" np-disabled="npDisabled">\n  </inep-radiobutton>\n  <div ng-show="cidSelecionado">\n    <inep-input-text np-id="cid" np-label="Informe o código:" ng-model="ngModel.cid" np-size="12" np-optional="npOptional" np-maxlength="{{tamanhoCid}}" np-validator-message="{{mensagemCid}}" np-readonly="npDisabled" inep-validator="validarCampo()" to-upper-case="to-upper-case">\n    </inep-input-text>\n    <span tabindex="0">\n      <b ng-if="ngModel.classificacaoDoenca">Descrição: </b>{{ngModel.classificacaoDoenca.label}}\n    </span>\n  </div>\n</div>\n'),a.put("enem-regra/template/regras/rne007.html",'<div ng-show="ngModel.dependencia.regras.indexOf(\'RNE007\') > -1">\n  <div class="row with-space-top">\n    <inep-radiobutton np-id="comboPossuiNomeSocial" np-label="Deseja ser tratado pelo nome social?" np-values="opcoesNomeSocial" np-selected-value="$parent.$parent.possuiNomeSocial" np-inline="true" np-text-name="text" np-value-name="value" np-on-click="limparAoSelecionarNomeSocial()" np-optional="npOptional" ng-if="!npDisabled">\n    </inep-radiobutton>\n    <div ng-if="npDisabled">\n      <div class="col-md-12">Deseja ser tratado pelo nome social?\n        <inep-output-text np-id="nomePossuiSocialOut" ng-model="nomeOpcao"></inep-output-text>\n      </div>\n    </div>\n  </div>\n  <div ng-if="$parent.possuiNomeSocial">\n    <div class="row">\n      <div class="col-md-1"></div>\n      <inep-input-text np-id="nomeSocial" np-label="Nome social:" ng-model="ngModel.nomeSocial" np-size="7" np-optional="npOptional" ng-if="!$parent.$parent.npDisabled">\n      </inep-input-text>\n      <div ng-if="$parent.$parent.npDisabled" class="col-md-7">Nome social:\n        <inep-output-text np-id="nomeSocialOut" ng-model="ngModel.nomeSocial"></inep-output-text>\n      </div>\n      <div class="col-md-4"></div>\n    </div>\n    <div class="row">\n      <div class="col-md-1"></div>\n      <div class="col-md-11">\n        <div ng-if="npInformacao" class="box-describe">{{npInformacao}}</div>\n      </div>\n    </div>\n    <div class="row">\n      <div class="col-md-1"></div>\n      <inep-radiobutton np-id="comboAmbienteSanitario" np-label="Ambiente sanitário:" np-values="opcoesSanitario" np-selected-value="ngModel.tipoSanitario" np-inline="true" np-text-name="text" np-value-name="value" np-size="11" np-optional="npOptional" np-on-click="carregarNomeAmbienteSanitario()" ng-if="!npDisabled">\n      </inep-radiobutton>\n      <div ng-if="$parent.$parent.npDisabled" class="col-md-11">Ambiente sanitário:\n        <inep-output-text np-id="nomeAmbienteOut" ng-model="nomeAmbienteSanitario"></inep-output-text>\n      </div>\n    </div>\n    <div ng-if="!$parent.$parent.npDisabled" class="row">\n      <div class="col-md-1"></div>\n      <div class="col-md-11">\n        <enem-fieldset>\n          <inep-boolean-checkbox np-id="declaroTravestiTransexual" np-value="opcaoTravestiTransexual.text" np-selected-value="opcaoTravestiTransexual.value" np-optional="false">\n          </inep-boolean-checkbox>\n        </enem-fieldset>\n      </div>\n    </div>\n  </div>\n</div>\n'),a.put("views/inscricao/finalizarProcesso/finalizarInscricao.html",'<header role="banner"><h1 class="hide"> - </h1><nav role="navigation" aria-labelledby="#nav" ng-controller="NavigationBarController" class="navbar navbar-default navbar-fixed-top"><h2 id="nav" class="hide">Navegação Principal</h2><div class="container-fluid"><div class="navbar-header text-center"><button type="button" data-toggle="offcanvas" class="navbar-toggle collapsed left"><span class="sr-only">Toggle navigation</span><span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span></button><div aria-label="Bem vindo ao INEP" class="navbar-brand"><img src="images/logo_inep.svg" alt="Instituto Nacional de Estudos e Pesquisas Educacionais Anísio Teixeira"/></div><button type="button" data-toggle="collapse" data-target="#navbar-collapse" class="navbar-toggle collapsed right p-n"><span class="sr-only">Toggle navigation</span><i class="fa fa-gear text-white"></i></button></div><!--#navbar-collapse.collapse.navbar-collapse--><!--  ul.nav.navbar-nav--><!--    li.active--><!--      span.logo-inep.h3.m-n.font-700(data-toggle=\'tooltip\', data-placement=\'bottom\', title=project.name) #{project.abbr}--><!----><!--  ul.nav.navbar-nav.navbar-right--><!--    if !login--><!--      li--><!--        span(data-toggle=\'dropdown\') #[i.fa.fa-user] Participante: {{nomeParticipanteLogado}}--><!--    li--><!--      a.contrast(href=\'#\', inep-contrast="", data-toggle=\'tooltip\', data-placement=\'bottom\', aria-label=\'Contraste\') #[i.fa.fa-adjust]--><script type="text/ng-template" id="warning-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Você ainda está aí?</h3></div><div idle-countdown="countdown" class="modal-body"><uib-progressbar max="30" value="countdown" animate="true" class="progress-striped active"></uib-progressbar>Sua sessão será encerrada em {{countdown}} segundos.</div></div></script><script type="text/ng-template" id="timedout-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Sess&atilde;o encerrada.</h3></div><div class="modal-body"><p></p>Sua sess&atilde;o foi encerrada por inatividade.</div></div></script></div></nav></header><main role="main"><section class="login"><h1 class="hide">Painel de entrada</h1><div class="panel-box"><div ng-controller="EspelhoController as c" ng-init="c.init()" class="container"><header><div class="page-header with-space-top"><h1 class="h3">Inscri&ccedil;&atilde;o > ENCCEJA <small>conclus&atilde;o</small></h1></div></header><form autocomplete="off" inep-message-bag="inep-message-bag" message-bag-header-error="O formulário abaixo está inválido pelos seguintes erros:" name="concluirInscricaoForm" novalidate="true" role="form"><div class="row"><div class="col-md-4"></div><enem-fieldset><div tabindex="0" ng-if="c.espelho.situacaoIncricao != &quot;Não confirmada&quot;" class="msg-inscricao-sucesso">Inscri&ccedil;&atilde;o conclu&iacute;da com sucesso.</div><div tabindex="0" ng-if="c.espelho.situacaoIncricao == &quot;Não confirmada&quot;" class="msg-inscricao-aviso">Inscrição concluída – Pendente de pagamento da taxa de ressarcimento</div></enem-fieldset><div class="col-md-4"></div></div><div ng-if="c.espelho.situacaoIncricao == &quot;Não confirmada&quot;" class="row"><enem-fieldset><span class="text-justify"> Você foi ausente em todas as áreas de conhecimento em que estava inscrito no Encceja 2025 e não justificou sua ausência ou teve sua justificativa reprovada. Acesse o menu lateral para ter acesso a sua GRU Cobrança. Sua inscrição será confirmada apenas após o pagamento da GRU.</span></enem-fieldset></div></form><div></div><div class="panel panel-info"><div tabindex="0" class="panel-heading"><h2 text-left="text-left" text-primary="text-primary" class="h4 panel-title">Confirma&ccedil;&atilde;o dos dados</h2></div><div class="panel-body"><div tabindex="0" class="with-space-top"><br/><legend><b>Dados da inscri&ccedil;&atilde;o</b></legend><div class="row"><div class="col-md-12"><p>Guarde o seu n&uacute;mero de inscri&ccedil;&atilde;o, informado abaixo.</p></div></div><div class="row"><div class="col-md-12"><b>N&uacute;mero de inscri&ccedil;&atilde;o:&nbsp;</b><inep-output-text np-id="numInscricao" ng-model="c.espelho.numeroInscricao" np-empty-Value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div class="row"><div class="col-md-12"><b>Situa&ccedil;&atilde;o da inscri&ccedil;&atilde;o:&nbsp;</b><inep-output-text np-id="situacaoInscricao" ng-model="c.espelho.situacaoIncricao" np-empty-Value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div class="row"><div class="col-md-12"><b>Ano ENCCEJA:&nbsp;</b><inep-output-text np-id="anoEnem" ng-model="c.anoEdicao" np-empty-Value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div></div><div tabindex="0" class="with-space-top"><br/><legend><b>Dados pessoais</b></legend><div class="row"><div class="col-md-3"><b>CPF:&nbsp;</b><inep-output-text np-id="cpfFormatado" ng-model="c.espelho.cpf" np-mask="999.999.999-99" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div><div class="col-md-6"><b>Nome completo:&nbsp;</b><inep-output-text np-id="nome" ng-model="c.espelho.nome" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div><div class="col-md-3"><b>Data de nascimento:&nbsp;</b><inep-output-text np-id="dataNascimento" ng-model="c.espelho.dataNascimento" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div class="row"><div ng-if="!!c.espelho.nomeSocialEspelhoDto &amp;&amp; c.espelho.nomeSocialEspelhoDto.status == \'Aprovado\'" class="col-md-6"><b>Nome Social:&nbsp;</b><inep-output-text np-id="nomeSocial" ng-model="c.espelho.nomeSocialEspelhoDto.nomeSocial" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div><div class="col-md-6"><b>Nome completo da m&atilde;e:&nbsp;</b><inep-output-text np-id="nomeDaMae" ng-model="c.espelho.nomeDaMae" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div class="row"><div class="col-md-6"><b>Nome completo do pai:&nbsp;</b><inep-output-text np-id="nomeDoPai" ng-model="c.espelho.nomeDoPai" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div class="row"><div class="col-md-3"><b>Sexo:&nbsp;</b><inep-output-text np-id="sexo" ng-model="c.espelho.sexo" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div><div class="col-md-3"><b>Cor ou Ra&ccedil;a:&nbsp;</b><inep-output-text np-id="nomeEtnia" ng-model="c.espelho.etnia" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div class="row"><div class="col-md-3"><b>Estado civil:&nbsp;</b><inep-output-text np-id="nomeEstadoCivil" ng-model="c.espelho.estadoCivil" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div><div class="col-md-6"><b>Nacionalidade:&nbsp;</b><inep-output-text np-id="nacionalidade" ng-model="c.espelho.nacionalidade" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div class="row"><div ng-if="!!c.espelho.nascimentoMunicipio"><div class="col-md-3"><b>UF de nascimento:&nbsp;</b><inep-output-text np-id="nomeUfNascimento" ng-model="c.espelho.ufNascimento" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div><div class="col-md-3"><b>Munic&iacute;pio de nascimento:&nbsp;</b><inep-output-text np-id="nomeMunicipioNascimento" ng-model="c.espelho.nascimentoMunicipio" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div></div></div><div tabindex="0" class="with-space-top"><br/><legend><b>Endere&ccedil;o residencial</b></legend><div class="row"><div class="col-md-12"><b>CEP:&nbsp;</b><inep-output-text np-id="cepFormatado" ng-model="c.espelho.cep" np-mask="99.999-999" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div class="row"><div class="col-md-5"><b>Endere&ccedil;o:&nbsp;</b><inep-output-text np-id="logradouro" ng-model="c.espelho.logradouro" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div><div class="col-md-3"><b>N&uacute;mero:&nbsp;</b><inep-output-text np-id="numeroEndereco" ng-model="c.espelho.residenciaNumero" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div><div class="col-md-4"><b>Complemento:&nbsp;</b><inep-output-text np-id="complemento" ng-model="c.espelho.complemento" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div class="row"><div class="col-md-5"><b>Bairro:&nbsp;</b><inep-output-text np-id="bairro" ng-model="c.espelho.bairro" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div><div class="col-md-4"><b>Munic&iacute;pio:&nbsp;</b><inep-output-text np-id="nomeMunicipioEndereco" ng-model="c.espelho.residenciaMunicipio" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div><div class="col-md-3"><b>UF:&nbsp;</b><inep-output-text np-id="nomeUfEndereco" ng-model="c.espelho.residenciaUf" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div></div><div tabindex="0" class="with-space-top"><br/><legend><b>Contato</b></legend><div class="row"><div class="col-md-6"><b>Telefone fixo:&nbsp;</b><inep-output-text np-id="telefoneFixo" ng-model="c.espelho.fixo" np-mask="(99) 9999-9999" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div><div class="col-md-6"><b>Celular:&nbsp;</b><inep-output-text np-id="telefoneMovel" ng-model="c.espelho.celular" np-mask="(99) 99999-9999" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div class="row"><div class="col-md-12"><b>E-mail:&nbsp;</b><inep-output-text np-id="email" ng-model="c.espelho.email" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div></div><div class="with-space-top"><br/><legend><b>Atendimento especializado</b></legend><div class="row"><div class="col-md-12"><b>Necessita de atendimento especializado para realização das provas:&nbsp;</b><inep-output-text np-id="possuiEspecializado" ng-model="c.possuiEspecializadoValue" np-empty-Value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div ng-if="c.possuiEspecializado()" class="row with-space-bottom"><div class="col-md-12"><ul><li ng-if="a.statusItem === c.constantes.MARCADO" ng-repeat="a in c.especializados"><label style="font-weight: normal;">{{ a.descricao }}</label><div ng-if="!!a.informacao" class="box-describe">{{ a.informacao }}</div><div ng-if="!!a.cid" class="with-space-bottom"><b>{{ a.cid }}</b></div><div ng-if="a.statusItem === c.constantes.MARCADO &amp;&amp; a.dependencia.regras.indexOf(&quot;RNE005&quot;) &gt; -1"><enem-regra005 ng-model="a" np-disabled="true" np-optional="true"></enem-regra005></div><div ng-if="!!a.statusLaudo"><b>Laudo:<span ng-if="a.statusLaudo === 1" style="color: green;"> Aprovado</span><span ng-if="a.statusLaudo === 6" style="color: green;"> Aprovado em edições anteriores</span><span ng-if="a.statusLaudo === 11 || a.statusLaudo === 10" style="color: red;"> Reprovado, mantido o atendimento</span><div ng-if="(a.statusLaudo === 11 || a.statusLaudo === 10) &amp;&amp; a.exibirCriterios" ng-repeat="r in a.textoReprovacao"><span style="color: red;">{{r}} <br></span></div><span ng-if="a.statusLaudo === a.ZERO || a.statusLaudo === 3" style="color: red;"> Reprovado por não atender o(s) seguinte(s) critério(s): <br> </span><div ng-if="a.statusLaudo === a.ZERO || a.statusLaudo === 3" ng-repeat="r in a.textoReprovacao"><span style="color: red;">{{r}} <br></span></div><span ng-if="a.statusLaudo === 2 || a.statusLaudo === 12" style="color: orange;"> Em An&aacute;lise</span></b></div></li></ul></div></div><div ng-if="c.possuiEspecializado()" class="row"><div class="col-sm-12"><p><b>Aux&iacute;lio que necessitar&aacute; para realiza&ccedil;&atilde;o da prova:</b></p></div><div class="col-sm-12"><ul><li ng-if="r.statusItemAdicional !== c.constantes.OCULTO" ng-repeat="r in c.recursosEspecializados">{{ r.descricao }}<b ng-if="r.codigo !== 30" class="{{ c.verificarCorCampoInformado(r.statusItem) }}">: {{ c.opcaoSimNao(r.statusItem) }}</b><div ng-if="r.informacao != null &amp;&amp; r.statusItem === c.constantes.MARCADO" class="box-describe">{{ r.informacao }}</div></li></ul></div></div></div><!----><!--.with-space-top--><!--  br/--><!--  legend: b Atendimento espec&iacute;fico--><!--  .row: .col-md-12--><!--    b Possui necessidade de atendimento específico:&nbsp;--><!--    inep-output-text(np-id=\'possuiEspecifico\',--><!--    ng-model=\'c.possuiEspecificoValue\',--><!--    np-empty-Value=\'{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}\')--><!----><!--  .row.with-space-bottom(ng-if=\'c.possuiEspecifico\'): .col-md-12--><!--    ul--><!--      li(ng-if=\'a.statusItem === c.constantes.MARCADO\', ng-repeat=\'a in c.especificos\')--><!--        label(style=\'font-weight: normal;\')--><!--          | {{ a.descricao }}--><!--        div(class=\'box-describe\', ng-if=\'!!a.informacao\') {{ a.informacao }}--><!--        div.with-space-bottom(ng-if=\'!!a.cid\'): b {{ a.cid }}--><!--        div(ng-if=\'a.statusItem === c.constantes.MARCADO && a.dependencia.regras.indexOf("RNE005") > -1\')--><!--          enem-regra005(ng-model=\'a\', np-disabled=\'true\', np-optional=\'true\')--><!--        div(ng-if=\'!!a.statusLaudo\')--><!--          b Laudo:--><!--            span(ng-if=\'a.statusLaudo === 1\', style=\'color: green;\')  Aprovado--><!--            span(ng-if=\'a.statusLaudo === 3\', style=\'color: red;\')  Reprovado--><!--            span(ng-if=\'a.statusLaudo === 2\', style=\'color: orange;\')  Em An&aacute;lise--><!----><!--  .row(ng-if=\'c.possuiRecursoEspecifico\')--><!--    .col-sm-12: p: b Aux&iacute;lio que necessitar&aacute; para realiza&ccedil;&atilde;o da prova:--><!--    .col-sm-12: ul--><!--      li(ng-if=\'r.statusItemAdicional !== c.constantes.OCULTO\', ng-repeat=\'r in c.recursosEspecificos\') {{ r.descricao }}--><!--        b(ng-if=\'r.codigo !== 30\', class=\'{{ c.verificarCorCampoInformado(r.statusItem) }}\') : {{ c.opcaoSimNao(r.statusItem) }}--><!--        div(ng-if=\'r.informacao != null && r.statusItem === c.constantes.MARCADO\', class=\'box-describe\') {{ r.informacao }}--><!-- include ./confirmarDados_doencaInfectocontagiosa--><!--include ./confirmarDados_nomeSocial--><!--include ../atendimentoRecursos/confirmacao/atendimento--><div tabindex="0" class="with-space-top"><br/><legend><b>Prova</b></legend><div class="row"><div class="col-md-12"><b>Nível de ensino escolhido para o qual quero a certificação:</b><inep-output-text np-id="liguaEstrangeira" ng-model="c.espelho.opcaoConclusao" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text><!--.row.with-space: b.col-md-8 Provas que farei no Encceja 2020:--><div class="row with-space"><b class="col-md-8">Provas que farei no Encceja 2026:<ul></ul><li ng-repeat="a in c.espelho.listaDisciplinas"><label style="font-weight: normal;">{{ a }}</label></li></b></div></div></div></div><div tabindex="0" class="with-space-top"><br/><legend><b>UF e cidade onde farei as provas:</b></legend><div class="row"><div class="col-md-9"><b>UF:&nbsp;</b><inep-output-text np-id="ufProva" ng-model="c.espelho.ufProva" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text>,<inep-output-text np-id="municipioProva" ng-model="c.espelho.cidadeProva" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div></div><div ng-if="c.espelho.ensinoMedio !== null" tabindex="0" class="with-space-top"><br/><legend><b>Instituição Certificadora onde solicitarei o certificado de conclusão ou a declaração parcial de proficiência se conseguir a nota mínima exigida:</b></legend><div class="row espacoLinha"><div class="col-md-3"><b>UF da instituição certificadora:</b><inep-output-text np-id="situacaoEnsinoMedio" ng-model="c.espelho.ufEntidadeCertificadora" np-empty-Value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div><div class="col-md-6"><b>Instituição:&nbsp;<inep-output-text np-id="ufEntidadeCertidicadora" ng-model="c.espelho.entidadeCertificadora" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></b></div></div></div><div ng-if="c.espelho.ausenciaDto.inAusente" tabindex="0" class="with-space-top"><br/><legend><b>Justificativa de ausência:</b></legend><div class="row espacoLinha"><div class="col-md-12"><inep-output-text np-id="justificativaAusencia" ng-model="c.espelho.ausenciaDto.justificativaAusencia.label" np-empty-Value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div></div></div></div><div class="panel panel-info hidden-print"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Junte-se a nós</h2></div><div class="panel-body"><div class="row"><div class="col-md-12"><p class="left"><strong>Faça parte do Conselho de Usuários de Serviços do INEP!</strong></p></div></div><div class="row"><div class="col-md-12"><p class="left"><strong>Acesse a plataforma, se cadastre e contribua com a melhoria dos nossos serviços.</strong></p></div></div><div class="row"><div style="padding-bottom: 10px" class="col-md-12"><button style="margin-left: 10px;" ng-click="c.openNewTab(\'https://conselhodeusuarios.cgu.gov.br/inicio\')" role="button" class="btn btn-primary">PARTICIPAR</button><button style="margin-left: 10px;" ng-click="c.openNewTab(\'https://www.gov.br/inep/pt-br/acesso-a-informacao/participacao-social/conselhos-e-orgaos-colegiados/conselho-de-usuarios\')" role="button" class="btn btn-primary">SAIBA MAIS</button></div></div></div></div><div><div class="text-center"><p tabindex="0">Para acompanhar sua inscrição, visualizar seu local de prova e seus resultados é necessário se\ncadastrar no Portal Gov.br e criar uma senha de acesso. Caso já tenha se cadastrado anteriormente,\nacesse a Página do Participante.</p></div><div><div style="padding-top: 40px; padding-bottom: 40px;" class="col-md-2"></div><div style="padding-top: 40px; padding-bottom: 40px;" class="col-md-2"><!--button.btn.btn-primary(ng-if="c.espelho.situacaoIncricao == \'Não confirmada\' && htmlBoletoCobranca != undefined " , ng-disabled="desabilitarBotaoImprimir", ng-click="imprimirBoletoAction()", role="button") Imprimir boleto--></div><div class="col-md-1"></div><div style="padding-top: 40px; padding-bottom: 40px;" class="col-md-2"><button type="submit" data-ui-sref="loginUnico" class="btn btn-tela-inicial btn-block">Página do participante</button></div><div class="col-md-1"></div><div style="padding-top: 40px; padding-bottom: 40px;" class="col-md-2"><button type="submit" ng-click="c.redirecionarCadastrarAcessoGov()" class="btn btn-tela-inicial btn-block">Portal gov.br</button></div></div><div inep-modal="inep-modal" np-id="modalExibirMensagem" np-buttons="c.modalExibirMensagem.buttons" np-show="c.modalExibirMensagem.show" np-options="c.modalExibirMensagem.options" np-header="Avaliar serviço"><p tabindex="0">{{ c.modalExibirMensagem.saudacao }}</p><p tabindex="0">{{ c.modalExibirMensagem.message }}</p></div></div><br/><div><div style="padding-top: 70px;" class="clearfix"><ul class="pagination margin-bottom-none pull-right"><li class="primary"><button ng-click="c.sair()" role="button" class="btn btn-primary">Sair</button></li><li class="primary"><button ng-click="c.imprimir()" role="button" class="btn btn-primary">Imprimir      </button></li></ul></div></div></div></div></section></main>'),a.put("views/justificativa-ausencia/wizard/atualizarContatos.html",'<div ng-controller="AtualizarContatosController as c"><header><!--.page-header.with-space-top: h1.h3 Justificativa de aus&ecirc;ncia > ENCCEJA {{ c.anoEdicao }} #[small dados de contato]--><div class="page-header with-space-top"><h1 class="h3">Justificativa de aus&ecirc;ncia > ENCCEJA <small>dados de contato</small></h1></div></header><div class="row"><div class="col-md-12"><form autocomplete="off" inep-message-bag="inep-message-bag" message-bag-header-error="O formulário abaixo está inválido pelos seguintes erros:" name="dadosAcessoForm" novalidate="true" role="form"><div class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Contato</h2></div><div class="panel-body"><p tabindex="0">Participante, <br><br>\nInforme seus dados de contato corretamente e mantenha-os atualizados. Assim, o Inep conseguirá entrar em contato com você, caso necessário. \nÉ obrigatório informar pelo menos um contato telefônico (fixo ou celular).</p><div class="row"><inep-input-text np-label="Telefone fixo" np-id="inputTelFixo" ng-model="c.dadosAcesso.telefone" np-mask="(99) 9999-9999" inep-validator="c.validarTelefone(c.dadosAcesso.telefone)" np-optional="c.fixoOpcional" np-size="4" np-accessibility-message="{{c.mensagens.MSGA021_}}"></inep-input-text><inep-input-text np-label="Celular" np-id="inputCel" np-allow-copy="false" np-allow-cut="false" np-allow-paste="false" ng-model="c.dadosAcesso.celular" np-mask="(99) 99999-9999" np-optional="c.celularOpcional" inep-validator="c.validarCampo(c.dadosAcesso.celular)" np-size="4" np-accessibility-message="{{c.mensagens.MSGA008_}}"></inep-input-text><inep-input-text np-label="Confirmar celular" np-id="inputConfirmCel" np-allow-copy="false" np-allow-cut="false" np-allow-paste="false" ng-model="c.dadosAcesso.confirmaCelular" np-mask="(99) 99999-9999" ng-match="c.dadosAcesso.celular" np-optional="c.celularOpcional" np-size="4" inep-validator="c.validarCampo(c.dadosAcesso.confirmaCelular)" np-confirm-value="c.dadosAcesso.celular" np-confirm-message="Confirmação do celular divergente." np-accessibility-message="{{mensagens.MSGA010_}}"></inep-input-text></div><div class="row"><div class="form-group"><inep-email np-id="inputEmail" np-value="c.dadosAcesso.email" np-optional="false" np-allow-copy="false" np-allow-cut="false" np-allow-paste="false" np-maxlength="255" np-label="E-mail" np-size="6" np-on-blur="c.verificaSeEmailCadastrado()" inep-validator="c.exibeErroEmail()" np-accessibility-message="{{c.mensagens.MSGA006}}"></inep-email><inep-email np-id="inputConfirmaEmail" np-value="c.dadosAcesso.confirmaEmail" np-optional="false" np-label="Confirmar e-mail" np-size="6" np-allow-copy="false" np-maxlength="255" np-allow-cut="false" np-allow-paste="false" np-confirm-value="c.dadosAcesso.email" np-confirm-message="Confirmação de e-mail divergente." np-accessibility-message="{{c.mensagens.MSGA009}}"></inep-email></div></div></div></div></form></div></div></div>'),a.put("views/justificativa-ausencia/wizard/confirmarInformacoesPessoais.html",'<div ng-controller="ConfirmarInformacoesPessoaisJustificativaController as c" ng-init="init()"><header><!--.page-header.with-space-top: h1.h3 Justificativa de aus&ecirc;ncia > ENCCEJA {{ c.anoEdicao }} #[small dados pessoais]--><div class="page-header with-space-top"><h1 class="h3">Justificativa de aus&ecirc;ncia > ENCCEJA <small>dados pessoais</small></h1></div></header><div class="row"><div class="col-md-12"><form autocomplete="off" inep-message-bag="inep-message-bag" message-bag-header-error="O formulário abaixo está inválido pelos seguintes erros:" name="informacoesPessoaisForm" novalidate="true" role="form"><div tabindex="0"><div class="text-center text-primary"><label>Os campos com <i alt="asterisco" class="fa fa-asterisk"><span class="hidden-accessibility">asterisco</span></i> s&atilde;o de preenchimento obrigat&oacute;rio</label></div><div class="row with-space-bottom"></div></div><div class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Dados pessoais</h2></div><div class="panel-body"><div class="row"><inep-cpf np-id="numeroCpf" np-label="CPF " np-optional="false" np-readonly="true" np-size="2" np-value="c.informacoesPessoais.cpf"></inep-cpf><inep-input-text np-id="inputNome" np-label="Nome completo" ng-model="c.informacoesPessoais.nome" np-optional="false" np-readonly="true" np-size="7"></inep-input-text><div class="col-md-3"><inep-calendar ng-model="c.informacoesPessoais.dataDeNascimento" np-id="calendar" np-label="Data de nascimento" np-type="popup" np-optional="false" np-starting-day="0" np-hide-icon="true" np-min-date="1900-01-01" np-year-range="20" np-current-text="Hoje" np-clear-text="Limpar" np-close-text="Fechar" np-width="12" np-readonly="true"></inep-calendar></div></div><div class="row"><inep-input-text np-id="inputNomeMae" np-label="Nome completo da mãe" ng-model="c.informacoesPessoais.nomeDaMae" np-optional="false" np-readonly="true" np-size="6"></inep-input-text></div><div class="row with-space-top"><div class="col-md-12"><div class="box-describe"><span class="text-justify">Caso seus dados pessoais não estejam corretos, continue sua justificativa de ausência fornecendo os dados solicitados e após concluí-la, entre em contato com a Receita Federal para realizar a atualização necessária. Em caso de dúvidas entre em contato com a Central de Atendimento do Inep pelo telefone 0800-616161 ou com a Ouvidoria pelo endereço<a target="_blank" href="falabr.cgu.gov.br">falabr.cgu.gov.br.</a></span></div></div></div></div></div></form></div></div></div>'),
a.put("views/justificativa-ausencia/wizard/finalizarAusencia.html",'<div ng-controller="FinalizarJustificativaAusenciaController as c" ng-init="init()"><header><!--.page-header.with-space-top: h1.h3 Justificativa de aus&ecirc;ncia > ENCCEJA {{ c.anoEdicao }} #[small dados pessoais]--><div class="page-header with-space-top"><h1 class="h3">Justificativa de aus&ecirc;ncia > ENCCEJA <small>dados pessoais</small></h1></div></header><div class="row"><div class="col-md-12"><form autocomplete="off" inep-message-bag="inep-message-bag" message-bag-header-error="O formulário abaixo está inválido pelos seguintes erros:" name="resumoForm" novalidate="true" role="form"><div class="panel panel-info"><div tabindex="0" class="panel-heading"><h2 text-left="text-left" text-primary="text-primary" class="h4 panel-title">Resumo das informações</h2></div><div class="panel-body"><div tabindex="0" class="with-space-top"><br/><legend><b>Dados pessoais</b></legend><div class="row"><div class="col-md-3"><b>CPF:&nbsp;</b><inep-output-text np-id="cpfFormatado" ng-model="c.dadosPessoais.cpf" np-mask="999.999.999-99" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div><div class="col-md-6"><b>Nome:&nbsp;</b><inep-output-text np-id="nome" ng-model="c.dadosPessoais.nome" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div><div class="col-md-3"><b>Data de nascimento:&nbsp;</b><inep-output-text np-id="dataNascimento" ng-model="c.dadosPessoais.dataDeNascimento" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div class="row"><div class="col-md-6"><b>Nome da m&atilde;e:&nbsp;</b><inep-output-text np-id="nomeDaMae" ng-model="c.dadosPessoais.nomeDaMae" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div></div><div tabindex="0" class="with-space-top"><br/><legend><b>Justificativa de aus&ecirc;ncia</b></legend><div class="row"><div class="col-md-12"><!--b Qual a justificativa para a sua aus&ecirc;ncia ao Encceja 2019?&nbsp;--><b>Qual a justificativa para a sua aus&ecirc;ncia ao Encceja {{ c.anoEdicao }}?&nbsp;</b><inep-output-text np-id="motivoJustificativa" ng-model="c.motivoSelecionado.label" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><!--.row.with-space-top--><!--  .col-md-12--><!--    div(class=\'box-describe\')--><!--      span.text-justify {{c.descricaoArquivo}}--></div><div tabindex="0" class="with-space-top"><br/><legend><b>Contato</b></legend><div class="row"><div class="col-md-6"><b>Telefone fixo:&nbsp;</b><inep-output-text np-id="telefoneFixo" ng-model="c.dadosAcesso.telefone" np-mask="(99) 9999-9999" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div><div class="col-md-6"><b>Celular:&nbsp;</b><inep-output-text np-id="telefoneMovel" ng-model="c.dadosAcesso.celular" np-mask="(99) 99999-9999" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div class="row"><div class="col-md-12"><b>E-mail:&nbsp;</b><inep-output-text np-id="email" ng-model="c.dadosAcesso.email" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div></div></div></div></form></div></div></div>'),a.put("views/justificativa-ausencia/wizard/justificativaAusencia.html",'<div ng-controller="JustificativaAusenciaController as c"><header><!--.page-header.with-space-top: h1.h3 Justificativa de aus&ecirc;ncia > ENCCEJA {{ c.anoEdicao }} #[small justificativa de aus&ecirc;ncia]--><div class="page-header with-space-top"><h1 class="h3">Justificativa de aus&ecirc;ncia > ENCCEJA <small>justificativa de aus&ecirc;ncia</small></h1></div></header><div class="row"><div class="col-md-12"><form autocomplete="off" inep-message-bag="inep-message-bag" message-bag-header-error="O formulário abaixo está inválido pelos seguintes erros:" name="justificativaForm" novalidate="true" role="form"><div class="panel panel-info"><!--.panel-heading: h2.h4.panel-title.text-left.text-primary Motivo da Ausência no Encceja 2019--><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Motivo da Ausência no Encceja {{ c.anoEdicao }}</h2></div><div class="panel-body"><div class="row"><inep-radiobutton np-id="radioNivel" np-label="Qual a justificativa para a sua ausência ao Encceja {{ c.anoEdicao }}?" np-values="c.opcoesJustificativa" np-selected-value="c.informacoesJustificativa.coJustificativa" np-on-change="c.motivoJustificativaOnChange()" np-optional="false" np-size="12"></inep-radiobutton></div><div class="row with-space-top"><div ng-if="!!c.descricaoArquivo" class="col-md-12"><div class="box-describe"><span ng-bind-html="c.trust(c.descricaoArquivo)" class="text-justify"></span><br/><br/><span class="text-justify">Somente ser&atilde;o aceitos documentos no formato PDF, PNG ou JPG, no tamanho m&aacute;ximo de 2MB.</span></div></div></div><div ng-if="c.descricaoArquivo" ng-repeat="a in c.arquivos" class="row with-space-bottom"><enem-fieldset><div ng-if="!a.send" class="col-md-8"><span style="color: #0e377d;font-weight: bold;" class="text-justify">{{a.label}}</span><i ng-if="a.obrigatorio" style="margin-left: 2px" class="fa fa-asterisk fa"></i><inep-input-file np-id="arquivo_{{a.id}}" np-label="" np-value="a.file" np-max-file-size="c.maxFileSize" np-show-icon="true" np-size="12" np-max-file-message="Tamanho de arquivo inválido." np-content-type-message="Formato de arquivo inválido." np-disabled="" np-optional="!a.obrigatorio" inep-validator="c.isFileValid(a.file, c.maxFileSize, c.contentTypes)" np-content-types="c.contentTypes" np-empty-message="{{c.mensagens.MSG_ARQUIVO_VAZIO}}"></inep-input-file></div><div ng-if="c.isFileValid(a.file, c.maxFileSize, c.contentTypes) &amp;&amp; !a.send" style="padding-top: 17px;" class="col-md-4"><button id="enviar_arquivo_{{a.id}}" ng-click="c.enviarArquivo(a)" class="btn btn-default">Enviar arquivo</button></div><div ng-if="a.send" class="col-md-8"><span style="color: #0e377d;font-weight: bold;" class="text-justify">{{a.label}}</span><br/><inep-output-text id="mensagem_arquivo_{{a.id}}" ng-model="c.mensagemArquivoEnviado"></inep-output-text></div><div ng-if="a.send" class="col-md-4"><button id="excluir_arquivo_{{a.id}}" ng-click="c.excluirArquivo(a)" class="btn btn-default ">Excluir arquivo</button></div></enem-fieldset></div></div><div ng-if="c.isRecurso" class="clearfix"><ul class="pagination margin-bottom-none pull-right"><li class="primary"><button ng-click="c.cancelar()" role="button" class="btn btn-primary">Cancelar</button></li><li class="primary"><button ng-click="c.salvarRecurso()" role="button" class="btn btn-primary">Enviar recurso</button></li></ul></div></div></form></div></div></div>'),a.put("views/inscricao/wizard/dadosAcesso.html",'<header role="banner"><h1 class="hide"> - </h1><nav role="navigation" aria-labelledby="#nav" ng-controller="NavigationBarController" class="navbar navbar-default navbar-fixed-top"><h2 id="nav" class="hide">Navegação Principal</h2><div class="container-fluid"><div class="navbar-header text-center"><button type="button" data-toggle="offcanvas" class="navbar-toggle collapsed left"><span class="sr-only">Toggle navigation</span><span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span></button><div aria-label="Bem vindo ao INEP" class="navbar-brand"><img src="images/logo_inep.svg" alt="Instituto Nacional de Estudos e Pesquisas Educacionais Anísio Teixeira"/></div><button type="button" data-toggle="collapse" data-target="#navbar-collapse" class="navbar-toggle collapsed right p-n"><span class="sr-only">Toggle navigation</span><i class="fa fa-gear text-white"></i></button></div><!--#navbar-collapse.collapse.navbar-collapse--><!--  ul.nav.navbar-nav--><!--    li.active--><!--      span.logo-inep.h3.m-n.font-700(data-toggle=\'tooltip\', data-placement=\'bottom\', title=project.name) #{project.abbr}--><!----><!--  ul.nav.navbar-nav.navbar-right--><!--    if !login--><!--      li--><!--        span(data-toggle=\'dropdown\') #[i.fa.fa-user] Participante: {{nomeParticipanteLogado}}--><!--    li--><!--      a.contrast(href=\'#\', inep-contrast="", data-toggle=\'tooltip\', data-placement=\'bottom\', aria-label=\'Contraste\') #[i.fa.fa-adjust]--><script type="text/ng-template" id="warning-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Você ainda está aí?</h3></div><div idle-countdown="countdown" class="modal-body"><uib-progressbar max="30" value="countdown" animate="true" class="progress-striped active"></uib-progressbar>Sua sessão será encerrada em {{countdown}} segundos.</div></div></script><script type="text/ng-template" id="timedout-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Sess&atilde;o encerrada.</h3></div><div class="modal-body"><p></p>Sua sess&atilde;o foi encerrada por inatividade.</div></div></script></div></nav></header><main role="main"><section class="login"><h1 class="hide">Painel de entrada</h1><div class="panel-box"><div class="container"><header><div class="page-header with-space-top"><h1 class="h3">Inscri&ccedil;&atilde;o > ENCCEJA <small>contato</small></h1></div></header><form name="dadosAcessoForm" role="form" novalidate="true" autocomplete="off" ng-controller="DadosAcessoController as c" ng-init="c.init()" ng-submit="enviar(dto)" inep-message-bag="inep-message-bag" message-bag-header-error="O formulário abaixo está inválido pelos seguintes erros:"><div tabindex="0"><div class="text-center text-primary"><label>Os campos com <i alt="asterisco" class="fa fa-asterisk"><span class="hidden-accessibility">asterisco</span></i> s&atilde;o de preenchimento obrigat&oacute;rio</label></div><div class="row with-space-bottom"></div></div><div class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Contato</h2></div><div class="panel-body"><p tabindex="0">Participante, <br><br>\nInforme seus dados de contato corretamente e mantenha-os atualizados.\nSó assim o Inep conseguirá entrar em contato com você.\nÉ obrigatório informar pelo menos um contato telefônico (fixo ou celular).</p><div class="row"><inep-input-text np-label="Telefone fixo" np-id="inputTelFixo" ng-model="c.dadosAcesso.telefone" np-mask="(99) 9999-9999" inep-validator="c.validarTelefone(c.dadosAcesso.telefone)" np-optional="c.fixoOpcional" np-size="4" np-accessibility-message="{{c.mensagens.MSGA021_}}"></inep-input-text><inep-input-text np-label="Celular" np-id="inputCel" np-allow-copy="false" np-allow-cut="false" np-allow-paste="false" ng-model="c.dadosAcesso.celular" np-mask="(99) 99999-9999" np-optional="c.celularOpcional" inep-validator="c.validarCampo(c.dadosAcesso.celular)" np-size="4" np-accessibility-message="{{c.mensagens.MSGA008_}}"></inep-input-text><inep-input-text np-label="Confirmar celular" np-id="inputConfirmCel" np-allow-copy="false" np-allow-cut="false" np-allow-paste="false" ng-model="c.dadosAcesso.confirmaCelular" np-mask="(99) 99999-9999" ng-match="c.dadosAcesso.celular" np-optional="c.celularOpcional" np-size="4" inep-validator="c.validarCampo(c.dadosAcesso.confirmaCelular)" np-confirm-value="c.dadosAcesso.celular" np-confirm-message="Confirmação do celular divergente." np-accessibility-message="{{mensagens.MSGA010_}}"></inep-input-text></div><div class="row"><div class="form-group"><inep-email np-id="inputEmail" np-value="c.dadosAcesso.email" np-optional="false" np-allow-copy="false" np-allow-cut="false" np-allow-paste="false" np-maxlength="255" np-label="E-mail" np-size="6" np-on-blur="c.verificaSeEmailCadastrado()" inep-validator="c.exibeErroEmail()" np-accessibility-message="{{c.mensagens.MSGA006}}"></inep-email><inep-email np-id="inputConfirmaEmail" np-value="c.dadosAcesso.confirmaEmail" np-optional="false" np-label="Confirmar e-mail" np-size="6" np-allow-copy="false" np-maxlength="255" np-allow-cut="false" np-allow-paste="false" np-confirm-value="c.dadosAcesso.email" np-confirm-message="Confirmação de e-mail divergente." np-accessibility-message="{{c.mensagens.MSGA009}}"></inep-email></div></div></div></div><div class="clearfix"><ul class="pagination margin-bottom-none pull-right"><li class="primary"><button ng-click="c.cancelarInscricao()" role="button" class="btn btn-primary">Sair</button></li><li class="primary"><button ng-click="c.concluir()" role="button" class="btn btn-primary">Salvar</button></li></ul></div><div inep-modal="inep-modal" np-id="modalWizard" np-buttons="c.modalSair.botoes" np-show="c.modalSair.exibe"><h2 aria-labelledby="texto" tabindex="0" class="titulo-modal h5 panel-title text-center text-primary">{{ c.modalSair.mensagem }}\n</h2></div><div inep-modal="inep-modal" np-id="modalWizard" np-buttons="c.modalInscricoesEncerradas.buttons" np-options="c.modalOptions" np-show="c.modalInscricoesEncerradas.show"><h2 aria-labelledby="texto" tabindex="0" class="titulo-modal h5 panel-title text-center text-primary">{{ c.modalInscricoesEncerradas.message }}</h2></div></form></div></div></section></main>'),a.put("views/inscricao/wizard/informacoesPessoais.html",'<div ng-controller="InformacoesPessoaisController as c" ng-init="c.init()"><header><div class="page-header with-space-top"><h1 class="h3">Inscri&ccedil;&atilde;o > ENCCEJA <small>dados pessoais</small></h1></div></header><div class="row"><div class="col-md-12"><form autocomplete="off" inep-message-bag="inep-message-bag" message-bag-header-error="O formulário abaixo está inválido pelos seguintes erros:" name="informacoesPessoaisForm" novalidate="true" role="form"><div tabindex="0"><div class="text-center text-primary"><label>Os campos com <i alt="asterisco" class="fa fa-asterisk"><span class="hidden-accessibility">asterisco</span></i> s&atilde;o de preenchimento obrigat&oacute;rio</label></div><div class="row with-space-bottom"></div></div><div class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Dados pessoais</h2></div><div class="panel-body"><div class="row"><inep-cpf np-id="numeroCpf" np-label="CPF " np-optional="false" np-readonly="true" np-size="2" np-value="c.informacoesPessoais.cpf"></inep-cpf><inep-input-text np-id="inputNome" np-label="Nome completo" ng-model="c.informacoesPessoais.nome" np-optional="false" np-readonly="true" np-size="7"></inep-input-text><div class="col-md-3"><inep-calendar ng-model="c.informacoesPessoais.dataDeNascimento" np-id="calendar" np-label="Data de nascimento" np-type="popup" np-optional="false" np-starting-day="0" np-hide-icon="true" np-min-date="1900-01-01" np-year-range="20" np-current-text="Hoje" np-clear-text="Limpar" np-close-text="Fechar" np-width="12" np-readonly="true"></inep-calendar></div></div><div class="row"><inep-input-text np-id="inputNomeMae" np-label="Nome completo da mãe" ng-model="c.informacoesPessoais.nomeDaMae" np-optional="false" np-readonly="true" np-size="6"></inep-input-text><inep-radiobutton np-id="checkboxSexo" np-inline="true" np-label="Sexo" np-selected-value="c.informacoesPessoais.sexo" np-on-change="c.alteraDeclaracaoRecurso()" np-optional="false" np-values="c.sexos" np-text-name="label" np-value-name="value" np-size="3"></inep-radiobutton></div><div class="row"><inep-boolean-checkbox np-id="exteriorCheck" np-value="\'Não quero declarar o nome do meu pai\'" np-selected-value="c.informarNomePai" np-optional="true" np-on-change="c.onChangeDeclaraPai()" np-size="6"></inep-boolean-checkbox><inep-input-text np-id="inputNomePai" np-label="Nome completo do pai" ng-model="c.informacoesPessoais.nomeDoPai" inep-validator="c.validarNomeDoPai(c.informacoesPessoais.nomeDoPai)" np-optional="c.informarNomePai" np-readonly="c.informarNomePai" np-size="6"></inep-input-text></div><div class="row"><inep-combobox np-id="selectEtnia" np-label="Cor ou Raça" np-optional="false" np-selected-value="c.informacoesPessoais.etnia" np-values="c.etnias" np-size="3"></inep-combobox><inep-combobox np-id="selectEstadoCivil" np-label="Estado civil" np-optional="false" np-selected-value="c.informacoesPessoais.estadoCivil" np-size="3" np-values="c.estadosCivis"></inep-combobox><inep-combobox np-accessibility-message="{{c.mensagens.MSGA030}}" np-id="selectNacionalidade" np-label="Nacionalidade" np-optional="false" np-selected-value="c.informacoesPessoais.nacionalidade" np-size="6" np-on-change="c.nacionalidadeChanged()" np-values="c.nacionalidades"></inep-combobox></div><div class="row"><div id="nacionalidade" ng-if="c.isBrasileiro()"><inep-combobox np-accessibility-message="{{c.mensagens.MSGA031}}" np-id="ufNascimento" np-label="UF de nascimento" np-optional="!c.isBrasileiro()" np-selected-value="c.informacoesPessoais.nascimentoUf" np-size="3" np-values="c.ufs"></inep-combobox><inep-municipio np-id="municipioNascimento" np-accessibility-message="{{c.mensagens.MSGA032}}" np-label="Município de nascimento" np-optional="!c.isBrasileiro()" np-no-select-label="Selecione" np-selected-value="c.informacoesPessoais.nascimentoMunicipio" np-size="3" np-uf="c.informacoesPessoais.nascimentoUf"></inep-municipio></div></div><div class="row with-space-top"><div class="col-md-12"><div class="box-describe"><span class="text-justify">Caso seus dados pessoais não estejam corretos, continue sua inscrição fornecendo os dados\nsolicitados e após concluí-la, entre em contato com a Receita Federal para realizar a\natualização necessária. Em caso de dúvidas entre em contato com a Central de Atendimento\ndo Inep pelo telefone 0800-616161 ou com a Ouvidoria pelo endereço&ensp;<a target="_blank" href="https://falabr.cgu.gov.br/">falabr.cgu.gov.br.</a></span></div></div></div></div></div><div class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Endere&ccedil;o</h2></div><div class="panel-body"><div class="row"><inep-cep np-accessibility-message="{{c.mensagens.MSGA013}}" np-cep-found="c.cepCorreio" np-id="inputResidenciaCep" np-label="CEP" np-on-blur="c.consultarCep()" np-optional="false" np-do-watch="c.flagWatchCep" np-value="c.informacoesPessoais.residencia.cep"></inep-cep><div style="margin-top 20px" class="col-md-3"><a target="_blank" title="{{c.mensagens.MSGA056}}" href="http://www.buscacep.correios.com.br/">Se você não tem certeza de qual é o seu CEP, o site dos Correios pode te ajudar.<span style="position: absolute; left: -999em;">{{c.mensagens.MSGA056}}</span></a></div></div><div class="row"><inep-input-text np-accessibility-message="{{c.mensagens.MSGA014}}" np-disabled="c.informacoesPessoais.desabilitaCampoLogradouro" np-id="inputResidenciaLogradouro" np-label="Endereço" np-maxlength="100" ng-model="c.informacoesPessoais.residencia.logradouro" np-optional="true" np-readonly="c.informacoesPessoais.desabilitaCampoLogradouro" np-size="6"></inep-input-text><inep-input-text np-accessibility-message="{{c.mensagens.MSGA015}}" np-id="inputResidenciaNumero" np-label="Número" np-maxlength="8" ng-model="c.informacoesPessoais.residencia.numero" np-optional="false" np-size="2"></inep-input-text><inep-input-text np-accessibility-message="{{c.mensagens.MSGA016}}" np-id="inputResidenciaComplemento" np-label="Complemento" np-maxlength="50" ng-model="c.informacoesPessoais.residencia.complemento" np-optional="true" np-size="4"></inep-input-text></div><div class="row"><inep-input-text np-accessibility-message="{{c.mensagens.MSGA017}}" np-id="inputResidenciaBairro" np-disabled="c.informacoesPessoais.desabilitaCampoBairro" np-label="Bairro" np-maxlength="100" ng-model="c.informacoesPessoais.residencia.bairro" np-optional="true" np-readonly="c.informacoesPessoais.desabilitaCampoBairro" np-size="6"></inep-input-text><inep-input-text np-disabled="true" np-id="inputResidenciaMunicipio" np-label="Município" np-maxlength="100" ng-model="c.informacoesPessoais.residencia.municipio" np-optional="true" np-readonly="true" np-size="4"></inep-input-text><inep-input-text np-disabled="true" np-id="inputResidenciaUf" np-label="UF" np-maxlength="100" ng-model="c.informacoesPessoais.residencia.uf" np-optional="true" np-readonly="true" np-size="2"></inep-input-text></div></div></div></form></div></div><div inep-modal="inep-modal" np-id="modalWizard" np-buttons="c.modalInscricoesEncerradas.buttons" np-options="c.modalOptions" np-show="c.modalInscricoesEncerradas.show"><h2 aria-labelledby="texto" tabindex="0" class="titulo-modal h5 panel-title text-center text-primary">{{ c.modalInscricoesEncerradas.message }}\n</h2></div><div inep-modal="inep-modal" np-buttons="c.modalPesquisaAusencia.buttons" np-show="c.modalPesquisaAusencia.show" np-id="modalPesquisa" np-options="c.modalPesquisaAusencia.options"><p>Participante, verificamos que você foi ausente na aplicação do Encceja do ano passado.\nQue bom te ver por aqui fazendo uma nova inscrição e contamos com a sua presença no dia de aplicação das provas.</p><p>Assim, gostaríamos que você nos indicasse os motivos que te levaram a não comparecer no dia de aplicação das provas. Você pode marcar uma ou mais opções. Sua resposta é sigilosa e ajudará o Inep a melhorar a aplicação do Exame.</p><div ng-repeat="alternativa in c.modalPesquisaAusencia.alternativas track by alternativa.id"><input id="a{{alternativa.id}}" type="checkbox" ng-model="c.respostasPesquisaAusencia[alternativa.id]" ng-true-value="{{alternativa}}" ng-false-value="null" ng-optional="false"/><label style="margin-left: 5px">{{alternativa.noJustificativa}}</label><br/><textarea ng-if="c.respostasPesquisaAusencia[alternativa.id].noJustificativa.includes(\'descreva\')" id="complemento-pesquisa" ng-model="c.respostasPesquisaAusencia[alternativa.id].complemento" maxlength="1000" style="width: 100%"></textarea></div><h5 ng-if="c.erroNenhumaResposta" style="color: #a94442" class="h5 panel-title"><b class="fa fa-times-circle-o"></b>Marcação obrigatória.</h5><br/><h5 tabindex="0" focus-me="focus-me" class="h5 panel-title text-center">Obrigado por sua resposta. Só a educação pode transformar vidas! Compareça.</h5></div></div>'),a.put("views/inscricao/wizard/informacoesProva.html",'<div ng-controller="InformacoesProvaController as c" ng-init="c.init()"><header><div class="page-header with-space-top"><h1 ng-if="c.pagina === 1" class="h3">Inscri&ccedil;&atilde;o > ENCCEJA <small>informa&ccedil;&otilde;es de prova</small></h1><h1 ng-if="c.pagina === 2" class="h3">Inscri&ccedil;&atilde;o > ENCCEJA <small>confirmação de dados</small></h1></div></header><div class="row"><div class="col-md-12"><form name="informacoesProvaForm" role="form" novalidate="true" autocomplete="off" inep-message-bag="inep-message-bag" message-bag-header-error="O formulário abaixo está inválido pelos seguintes erros:"><div ng-if="c.pagina === 1"><div tabindex="0"><div class="text-center text-primary"><label>Os campos com <i alt="asterisco" class="fa fa-asterisk"><span class="hidden-accessibility">asterisco</span></i> são de preenchimento obrigatório</label></div><div class="row with-space-bottom"></div></div><div class="panel panel-info"><div tabindex="0" class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Prova</h2></div><div class="panel-body"><div class="row with-space"><div class="col-md-12"><inep-radiobutton np-id="radioNivel" np-label="Para qual nível de ensino você busca certificação ou declaração parcial de proficiência?" np-values="c.opcoesConclusaoCurso" np-selected-value="c.informacoesProva.opcaoConclusao" np-inline="true" np-on-change="c.escolherNivelProvaChanged()" np-optional="false"></inep-radiobutton></div></div><div ng-if="c.habilitarDisciplinasEnsinoFundamental()" class="row"><enem-checkbox np-id="checkEnsinoFundamental" np-promise="c.ensinoFundamental" np-optional="false" np-lines="6" np-callback="c.ensinoFundamentalCallback" np-reiniciar-elements="false" np-size="8" np-label="Ensino Fundamental - Marque as provas que precisa fazer para conseguir a certificação do Ensino Fundamental"></enem-checkbox></div><div ng-if="c.habilitarDisciplinasEnsinoMedio()" class="row"><enem-checkbox np-id="checkEnsinoMedio" np-promise="c.ensinoMedio" np-values="c.iInnformacoesProva.opcaoDisciplinas" np-optional="false" np-lines="6" np-callback="c.ensinoMedioCallback" np-reiniciar-elements="false" np-size="6" np-label="Ensino Médio - Marque as provas que precisa fazer para conseguir a certificação do Ensino Médio"></enem-checkbox></div><div ng-if="c.habilitarDisciplinasEnsinoFundamental() || c.habilitarDisciplinasEnsinoMedio()" class="box-describe"><span class="text-justify">{{c.mensagens.MSGA074}}</span></div></div></div><div class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Cidade de prova</h2></div><div class="panel-body"><div class="row with-space"><div class="col-md-12"><div><label>Em qual estado e em qual município você prefere fazer as provas do Encceja?</label><i style="color: #9A0000" class="fa fa-asterisk fa"><span style="position: absolute; top: -20em; left: -300em;">Campo de preenchimento obrigat&oacute;rio.</span></i></div></div></div><div class="row with-space-top"><div class="col-md-12"><inep-combobox np-id="ufCidadeProva" np-label="Selecione a UF:" np-optional="false" np-no-select-label="Selecione" np-size="3" np-values="c.ufs" np-selected-value="c.informacoesProva.codigoUf" np-on-change="c.carregarMunicipios()" np-accessibility-message="{{c.mensagens.MSGA042}}"></inep-combobox><inep-combobox np-id="municipioCidadeProva" np-label="Selecione o Município:" np-optional="false" np-no-select-label="Selecione" np-size="4" np-values="c.listaMunicipio" np-selected-value="c.informacoesProva.codigoMunicipio" np-disabled="!c.informacoesProva.codigoUf" np-order-by="label" np-on-change="c.reiniciaDeclaro()" np-accessibility-message="{{c.mensagens.MSGA043}}"></inep-combobox></div></div></div></div><div class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Instituição certificadora</h2></div><div class="panel-body"><div class="row with-space"><div class="col-md-12"><div><label>O Inep não emite o Certificado de conclusão ou Declaração Parcial de Proficiência. Essa tarefa é da Instituição Certificadora:  Secretarias                              Estaduais de Educação e Institutos Federais de Educação. Você precisa escolher em qual Instituição Certificadora será mais fácil solicitar o Certificado                       ou a Declaração após a liberação dos resultados.</label></div></div></div></div><div class="panel-body"><div class="row with-space"><div class="col-md-12"><div><label>Em qual Instituição Certificadora você prefere solicitar seu certificado ou declaração parcial de proficiência?</label></div></div></div><div class="row with-space-top"><div class="col-md-12"><inep-combobox np-id="ufCidadeProva" np-label="Selecione a UF:" np-optional="false" np-no-select-label="Selecione" np-size="3" np-values="c.ufs" np-selected-value="c.informacoesProva.codigoUfCertificadora" np-on-change="c.carregarEntidadesCertificadoras()"></inep-combobox><inep-combobox np-id="entidadeCertificadora" np-label="Selecione a Instituição certificadora:" np-optional="false" np-no-select-label="Selecione" np-size="8" np-values="c.secretariasCertificadoras" np-selected-value="c.informacoesProva.codigoSecretariaCertificadora" np-order-by="id" np-on-change="c.setarUfEndidadeCertificadora()"></inep-combobox></div></div></div></div></div><div ng-if="c.pagina === 2"><div class="row"><div class="col-md-4"></div><enem-fieldset><div tabindex="0" focus-me="focus-me" class="msg-inscricao-aviso">Verifique se as informa&ccedil;&otilde;es abaixo est&atilde;o corretas  e continue sua inscri&ccedil;&atilde;o</div></enem-fieldset></div><div class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Prova</h2></div><div class="panel-body"><div><b><div class="row with-space"><b class="col-md-6"></b></div>Nível de ensino escolhido para o qual quero a certificação:<inep-output-selection np-id="c.informacoesProva.opcaConclusao" ng-model="c.informacoesProva.opcaoConclusao" np-values="c.opcoesConclusaoCurso" np-empty-Value="NÃO INFORMADO"></inep-output-selection><!--.row.with-space: b.col-md-4 Provas que farei no Encceja 2020:--><div class="row with-space"><b class="col-md-4">Provas que farei no Encceja 2026:</b></div><ul ng-show="c.habilitarDisciplinasEnsinoFundamental()"><li ng-if="a.statusItem === c.constantes.MARCADO" ng-repeat="a in c.ensinoFundamental"><label style="font-weight: normal;">{{ a.descricao }}</label></li></ul><ul ng-show="c.habilitarDisciplinasEnsinoMedio()"><li ng-if="a.statusItem === c.constantes.MARCADO" ng-repeat="a in c.ensinoMedio"><label style="font-weight: normal;">{{ a.descricao }}</label></li></ul></b></div></div></div><div class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Cidade de prova</h2></div><div class="panel-body"><div><div class="row with-space"><b class="col-md-4">UF e cidade onde farei as provas: &nbsp;<inep-output-selection np-id="c.informacoesProva.codigoUf.label" ng-model="c.informacoesProva.codigoUf" np-values="c.ufs" np-empty-Value="NÃO INFORMADO"></inep-output-selection>,<inep-output-selection np-id="c.informacoesProva.codigoMunicipio.label" ng-model="c.informacoesProva.codigoMunicipio" np-values="c.listaMunicipio" np-empty-Value="NÃO INFORMADO"></inep-output-selection></b></div></div></div></div><div class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Instituição certificadora</h2></div><div class="panel-body"><div><div class="row with-space"><b class="col-md-10">Instituição Certificadora onde poderei solicitar o certificado de conclusão ou a declaração parcial de proficiência se conseguir a nota mínima exigida:</b></div><inep-output-selection np-id="c.informacoesProva.codigoSecretariaCertificadora.id" ng-model="c.informacoesProva.codigoSecretariaCertificadora" np-values="c.secretariasCertificadoras" np-empty-Value="NÃO INFORMADO"></inep-output-selection><div class="row with-space"><b class="col-md-4">UF da Instituição certificadora: &nbsp;<inep-output-selection np-id="c.informacoesProva.codigoSecretariaCertificadora.id" ng-model="c.informacoesProva.codigoSecretariaCertificadora" np-values="c.secretariasCertificadoras" np-item-label="uf" np-empty-Value="NÃO INFORMADO"></inep-output-selection></b></div></div><div class="row with-space"><div class="col-md-12"><enem-fieldset np-tab="0"><span class="attention-label">Aten&ccedil;&atilde;o:&nbsp;</span><span class="text-justify"> Na Página do Participante, durante o período de inscrição, você poderá alterar o nível de ensino ao qual busca certificação ou proficiência parcial e as provas que pretende fazer.</span></enem-fieldset></div></div><div class="row"><div class="col-md-12"><inep-boolean-checkbox np-id="booleanCheck" np-value="c.textDeclaracao" np-selected-value="c.informacoesProva.declaro" np-required-message="{{c.mensagens.MSGOD05}}" np-optional="false"></inep-boolean-checkbox></div></div></div></div></div></form></div></div><div inep-modal="inep-modal" np-id="modalWizard" np-buttons="c.modalInscricoesEncerradas.buttons" np-options="c.modalOptions" np-show="c.modalInscricoesEncerradas.show"><h2 aria-labelledby="texto" tabindex="0" class="titulo-modal h5 panel-title text-center text-primary">{{ c.modalInscricoesEncerradas.message }}</h2></div></div>'),a.put("views/inscricao/wizard/informarSenha.html",'<div ng-controller="InformarSenhaController as c"><header><div class="page-header with-space-top"><h1 class="h3">Inscri&ccedil;&atilde;o > ENCCEJA <small>informar senha</small></h1></div></header><div class="row"><div class="col-md-12"><form autocomplete="off" inep-message-bag="inep-message-bag" message-bag-header-error="O formulário abaixo está inválido pelos seguintes erros:" name="informarSenhaForm" novalidate="true" role="form"><div tabindex="0"><div class="text-center text-primary"><label>Os campos com <i alt="asterisco" class="fa fa-asterisk"><span class="hidden-accessibility">asterisco</span></i> são de preenchimento obrigatório</label></div><div class="row with-space-bottom"></div></div><div class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Senha</h2></div><div class="panel-body"><div class="row"><div class="col-md-12"><p tabindex="0"><span class="attention-label">Aten&ccedil;&atilde;o:</span> Esta senha ser&aacute; utilizada para o acompanhamento de sua inscri&ccedil;&atilde;o e obten&ccedil;&atilde;o de seus resultados.\n A senha somente poder&aacute; ser recuperada via e-mail ou SMS.</p></div></div><div class="row"><br/></div><div class="row"><inep-password np-value="c.informarSenha.senha" np-id="inputSenha" np-label="Senha:" np-optional="false" np-size="4" np-minlength="6" np-maxlength="10" np-pattern="\'[0-9a-zA-Z]{1,10}\'" np-pattern-message="A senha informada é inválida. Siga a regra de criação de senha apresentada abaixo do campo." np-accessibility-message="{{c.mensagens.MSGA022}}"></inep-password></div><div class="row"><div class="col-md-12">M&iacute;nimo de 6 e m&aacute;ximo de 10 caracteres, podendo conter apenas\n n&uacute;meros e letras, com distin&ccedil;&atilde;o de mai&uacute;sculas e\n min&uacute;sculas.</div></div><div class="row"><br/></div><div class="row"><inep-password np-value="c.informarSenha.confirmaSenha" np-id="inputConfirmarSenha" np-label="Confirmar senha:" np-optional="false" np-size="4" np-confirm-value="c.informarSenha.senha" np-maxlength="10" np-pattern="\'[0-9a-zA-Z]{1,10}\'" np-pattern-message="A senha informada é inválida. Siga a regra de criação de senha apresentada abaixo do campo." np-confirm-password="true" np-confirm-message="Os dados devem coincidir com os inseridos no campo senha." np-accessibility-message="{{c.mensagens.MSGA023}}"></inep-password></div></div></div></form></div></div></div>'),
a.put("views/inscricao/wizard/navegacaoAtendimento.html",'<div ng-controller="AtendimentoNavegacaoController as c" ng-init="c.init()"><header><div class="page-header with-space-top"><h1 class="h3">Inscri&ccedil;&atilde;o > ENCCEJA <small>{{ c.title}} </small></h1></div></header><form name="atendimentoRecursosForm" role="form" novalidate="true" autocomplete="off" inep-message-bag="inep-message-bag" message-bag-header-error="O formulário abaixo está inválido pelos seguintes erros:"><div ng-if="c.nav.especializado" ng-controller="AtendimentoEspecializadoController as c"><div tabindex="0"><div class="text-center text-primary"><label>Os campos com <i alt="asterisco" class="fa fa-asterisk"><span class="hidden-accessibility">asterisco</span></i> são de preenchimento obrigatório</label></div><div class="row with-space-bottom"></div></div><div class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Atendimentos especializado</h2></div><div class="panel-body"><div class="row"><inep-radiobutton np-id="radioPrecisaEspecializado" np-label="Você precisa de algum tipo de Atendimento Especializado para fazer a prova?" np-values="c.comboSimNao()" np-selected-value="c.precisaEspecializado" np-inline="true" np-on-change="c.precisaEspecializadoChanged()" np-optional="true"></inep-radiobutton></div><div class="box-describe"><span class="boldText"> Atendimento especializado:</span><span class="text-justify"> {{ c.msg.ATENDIMENTO_ESPECIALIZADO_AVISO }}</span></div><div ng-if="c.precisaAtendimento()" class="row"><enem-checkbox np-id="checkEspecializado" np-promise="c.especializadoPromise" np-optional="false" np-lines="9" np-size="6" np-on-change="c.precisaRecursoChanged()" np-callback="c.especializadoCallback" np-label="Qual condição motiva a sua necessidade de atendimento especializado?" np-pessoa-fisica="c.pessoaFisica"></enem-checkbox></div><div ng-if="c.precisaAparelhoAuditivo()" class="row"><inep-radiobutton np-id="radioPrecisaAparelhoAuditivo" np-label="Você utilizará aparelho auditivo ou implante coclear no dia de aplicação do Exame?" np-values="c.comboSimNao()" np-selected-value="c.inAparelhoAuditivo" np-inline="true" np-optional="false"></inep-radiobutton></div><div ng-if="c.precisaAparelhoGlicemia()" class="row"><inep-radiobutton np-id="radioPrecisaAparelhoGlicemia" np-label="Você utilizará algum aparelho específico para aferição da glicemia no dia de aplicação do Exame?" np-values="c.comboSimNao()" np-selected-value="c.inAparelhoGlicemia" np-inline="true" np-optional="false"></inep-radiobutton></div><div ng-if="c.precisaAtendimento()" class="row"><enem-fieldset><inep-boolean-checkbox np-id="declaroAtendimento" np-value="c.declaroAtendimento.text" np-selected-value="c.declaroAtendimento.value" np-optional="false" np-required-message="Confirme a declaração"></inep-boolean-checkbox></enem-fieldset></div></div></div><div ng-if="c.exibeCid()" class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">CID</h2></div><div class="panel-body"><div ng-if="a.statusItem === c.constantes.MARCADO &amp;&amp; a.cid" ng-repeat="a in c.especializadoCallback track by a.codigo" class="row with-space-bottom"><enem-fieldset><div class="col-md-12"><label>{{ a.descricao }}</label></div><inep-input-text np-id="cid_{{a.codigo}}" np-label="CID" ng-model="c.cid[$index].codigo" np-size="3" np-optional="false" np-maxlength="7" inep-validator="c.validarCid($index)" to-upper-case="to-upper-case" np-placeholder="Informe o CID aqui"></inep-input-text><div class="col-md-3"><button id="pesquisarCid" ng-click="c.consultarCid($index)" class="btn btn-default align-button-upload">Consultar CID</button></div><span class="col-md-12"><b>Descri&ccedil;&atilde;o:</b> {{c.cid[$index].descricao}}</span><!--span.col-md-12(style="margin-top: 5px")--><!--  b Mantenha seus dados de contato telefônico atualizados. O Inep entrará em contato--><!--  |  com você para a verificação da sua necessidade de recurso de acessibilidade para realização das provas.-->\n\n\n</enem-fieldset></div></div></div><div ng-if="c.exibeRecursos()" class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Recursos</h2></div><div class="panel-body"><div ng-if="c.exibeRecursos()" class="row with-space-bottom"><div class="col-md-12"><div class="row"><enem-checkbox np-id="checkRecursos" np-promise="c.recursoEspecializadoPromise" np-callback="c.recursoEspecializadoCallback" np-optional="false" np-label="Indique o recurso de acessibilidade para a realização da prova, de acordo com sua necessidade. Pode ser selecionada mais de uma opção" np-vinculo-checkbox="c.especializadoCallback" np-accessibility-message="{{ c.mensagens.MSGA037 }}" np-disabled="true"></enem-checkbox></div><!--.row(ng-if=\'c.precisaCartaoRespostasAmpliado()\')--><!--  inep-radiobutton(np-id=\'radioPrecisaCartaoRespostaAmpliado\',--><!--  np-label=\'{{c.textoCartaoResposta}}\',--><!--  np-values=\'c.comboSimNao()\',--><!--  np-selected-value=\'c.inCartaoRespostaAumentado\',--><!--  np-inline="true",--><!--  np-optional=\'false\')--><!--row(ng-if="c.inCartaoRespostaAumentado == \'false\'")--><!--  label No dia do Exame, você receberá um Cartão-Resposta/Folha de Redação regular. Caso necessite de auxílio para seu preenchimento, solicite também "Auxílio para transcrição".--><!--row(ng-if="c.inCartaoRespostaAumentado == \'true\'")--><!--  label No dia do Exame, não será disponibilizado Auxílio para transcrição. Caso necessite de Auxílio para transcrição, não solicite Cartão-Resposta/Folha de Redação ampliado.--><div ng-if="c.precisaMetodoAtendimento()" class="row"><inep-radiobutton np-id="radioPrecisaMetodoAtendimento" np-label="Qual o método de atendimento você precisa no dia do Exame: Tadoma ou Libras tátil?" np-values="c.comboMetodoAtendimento()" np-vinculo-checkbox="c.recursoEspecializadoCallback" np-selected-value="c.metodoAtendimento" np-inline="true" np-optional="false"></inep-radiobutton></div><div class="row"><enem-fieldset><inep-boolean-checkbox np-id="declaroRecurso" np-value="c.declaroRecurso.text" np-selected-value="c.declaroRecurso.value" np-optional="false" np-required-message="{{ c.mensagens.MSGOD04 }}"></inep-boolean-checkbox></enem-fieldset></div></div></div></div></div><div ng-if="c.exibeDocumentacao()" class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Documenta&ccedil;&atilde;o comprobat&oacute;ria</h2></div><div class="panel-body"><div class="row"><div class="col-md-12"><label>Insira o documento que comprove sua solicitação.</label></div></div><div class="row"><enem-fieldset><span class="text-justify">1º Clique em "Escolher arquivo";<br></span><span class="text-justify">2º Selecione o documento;<br></span><span class="text-justify">3º Clique em "Enviar". <br><br></span><span class="attention-label">Atenção:</span><span class="boldText">{{c.msg.TIPO_ARQUIVO }}</span></enem-fieldset></div><div class="row"><enem-fieldset><span class="text-justify"> Participante, <br></span><span class="text-justify"> {{ c.msg.LAUDO_DEFERIMENTO }}</span></enem-fieldset></div><div ng-if="a.statusItem === c.constantes.MARCADO &amp;&amp; ((a.laudo || a.laudoTempoAdicional))" ng-repeat="a in c.especializadoCallback track by a.codigo" class="row with-space-bottom"><enem-fieldset><div ng-if="c.precisaDocLactante() &amp;&amp; a.codigo == 27" class="row"><inep-radiobutton np-id="radioPrecisaDocLactante" np-label="Marque o tipo de documento que anexou para comprovar a necessidade de tempo adicional:" np-values="c.comboDocLactante()" np-selected-value="c.tpDocumentoLactante" np-inline="true" np-optional="false"></inep-radiobutton></div><div ng-if="a.codigo == 100" class="row"><div class="col-md-12"><p style="margin-left: 15px; margin-right: 15px;">O participante em situação de classe hospitalar é aquele cujo processo formal de\nescolarização ocorre no interior de instituição hospitalar ou afim, na condição de estudante\ninternado para tratamento de saúde. Não é considerado participante em situação de classe\nhospitalar aquele que, na data de aplicação do Encceja Nacional 2026, estiver internado para\nrealização de partos, cirurgias ou tratamentos esporádicos, bem como pessoas que trabalham na\nárea hospitalar.</p></div></div><div class="col-md-12"><label>{{ a.descricao }}</label></div><div ng-show="!a.laudoDeferido" class="col-md-12"><inep-input-file ng-if="((a.laudo || a.laudoTempoAdicional) &amp;&amp; !a.laudoDeferido) &amp;&amp; !c.cid[$index].send" np-id="laudo_{{a.codigo}}" np-label="Laudo" np-value="c.cid[$index].file" np-max-file-size="c.maxFileSize" np-show-icon="true" np-size="6" np-max-file-message="Tamanho de arquivo inválido." np-content-type-message="Formato de arquivo inválido." np-disabled="" np-optional="false" inep-validator="c.validarArquivo($index)" np-content-types="c.contentTypes" np-empty-message="{{c.mensagens.MSG_ARQUIVO_VAZIO}}"></inep-input-file><div ng-if="c.isFileValid($index) &amp;&amp; !c.cid[$index].send" class="col-md-4"><button id="enviar_laudo_{{a.codigo}}" ng-click="c.enviarArquivo($index)" class="btn btn-default align-button-upload">Enviar laudo</button></div></div><div ng-show="!!a.laudoDeferido" class="col-md-12"><span class="text-justify">Você possui documento aprovado em edições anteriores, desta forma, não será necessário o envio de um novo documento.</span></div><div ng-if="c.cid[$index].send" class="col-md-12"><inep-output-text id="mensagem_laudo_{{a.codigo}}" ng-model="c.msg.ARQUIVO_ENVIADO_COM_SUCESSO"></inep-output-text></div><div ng-if="c.cid[$index].send &amp;&amp; !a.laudoDeferido" class="col-md-4"><button id="visualizar_laudo_{{a.codigo}}" style="margin-right:15px" ng-click="c.visualizarArquivo($index)" class="btn btn-default align-button-upload">Visualizar</button><button id="excluir_laudo_{{a.codigo}}" ng-click="c.excluirArquivo($index)" class="btn btn-default align-button-upload">Excluir laudo</button></div></enem-fieldset></div></div></div></div><!--div(ng-if=\'c.nav.recurso\', ng-controller=\'RecursoController as c\')--><!--  include atendimentoRecursos/recurso--><div ng-if="c.nav.confirmacao" ng-controller="ConfirmarInformacoesPessoaisController as c"><div class="row"><div class="col-md-4"></div><enem-fieldset><div tabindex="0" focus-me="focus-me" class="msg-inscricao-aviso">Verifique se as informa&ccedil;&otilde;es abaixo est&atilde;o corretas  e continue sua inscri&ccedil;&atilde;o</div></enem-fieldset></div><div class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Dados pessoais</h2></div><div class="panel-body"><div class="row"><div class="col-md-3"><b>CPF:&nbsp;</b><inep-output-text np-id="cpfFormatado" ng-model="c.informacoesPessoais.cpf" np-mask="999.999.999-99" np-empty-value="{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}"></inep-output-text></div><div class="col-md-6"><b>Nome completo:&nbsp;</b><inep-output-text np-id="nome" ng-model="c.informacoesPessoais.nome" np-empty-value="{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}"></inep-output-text></div><div class="col-md-3"><b>Data de nascimento:&nbsp;</b><inep-output-text np-id="dataNascimento" ng-model="c.informacoesPessoais.dataDeNascimentoFormatada" np-empty-value="{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}"></inep-output-text></div></div><div class="row"><div class="col-md-6"><b>Nome completo da m&atilde;e:&nbsp;</b><inep-output-text np-id="nomeMae" ng-model="c.informacoesPessoais.nomeDaMae" np-empty-value="{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}"></inep-output-text></div><div class="col-md-6"><b>Nome completo do pai:&nbsp;</b><inep-output-text np-id="nomePai" ng-model="c.informacoesPessoais.nomeDoPai" np-empty-value="{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}"></inep-output-text></div></div><div class="row"><div class="col-md-3"><b>Sexo:&nbsp;</b><inep-output-selection np-id="sexo" ng-model="c.informacoesPessoais.sexo" np-values="c.sexos" np-empty-value="{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}"></inep-output-selection></div><div class="col-md-3"><b>Cor ou Ra&ccedil;a:&nbsp;</b><inep-output-selection np-id="nomeEtnia" ng-model="c.informacoesPessoais.etnia" np-values="c.etnias" np-empty-value="{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}"></inep-output-selection></div></div><div class="row"><div class="col-md-3"><b>Estado civil:&nbsp;</b><inep-output-selection np-id="nomeEstadoCivil" ng-model="c.informacoesPessoais.estadoCivil" np-values="c.estadosCivis" np-empty-value="{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}"></inep-output-selection></div><div class="col-md-6"><b>Nacionalidade:&nbsp;</b><inep-output-selection np-id="nacionalidade" ng-model="c.informacoesPessoais.nacionalidade" np-values="c.nacionalidades" np-empty-value="{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}"></inep-output-selection></div></div><div class="row"><div ng-if="c.informacoesPessoais.nacionalidade === 1"><div class="col-md-3"><b>UF de nascimento:&nbsp;<inep-output-selection np-id="nomeUfNascimento" ng-model="c.informacoesPessoais.nascimentoUf" np-values="c.ufs" np-empty-value="{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}"></inep-output-selection></b></div><div class="col-md-3"><b>Munic&iacute;pio de nascimento:&nbsp;</b><inep-output-selection np-id="nomeMunicipioNascimento" ng-model="c.informacoesPessoais.nascimentoMunicipio" np-values="c.municipios" np-empty-value="{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}"></inep-output-selection></div></div></div></div></div><div class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Endere&ccedil;o</h2></div><div class="panel-body"><div class="row"><div class="col-md-12"><b>CEP:&nbsp;</b><inep-output-text np-id="cepFormatado" ng-model="c.informacoesPessoais.residencia.cep" np-mask="99.999-999" np-empty-value="{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}"></inep-output-text></div></div><div class="row"><div class="col-md-5"><b>Endere&ccedil;o:&nbsp;</b><inep-output-text np-id="logradouro" ng-model="c.informacoesPessoais.residencia.logradouro" np-empty-value="{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}"></inep-output-text></div><div class="col-md-3"><b>N&uacute;mero:&nbsp;</b><inep-output-text np-id="numeroEndereco" ng-model="c.informacoesPessoais.residencia.numero" np-empty-value="{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}"></inep-output-text></div><div class="col-md-4"><b>Complemento:&nbsp;</b><inep-output-text np-id="complemento" ng-model="c.informacoesPessoais.residencia.complemento" np-empty-value="{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}" style="word-wrap: break-word;"></inep-output-text></div></div><div class="row"><div class="col-md-5"><b>Bairro:&nbsp;</b><inep-output-text np-id="bairro" ng-model="c.informacoesPessoais.residencia.bairro" np-empty-value="{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}"></inep-output-text></div><div class="col-md-3"><b>UF:&nbsp;</b><inep-output-text np-id="nomeUfEndereco" ng-model="c.informacoesPessoais.residencia.uf" np-empty-value="{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}"></inep-output-text></div><div class="col-md-4"><b>Munic&iacute;pio:&nbsp;</b><inep-output-text np-id="nomeMunicipioEndereco" ng-model="c.informacoesPessoais.residencia.municipio" np-empty-value="{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}"></inep-output-text></div></div></div></div><div class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Atendimento especializado</h2></div><div class="panel-body"><div class="row"><div class="col-md-12"><b>Você precisa de algum recurso de acessibilidade para fazer a prova?</b><inep-output-text np-id="possuiEspecializado" ng-model="c.possuiEspecializadoValue" np-empty-Value="{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}"></inep-output-text></div></div><div ng-if="c.possuiEspecializado()" class="row with-space-bottom"><div class="col-md-12"><ul><li ng-if="a.statusItem === c.constantes.MARCADO" ng-repeat="a in c.especializados"><label style="font-weight: normal;">{{ a.descricao }}</label><div ng-if="!!a.informacao" class="box-describe">{{ a.informacao }}</div><div ng-if="!!a.cid" class="with-space-bottom"><b>{{ a.cid }}</b></div><div ng-if="a.statusItem === c.constantes.MARCADO &amp;&amp; a.dependencia.regras.indexOf(&quot;RNE005&quot;) &gt; -1"><enem-regra005 ng-model="a" np-disabled="true" np-optional="true"></enem-regra005></div></li></ul></div></div><div ng-if="c.possuiEspecializado()" class="row"><div class="col-sm-12"><p><b>Aux&iacute;lio que necessitar&aacute; para realiza&ccedil;&atilde;o da prova:</b></p></div><div class="col-sm-12"><ul><li ng-if="r.statusItemAdicional !== c.constantes.OCULTO" ng-repeat="r in c.recursosEspecializados">{{ r.descricao }}<b ng-if="r.codigo !== 30" class="{{ c.verificarCorCampoInformado(r.statusItem) }}">: {{ c.opcaoSimNao(r.statusItem) }}</b><div ng-if="r.informacao != null &amp;&amp; r.statusItem === c.constantes.MARCADO" class="box-describe">{{ r.informacao }}</div></li></ul></div></div></div></div><!--.panel.panel-info--><!--  .panel-heading: h2.h4.panel-title.text-left.text-primary Atendimento espec&iacute;fico--><!--  .panel-body--><!--    .row: .col-md-12--><!--      b Possui necessidade de atendimento específico:&nbsp;--><!--      inep-output-text(np-id=\'possuiAtendEspec\',--><!--      ng-model=\'c.possuiEspecificoValue\',--><!--      np-empty-value=\'{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}\')--><!----><!--    .row.with-space-bottom(ng-if=\'c.possuiEspecifico\'): .col-md-12--><!--      ul--><!--        li(ng-if=\'a.statusItem === c.constantes.MARCADO\', ng-repeat=\'a in c.especificos\')--><!--          label(style=\'font-weight: normal;\')--><!--            | {{ a.descricao }}--><!--          div(class=\'box-describe\', ng-if=\'!!a.informacao\') {{ a.informacao }}--><!--          div.with-space-bottom(ng-if=\'!!a.cid\'): b {{ a.cid }}--><!--          div(ng-if=\'a.statusItem === c.constantes.MARCADO && a.dependencia.regras.indexOf("RNE005") > -1\')--><!--            enem-regra005(ng-model=\'a\', np-disabled=\'true\', np-optional=\'true\')--><!----><!--    .row(ng-if=\'c.possuiRecursoEspecifico\')--><!--      .col-sm-12: p: b Aux&iacute;lio que necessitar&aacute; para realiza&ccedil;&atilde;o da prova:--><!--      .col-sm-12: ul--><!--        li(ng-if=\'r.statusItemAdicional !== c.constantes.OCULTO\', ng-repeat=\'r in c.recursosEspecificos\') {{ r.descricao }}--><!--          b(ng-if=\'r.codigo !== 30\', class=\'{{ c.verificarCorCampoInformado(r.statusItem) }}\') : {{ c.opcaoSimNao(r.statusItem) }}--><!--          div(ng-if=\'r.informacao != null && r.statusItem === c.constantes.MARCADO\', class=\'box-describe\') {{ r.informacao }}-->\n</div><div inep-modal="inep-modal" np-id="modalWizard" np-buttons="c.modalInscricoesEncerradas.buttons" np-options="c.modalOptions" np-show="c.modalInscricoesEncerradas.show"><h2 aria-labelledby="texto" tabindex="0" class="titulo-modal h5 panel-title text-center text-primary">{{ c.modalInscricoesEncerradas.message }}  </h2></div></form></div>'),a.put("views/inscricao/wizard/nomeSocial.html",'<div ng-controller="NomeSocialInscricaoController as c" ng-init="c.init()"><header><div class="page-header with-space-top"><h1 class="h3">Inscri&ccedil;&atilde;o > ENCCEJA <small>Tratamento pelo nome social</small></h1></div></header><form id="nomeSocialForm" name="nomeSocialForm" role="form" novalidate="true" autocomplete="off" inep-message-bag="inep-message-bag" message-bag-header-error="O formulário abaixo está inválido pelos seguintes erros:"><div tabindex="0"><div class="text-center text-primary"><label>Os campos com <i alt="asterisco" class="fa fa-asterisk"><span class="hidden-accessibility">asterisco</span></i> são de preenchimento obrigatório</label></div><div class="row with-space-bottom"></div></div><div class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Tratamento pelo nome social</h2></div><div class="panel-body"><div class="row"><inep-radiobutton np-id="radioPrecisaNomeSocial" np-label="Esse tratamento é exclusivo para os participantes travestis, transexuais ou transgêneros que se identificam e querem ser reconhecidos socialmente em consonância com sua identidade de gênero, desde que tenham feito esse cadastro na Receita Federal do Brasil. Você quer ser tratado pelo nome social?" np-values="c.comboSimNao()" np-selected-value="c.usarNomeSocial" np-inline="true" np-on-change="c.usarNomeSocialChanged()" np-optional="false"></inep-radiobutton></div><div ng-if="c.consultouNome &amp;&amp; !c.nomeSocialReceita" style="padding: 15px"><div class="row"><p>Não identificamos na base da Receita Federal a existência do Nome Social.</p><p>Para ser tratado pelo Nome Social é necessário o cadastro dessa condição junto \nà Receita Federal do Brasil. Você pode concluir a sua inscrição, atualizar essa \ninformação na Receita Federal e informar o nome social na Página do \nParticipante até o último dia de inscrição, previsto no edital do Encceja, disponível no endereço <a href="https://www.gov.br/inep/pt-br/areas-de-atuacao/avaliacao-e-exames-educacionais/encceja" target="_blank">https://www.gov.br/inep/pt-br/areas-de-atuacao/avaliacao-e-exames-educacionais/encceja.</a></p></div></div><div ng-if="c.usarNomeSocial == \'true\' &amp;&amp; c.nomeSocialReceita" style="padding: 15px"><div class="row"><inep-radiobutton np-id="radioNomeSocialReceita" np-label="Identificamos, na base da Receita Federal, a existência do nome social {{c.nomeSocialReceita}} para o seu CPF. Você deseja ser identificado em todas as fases do Exame por seu nome social?" np-values="c.comboSimNao()" np-selected-value="c.utilizarNomeReceita" np-inline="true" np-disabled="!!possuiNomeSocialCadastrado" np-optional="false"></inep-radiobutton></div></div></div></div></form></div>'),a.put("views/inscricao/wizard/questionario.html",'<header><div class="page-header with-space-top"><h1 class="h3">Inscri&ccedil;&atilde;o > ENCCEJA <small>question&aacute;rio socioecon&ocirc;mico</small></h1></div></header><form name="questionarioForm" role="form" ng-controller="QuestionarioController as c" ng-init="c.init()" novalidate="true" autocomplete="off" inep-message-bag="inep-message-bag" message-bag-header-error="O formulário abaixo está inválido pelos seguintes erros:"><div tabindex="0"><div class="text-center text-primary"><label>Os campos com <i alt="asterisco" class="fa fa-asterisk"><span class="hidden-accessibility">asterisco</span></i> são de preenchimento obrigatório</label></div><div class="row with-space-bottom"></div></div><div inep-modal="inep-modal" np-id="modalWizard" np-buttons="c.modalCallbackError.botoes" np-show="c.modalCallbackError.exibe" np-header="Aviso"><p tabindex="0">{{c.modalCallbackError.mensagem}}</p></div><div inep-modal="inep-modal" np-id="modalWizard" np-buttons="c.modalInscricoesEncerradas.buttons" np-options="c.modalOptions" np-show="c.modalInscricoesEncerradas.show"><h2 aria-labelledby="texto" tabindex="0" class="titulo-modal h5 panel-title text-center text-primary">{{ c.modalInscricoesEncerradas.message }}\n</h2></div><div class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Orienta&ccedil;&atilde;o do question&aacute;rio</h2></div><div class="panel-body"><p>Prezado(a) participante,</p><p>Você deverá responder ao Questionário Socioeconômico do Encceja.\nNele, você encontrará questões sobre: você e sua família e você e os estudos.</p><p>Não há respostas certas ou erradas. Por essa razão, pedimos que leia com atenção cada questão e as responda corretamente.</p><p>As informações obtidas neste questionário serão utilizadas para a elaboração de estatísticas e estudos sobre a educação brasileira.\nNão haverá identificação nominal no participante.</p></div></div><div ng-repeat="grupo in questionario"><div class="panel panel-info"><div tabindex="0" class="panel-heading"><h2 class="h4 panel-title text-left text-primary">{{grupo.descricao}}  </h2></div><div ng-repeat="questao in grupo.questoes"><div ng-if="!questao.escondida" class="panel-body"><h4 ng-if="questao.tituloGrupo !== undefined" class="panel panel-info"><b id="tituloGrupo{{questao.id}}" tabindex="0">{{questao.tituloGrupo}}</b></h4><b id="info{{questao.id}}" tabindex="0"> <div ng-if="!questao.multipla &amp;&amp; questao.tipo !== 3" id="dv{{questao.id}}" class="with-space"><inep-radiobutton np-id="q{{questao.id}}" np-label="{{questao.numeroQuestao}} - {{questao.descricao}}" np-values="questao.alternativas" np-selected-value="respostas[questao.id]" np-inline="questao.inline" np-on-change="verifiqueResposta(questao)" np-optional="false" ng-if="!questao.escondida" np-subtitle="(Marque apenas uma resposta)"></inep-radiobutton></div><div ng-if="!questao.multipla &amp;&amp; questao.tipo === 3" id="dv{{questao.id}}" class="with-space"><inep-radiobutton np-id="q{{questao.id}}" np-label="{{questao.numeroQuestao}} - {{questao.descricao}}" np-values="questao.alternativas" np-selected-value="respostas[questao.id]" np-inline="questao.inline" np-on-change="verifiqueResposta(questao)" np-optional="true" ng-if="!questao.escondida" np-subtitle="(Marque apenas uma resposta)" np-disabled="questao.desabilitado"></inep-radiobutton></div><div ng-if="questao.multipla" id="dv{{questao.id}}" style="padding-left:15px" class="with-space"><label>{{questao.numeroQuestao}} - {{questao.descricao}}</label><i style="color: #9A0000" class="fa fa-asterisk fa"></i><div ng-repeat="alternativa in questao.alternativas"><input id="a{{alternativa.id}}" type="checkbox" ng-model="respostas[alternativa.id]" ng-true-value="{{alternativa.id}}" ng-false-value="null" ng-optional="true" ng-change="c.zerarMultiplasIncompativeis(alternativa.incompativeis)" ng-disabled="questao.limite &amp;&amp; c.atingiuLimite(questao) &amp;&amp; !c.opcaoMarcada(alternativa)"/><label>{{alternativa.label}}</label></div><label ng-if="submitted &amp;&amp; c.multiplaSemResposta(questao)" style="color: #a94442" for="grid" role="alert" align="center" class="control-label"><b class="fa fa-times-circle-o"></b>Campo obrigatório.</label></div></b></div><h4 ng-if="!questao.escondida &amp;&amp; questao.finalGrupo" class="panel panel-info">  <b tabindex="0">{{  }}</b></h4></div><div><div class="panel-body"><div class="with-space"><div class="box-describe"><span class="text-justify">Atenção: Não será possível alterar o questionário após selecionar a opção "Confirmar".</span></div></div></div></div></div></div></form>'),a.put("views/inscricao/wizard/atendimentoRecursos/atendimentoEspecializado.html",'<div tabindex="0"><div class="text-center text-primary"><label>Os campos com <i alt="asterisco" class="fa fa-asterisk"><span class="hidden-accessibility">asterisco</span></i> são de preenchimento obrigatório</label></div><div class="row with-space-bottom"></div></div><div class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Atendimentos especializado</h2></div><div class="panel-body"><div class="row"><inep-radiobutton np-id="radioPrecisaEspecializado" np-label="Você precisa de algum tipo de Atendimento Especializado para fazer a prova?" np-values="c.comboSimNao()" np-selected-value="c.precisaEspecializado" np-inline="true" np-on-change="c.precisaEspecializadoChanged()" np-optional="true"></inep-radiobutton></div><div class="box-describe"><span class="boldText"> Atendimento especializado:</span><span class="text-justify"> {{ c.msg.ATENDIMENTO_ESPECIALIZADO_AVISO }}</span></div><div ng-if="c.precisaAtendimento()" class="row"><enem-checkbox np-id="checkEspecializado" np-promise="c.especializadoPromise" np-optional="false" np-lines="9" np-size="6" np-on-change="c.precisaRecursoChanged()" np-callback="c.especializadoCallback" np-label="Qual condição motiva a sua necessidade de atendimento especializado?" np-pessoa-fisica="c.pessoaFisica"></enem-checkbox></div><div ng-if="c.precisaAparelhoAuditivo()" class="row"><inep-radiobutton np-id="radioPrecisaAparelhoAuditivo" np-label="Você utilizará aparelho auditivo ou implante coclear no dia de aplicação do Exame?" np-values="c.comboSimNao()" np-selected-value="c.inAparelhoAuditivo" np-inline="true" np-optional="false"></inep-radiobutton></div><div ng-if="c.precisaAparelhoGlicemia()" class="row"><inep-radiobutton np-id="radioPrecisaAparelhoGlicemia" np-label="Você utilizará algum aparelho específico para aferição da glicemia no dia de aplicação do Exame?" np-values="c.comboSimNao()" np-selected-value="c.inAparelhoGlicemia" np-inline="true" np-optional="false"></inep-radiobutton></div><div ng-if="c.precisaAtendimento()" class="row"><enem-fieldset><inep-boolean-checkbox np-id="declaroAtendimento" np-value="c.declaroAtendimento.text" np-selected-value="c.declaroAtendimento.value" np-optional="false" np-required-message="Confirme a declaração"></inep-boolean-checkbox></enem-fieldset></div></div></div><div ng-if="c.exibeCid()" class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">CID</h2></div><div class="panel-body"><div ng-if="a.statusItem === c.constantes.MARCADO &amp;&amp; a.cid" ng-repeat="a in c.especializadoCallback track by a.codigo" class="row with-space-bottom"><enem-fieldset><div class="col-md-12"><label>{{ a.descricao }}</label></div><inep-input-text np-id="cid_{{a.codigo}}" np-label="CID" ng-model="c.cid[$index].codigo" np-size="3" np-optional="false" np-maxlength="7" inep-validator="c.validarCid($index)" to-upper-case="to-upper-case" np-placeholder="Informe o CID aqui"></inep-input-text><div class="col-md-3"><button id="pesquisarCid" ng-click="c.consultarCid($index)" class="btn btn-default align-button-upload">Consultar CID</button></div><span class="col-md-12"><b>Descri&ccedil;&atilde;o:</b> {{c.cid[$index].descricao}}</span><!--span.col-md-12(style="margin-top: 5px")--><!--  b Mantenha seus dados de contato telefônico atualizados. O Inep entrará em contato--><!--  |  com você para a verificação da sua necessidade de recurso de acessibilidade para realização das provas.-->\n\n\n</enem-fieldset></div></div></div><div ng-if="c.exibeRecursos()" class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Recursos</h2></div><div class="panel-body"><div ng-if="c.exibeRecursos()" class="row with-space-bottom"><div class="col-md-12"><div class="row"><enem-checkbox np-id="checkRecursos" np-promise="c.recursoEspecializadoPromise" np-callback="c.recursoEspecializadoCallback" np-optional="false" np-label="Indique o recurso de acessibilidade para a realização da prova, de acordo com sua necessidade. Pode ser selecionada mais de uma opção" np-vinculo-checkbox="c.especializadoCallback" np-accessibility-message="{{ c.mensagens.MSGA037 }}" np-disabled="true"></enem-checkbox></div><!--.row(ng-if=\'c.precisaCartaoRespostasAmpliado()\')--><!--  inep-radiobutton(np-id=\'radioPrecisaCartaoRespostaAmpliado\',--><!--  np-label=\'{{c.textoCartaoResposta}}\',--><!--  np-values=\'c.comboSimNao()\',--><!--  np-selected-value=\'c.inCartaoRespostaAumentado\',--><!--  np-inline="true",--><!--  np-optional=\'false\')--><!--row(ng-if="c.inCartaoRespostaAumentado == \'false\'")--><!--  label No dia do Exame, você receberá um Cartão-Resposta/Folha de Redação regular. Caso necessite de auxílio para seu preenchimento, solicite também "Auxílio para transcrição".--><!--row(ng-if="c.inCartaoRespostaAumentado == \'true\'")--><!--  label No dia do Exame, não será disponibilizado Auxílio para transcrição. Caso necessite de Auxílio para transcrição, não solicite Cartão-Resposta/Folha de Redação ampliado.--><div ng-if="c.precisaMetodoAtendimento()" class="row"><inep-radiobutton np-id="radioPrecisaMetodoAtendimento" np-label="Qual o método de atendimento você precisa no dia do Exame: Tadoma ou Libras tátil?" np-values="c.comboMetodoAtendimento()" np-vinculo-checkbox="c.recursoEspecializadoCallback" np-selected-value="c.metodoAtendimento" np-inline="true" np-optional="false"></inep-radiobutton></div><div class="row"><enem-fieldset><inep-boolean-checkbox np-id="declaroRecurso" np-value="c.declaroRecurso.text" np-selected-value="c.declaroRecurso.value" np-optional="false" np-required-message="{{ c.mensagens.MSGOD04 }}"></inep-boolean-checkbox></enem-fieldset></div></div></div></div></div><div ng-if="c.exibeDocumentacao()" class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Documenta&ccedil;&atilde;o comprobat&oacute;ria</h2></div><div class="panel-body"><div class="row"><div class="col-md-12"><label>Insira o documento que comprove sua solicitação.</label></div></div><div class="row"><enem-fieldset><span class="text-justify">1º Clique em "Escolher arquivo";<br></span><span class="text-justify">2º Selecione o documento;<br></span><span class="text-justify">3º Clique em "Enviar". <br><br></span><span class="attention-label">Atenção:</span><span class="boldText">{{c.msg.TIPO_ARQUIVO }}</span></enem-fieldset></div><div class="row"><enem-fieldset><span class="text-justify"> Participante, <br></span><span class="text-justify"> {{ c.msg.LAUDO_DEFERIMENTO }}</span></enem-fieldset></div><div ng-if="a.statusItem === c.constantes.MARCADO &amp;&amp; ((a.laudo || a.laudoTempoAdicional))" ng-repeat="a in c.especializadoCallback track by a.codigo" class="row with-space-bottom"><enem-fieldset><div ng-if="c.precisaDocLactante() &amp;&amp; a.codigo == 27" class="row"><inep-radiobutton np-id="radioPrecisaDocLactante" np-label="Marque o tipo de documento que anexou para comprovar a necessidade de tempo adicional:" np-values="c.comboDocLactante()" np-selected-value="c.tpDocumentoLactante" np-inline="true" np-optional="false"></inep-radiobutton></div><div ng-if="a.codigo == 100" class="row"><div class="col-md-12"><p style="margin-left: 15px; margin-right: 15px;">O participante em situação de classe hospitalar é aquele cujo processo formal de\nescolarização ocorre no interior de instituição hospitalar ou afim, na condição de estudante\ninternado para tratamento de saúde. Não é considerado participante em situação de classe\nhospitalar aquele que, na data de aplicação do Encceja Nacional 2026, estiver internado para\nrealização de partos, cirurgias ou tratamentos esporádicos, bem como pessoas que trabalham na\nárea hospitalar.</p></div></div><div class="col-md-12"><label>{{ a.descricao }}</label></div><div ng-show="!a.laudoDeferido" class="col-md-12"><inep-input-file ng-if="((a.laudo || a.laudoTempoAdicional) &amp;&amp; !a.laudoDeferido) &amp;&amp; !c.cid[$index].send" np-id="laudo_{{a.codigo}}" np-label="Laudo" np-value="c.cid[$index].file" np-max-file-size="c.maxFileSize" np-show-icon="true" np-size="6" np-max-file-message="Tamanho de arquivo inválido." np-content-type-message="Formato de arquivo inválido." np-disabled="" np-optional="false" inep-validator="c.validarArquivo($index)" np-content-types="c.contentTypes" np-empty-message="{{c.mensagens.MSG_ARQUIVO_VAZIO}}"></inep-input-file><div ng-if="c.isFileValid($index) &amp;&amp; !c.cid[$index].send" class="col-md-4"><button id="enviar_laudo_{{a.codigo}}" ng-click="c.enviarArquivo($index)" class="btn btn-default align-button-upload">Enviar laudo</button></div></div><div ng-show="!!a.laudoDeferido" class="col-md-12"><span class="text-justify">Você possui documento aprovado em edições anteriores, desta forma, não será necessário o envio de um novo documento.</span></div><div ng-if="c.cid[$index].send" class="col-md-12"><inep-output-text id="mensagem_laudo_{{a.codigo}}" ng-model="c.msg.ARQUIVO_ENVIADO_COM_SUCESSO"></inep-output-text></div><div ng-if="c.cid[$index].send &amp;&amp; !a.laudoDeferido" class="col-md-4"><button id="visualizar_laudo_{{a.codigo}}" style="margin-right:15px" ng-click="c.visualizarArquivo($index)" class="btn btn-default align-button-upload">Visualizar</button><button id="excluir_laudo_{{a.codigo}}" ng-click="c.excluirArquivo($index)" class="btn btn-default align-button-upload">Excluir laudo</button></div></enem-fieldset></div></div></div>'),
a.put("views/inscricao/wizard/atendimentoRecursos/atendimentoEspecifico.html",'<div tabindex="0"><div class="text-center text-primary"><label>Os campos com <i alt="asterisco" class="fa fa-asterisk"><span class="hidden-accessibility">asterisco</span></i> são de preenchimento obrigatório</label></div><div class="row with-space-bottom"></div></div><div class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Atendimento espec&iacute;fico</h2></div><div class="panel-body"><div class="row"><inep-radiobutton np-id="radioEspecifico" np-label="Você precisa de algum atendimento específico para fazer a prova?" np-values="c.comboSimNao()" np-selected-value="c.precisaEspecifico" np-inline="true" np-optional="false" np-on-change="c.precisaEspecificoChanged()" np-accessibility-message="{{ c.mensagens.MSGA036 }}"></inep-radiobutton></div><div class="box-describe"><span class="boldText"> Atendimento específico:</span><span class="text-justify"> {{ c.msg.ATENDIMENTO_ESPECIFICO_AVISO }}</span></div><div ng-if="c.precisaAtendimento()" class="row"><enem-checkbox np-id="checkEspecifico" np-promise="c.especificoPromise" np-optional="false" np-callback="c.especificoCallback" np-label="Indique o(s) motivo(s) para o atendimento específico:" np-pessoa-fisica="c.pessoaFisica"></enem-checkbox></div></div></div><div ng-if="c.exibeRecursos()" class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Recursos</h2></div><div class="panel-body"><div ng-if="c.exibeRecursos()" class="row with-space-bottom"><div class="col-md-12"><div class="row"><enem-checkbox np-id="checkRecursos" np-promise="c.recursoEspecificoPromise" np-callback="c.recursoEspecificoCallback" np-optional="false" np-label="Você precisa de algum auxílio/recurso de acessibilidade: Indique o auxílio ou recurso de acessibilidade: De acordo com sua necessidade, pode ser selecionada mais de uma opção." np-vinculo-checkbox="c.especificoCallback" np-accessibility-message="{{ c.mensagens.MSGA037 }}"></enem-checkbox></div></div></div></div></div><div ng-if="c.exibeCidDocumentacao()" class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">CID</h2></div><div class="panel-body"><div ng-if="a.statusItem === c.constantes.MARCADO &amp;&amp; a.laudo &amp;&amp; !a.laudoDeferido &amp;&amp; a.cid" ng-repeat="a in c.especificoCallback track by a.codigo" class="row with-space-bottom"><enem-fieldset><div class="col-md-12"><label>{{ a.descricao }}</label></div><inep-input-text ng-if="(a.laudo &amp;&amp; !a.laudoDeferido &amp;&amp; a.cid)" np-id="cid_{{a.codigo}}" np-label="CID" ng-model="c.cid[$index].codigo" np-size="2" np-optional="false" np-maxlength="7" inep-validator="c.validarCid($index)" to-upper-case="to-upper-case" np-on-change="c.consultarCid($index)" np-placeholder="Informe o CID aqui"></inep-input-text><span ng-if="(a.laudo &amp;&amp; !a.laudoDeferido)" class="col-md-12"><b>Descri&ccedil;&atilde;o:</b> {{c.cid[$index].descricao}}</span></enem-fieldset></div></div></div>'),a.put("views/inscricao/wizard/atendimentoRecursos/confirmacao.html",'<div class="row"><div class="col-md-4"></div><enem-fieldset><div tabindex="0" focus-me="focus-me" class="msg-inscricao-aviso">Verifique se as informa&ccedil;&otilde;es abaixo est&atilde;o corretas  e continue sua inscri&ccedil;&atilde;o</div></enem-fieldset></div><div class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Dados pessoais</h2></div><div class="panel-body"><div class="row"><div class="col-md-3"><b>CPF:&nbsp;</b><inep-output-text np-id="cpfFormatado" ng-model="c.informacoesPessoais.cpf" np-mask="999.999.999-99" np-empty-value="{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}"></inep-output-text></div><div class="col-md-6"><b>Nome completo:&nbsp;</b><inep-output-text np-id="nome" ng-model="c.informacoesPessoais.nome" np-empty-value="{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}"></inep-output-text></div><div class="col-md-3"><b>Data de nascimento:&nbsp;</b><inep-output-text np-id="dataNascimento" ng-model="c.informacoesPessoais.dataDeNascimentoFormatada" np-empty-value="{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}"></inep-output-text></div></div><div class="row"><div class="col-md-6"><b>Nome completo da m&atilde;e:&nbsp;</b><inep-output-text np-id="nomeMae" ng-model="c.informacoesPessoais.nomeDaMae" np-empty-value="{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}"></inep-output-text></div><div class="col-md-6"><b>Nome completo do pai:&nbsp;</b><inep-output-text np-id="nomePai" ng-model="c.informacoesPessoais.nomeDoPai" np-empty-value="{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}"></inep-output-text></div></div><div class="row"><div class="col-md-3"><b>Sexo:&nbsp;</b><inep-output-selection np-id="sexo" ng-model="c.informacoesPessoais.sexo" np-values="c.sexos" np-empty-value="{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}"></inep-output-selection></div><div class="col-md-3"><b>Cor ou Ra&ccedil;a:&nbsp;</b><inep-output-selection np-id="nomeEtnia" ng-model="c.informacoesPessoais.etnia" np-values="c.etnias" np-empty-value="{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}"></inep-output-selection></div></div><div class="row"><div class="col-md-3"><b>Estado civil:&nbsp;</b><inep-output-selection np-id="nomeEstadoCivil" ng-model="c.informacoesPessoais.estadoCivil" np-values="c.estadosCivis" np-empty-value="{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}"></inep-output-selection></div><div class="col-md-6"><b>Nacionalidade:&nbsp;</b><inep-output-selection np-id="nacionalidade" ng-model="c.informacoesPessoais.nacionalidade" np-values="c.nacionalidades" np-empty-value="{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}"></inep-output-selection></div></div><div class="row"><div ng-if="c.informacoesPessoais.nacionalidade === 1"><div class="col-md-3"><b>UF de nascimento:&nbsp;<inep-output-selection np-id="nomeUfNascimento" ng-model="c.informacoesPessoais.nascimentoUf" np-values="c.ufs" np-empty-value="{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}"></inep-output-selection></b></div><div class="col-md-3"><b>Munic&iacute;pio de nascimento:&nbsp;</b><inep-output-selection np-id="nomeMunicipioNascimento" ng-model="c.informacoesPessoais.nascimentoMunicipio" np-values="c.municipios" np-empty-value="{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}"></inep-output-selection></div></div></div></div></div><div class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Endere&ccedil;o</h2></div><div class="panel-body"><div class="row"><div class="col-md-12"><b>CEP:&nbsp;</b><inep-output-text np-id="cepFormatado" ng-model="c.informacoesPessoais.residencia.cep" np-mask="99.999-999" np-empty-value="{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}"></inep-output-text></div></div><div class="row"><div class="col-md-5"><b>Endere&ccedil;o:&nbsp;</b><inep-output-text np-id="logradouro" ng-model="c.informacoesPessoais.residencia.logradouro" np-empty-value="{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}"></inep-output-text></div><div class="col-md-3"><b>N&uacute;mero:&nbsp;</b><inep-output-text np-id="numeroEndereco" ng-model="c.informacoesPessoais.residencia.numero" np-empty-value="{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}"></inep-output-text></div><div class="col-md-4"><b>Complemento:&nbsp;</b><inep-output-text np-id="complemento" ng-model="c.informacoesPessoais.residencia.complemento" np-empty-value="{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}" style="word-wrap: break-word;"></inep-output-text></div></div><div class="row"><div class="col-md-5"><b>Bairro:&nbsp;</b><inep-output-text np-id="bairro" ng-model="c.informacoesPessoais.residencia.bairro" np-empty-value="{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}"></inep-output-text></div><div class="col-md-3"><b>UF:&nbsp;</b><inep-output-text np-id="nomeUfEndereco" ng-model="c.informacoesPessoais.residencia.uf" np-empty-value="{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}"></inep-output-text></div><div class="col-md-4"><b>Munic&iacute;pio:&nbsp;</b><inep-output-text np-id="nomeMunicipioEndereco" ng-model="c.informacoesPessoais.residencia.municipio" np-empty-value="{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}"></inep-output-text></div></div></div></div><div class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Atendimento especializado</h2></div><div class="panel-body"><div class="row"><div class="col-md-12"><b>Você precisa de algum recurso de acessibilidade para fazer a prova?</b><inep-output-text np-id="possuiEspecializado" ng-model="c.possuiEspecializadoValue" np-empty-Value="{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}"></inep-output-text></div></div><div ng-if="c.possuiEspecializado()" class="row with-space-bottom"><div class="col-md-12"><ul><li ng-if="a.statusItem === c.constantes.MARCADO" ng-repeat="a in c.especializados"><label style="font-weight: normal;">{{ a.descricao }}</label><div ng-if="!!a.informacao" class="box-describe">{{ a.informacao }}</div><div ng-if="!!a.cid" class="with-space-bottom"><b>{{ a.cid }}</b></div><div ng-if="a.statusItem === c.constantes.MARCADO &amp;&amp; a.dependencia.regras.indexOf(&quot;RNE005&quot;) &gt; -1"><enem-regra005 ng-model="a" np-disabled="true" np-optional="true"></enem-regra005></div></li></ul></div></div><div ng-if="c.possuiEspecializado()" class="row"><div class="col-sm-12"><p><b>Aux&iacute;lio que necessitar&aacute; para realiza&ccedil;&atilde;o da prova:</b></p></div><div class="col-sm-12"><ul><li ng-if="r.statusItemAdicional !== c.constantes.OCULTO" ng-repeat="r in c.recursosEspecializados">{{ r.descricao }}<b ng-if="r.codigo !== 30" class="{{ c.verificarCorCampoInformado(r.statusItem) }}">: {{ c.opcaoSimNao(r.statusItem) }}</b><div ng-if="r.informacao != null &amp;&amp; r.statusItem === c.constantes.MARCADO" class="box-describe">{{ r.informacao }}</div></li></ul></div></div></div></div><!--.panel.panel-info--><!--  .panel-heading: h2.h4.panel-title.text-left.text-primary Atendimento espec&iacute;fico--><!--  .panel-body--><!--    .row: .col-md-12--><!--      b Possui necessidade de atendimento específico:&nbsp;--><!--      inep-output-text(np-id=\'possuiAtendEspec\',--><!--      ng-model=\'c.possuiEspecificoValue\',--><!--      np-empty-value=\'{{ c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO }}\')--><!----><!--    .row.with-space-bottom(ng-if=\'c.possuiEspecifico\'): .col-md-12--><!--      ul--><!--        li(ng-if=\'a.statusItem === c.constantes.MARCADO\', ng-repeat=\'a in c.especificos\')--><!--          label(style=\'font-weight: normal;\')--><!--            | {{ a.descricao }}--><!--          div(class=\'box-describe\', ng-if=\'!!a.informacao\') {{ a.informacao }}--><!--          div.with-space-bottom(ng-if=\'!!a.cid\'): b {{ a.cid }}--><!--          div(ng-if=\'a.statusItem === c.constantes.MARCADO && a.dependencia.regras.indexOf("RNE005") > -1\')--><!--            enem-regra005(ng-model=\'a\', np-disabled=\'true\', np-optional=\'true\')--><!----><!--    .row(ng-if=\'c.possuiRecursoEspecifico\')--><!--      .col-sm-12: p: b Aux&iacute;lio que necessitar&aacute; para realiza&ccedil;&atilde;o da prova:--><!--      .col-sm-12: ul--><!--        li(ng-if=\'r.statusItemAdicional !== c.constantes.OCULTO\', ng-repeat=\'r in c.recursosEspecificos\') {{ r.descricao }}--><!--          b(ng-if=\'r.codigo !== 30\', class=\'{{ c.verificarCorCampoInformado(r.statusItem) }}\') : {{ c.opcaoSimNao(r.statusItem) }}--><!--          div(ng-if=\'r.informacao != null && r.statusItem === c.constantes.MARCADO\', class=\'box-describe\') {{ r.informacao }}-->\n'),a.put("views/inscricao/wizard/atendimentoRecursos/recurso.html",'<div tabindex="0"><div class="text-center text-primary"><label>Os campos com <i alt="asterisco" class="fa fa-asterisk"><span class="hidden-accessibility">asterisco</span></i> são de preenchimento obrigatório</label></div><div class="row with-space-bottom"></div></div><div class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Recursos</h2></div><div class="panel-body"><div ng-if="c.exibeRecursos()" class="row with-space-bottom"><div class="col-md-12"><div class="row"><enem-checkbox np-id="checkRecursos" np-promise="c.recursoEspecializadoPromise" np-callback="c.recursoEspecializadoCallback" np-optional="false" np-label="Indique o auxílio/recurso de acessibilidade: De acordo com sua necessidade, pode ser selecionada mais de uma opção." np-vinculo-checkbox="c.especializadoCallback" np-accessibility-message="{{ c.mensagens.MSGA037 }}"></enem-checkbox></div><div class="row"><enem-fieldset><inep-boolean-checkbox np-id="declaroRecurso" np-value="c.declaroRecurso.text" np-selected-value="c.declaroRecurso.value" np-optional="false" np-required-message="{{ c.mensagens.MSGOD04 }}"></inep-boolean-checkbox></enem-fieldset></div></div></div></div></div><div ng-if="c.exibeCidDocumentacao()" class="panel panel-info"><div class="panel-heading"><h2 class="h4 panel-title text-left text-primary">Documenta&ccedil;&atilde;o comprobat&oacute;ria</h2></div><div class="panel-body"><div class="row"><div class="col-md-12"><label>Insira o documento que comprove sua solicitação.</label></div></div><div class="row"><enem-fieldset><span class="text-justify">1º Clique em "Escolher arquivo";<br></span><span class="text-justify">2º Selecione o documento;<br></span><span class="text-justify">3º Clique em "Enviar". <br><br></span><span class="attention-label">Atenção:</span><span class="boldText">{{c.msg.TIPO_ARQUIVO }}</span></enem-fieldset></div><div class="row"><enem-fieldset><span class="text-justify"> Participante, <br></span><span class="text-justify"> {{ c.msg.LAUDO_DEFERIMENTO }}</span></enem-fieldset></div><div ng-if="a.statusItem === c.constantes.MARCADO &amp;&amp; ((a.laudo || a.laudoTempoAdicional || c.inAparelhoGlicemia))" ng-repeat="a in c.especializadoCallback track by a.codigo" class="row with-space-bottom"><enem-fieldset><div class="col-md-12"><label>{{ a.descricao }}</label></div><div ng-show="!a.laudoDeferido" class="col-md-12"><inep-input-file ng-if="((a.laudo || a.laudoTempoAdicional) &amp;&amp; !a.laudoDeferido) &amp;&amp; !c.cid[$index].send" np-id="laudo_{{a.codigo}}" np-label="Laudo" np-value="c.cid[$index].file" np-max-file-size="c.maxFileSize" np-show-icon="true" np-size="6" np-max-file-message="Tamanho de arquivo inválido." np-content-type-message="Formato de arquivo inválido." np-disabled="" np-optional="false" inep-validator="c.validarArquivo($index)" np-content-types="c.contentTypes" np-empty-message="{{c.mensagens.MSG_ARQUIVO_VAZIO}}"></inep-input-file><div ng-if="c.isFileValid($index) &amp;&amp; !c.cid[$index].send" class="col-md-4"><button id="enviar_laudo_{{a.codigo}}" ng-click="c.enviarArquivo($index)" class="btn btn-default align-button-upload">Enviar laudo</button></div></div><div ng-show="!!a.laudoDeferido" class="col-md-12"><span class="text-justify">Seu documento comprobat&oacute;rio de solicita&ccedil;&atilde;o de atendimento especializado foi o mesmo de 2019, como seu documento est&aacute; aprovado voc&ecirc; n&atilde;o precisa inserir nova documenta&ccedil;&atilde;o.</span></div><div ng-if="c.cid[$index].send" class="col-md-12"><inep-output-text id="mensagem_laudo_{{a.codigo}}" ng-model="c.msg.ARQUIVO_ENVIADO_COM_SUCESSO"></inep-output-text></div><div ng-if="c.cid[$index].send" class="col-md-4"><button id="visualizar_laudo_{{a.codigo}}" style="margin-right:15px" ng-click="c.visualizarArquivo($index)" class="btn btn-default align-button-upload">Visualizar</button><button id="excluir_laudo_{{a.codigo}}" ng-click="c.excluirArquivo($index)" class="btn btn-default align-button-upload">Excluir laudo</button></div></enem-fieldset></div></div></div>'),a.put("views/inscricao/wizard/cartaoConfirmacao/cartaoConfirmacao_atendimentos.html",'<br/><div ng-if="c.possuiEspecializado() || c.possuiEspecifico" class="with-space-top"><legend><b>Atendimentos</b></legend><div class="row with-space-bottom col-md-12"><ul><li ng-if="c.possuiEspecializado" ng-repeat="a in c.especializados"><label style="font-weight: normal;">{{ a.descricao }}</label><div ng-if="!!a.informacaoCartao" class="box-describe"><b style="color: red">ATENÇÃO:</b>&#160;{{ a.informacaoCartao }}</div><div ng-if="!!a.informacaoCartao2" class="box-describe"><b style="color: red">ATENÇÃO:</b>&#160;{{ a.informacaoCartao2 }}</div></li><li ng-if="c.possuiEspecifico" ng-repeat="a in c.especificos"><label style="font-weight: normal;">{{ a.descricao }}</label><div ng-if="!!a.informacaoCartao" class="box-describe"><b style="color: red">ATENÇÃO:</b>{{ a.informacaoCartao }}</div></li></ul></div></div><div ng-if="c.possuiRecursoEspecializado || c.possuiRecursoEspecifico" class="with-space-top"><br/><legend><b>Recurso de acessibilidade</b></legend><div class="row col-sm-12"><ul><li ng-if="c.possuiRecursoEspecializado" ng-repeat="r in c.recursosEspecializadosMarcados">{{ r.descricao }}<div ng-if="!!r.informacaoCartao" class="box-describe">{{ r.informacaoCartao }}</div><div ng-if="!r.informacaoCartao &amp;&amp; !!r.informacao" class="box-describe">{{ r.informacao }}</div></li><li ng-if="c.possuiRecursoEspecifico" ng-repeat="r in c.recursosEspecificosMarcados">{{ r.descricao }}<div ng-if="!!r.informacaoCartao" class="box-describe">{{ r.informacaoCartao }}</div><div ng-if="!r.informacaoCartao &amp;&amp; !!r.informacao" class="box-describe">{{ r.informacao }}</div></li></ul></div></div>'),a.put("views/inscricao/wizard/cartaoConfirmacao/cartaoConfirmacao_dadosDeIdentificacao.html",'<div tabindex="0" class="with-space-top"><div ng-if="c.espelho.nomeSocialEspelhoDto &amp;&amp; c.espelho.nomeSocialEspelhoDto.nomeSocial" class="row"><div class="col-md-12"><b>Nome:&nbsp;</b><inep-output-text np-id="nome" ng-model="c.espelho.nomeSocialEspelhoDto.nomeSocial" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div class="row"><div class="col-md-12"><b ng-if="c.espelho.nomeSocialEspelhoDto &amp;&amp; c.espelho.nomeSocialEspelhoDto.nomeSocial">Nome civil:&nbsp;</b><b ng-if="!c.espelho.nomeSocialEspelhoDto">Nome:&nbsp;</b><inep-output-text np-id="nome" ng-model="c.espelho.nome" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div class="row"><div class="col-md-12"><b>N&uacute;mero de inscri&ccedil;&atilde;o:&nbsp;</b><inep-output-text np-id="numInscricao" ng-model="c.espelho.numeroInscricao" np-empty-Value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div class="row"><div class="col-md-12"><b>CPF:&nbsp;</b><inep-output-text np-id="cpfFormatado" ng-model="c.espelho.cpf" np-mask="999.999.999-99" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div><div class="row"><div class="col-md-12"><b>Data de nascimento:&nbsp;</b><inep-output-text np-id="dataNascimento" ng-model="c.espelho.dataNascimento" np-empty-value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text></div></div></div>'),a.put("views/inscricao/wizard/cartaoConfirmacao/cartaoConfirmacao_identificacaoProva.html",'<div class="with-space-top"><div class="row with-space-bottom col-md-12"><div><p>Dia da aplicação da prova: <label class="texto-azul">{{c.cartaoConfirmacao.diaProva}}/{{c.cartaoConfirmacao.mesProva}}/{{c.cartaoConfirmacao.anoProva}}</label></p><p>Nível Certificação: <label class="texto-azul">{{c.nivelCertificacao.nivel}}</label></p><!--b Data da prova: {{c.cartaoConfirmacao.diaProva}} de {{c.cartaoConfirmacao.mesProva}} de {{c.cartaoConfirmacao.anoProva}} | HOR&AacuteRIO DE BRAS&IacuteLIA/DF--><!--table.tabela.justificado(style=\'border: 1px solid;cellpadding: 2px; border-radius: 5px; width: 260px;\')--><!--    tr--><!--      td.header.centro(style=\'border: 1px; solid;cellpadding: 2px;text-align: center;font-weight: bold;\')--><!--        | Dia da Prova--><!--      td.header.centro(style=\'border: 1px solid;cellpadding: 2px;text-align: center;font-weight: bold;\')--><!--        | Nível Certificação--><!--    tr--><!--      td.header.centro(style=\'border: 1px solid;cellpadding: 2px;text-align: center;\')--><!--        label.texto-azul {{c.cartaoConfirmacao.diaProva}}/{{c.cartaoConfirmacao.mesProva}}/{{c.cartaoConfirmacao.anoProva}}--><!--        //label.texto-azul 28/08/2022--><!--      td.header.centro(style=\'border: 1px solid;cellspacing: 2px;text-align: center;\')--><!--        label.texto-azul {{c.nivelCertificacao.nivel}}--><!--        //label.texto-azul Nível Fundamental--><!--br     --></div><p ng-if="!!c.cartaoConfirmacao.ensalamentosMatutino &amp;&amp; c.cartaoConfirmacao.ensalamentosMatutino.length &gt; 0">Provas:</p><div ng-repeat="a in c.cartaoConfirmacao.ensalamentosMatutino"><inep-output-text ng-model="a.prova" np-empty-Value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text><br/></div><div ng-if="!!c.cartaoConfirmacao.ensalamentosMatutino &amp;&amp; c.cartaoConfirmacao.ensalamentosMatutino.length &gt; 0"><div><!--b Per&iacute;odo Manh&atilde - Abertura dos port&otildees: 08h00 - Fechamento dos port&otildees: 8h45 - In&iacutecio das provas: 09h00--><table style="border: 1px solid;cellpadding: 2px; border-radius: 5px; width: 500px;" class="tabela justificado"><tr><td style="border: 1px; solid;cellpadding: 2px;text-align: center;width: 80px;font-weight: bold;" class="header centro">Período</td><td style="border: 1px solid;cellpadding: 2px;text-align: center;font-weight: bold;" class="header centro">Abertura dos Portões</td><td style="border: 1px solid;cellpadding: 2px;text-align: center;font-weight: bold;" class="header centro">Fechamento dos Portões  </td><td style="border: 1px solid;cellpadding: 2px;text-align: center;font-weight: bold;" class="header centro">Início das Provas</td><td style="border: 1px solid;cellpadding: 2px;text-align: center;font-weight: bold;" class="header centro">Fim das Provas  </td></tr><tr><td style="border: 1px solid;cellpadding: 2px;text-align: center;width: 80px;" class="header centro"><!--label.texto-azul {{c.cartaoConfirmacao.diaProva}}/{{c.cartaoConfirmacao.mesProva}}/{{c.cartaoConfirmacao.anoProva}}--><label class="texto-azul">Manhã</label></td><td style="border: 1px solid;cellspacing: 2px;text-align: center;" class="header centro"><label class="texto-azul">8h</label></td><td style="border: 1px solid;cellspacing: 2px;text-align: center;" class="header centro"><label class="texto-azul">8h45</label></td><td style="border: 1px solid;cellspacing: 2px;text-align: center;" class="header centro"><label class="texto-azul">9h</label></td><td style="border: 1px solid;cellspacing: 2px;text-align: center;" class="header centro"><label class="texto-azul">13h</label></td></tr></table><div></div><!--b {{c.ensalamentoManha.bloco}} - {{c.ensalamentoManha.andar ? c.ensalamentoManha.andar + \' -\' : \'\'}} {{c.ensalamentoManha.sala}}--></div><br/></div><p ng-if="!!c.cartaoConfirmacao.ensalamentosVespertino &amp;&amp; c.cartaoConfirmacao.ensalamentosVespertino.length &gt; 0">Provas:</p><div ng-repeat="a in c.cartaoConfirmacao.ensalamentosVespertino"><inep-output-text ng-model="a.prova" np-empty-Value="{{c.constantes.INSCRICAO.TEXTO_NAO_INFORMADO}}"></inep-output-text><br/></div><div ng-if="!!c.cartaoConfirmacao.ensalamentosVespertino &amp;&amp; c.cartaoConfirmacao.ensalamentosVespertino.length &gt; 0"><div><!--b Per&iacute;odo Tarde - Abertura dos port&otildees: 14h30 - Fechamento dos port&otildees: 15h15 – In&iacutecio das provas: 15h30min--><!--b Per&iacute;odo Tarde - Abertura dos port&otildees: 14h00 - Fechamento dos port&otildees: 14h45 – In&iacutecio das provas: 15h00--><table style="border: 1px solid;cellpadding: 2px; border-radius: 5px; width: 500px;" class="tabela justificado"><tr><td style="border: 1px solid;cellpadding: 2px;text-align: center;width: 80px;font-weight: bold;" class="header centro">Período</td><td style="border: 1px solid;cellpadding: 2px;text-align: center;font-weight: bold;" class="header centro">Abertura dos Portões</td><td style="border: 1px solid;cellpadding: 2px;text-align: center;font-weight: bold;" class="header centro">Fechamento dos Portões  </td><td style="border: 1px solid;cellpadding: 2px;text-align: center;font-weight: bold;" class="header centro">Início das Provas</td><td style="border: 1px solid;cellpadding: 2px;text-align: center;font-weight: bold;" class="header centro">Fim das Provas  </td></tr><tr><td style="border: 1px solid;cellpadding: 2px;text-align: center;width: 80px;" class="header centro"><!--label.texto-azul {{c.cartaoConfirmacao.diaProva}}/{{c.cartaoConfirmacao.mesProva}}/{{c.cartaoConfirmacao.anoProva}}--><label class="texto-azul">Tarde</label></td><td style="border: 1px solid;cellspacing: 2px;text-align: center;" class="header centro"><label class="texto-azul">14h30</label></td><td style="border: 1px solid;cellspacing: 2px;text-align: center;" class="header centro"><label class="texto-azul">15h15</label></td><td style="border: 1px solid;cellspacing: 2px;text-align: center;" class="header centro"><label class="texto-azul">15h30</label></td><td style="border: 1px solid;cellspacing: 2px;text-align: center;" class="header centro"><label class="texto-azul">20h30</label></td></tr></table><div></div><!--b {{c.ensalamentoTarde.bloco}} - {{c.ensalamentoTarde.andar ? c.ensalamentoTarde.andar + \' -\' : \'\'}} {{c.ensalamentoTarde.sala}}--></div></div><br/><p>*Os hor&aacute;rios abaixo se referem ao hor&aacute;rio de Bras&iacute;lia/DF        </p></div></div>'),a.put("views/inscricao/wizard/cartaoConfirmacao/cartaoConfirmacao_instrucoes.html",'<div tabindex="0" class="with-space-top"><!--.row.col-sm-12: ul--><!--  li--><!--    | Conhecer o local de suas provas com antecedência.--><!--.row--><!--  .col-md-12--><!--    p.text-justify--><div class="row col-sm-12"><ul><li> Comparecer ao local de realização da prova, com antecedência de, no mínimo, 1 (uma) hora do horário fixado para o início da aplicação.</li></ul></div><div class="row col-sm-12"><ul><li>Responder as provas com caneta preta, fabricada em material transparente.</li></ul></div><div class="row col-sm-12"><ul><li> Levar para identificação, no dia do Exame, documento oficial original com foto. Consideram-se documentos válidos para a identificação:<div class="row col-sm-12"><ul><li class="with-space-top">Do participante brasileiro:<p class="text-justify with-space-left with-space-top">a) Cédulas de Identidade expedidas por Secretarias de Segurança Pública, Forças Armadas, Polícia Militar e Polícia Federal;</p><p class="text-justify with-space-left">b) Identificação fornecida por ordens ou conselhos de classes que, por lei, tenha validade como documento de identidade;</p><p class="text-justify with-space-left">c) Passaporte;</p><p class="text-justify with-space-left">d) Carteira Nacional de Habilitação, na forma da Lei nº 9.503, de 23 de setembro de 1997;</p><p class="text-justify with-space-left">e) Carteira de Trabalho e Previdência Social impressa e expedida após 27 de janeiro de 1997;</p><p class="text-justify with-space-left">f) Documentos digitais com foto (e-Título, CNH digital, RG digital e CIN digital) apresentados nos respectivos aplicativos oficiais ou no aplicativo Gov.br.</p></li><li class="with-space-top">Do participante estrangeiro:<p class="text-justify with-space-left with-space-top">a) Passaporte;</p><p class="text-justify with-space-left">b) Identidade expedida pelo Ministério da Justiça para estrangeiros, inclusive aqueles reconhecidos como refugiados, em consonância com a Lei nº 9.474, de 22 de julho de 1997;</p><p class="text-justify with-space-left">c) Carteira de Registro Nacional Migratório, de que trata a Portaria nº 11.264, de 24 de janeiro de 2020;</p><p class="text-justify with-space-left">d) Documento Provisório de Registro Nacional Migratório, de que trata a Portaria nº 11.264, de 24 de janeiro de 2020;</p><p class="text-justify with-space-left">e) Cédula de identidade civil ou documento estrangeiro equivalente, emitido por Estado parte ou associado ao Mercosul, nos termos do Acordo sobre Documentos de Viagem dos Estados Partes do Mercosul e Estados Associados.</p><p class="text-justify with-space-left">f) Documentos digitais com foto (Carteira de Registro Nacional Migratório [CRNM] e Documento Provisório de Registro Nacional [DPRNM]) apresentados no aplicativo Carteira Digital do Migrante.</p></li></ul></div></li></ul></div><div class="row col-sm-12"><ul><li>Realizar a impressão da Declaração Comparecimento e apresentá-la ao chefe de sala, antes de entrar na sala de provas, por turno, se precisar.</li></ul></div><div class="row col-sm-12"><ul><li>Não usar óculos escuros e artigos de chapelaria, tais como: boné, véu, quipá, chapéu, viseira, gorro e similares no dia de prova.</li></ul></div><div class="row col-sm-12"><ul><li>Não utilizar no dia de provas lápis, caneta de material não transparente, lapiseira, borrachas,\ncorretivos, livros, manuais, impressos, anotações, protetor auricular e quaisquer dispositivos\neletrônicos, tais como: garrafa/copo digital, cigarro eletrônico,  wearable tech, máquinas\ncalculadoras, agendas eletrônicas ou similares, telefones celulares, smartphones, tablets,\nIpods®, pen drives, mp3 ou similar, gravadores, relógios, alarmes de qualquer espécie, chaves\ncom alarme ou com qualquer outro componente eletrônico, fones de ouvido ou qualquer transmissor,\ngravador ou receptor de dados, imagens, vídeos e mensagens e quaisquer outros materiais estranhos\nà realização da prova.</li></ul></div><div class="row col-sm-12"><ul><li>Manter aparelhos eletrônicos como celular, tablet, pulseiras e relógios inteligentes com todos os aplicativos,\nfunções e sistemas desativados e desligados, incluindo alarmes, no envelope porta-objetos.</li></ul></div><!--.row.col-sm-12: ul--><!--  li--><!--    | Leve sua garrafinha de água para evitar o uso do bebedouro.--><!--.row.col-sm-12: ul--><!--  li--><!--    | Você pode levar seu próprio álcool em gel para higienização de suas mãos durante a aplicação das provas.--><!--.row.col-sm-12: ul--><!--  li--><!--    | O local de provas foi higienizado e os procedimentos de aplicação adaptados para sua segurança na realização do Encceja.--><div class="row"><div class="col-md-12 text-center"><figure><img src="images/contato.png" style="margin-left: 4%;"/></figure></div></div></div>'),a.put("views/inscricao/wizard/cartaoConfirmacao/cartaoConfirmacao_localProva.html",'<div class="row col-md-12 with-space-top"><b>Nome do local de provas:&nbsp;</b><b style="color: #0e377d">{{c.cartaoConfirmacao.localDeProva}}</b><br/><b>Endereço do local de provas:&nbsp;</b><b ng-if="!!c.ensalamentoManha &amp;&amp; !!c.ensalamentoTarde" style="color: #0e377d">{{c.cartaoConfirmacao.enderecoProva}}/{{c.ensalamentoManha.bloco}} - {{c.ensalamentoManha.andar}}</b><b ng-if="!!c.ensalamentoManha &amp;&amp; !c.ensalamentoTarde" style="color: #0e377d">{{c.cartaoConfirmacao.enderecoProva}}/{{c.ensalamentoManha.bloco}} - {{c.ensalamentoManha.andar}}</b><b ng-if="!c.ensalamentoManha &amp;&amp; !!c.ensalamentoTarde" style="color: #0e377d">{{c.cartaoConfirmacao.enderecoProva}}/{{c.ensalamentoTarde.bloco}} - {{c.ensalamentoTarde.andar}}</b><br/><b>Município/UF:&nbsp;</b><b style="color: #0e377d">{{c.cartaoConfirmacao.municipioUfProva}}</b><br/><b>Sala de provas:&nbsp;</b><b ng-if="!!c.ensalamentoManha &amp;&amp; !!c.ensalamentoTarde" style="color: #0e377d">{{c.ensalamentoManha.sala}}</b><b ng-if="!!c.ensalamentoManha &amp;&amp; !c.ensalamentoTarde" style="color: #0e377d">{{c.ensalamentoManha.sala}}</b><b ng-if="!c.ensalamentoManha &amp;&amp; !!c.ensalamentoTarde" style="color: #0e377d">{{c.ensalamentoTarde.sala}}</b></div>'),a.put("views/inscricao/wizard/cartaoConfirmacao/cartaoConfirmacao_nivelCertificacao.html",'<div class="row col-md-12 with-space-top"><b>Nível Certificação:&nbsp;</b><inep-output-text np-id="nivel" ng-model="c.niv