tArea.$dirty || $parent.submitted) && formTextArea.textArea.$error.pattern" role="alert">\n    <i class="fa fa-times-circle-o"></i>\n    {{npPatternMessage}}\n  </label>\n  <label class="control-label" for="textarea_{{npId}}" id="{{npId}}_minlength" ng-if="(formTextArea.textArea.$dirty || $parent.submitted) && formTextArea.textArea.$error.minlength" role="alert">\n    <i class="fa fa-times-circle-o"></i>\n    {{npMinlengthMessage}}\n  </label>\n  <label class="control-label" for="textarea_{{npId}}" id="{{npId}}_validator" ng-if="npValidatorMessage && showValidatorMessage()" role="alert">\n    <i class="fa fa-times-circle-o"></i>\n    {{npValidatorMessage}}\n  </label>\n  <label class="control-label" for="textarea_{{npId}}" ng-if="apresentarErroConfirmacao()" role="alert">\n      <i class="fa fa-times-circle-o"></i>\n      {{npConfirmMessage}}\n  </label>\n</div>\n'),a.put("visualcaptcha/inepVisualCaptchaTemplate.html",'<div ng-form="formCaptcha" class="text-left form-group col-md-12" ng-class="{\'has-error\' : apresentarErroRequired()}">\n  <div ng-controller="InepVisualCaptchaController">\n    <div captcha options="captchaOptions" id="inep-captcha" ng-click="captchaValidate()"></div>\n    <label class="control-label" for="inep-captcha" id="inep-captcha_required" ng-if="apresentarErroRequired()" role="alert">\n      <i class="fa fa-times-circle-o"></i>\n      {{npRequiredMessage}}\n    </label>\n  </div>\n</div>\n'),a.put("views/informaObrigatoriedade.html",'<div tabindex="0"><div class="text-center text-primary"><label>Os campos com <i alt="asterisco" class="fa fa-asterisk"><span class="hidden-accessibility">asterisco</span></i> são de preenchimento obrigatório</label></div><div class="row with-space-bottom"></div></div>'),a.put("views/inicial.html",'<header role="banner"><h1 class="hide"> - </h1><nav role="navigation" aria-labelledby="#nav" ng-controller="NavigationBarController" class="navbar navbar-default navbar-fixed-top"><h2 id="nav" class="hide">Navegação Principal</h2><div class="container-fluid"><div class="navbar-header text-center"><button type="button" data-toggle="offcanvas" class="navbar-toggle collapsed left"><span class="sr-only">Toggle navigation</span><span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span></button><div aria-label="Bem vindo ao INEP" class="navbar-brand"><img src="images/logo_inep.svg" alt="Instituto Nacional de Estudos e Pesquisas Educacionais Anísio Teixeira"></div><button type="button" data-toggle="collapse" data-target="#navbar-collapse" class="navbar-toggle collapsed right p-n"><span class="sr-only">Toggle navigation</span><i class="fa fa-gear text-white"></i></button></div><script type="text/ng-template" id="warning-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Você ainda está aí?</h3></div><div idle-countdown="countdown" class="modal-body"><uib-progressbar max="30" value="countdown" animate="true" class="progress-striped active"></uib-progressbar>Sua sessão será encerrada em {{countdown}} segundos.</div></div></script><script type="text/ng-template" id="timedout-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Sess&atilde;o encerrada.</h3></div><div class="modal-body"><p></p>Sua sess&atilde;o foi encerrada por inatividade.</div></div></script></div></nav></header><main role="main"><section class="login"><h1 class="hide">Painel de entrada</h1><div class="container-fluid"><article><header class="text-center m-b"><div class="row"><div class="col-md-12 fundo-logo"><figure><img src="images/Logo-Encceja2026.png" alt="Exame Nacional para Certificação de Competências de Jovens e Adultos" tabindex="0" class="img-logo-enem"></figure></div></div></header></article></div><div ng-controller="PaginaInicialController as c" ng-init="c.init()" class="container"><div style="padding-bottom:3px" ng-if="c.inscricaoAberta.inscricaoEnabled" class="row"><div class="col-md-2"></div><div class="col-md-8"><button type="submit" ng-disabled="c.disableInscricao" data-ui-sref="primeiroAcesso" class="btn btn-tela-inicial btn-block">Inscri&ccedil;&atilde;o {{ c.getAnoEdicao() }}</button></div><div class="col-md-2"></div></div><div style="padding-bottom:3px" ng-if="c.menuJustificativaAusenciaVisivel.justificativaAusenciaEnabled" class="row"><div class="col-md-2"></div><div class="col-md-8"><button type="submit" data-ui-sref="primeiroAcessoJustificativa" class="btn btn-tela-inicial btn-block">Justificativa de Aus&ecirc;ncia</button></div><div class="col-md-2"></div></div><div style="padding-bottom:3px" class="row"><div class="col-md-2"></div><div class="col-md-8"><button type="submit" data-ui-sref="loginUnico" ng-if="(c.ignorarSenhaAtivo === 0)" class="btn btn-tela-inicial btn-block">Página do Participante</button><button type="submit" data-ui-sref="loginByPass" ng-if="(c.ignorarSenhaAtivo === 1)" class="btn btn-tela-inicial btn-block">Página do Participante</button></div><div class="col-md-2"></div></div><div style="padding-bottom:3px" ng-if="c.isPeriodoDeAutenticidade()" class="row"><div class="col-md-2"></div><div class="col-md-8"><button type="submit" data-ui-sref="loginAutenticidade" class="btn btn-tela-inicial btn-block">Autenticidade das Informações</button></div><div class="col-md-2"></div></div><div style="padding-bottom:3px" class="row"><div class="col-md-2"></div><div class="col-md-8"><button style="white-space:normal" ng-click="c.showOrientacoes = !c.showOrientacoes" class="btn btn-tela-inicial btn-block">Orienta&ccedil;&otilde;es para recupera&ccedil;&atilde;o de senha</button><div ng-if="c.showOrientacoes" class="panel panel-body"><style>table.tableEsqueciSenha{font-size:12pt;color:gray}table.tableEsqueciSenha td.numero{font-family:monospace;color:#0b4db0;font-size:13pt;font-weight:bolder;padding-right:20px;vertical-align:top}.esqueciSenha{color:#fff;background-color:#0b4883;border-radius:10px;padding:20px}.esqueciSenha h1{color:#fff}.esqueciSenha h2{color:#fff}.esqueciSenha h3{color:#fff}.esqueciSenha h4{color:#fff}.esqueciSenha .passo{background-color:#afc0ce;border-radius:5px;margin:12px 0;padding:12px;font-family:Verdana,"Helvetica Neue",Helvetica,Arial,sans-serif}</style><div ng-if="c.showOrientacoes" class="panel panel-body"><div style="padding-top:40px;padding-bottom:40px" class="col-md-12"><p style="font-size:18pt"><b>Orientações para recuperação de senha</b></p><table class="tableEsqueciSenha"><tr><td class="numero">1º</td><td>Acesse o sistema pelo endereço: https://sso.acesso.gov.br/login</td></tr><tr><td class="numero">2º</td><td>Informe seu CPF e clique na opção &quot;Próxima&quot;</td></tr><tr><td class="numero">3º</td><td>Em seguida selecione a opção &quot;Esqueci minha senha” e siga as instruções</td>das etapas seguintes para recadastrar sua nova senha.</tr></table></div></div></div></div></div></div></section></main>'),a.put("views/navegadores.html",'<header role="banner"><h1 class="hide"> - </h1><nav aria-labelledby="#nav" class="navbar navbar-default navbar-fixed-top"><h2 id="nav" class="hide">Navegação Principal</h2><div class="container-fluid"><div class="navbar-header text-center"><button type="button" data-toggle="offcanvas" class="navbar-toggle collapsed left"><span class="sr-only">Toggle navigation</span><span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span></button><div aria-label="Bem vindo ao INEP" class="navbar-brand"><img src="images/logo_inep.svg" alt="Instituto Nacional de Estudos e Pesquisas Educacionais Anísio Teixeira"></div><button type="button" data-toggle="collapse" data-target="#navbar-collapse" class="navbar-toggle collapsed right p-n"><span class="sr-only">Toggle navigation</span><i class="fa fa-gear text-white"></i></button></div></div></nav></header><main role="main"><section class="login"><div class="container-fluid"><article><header class="text-center m-b"><div class="row"><div class="col-md-12 fundo-logo"><figure><img src="images/Logo-Encceja2026.png" alt="Exame Nacional para Certificação de Competências de Jovens e Adultos" tabindex="0" focus-me="focus-me" class="img-logo-enem"></figure></div></div></header></article></div><div class="container-fluid"><div class="row"><div class="col-md-12"><div class="panel panel-info"><div class="panel-heading"><h2 tabindex="0" focus-me="focus-me" class="h4 panel-title text-center text-primary">Aviso\n</h2></div><div class="panel-body"><h2 class="h4 text-dark text-center"><p tabindex="0">Este navegador n&atilde;o &eacute; compat&iacute;vel. Utilize o Google Chrome ou Mozilla Firefox.</p></h2></div></div></div></div></div></section></main>'),a.put("views/orientacoesParaTrocaDeSenha.html",'<style>table.tableEsqueciSenha{font-size:12pt;color:gray}table.tableEsqueciSenha td.numero{font-family:monospace;color:#0b4db0;font-size:13pt;font-weight:bolder;padding-right:20px;vertical-align:top}.esqueciSenha{color:#fff;background-color:#0b4883;border-radius:10px;padding:20px}.esqueciSenha h1{color:#fff}.esqueciSenha h2{color:#fff}.esqueciSenha h3{color:#fff}.esqueciSenha h4{color:#fff}.esqueciSenha .passo{background-color:#afc0ce;border-radius:5px;margin:12px 0;padding:12px;font-family:Verdana,"Helvetica Neue",Helvetica,Arial,sans-serif}</style><div ng-if="c.showOrientacoes" class="panel panel-body"><div style="padding-top:40px;padding-bottom:40px" class="col-md-12"><p style="font-size:18pt"><b>Orientações para recuperação de senha</b></p><table class="tableEsqueciSenha"><tr><td class="numero">1º</td><td>Acesse o sistema pelo endereço: https://sso.acesso.gov.br/login</td></tr><tr><td class="numero">2º</td><td>Informe seu CPF e clique na opção &quot;Próxima&quot;</td></tr><tr><td class="numero">3º</td><td>Em seguida selecione a opção &quot;Esqueci minha senha” e siga as instruções</td>das etapas seguintes para recadastrar sua nova senha.</tr></table></div></div>'),a.put("views/orientacoesParticipante.html",'<style>table.tableEsqueciSenha{font-size:12pt;color:gray}li.numero{font-family:Arial;color:#0b4db0;font-size:13pt;font-weight:bolder;padding-right:20px;vertical-align:top}label.texto-azul{font-family:Arial;color:#0b4db0}p.texto-branco-bold{font-family:Arial;color:#fff;font-size:14px;width:190px;padding:20px;font-weight:700}p.texto-branco{font-family:Arial;color:#fff;font-size:14px;width:190px;padding:20px}a.button{text-decoration:none;color:#FFF;background-color:#044785;display:block;width:100%;display:inline-block;margin-bottom:0;font-weight:700;text-align:center;vertical-align:middle;cursor:pointer;background-image:none;border:1px solid transparent;white-space:nowrap;padding:6px 12px;font-size:13px;line-height:1.42857;border-radius:3px}</style><div ng-if="c.showOrientacoesGerais" class="panel panel-body"><a target="blank" href="http://download.inep.gov.br/educacao_basica/encceja/passo_a_passo/encceja2019_passo-a-passo.pdf"><figure><img src="images/botaoDownload.png" alt="Exame Nacional para Certificação de Competências de Jovens e Adultos" tabindex="0"></figure></a><p></p><div style="padding-top:40px;padding-bottom:40px;border-top:2px solid #d3d3d3" class="col-md-12"><p>O Encceja é um exame voluntário, gratuito e destinado a jovens e adultos que não tiveram oportunidade de concluir\nseus estudos na idade apropriada para cada nível de ensino: no mínimo, 15 (quinze) anos completos para o Ensino\nFundamental, e no mínimo 18 (dezoito) anos completos para o Ensino Médio. As provas do Encceja acontecerão no\ndia 29 de agosto de 2021. O período de inscrição será de 11 a 22 de janeiro de 2021.</p><p><label class="texto-azul">Para você se preparar, o Inep oferece material de estudo gratuito\npara o Ensino Fundamental e para o Ensino Médio.</label></p><div><div class="col-md-6"><a target="blank" href="http://portal.inep.gov.br/web/guest/educacao-basica/encceja/outros-documentos" class="button">Apostilas para estudantes e professores</a></div><div class="col-md-offset-2"></div><div class="col-md-6"><a target="blank" href="http://portal.inep.gov.br/web/guest/educacao-basica/encceja/provas-e-gabaritos" class="button">Provas do Encceja 2018</a></div></div><p style="font-size:18pt;padding-top:40px"><b>Acesse também os nossos canais de comunicação e fique por dentro de tudo!</b></p><p>No Portal do Inep você encontra todas as informações que precisa sobre o Exame.\nConstantemente, também atualizamos as nossas redes sociais:&nbsp;<a href="https://www.facebook.com/Inep.oficial/" style="font-family:Arial;color:#0b4db0;font-weight:700">Facebook</a>&nbsp;|&nbsp;<a href="https://instagram.com/inepcomunicacao" style="font-family:Arial;color:#0b4db0;font-weight:700">Instagram</a>&nbsp;|&nbsp;<a href="https://twitter.com/Inep_Imprensa" style="font-family:Arial;color:#0b4db0;font-weight:700">Twitter</a>&nbsp;para você ficar sempre bem informado.</p><p>Acesse e confira!</p><p style="font-size:18pt"><b>Certificação x Declaração de Parcial de Proficiência</b></p><p>Os resultados do Encceja permitem a emissão de dois documentos:</p><p></p><ul><li class="numero">Certificação de Conclusão de Ensino Fundamental ou do Ensino Médio:</li><p>Para o participante que conseguir a nota mínima exigida nas quatro provas objetivas e na redação.</p></ul><ul><li class="numero">Declaração Parcial de Proficiência:</li><p>Para o participante que conseguir a nota mínima exigida em uma das quatro provas, ou em mais de uma, mas não em todas elas.</p></ul><br><p><strong>Atenção:</strong></p><p>O Inep elabora, aplica e corrige as provas do Encceja, mas não emite certificado de conclusão ou declaração parcial de\nproficiência. Essa tarefa é das secretarias estaduais de educação e dos institutos federais de educação parceiros do Inep.\nDurante a inscrição você precisa escolher em qual Instituição Certificadora será mais fácil solicitar o certificado ou a\ndeclaração após a liberação dos resultados.</p></div><div style="padding-top:40px;padding-bottom:40px;border-top:2px solid #d3d3d3" class="col-md-12"><p style="font-size:18pt">Cronograma: Confira as principais datas do\n<b>Encceja 2020</b></p><table><tr><td style="background:#044785;width:190px;border-radius:7px 7px 7px 7px"><div style="height:100px"><p class="texto-branco-bold">Justificativa de\nAusência</p></div><div style="padding-left:20px"><div style="padding-top:10px;padding-bottom:10px;border-top:2px solid #d3d3d3" class="col-md-9"></div></div><div style="height:100px;padding-top:5px"><p class="texto-branco">14 a 20 de dezembro de 2020</p></div></td><td style="padding-left:40px"></td><td style="background:#044785;width:190px;border-radius:7px 7px 7px 7px"><div style="height:100px"><p class="texto-branco-bold">Inscrição</p></div><div style="padding-left:20px"><div style="padding-top:10px;padding-bottom:10px;border-top:2px solid #d3d3d3" class="col-md-9"></div></div><div style="height:100px;padding-top:5px"><p class="texto-branco">11 a 22 de janeiro de 2021.</p></div></td><td style="padding-left:40px"></td><td style="background:#044785;width:190px;border-radius:7px 7px 7px 7px"><div style="height:100px"><p class="texto-branco-bold">Aplicação das provas</p></div><div style="padding-left:20px"><div style="padding-top:10px;padding-bottom:10px;border-top:2px solid #d3d3d3" class="col-md-9"></div></div><div style="height:100px;padding-top:5px"><p class="texto-branco">29 de agosto de 2021.</p></div></td></tr></table></div></div>'),a.put("wizard/inepWizardTemplate.html",'<div class="col-md-12" id="inepWizard">\n  \n  <div id="rootwizard" class="wizard">\n    <div id="error" class="error"></div>\n    \n    <div class="wizard-head" ng-show="npShowHead">\n      <ul role="tablist">\n        <li ng-repeat="step in steps" class="hidden-xs" role="tab">\n          <a ng-href="#{{step.npTabId}}" id="{{step.npTabId}}" data-toggle="tab">{{step.npTitle}}</a>\n        </li>\n      </ul>\n    </div>\n    \n\n    <div class="widget" id="wiz-widget">\n      \n      <div class="widget-head progress col-md-12" id="bar" role="progressbar">\n        <div class="progress-bar progress-bar-primary" id="wiz-progress-bar" aria-labelledby="wiz-progress-bar header-active wiz-widget">Passo <strong class="step-current">1</strong>\n          de <strong class="steps-total">{{steps.length}}</strong> - <strong class="steps-percent">100%</strong>\n\n          <div style="display:none">{{steps[currentStepIndex].npTitle}}</div>\n        </div>\n      </div>\n      \n\n      <div class="widget-body">\n        \n        <div class="tab-content">\n          <div class="tab-pane active">\n            <div class="pull-right" ng-show="!npShowHead" id="wiz-header">\n              <h3 id="header-active">{{steps[currentStepIndex].npTitle}}</h3>\n            </div>\n            <div class="row">\n              <div ng-transclude></div>\n              <div class="container">\n                <div class="container-fluid col-md-12" ng-include="npHref" id="wiz-container"></div>\n              </div>\n            </div>\n          </div>\n        </div>\n        \n\n        \n        <div class="clearfix">\n          <ul class="pagination margin-bottom-none pull-right">\n            <li class="primary">\n              <button class="btn btn-primary" ng-href="#/" ng-click="quit()" ng-disabled="npDisabled" ng-hide="npHide" ng-show="npShow" role="button">Sair\n              </button>\n            </li>\n            <li class="primary change" ng-if="showOnChange()">\n              <button class="btn btn-primary" ng-disabled="npDisabled" ng-hide="npHide" ng-show="npShow" ng-click="onChange()" role="button">Alterar\n              </button>\n            </li>\n            <li class="primary previous" ng-show="hasPrevious()">\n              <button id="wizardPrevious" class="btn btn-primary" ng-click="showPreviousStep()" ng-disabled="npDisabled" np-hide="npHide" ng-show="npShow" role="button">Anterior\n              </button>\n            </li>\n\n            <li class="primary next" ng-show="hasNext()">\n              <button id="wizardNext" class="btn btn-primary" ng-disabled="npDisabled" ng-hide="npHide" ng-show="npShow" ng-click="showNextStep()" role="button">Próximo\n              </button>\n            </li>\n            <li class="primary next" ng-show="!hasNext()">\n              <button id="wizardFinish" class="btn btn-primary" ng-click="showNextStep()" ng-disabled="npDisabled" np-hide="npHide" ng-show="npShow" role="button">Confirmar\n              </button>\n            </li>\n            \n              \n              \n                      \n              \n            \n          </ul>\n        </div>\n        \n\n      </div>\n    </div>\n  </div>\n  \n</div>\n'),a.put("template/dirPagination.html",'<ul ng-if="1 &lt; pages.length || !autoHide" class="pagination"><li ng-if="boundaryLinks" ng-class="{ disabled : pagination.current == 1 }"><a href="#" ng-click="setCurrent(1)" title="Primeira página">Primeira<span style="position:absolute;left:-999em">página</span></a></li><li ng-if="directionLinks" ng-class="{ disabled : pagination.current == 1 }"><a href="#" ng-click="setCurrent(pagination.current - 1)" title="Página anterior"><span style="position:absolute;left:-999em">página</span>Anterior</a></li><li ng-repeat="pageNumber in pages track by tracker(pageNumber, $index)" ng-class="{ active : pagination.current == pageNumber, disabled : pageNumber == \'...\' }"><a href="#" ng-click="setCurrent(pageNumber)" title="Página {{ pageNumber }}"><span style="position:absolute;left:-999em">página</span>{{ pageNumber }}</a></li><li ng-if="directionLinks" ng-class="{ disabled : pagination.current == pagination.last }"><a href="#" ng-click="setCurrent(pagination.current + 1)" title="Próxima página">Próxima<span style="position:absolute;left:-999em">página</span></a></li><li ng-if="boundaryLinks" ng-class="{ disabled : pagination.current == pagination.last }"><a href="#" ng-click="setCurrent(pagination.last)" title="Última página">Última<span style="position:absolute;left:-999em">página</span></a></li></ul>'),a.put("template/entry.html",'<header role="banner"><h1 class="hide"> - </h1><nav role="navigation" aria-labelledby="#nav" ng-controller="NavigationBarController" class="navbar navbar-default navbar-fixed-top"><h2 id="nav" class="hide">Navegação Principal</h2><div class="container-fluid"><div class="navbar-header text-center"><button type="button" data-toggle="offcanvas" class="navbar-toggle collapsed left"><span class="sr-only">Toggle navigation</span><span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span></button><div aria-label="Bem vindo ao INEP" class="navbar-brand"><img src="images/logo_inep.svg" alt="Instituto Nacional de Estudos e Pesquisas Educacionais Anísio Teixeira"></div><button type="button" data-toggle="collapse" data-target="#navbar-collapse" class="navbar-toggle collapsed right p-n"><span class="sr-only">Toggle navigation</span><i class="fa fa-gear text-white"></i></button></div><script type="text/ng-template" id="warning-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Você ainda está aí?</h3></div><div idle-countdown="countdown" class="modal-body"><uib-progressbar max="30" value="countdown" animate="true" class="progress-striped active"></uib-progressbar>Sua sessão será encerrada em {{countdown}} segundos.</div></div></script><script type="text/ng-template" id="timedout-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Sess&atilde;o encerrada.</h3></div><div class="modal-body"><p></p>Sua sess&atilde;o foi encerrada por inatividade.</div></div></script></div></nav></header><main role="main"><section class="login"><h1 class="hide">Painel de entrada</h1></section></main>'),a.put("template/navigation.html",'<nav role="navigation" aria-labelledby="#nav" ng-controller="NavigationBarController" class="navbar navbar-default navbar-fixed-top"><h2 id="nav" class="hide">Navegação Principal</h2><div class="container-fluid"><div class="navbar-header text-center"><button type="button" data-toggle="offcanvas" class="navbar-toggle collapsed left"><span class="sr-only">Toggle navigation</span><span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span></button><div aria-label="Bem vindo ao INEP" class="navbar-brand"><img src="images/logo_inep.svg" alt="Instituto Nacional de Estudos e Pesquisas Educacionais Anísio Teixeira"></div><button type="button" data-toggle="collapse" data-target="#navbar-collapse" class="navbar-toggle collapsed right p-n"><span class="sr-only">Toggle navigation</span><i class="fa fa-gear text-white"></i></button></div><script type="text/ng-template" id="warning-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Você ainda está aí?</h3></div><div idle-countdown="countdown" class="modal-body"><uib-progressbar max="30" value="countdown" animate="true" class="progress-striped active"></uib-progressbar>Sua sessão será encerrada em {{countdown}} segundos.</div></div></script><script type="text/ng-template" id="timedout-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Sess&atilde;o encerrada.</h3></div><div class="modal-body"><p></p>Sua sess&atilde;o foi encerrada por inatividade.</div></div></script></div></nav>'),a.put("enem-regra/template/enemRegraTemplate.html",'<ul ng-form="formEnemRegra" ng-if="ngModel.statusItem === \'MARCADO\' && ngModel.dependencia && ngModel.dependencia.regras">\n  <li>\n    <enem-regra003 ng-model="ngModel"></enem-regra003>\n  </li>\n  <li>\n    <enem-regra004 ng-model="ngModel"></enem-regra004>\n  </li>\n  <li>\n    <enem-regra005 ng-model="ngModel" np-disabled="false" np-optional="false"></enem-regra005>\n  </li>\n</ul>\n'),a.put("views/guest/confirmarDadosContato.html",'<header role="banner"><h1 class="hide"> - </h1><nav role="navigation" aria-labelledby="#nav" ng-controller="NavigationBarController" class="navbar navbar-default navbar-fixed-top"><h2 id="nav" class="hide">Navegação Principal</h2><div class="container-fluid"><div class="navbar-header text-center"><button type="button" data-toggle="offcanvas" class="navbar-toggle collapsed left"><span class="sr-only">Toggle navigation</span><span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span></button><div aria-label="Bem vindo ao INEP" class="navbar-brand"><img src="images/logo_inep.svg" alt="Instituto Nacional de Estudos e Pesquisas Educacionais Anísio Teixeira"></div><button type="button" data-toggle="collapse" data-target="#navbar-collapse" class="navbar-toggle collapsed right p-n"><span class="sr-only">Toggle navigation</span><i class="fa fa-gear text-white"></i></button></div><script type="text/ng-template" id="warning-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Você ainda está aí?</h3></div><div idle-countdown="countdown" class="modal-body"><uib-progressbar max="30" value="countdown" animate="true" class="progress-striped active"></uib-progressbar>Sua sessão será encerrada em {{countdown}} segundos.</div></div></script><script type="text/ng-template" id="timedout-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Sess&atilde;o encerrada.</h3></div><div class="modal-body"><p></p>Sua sess&atilde;o foi encerrada por inatividade.</div></div></script></div></nav></header><main role="main"><section class="login"><h1 class="hide">Painel de entrada</h1><div class="container-fluid"><article><header class="text-center m-b"><div class="row"><div class="col-md-12 fundo-logo"><figure><img src="images/Logo-Encceja2026.png" alt="Exame Nacional para Certificação de Competências de Jovens e Adultos"></figure></div></div></header></article></div><div class="container"><div class="row"><div class="col-sm-8 col-sm-offset-2 col-lg-8 col-lg-offset-2"><form name="recuperarSenhaForm" role="form" novalidate="true" autocomplete="off" ng-controller="RecuperarSenhaController as c" ng-submit="c.enviar(c.dto)" inep-message-bag="inep-message-bag" message-bag-header-error="O formulário abaixo está inválido pelos seguintes erros:"><div class="panel panel-info"><div class="panel-heading"><h1 tabindex="0" focus-me="focus-me" class="h4 panel-title text-center text-primary">Alterar dados de contato para envio de senha</h1></div><div class="panel-body"><h2 class="h6 text-dark"><p tabindex="0">Para alterar seus dados de contato, confirme as informações abaixo:</p></h2><div inep-modal="inep-modal" np-buttons="c.buttons" np-show="c.modalShow" np-id="modal" np-options="c.modalOptions" np-header="ENCCEJA &gt; Alterar senha"><p tabindex="0">{{ c.modalMessage }}</p></div><div class="row"><inep-cpf np-id="numeroCpf" np-label="CPF: " np-value="c.dto.cpf" np-size="6" np-optional="false" np-black-list="pessoaFisica.blacklist" np-readonly="true"></inep-cpf></div><div class="row"><inep-email np-id="inputEmail" np-value="c.dto.emailInscricao" np-optional="false" np-allow-copy="false" np-allow-cut="false" np-allow-paste="false" np-maxlength="255" np-label="E-mail cadastrado na inscrição" np-size="7"></inep-email></div><div ng-if="c.random === 0" class="row"><inep-radiobutton np-id="checkboxEnvio" np-values="c.opcoesSimNao" np-selected-value="c.dto.possuiNomeMae" np-label="Possui nome da mãe cadastrado: " np-inline="true" np-optional="false" np-size="5" np-accessibility-message="{{c.mensagens.MSGA029}}"></inep-radiobutton><inep-input-text np-id="inputNomeMae" np-label="Nome da mãe: " ng-model="c.dto.nomeMae" np-optional="c.dto.possuiNomeMae === &quot;false&quot;" np-readonly="c.dto.possuiNomeMae === &quot;false&quot;" np-size="7" np-maxlength="150" np-accessibility-message="{{c.mensagens.MSGA004}}"></inep-input-text></div><div ng-if="c.random === 1" class="row"><inep-input-text np-accessibility-message="{{c.mensagens.MSGA012}}" np-id="inputIdentidadeNumero" np-label="Nº da identidade" np-maxlength="20" ng-model="c.dto.identidadeNumero" np-optional="false" inep-validator="c.validarRg(c.dto.identidadeNumero)" np-size="4"></inep-input-text><inep-combobox np-id="selectIdentidadeOrgaoExpedidor" np-label="Órgão expedidor" np-optional="false" np-reverse="true" np-selected-value="c.dto.identidadeOrgaoExpedidor" np-size="4" np-values="c.orgaosExpedidores"></inep-combobox><inep-combobox np-id="selectUfIdentidade" np-label="UF da identidade" np-optional="false" np-selected-value="c.dto.identidadeUf" np-size="4" np-values="c.ufs"></inep-combobox></div><div ng-if="c.random === 2" class="row"><inep-input-text np-id="inputCep" np-label="Cep de residência" ng-model="c.dto.cepResidencia" np-size="6" np-mask="99999-999"></inep-input-text><inep-input-text np-id="inputNumero" np-label="Numero de residência" ng-model="c.dto.numeroResidencia" np-size="6" np-accessibility-message="{{c.mensagens.MSGA015}}"></inep-input-text></div><div ng-if="c.random === 3" class="row"><inep-combobox np-id="selectEstadoCivil" np-label="Estado civil" np-optional="false" np-selected-value="c.dto.estadoCivil" np-size="6" np-values="c.estadosCivis"></inep-combobox><div class="col-sm-6"><inep-calendar np-id="calendar" np-label="Data de nascimento:" ng-model="c.dto.dataDeNascimento" np-type="popup" np-optional="false" np-starting-day="0" np-year-range="20" np-current-text="Hoje" np-clear-text="Limpar" np-close-text="Fechar" np-width="12" np-hide-icon="true" np-min-date="1900-01-01" np-accessibility-message="{{c.mensagens.MSGA003}}"></inep-calendar></div></div><div ng-if="c.random === 4" class="row"><inep-combobox np-id="ufResidencia" np-label="UF de residência: " np-selected-value="c.dto.ufResidencia" np-optional="false" np-size="6" np-values="c.ufs" np-accessibility-message="{{c.mensagens.MSGA018}}"></inep-combobox><inep-municipio np-id="municipioResidencia" np-label="Município de residência: " np-uf="c.dto.ufResidencia" np-selected-value="c.dto.municipioResidencia" np-optional="false" np-size="6" np-accessibility-message="{{c.mensagens.MSGA019}}"></inep-municipio></div><div ng-if="c.random === 5" class="row"><inep-combobox np-accessibility-message="{{c.mensagens.MSGA030}}" np-id="selectNacionalidade" np-label="Nacionalidade" np-optional="false" np-selected-value="c.dto.nacionalidade" np-size="4" np-on-change="c.nacionalidadeChanged()" np-values="c.nacionalidades"></inep-combobox><div id="nacionalidade" ng-if="c.isBrasileiro()"><inep-combobox np-accessibility-message="{{c.mensagens.MSGA031}}" np-id="ufNascimento" np-label="UF de nascimento" np-optional="!c.isBrasileiro()" np-selected-value="c.dto.nascimentoUf" np-size="4" np-values="c.ufs"></inep-combobox><inep-municipio np-id="municipioNascimento" np-accessibility-message="{{c.mensagens.MSGA032}}" np-label="Município de nascimento" np-optional="!c.isBrasileiro()" np-no-select-label="Selecione" np-selected-value="c.dto.nascimentoMunicipio" np-size="4" np-uf="c.dto.nascimentoUf"></inep-municipio></div></div><h2 class="h6 text-dark"><p tabindex="0">Informe novos dados para contato. Estas informações serão utilizadas para envio da nova senha.</p></h2><div class="row"><div class="form-group"><inep-email np-id="inputNovoEmail" np-value="c.dto.novoEmail" np-optional="false" np-allow-copy="false" np-allow-cut="false" np-allow-paste="false" np-maxlength="255" np-label="E-mail" np-on-blur="c.verificaSeEmailCadastrado()" inep-validator="c.exibeErroEmail()" np-size="6" np-accessibility-message="{{c.mensagens.MSGA006}}"></inep-email><inep-email np-id="inputConfirmaEmail" np-value="c.dto.confirmaEmail" np-optional="false" np-label="Confirmar e-mail" np-size="6" np-allow-copy="false" np-maxlength="255" np-allow-cut="false" np-allow-paste="false" np-confirm-value="c.dto.novoEmail" np-confirm-message="Confirmação de e-mail divergente." np-accessibility-message="{{c.mensagens.MSGA009}}"></inep-email></div></div><div class="row with-space-top"><div class="col-md-6 col-md-offset-3"><inep-visual-captcha></inep-visual-captcha></div></div></div><ul class="list-group"><li class="list-group-item"><a ui-sref="loginParticipanteOLD" style="cursor:pointer"><i class="fa fa-sign-out text-dark"></i> Sair</a></li></ul><footer class="panel-footer p-n"><button type="submit" ng-disabled="recuperarSenhaForm.$invalid" class="btn btn-default btn-block"><i class="fa fa-paper-plane-o"></i> Salvar novos dados de contato e enviar nova senha</button></footer></div></form></div></div></div></section></main>'),
a.put("views/guest/enviarSenha.html",'<header role="banner"><h1 class="hide"> - </h1><nav role="navigation" aria-labelledby="#nav" ng-controller="NavigationBarController" class="navbar navbar-default navbar-fixed-top"><h2 id="nav" class="hide">Navegação Principal</h2><div class="container-fluid"><div class="navbar-header text-center"><button type="button" data-toggle="offcanvas" class="navbar-toggle collapsed left"><span class="sr-only">Toggle navigation</span><span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span></button><div aria-label="Bem vindo ao INEP" class="navbar-brand"><img src="images/logo_inep.svg" alt="Instituto Nacional de Estudos e Pesquisas Educacionais Anísio Teixeira"></div><button type="button" data-toggle="collapse" data-target="#navbar-collapse" class="navbar-toggle collapsed right p-n"><span class="sr-only">Toggle navigation</span><i class="fa fa-gear text-white"></i></button></div><script type="text/ng-template" id="warning-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Você ainda está aí?</h3></div><div idle-countdown="countdown" class="modal-body"><uib-progressbar max="30" value="countdown" animate="true" class="progress-striped active"></uib-progressbar>Sua sessão será encerrada em {{countdown}} segundos.</div></div></script><script type="text/ng-template" id="timedout-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Sess&atilde;o encerrada.</h3></div><div class="modal-body"><p></p>Sua sess&atilde;o foi encerrada por inatividade.</div></div></script></div></nav></header><main role="main"><section class="login"><h1 class="hide">Painel de entrada</h1><div class="container-fluid"><article><header class="text-center m-b"><div class="row"><div class="col-md-12 fundo-logo"><figure><img src="images/Logo-Encceja2026.png" alt="Exame Nacional para Certificação de Competências de Jovens e Adultos"></figure></div></div></header></article></div><div class="container"><div class="row"><div class="col-sm-8 col-sm-offset-2 col-lg-8 col-lg-offset-2"><form id="enviarSenhaForm" name="enviarSenhaForm" role="form" novalidate="true" autocomplete="off" ng-controller="EnviarSenhaController as c" ng-submit="c.enviar(c.dto)" inep-message-bag="inep-message-bag" message-bag-header-error="O formulário abaixo está inválido pelos seguintes erros:"><div class="panel panel-info"><div class="panel-heading"><h1 tabindex="0" focus-me="focus-me" class="h4 panel-title text-center text-primary">Enviar senha temporária por {{c.dto.tipoEnvio === 1 ? \'e-mail\' : \'SMS\' }}</h1></div><div class="panel-body with-space-bottom"><h2 class="h6 text-dark"><p tabindex="0">Sua nova senha poderá ser enviada para o {{c.dto.tipoEnvio === 1 ? \'E-MAIL\' : \'TELEFONE CELULAR\' }} abaixo cadastrado.\n Você pode solicitar o envio da uma nova senha ou informar que não possui mais acesso a este canal de comunicação.</p></h2><div inep-modal="inep-modal" np-buttons="c.modal.buttons" np-show="c.modal.show" np-id="c.modal" np-options="c.modalOptions" np-header="Encceja &gt; Enviar senha"><span tabindex="0" ng-if="c.modal.tipoEnvio == 1"><p>Sua nova senha foi enviada para o email \'{{c.modal.destinatario}}\'.</p></span><span tabindex="0" ng-if="c.modal.tipoEnvio == 2"><p>Sua nova senha foi enviada por SMS para o celular \'{{c.modal.destinatario}}\'.</p></span><span tabindex="0" ng-if="!!c.modal.msgErro"><p>{{c.modal.msgErro}}</p></span></div><div class="row"><inep-cpf np-id="cpfEnvioSenha" np-label="CPF: " np-value="c.dto.cpf" np-size="4" np-optional="false" np-readonly="true"></inep-cpf><inep-input-text ng-if="c.dto.tipoEnvio === 1" np-label="E-mail" np-id="inputEmail" ng-model="c.dto.email" np-size="8" np-readonly="true" np-accessibility-message="{{c.mensagens.MSGA006}}"></inep-input-text><inep-input-text ng-if="c.dto.tipoEnvio === 2" np-label="Telefone celular" np-id="inputTelCelular" ng-model="c.dto.celular" np-size="8" np-readonly="true" np-accessibility-message="{{c.mensagens.MSGA021_}}"></inep-input-text></div><div class="row with-space-top"><div class="col-md-8 col-md-offset-2"><inep-visual-captcha></inep-visual-captcha></div></div></div><ul class="list-group"><li class="list-group-item"><a data-ui-sref="loginParticipanteOLD" style="cursor:pointer"><i class="fa fa-sign-out text-dark"></i> Sair</a><span class="pull-right"><a style="cursor:pointer" ng-click="c.naoTenhoAcesso()">Não tenho acesso a este {{c.dto.tipoEnvio === 1 ? \'e-mail\' : \'telefone celular\' }}&nbsp;<i class="fa fa-arrow-circle-right text-dark"></i></a></span></li></ul><footer class="panel-footer p-n"><button class="btn btn-default btn-block"><i class="fa fa-paper-plane-o"></i> Enviar nova senha por {{c.dto.tipoEnvio === 1 ? \'e-mail\' : \'SMS\' }}</button></footer></div></form></div></div></div></section></main>'),a.put("views/inscricao/inscricaoWizard.html",'<header role="banner"><h1 class="hide"> - </h1><nav role="navigation" aria-labelledby="#nav" ng-controller="NavigationBarController" class="navbar navbar-default navbar-fixed-top"><h2 id="nav" class="hide">Navegação Principal</h2><div class="container-fluid"><div class="navbar-header text-center"><button type="button" data-toggle="offcanvas" class="navbar-toggle collapsed left"><span class="sr-only">Toggle navigation</span><span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span></button><div aria-label="Bem vindo ao INEP" class="navbar-brand"><img src="images/logo_inep.svg" alt="Instituto Nacional de Estudos e Pesquisas Educacionais Anísio Teixeira"></div><button type="button" data-toggle="collapse" data-target="#navbar-collapse" class="navbar-toggle collapsed right p-n"><span class="sr-only">Toggle navigation</span><i class="fa fa-gear text-white"></i></button></div><script type="text/ng-template" id="warning-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Você ainda está aí?</h3></div><div idle-countdown="countdown" class="modal-body"><uib-progressbar max="30" value="countdown" animate="true" class="progress-striped active"></uib-progressbar>Sua sessão será encerrada em {{countdown}} segundos.</div></div></script><script type="text/ng-template" id="timedout-dialog.html"><div class="modal-content"><div class="modal-header"><h3 class="modal-title">Sess&atilde;o encerrada.</h3></div><div class="modal-body"><p></p>Sua sess&atilde;o foi encerrada por inatividade.</div></div></script></div></nav></header><main role="main"><section class="login"><h1 class="hide">Painel de entrada</h1><div id="wizard" ng-controller="InscricaoController as c"><style>#wiz-progress-bar{display:none}</style><inep-wizard np-show-head="true" np-on-quit="c.cancelarInscricao()" np-on-finish="c.validarFinalizarInscricao()" np-disabled="desabilita"><inep-step np-tab-id="tab1" np-title="Dados pessoais" np-href="views/inscricao/wizard/informacoesPessoais.html"></inep-step><inep-step np-tab-id="tab2" np-title="Atendimentos / Recursos" np-href="views/inscricao/wizard/navegacaoAtendimento.html"></inep-step><inep-step np-tab-id="tab3" np-title="Tratamento pelo nome social" np-href="views/inscricao/wizard/nomeSocial.html"></inep-step><inep-step np-tab-id="tab4" np-title="Prova" np-href="views/inscricao/wizard/informacoesProva.html"></inep-step><inep-step np-tab-id="tab6" ng-if="c.ausencia.inAusente" np-title="Justificativa de ausência" np-href="views/inscricao/wizard/justificativaAusencia.html"></inep-step><inep-step np-tab-id="tab7" ng-if="c.questionario" np-title="Questionário" np-href="views/inscricao/wizard/questionario.html"></inep-step></inep-wizard><div inep-modal="inep-modal" np-id="modalWizard" np-buttons="c.modalSair.botoes" np-show="c.modalSair.exibe"><h2 aria-labelledby="texto" tabindex="0" class="titulo-modal h5 panel-title text-center text-primary">{{ c.modalSair.mensagem }}</h2></div></div></section></main>'),a.put("views/inscricao/loginByPass.html",'<header role="banner"><h1 class="hide"