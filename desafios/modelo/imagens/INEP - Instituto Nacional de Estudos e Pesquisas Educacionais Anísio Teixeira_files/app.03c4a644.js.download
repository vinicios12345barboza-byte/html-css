arget='_blank' href='https://www.gov.br/inep/pt-br/centrais-de-conteudo/legislacao/encceja'>https://www.gov.br/inep/pt-br/centrais-de-conteudo/legislacao/encceja</a>.",arquivos:[{label:"Boletim de Ocorrência",obrigatorio:!0}],statusItem:"DESMARCADO"},{id:3,ordem:3,label:"Casamento/União Estável",descricaoArquivo:"Certidão de Casamento ou Declaração de União Estável com o nome do participante, assinado em até 9 (nove) dias de antecedência das datas previstas no anexo do edital do Exame, disponível no endereço <a target='_blank' href='https://www.gov.br/inep/pt-br/centrais-de-conteudo/legislacao/encceja'>https://www.gov.br/inep/pt-br/centrais-de-conteudo/legislacao/encceja</a>.",arquivos:[{label:"Certidão de Casamento",obrigatorio:!0}],statusItem:"DESMARCADO"},{id:17,ordem:4,label:"Morte na família/Luto",descricaoArquivo:"Certidão de Óbito do cônjuge ou companheiro, pai, mãe ou responsável legal, avô, avó, irmão, filho ou enteado, ocorrido em até 7 (sete) dias de antecedência das datas previstas no anexo do edital do Exame, disponível no endereço <a target='_blank' href='https://www.gov.br/inep/pt-br/centrais-de-conteudo/legislacao/encceja'>https://www.gov.br/inep/pt-br/centrais-de-conteudo/legislacao/encceja</a>. É necessário o envio de documentação que comprove o parentesco.",arquivos:[{label:"Certidão de Óbito",obrigatorio:!0},{label:"Documento de Comprovação do Parentesco",obrigatorio:!0}],statusItem:"DESMARCADO"},{id:5,ordem:5,label:"Maternidade",descricaoArquivo:"Certidão de Nascimento ou de adoção legível que conste o nome da participante e que contemple as datas previstas no anexo do edital do Exame, disponível no endereço <a target='_blank' href='https://www.gov.br/inep/pt-br/centrais-de-conteudo/legislacao/encceja'>https://www.gov.br/inep/pt-br/centrais-de-conteudo/legislacao/encceja</a>.",arquivos:[{label:"Certidão de Nascimento ou de Adoção",obrigatorio:!0}],statusItem:"DESMARCADO"},{id:6,ordem:6,label:"Paternidade",descricaoArquivo:"Certidão de Nascimento ou de adoção legível  que conste o nome do participante e que contemple as datas previstas no anexo do edital do Exame, disponível no endereço <a target='_blank' href='https://www.gov.br/inep/pt-br/centrais-de-conteudo/legislacao/encceja'>https://www.gov.br/inep/pt-br/centrais-de-conteudo/legislacao/encceja</a>.",arquivos:[{label:"Certidão de Nascimento ou de Adoção",obrigatorio:!0}],statusItem:"DESMARCADO"},{id:7,ordem:7,label:"Mudança de domicílio para acompanhamento de familiar",descricaoArquivo:"Documento expedido por autoridade constituída que comprove o acompanhamento de cônjuge ou de companheiro, pai, mãe ou responsável legal, avô, avó, irmão, filho ou enteado deslocado para outra cidade nas datas previstas no anexo do edital do Exame, disponível no endereço <a target='_blank' href='https://www.gov.br/inep/pt-br/centrais-de-conteudo/legislacao/encceja'>https://www.gov.br/inep/pt-br/centrais-de-conteudo/legislacao/encceja</a>. É necessário o envio de documentação que comprove o parentesco.",arquivos:[{label:"Comprovante do Acompanhamento",obrigatorio:!0},{label:"Comprovante do Parentesco",obrigatorio:!0}],statusItem:"DESMARCADO"},{id:8,ordem:8,label:"Privação de liberdade",descricaoArquivo:"Mandado de prisão ou documento congênere legível, contendo o nome completo do participante e a assinatura do órgão competente atestando a privação de liberdade nas datas previstas no anexo do edital do Exame, disponível no endereço <a target='_blank' href='https://www.gov.br/inep/pt-br/centrais-de-conteudo/legislacao/encceja'>https://www.gov.br/inep/pt-br/centrais-de-conteudo/legislacao/encceja</a>.",arquivos:[{label:"Documento de Privação de Liberdade",obrigatorio:!0}],statusItem:"DESMARCADO"},{id:16,ordem:9,label:"Saúde",descricaoArquivo:"Atestado Médico ou Odontológico legível, com o nome completo do participante, especificando a emergência médica ou odontológica nas datas previstas no anexo do edital do Exame, disponível no endereço <a target='_blank' href='https://www.gov.br/inep/pt-br/centrais-de-conteudo/legislacao/encceja'>https://www.gov.br/inep/pt-br/centrais-de-conteudo/legislacao/encceja</a>. O documento deve conter o número do Conselho Regional de Medicina (CRM), do Registro do Ministério da Saúde (RMS) ou do Conselho Regional de Odontologia (CRO) e a assinatura do médico ou do odontólogo responsável. Também serão aceitos atestados de acompanhamento de familiar, contendo o nome completo do participante. ",arquivos:[{label:"Atestado Médico",obrigatorio:!0}],statusItem:"DESMARCADO"},{id:11,ordem:11,label:"Trabalho",descricaoArquivo:"Declaração com o nome completo do participante e a justificativa de exercício de atividade profissional nas datas previstas no anexo do edital do Exame, disponível no endereço <a target='_blank' href='https://www.gov.br/inep/pt-br/centrais-de-conteudo/legislacao/encceja'>https://www.gov.br/inep/pt-br/centrais-de-conteudo/legislacao/encceja</a>. A declaração deve conter o número do Cadastro Nacional de Pessoa Jurídica (CNPJ) com a identificação e a assinatura do empregador responsável pela declaração.",arquivos:[{label:"Declaração de Atividade Profissional",obrigatorio:!0}],statusItem:"DESMARCADO"},{id:15,ordem:13,label:"Intercâmbio acadêmico",descricaoArquivo:"Documento assinado, em língua portuguesa, da Instituição de Ensino Internacional que comprove intercâmbio internacional, contendo a identificação da Instituição de Ensino, o nome completo do participante e o período do curso que contemple as datas previstas no anexo do edital do Exame, disponível no endereço <a target='_blank' href='https://www.gov.br/inep/pt-br/centrais-de-conteudo/legislacao/encceja'>https://www.gov.br/inep/pt-br/centrais-de-conteudo/legislacao/encceja</a>.",arquivos:[{label:"Comprovante do Intercâmbio",obrigatorio:!0}],statusItem:"DESMARCADO"},{id:13,ordem:14,label:"Atividade Escolar",descricaoArquivo:"Declaração ou documento assinado que comprove a participação do estudante em atividade escolar, no Brasil ou exterior, que contemple as datas previstas no anexo do edital do Exame, disponível no endereço <a target='_blank' href='https://www.gov.br/inep/pt-br/centrais-de-conteudo/legislacao/encceja'>https://www.gov.br/inep/pt-br/centrais-de-conteudo/legislacao/encceja</a>.",arquivos:[{label:"Documento de Atividade Escolar",obrigatorio:!0}],statusItem:"DESMARCADO"},{id:14,ordem:15,label:"Não tenho justificativa para comprovar minha ausência",statusItem:"DESMARCADO"}]};return{obterJustificativas:a}}},{}],213:[function(a,e,o){"use strict";angular.module("enemParticipanteApp").factory("MotivosJustificativaService",a("./MotivosJustificativaService")).service("AusenciaService",a("./AusenciaService"))},{"./AusenciaService":211,"./MotivosJustificativaService":212}],214:[function(a,e,o){"use strict";e.exports=["$rootScope","$state","autenticacao",function(a,e,o){a.$on("$stateChangeSuccess",function(a,i,n,s,t){0===(i.access&o.getRole())&&e.go("inicial")})}]},{}]},{},[68]);